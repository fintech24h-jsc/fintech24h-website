---
// src/pages/case-studies/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { getAllCaseStudies } from '../../lib/wordpress';

const caseStudies = await getAllCaseStudies();

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Case Studies', item: 'https://fintech24h.com/case-studies' }
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Fintech24h Case Studies — Web3 Campaign Results",
  "url": "https://fintech24h.com/case-studies",
  "description": "Browse our marketing and growth records. See how we scaled layer-1 ecosystems, decentralized exchanges, and gaming hubs to millions of active users.",
  "provider": {
    "@type": "Organization",
    "name": "Fintech24h",
    "url": "https://fintech24h.com"
  },
  "hasPart": caseStudies.map((cs, i) => ({
    "@type": "Article",
    "position": i + 1,
    "name": cs.title.rendered,
    "url": `https://fintech24h.com/case-studies/${cs.slug}`
  }))
};
---

<BaseLayout
  title="Case Studies — Web3 Campaign Results & ROI"
  description="Browse our marketing and growth records. See how we scaled layer-1 ecosystems, decentralized exchanges, and gaming hubs to millions of active users."
  schema={collectionSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="relative py-24 lg:py-32 overflow-hidden" aria-label="Case Studies Directory">
    <!-- Ambient background glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-cyan w-[600px] h-[600px] absolute -top-40 -left-32 opacity-15"></div>
      <div class="bg-orb bg-orb-purple w-[500px] h-[500px] absolute bottom-10 -right-32 opacity-10"></div>
      <div class="grid-pattern absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-purple-400/30 bg-purple-400/5 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
          <span class="text-xs font-semibold text-purple-400 font-body uppercase tracking-wider">Proof of Work</span>
        </div>
        <h1 class="font-display text-h1 font-bold text-[#f0f4ff] mb-6">
          Campaign Reports & Client ROI
        </h1>
        <p class="text-lg text-[#94a3b8] font-body leading-relaxed">
          We focus on measurable conversions. Explore real campaign data detailing growth timelines, user acquisitions, and ad-spend efficiencies.
        </p>
      </div>

      <!-- Case studies list -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" data-animate="stagger">
        {caseStudies.map((cs) => (
          <div class="glass-card rounded-2xl p-8 sm:p-10 border border-white/5 flex flex-col justify-between group hover:border-cyan-400/35 transition-all duration-300" data-animate-child>
            <div>
              <!-- Client & Industry header -->
              <div class="flex items-center justify-between gap-4 mb-6">
                <span class="px-3 py-1 rounded-full border border-cyan-400/30 bg-cyan-400/5 text-[9px] font-bold text-cyan-400 font-body tracking-wider uppercase">
                  {cs.acf.industry}
                </span>
                <span class="text-xs text-[#475569] font-body font-semibold">{cs.acf.result_timeline}</span>
              </div>

              <!-- Title & Excerpt -->
              <h2 class="font-display text-xl sm:text-2xl font-bold text-[#f0f4ff] mb-4 group-hover:text-cyan-400 transition-colors">
                {cs.title.rendered}
              </h2>
              <p class="text-sm text-[#94a3b8] font-body leading-relaxed mb-6">
                {cs.excerpt.rendered.replace(/<[^>]*>/g, '').slice(0, 160).trim()}...
              </p>

              <!-- Highlights list -->
              <div class="grid grid-cols-3 gap-4 py-6 my-6 border-y border-white/5 text-center">
                <div>
                  <div class="text-lg sm:text-xl font-display font-bold text-cyan-400">{cs.acf.result_roi}</div>
                  <div class="text-[9px] text-[#475569] font-body uppercase tracking-wider mt-0.5">Campaign ROI</div>
                </div>
                <div>
                  <div class="text-lg sm:text-xl font-display font-bold text-purple-400">{cs.acf.result_leads}</div>
                  <div class="text-[9px] text-[#475569] font-body uppercase tracking-wider mt-0.5">Leads Generated</div>
                </div>
                <div>
                  <div class="text-lg sm:text-xl font-display font-bold text-[#f0f4ff]">{cs.acf.result_reach}</div>
                  <div class="text-[9px] text-[#475569] font-body uppercase tracking-wider mt-0.5">Total Reach</div>
                </div>
              </div>
            </div>

            <!-- Link -->
            <div class="flex justify-end pt-2">
              <a
                href={`/case-studies/${cs.slug}`}
                class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 font-display uppercase tracking-wider flex items-center gap-2 transition-colors"
                aria-label={`Read ${cs.acf.client_name} Case Study`}
              >
                Read Case Study
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>
