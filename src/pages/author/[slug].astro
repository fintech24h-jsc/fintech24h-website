---
// src/pages/author/[slug].astro
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { getUserBySlug, getPostsByAuthor, formatDate, getExcerpt, getFeaturedImage } from '../../lib/wordpress';
import { getReadingTime } from '../../lib/utils';
import { team } from '../../data/team';

Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

const { slug } = Astro.params;
const user = slug ? await getUserBySlug(slug) : null;

if (!user) {
  return Astro.redirect('/404');
}

// Find local team member details (signature gradient, telegram, linkedin, etc)
const member = team.find(m => {
  const slugMatch = m.name.toLowerCase().replace(/\s+/g, '-') === slug || 
                    (slug === 'phat' && m.name === 'Phat Vo') || 
                    (slug === 'vincent' && m.name === 'Vincent Nguyen') ||
                    (slug === 'jayc' && m.name === 'JayC') ||
                    (slug === 'gemi' && m.name === 'Gemi');
  return slugMatch;
});

// Merged Author Information
const authorName = member?.name || user.name;
const authorRole = member?.role || "Contributor";
const authorImage = member?.image || user.avatar_urls?.['96'] || 'https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp';
const signatureColor = member?.signatureColor || 'linear-gradient(135deg, #00c8f0 0%, #7c5cfc 100%)';
const telegram = member?.telegram || 'https://telegram.me/fintech24h';
const linkedin = member?.linkedin || 'https://www.linkedin.com/company/fintech24h/';

// Authentic CPO and Co-founder biography details for Phat Vo (No fabricated statistics)
const phatBio = "Co-Founder & Chief Product Officer of Fintech24h.com. Phat Vo directs the technical product roadmap, engineering nodes, and design systems for the entire Fintech24h ecosystem. He oversees the development of core platforms, manages cross-functional product teams, and spearheads business operations, ensuring seamless Web3 integration and client growth.";
const authorBio = slug === 'phat' ? phatBio : (member?.bio || user.description || "Fintech24h team member and contributor.");

// Fetch publications by the author
const posts = await getPostsByAuthor(user.id);

const currentUrl = `https://fintech24h.com/author/${slug}`;

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Blog', item: 'https://fintech24h.com/blog' },
  { name: authorName, item: currentUrl }
];

// Person Schema for SEO
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": authorName,
  "jobTitle": authorRole,
  "worksFor": {
    "@type": "Organization",
    "name": "Fintech24h",
    "url": "https://fintech24h.com",
    "logo": "https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp"
  },
  "description": authorBio,
  "image": authorImage,
  "sameAs": [
    telegram,
    linkedin
  ],
  "url": currentUrl
};

// Fintech24h Ecosystem products directed by Phat Vo (authentic products)
const phatProducts = [
  {
    name: "CMO Intern",
    tagline: "Web3 Growth Marketing Hub",
    desc: "A specialized platform connecting protocols with vetted marketing and community management talent to scale Web3 ecosystems.",
    url: "https://cmointern.com"
  },
  {
    name: "Coinstori",
    tagline: "Web3 Media Hub",
    desc: "A premium marketing and publication network amplifying brand presence across high-authority cryptocurrency news outlets.",
    url: "https://coinstori.com"
  },
  {
    name: "Custom Client Solutions",
    tagline: "Enterprise Architectures",
    desc: "Bespoke technology dashboards, automated lead generation funnels, and programmatic growth engines for enterprise clients.",
    url: "/services/custom-solutions"
  }
];

---

<BaseLayout
  title={`${authorName} — ${authorRole} | Fintech24h CPO Profile`}
  description={authorBio}
  schema={personSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- Premium Futuristic 3-Column HUD Dashboard Hero -->
  <section class="relative min-h-screen flex items-center justify-center px-4 overflow-hidden bg-[#020202] pt-32 pb-20" aria-label="Author Profile Hero">
    <!-- Background mesh & custom orbs -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <div class="absolute top-[15%] left-1/2 -translate-x-1/2 w-[80vw] h-[65vh] rounded-full filter blur-[130px] opacity-[0.18]" style={{ background: signatureColor }}></div>
      <div class="absolute bottom-[-15%] right-[5%] w-[400px] h-[400px] rounded-full filter blur-[110px] opacity-10 animate-[float-slow_15s_infinite_ease-in-out]" style={{ background: signatureColor }}></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#00c8f005_1px,transparent_1px),linear-gradient(to_bottom,#00c8f005_1px,transparent_1px)] bg-[size:5rem_5rem] opacity-20"></div>
    </div>

    <!-- Scanning line overlay -->
    <div class="absolute inset-0 pointer-events-none z-10 scanlines-overlay opacity-[0.02]"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full">
      
      <!-- Top Cyber Tag -->
      <div class="flex justify-between items-center mb-8 border-b border-white/10 pb-4">
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-full animate-ping" style={{ background: signatureColor }}></span>
          <span class="font-mono text-[10px] text-white/50 tracking-[0.3em] uppercase">SYSTEM.STATUS // NODE_ONLINE</span>
        </div>
        <div class="font-mono text-[10px] text-white/30 hidden md:block">
          SECURE_CLEARANCE // LEVEL_4_CPO
        </div>
      </div>

      <!-- Main Dashboard Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Column 1: Operator Identity Dossier -->
        <div class="lg:col-span-3 flex flex-col justify-between bg-black/40 border border-white/5 p-6 rounded-2xl backdrop-blur-md hover:border-white/10 transition-colors duration-500 relative overflow-hidden group">
          <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-[var(--accent-cyan)] to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-[scan-down_3s_linear_infinite]" style={{ '--accent-cyan': slug === 'phat' ? '#00c8f0' : '#7c5cfc' }}></div>
          
          <div class="flex flex-col items-center lg:items-start">
            <!-- HUD Interactive Avatar -->
            <div class="relative mb-6">
              <div class="absolute -inset-2.5 rounded-full border border-dashed border-white/10 group-hover:border-cyan-400/20 transition-colors duration-500 animate-[spin_45s_linear_infinite] z-0"></div>
              <div class="absolute -inset-1.5 rounded-full border border-double border-purple-500/10 group-hover:border-purple-500/20 transition-colors duration-500 animate-[spin_25s_linear_infinite_reverse] z-0"></div>
              
              <div class="relative w-36 h-36 rounded-full p-[2px] z-10 transition-transform duration-500 group-hover:scale-[1.02]" style={{ background: signatureColor }}>
                <div class="w-full h-full rounded-full bg-[#050810] overflow-hidden flex items-center justify-center border border-black">
                  <img 
                    src={authorImage} 
                    alt={authorName} 
                    class="w-full h-full object-cover filter grayscale opacity-95 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500"
                  />
                </div>
              </div>
            </div>

            <!-- Identity info -->
            <div class="text-center lg:text-left space-y-1">
              <span class="font-mono text-[9px] uppercase tracking-widest text-slate-500 block">Operator ID // 0x47C02</span>
              <h1 class="font-display text-3xl font-bold text-white uppercase tracking-tight">
                {authorName}
              </h1>
              <span class="font-mono text-xs uppercase font-medium tracking-wider" style={{ background: signatureColor, webkitBackgroundClip: 'text', webkitTextFillColor: 'transparent', backgroundClip: 'text' }}>
                {authorRole}
              </span>
            </div>

            <!-- Monospaced Credentials Badge -->
            <div class="w-full bg-white/5 border border-white/10 p-3 rounded-lg font-mono text-[10px] text-white/60 space-y-1 mt-6">
              <div class="flex justify-between"><span>NODE:</span><span class="text-white">F24H_ROOT_2</span></div>
              <div class="flex justify-between"><span>STATUS:</span><span class="text-emerald-400">ACTIVE</span></div>
              <div class="flex justify-between"><span>OPERATIONS:</span><span class="text-white">CO-FOUNDER</span></div>
            </div>
          </div>

          <!-- Social Matrix connections -->
          <div class="space-y-2 mt-8 lg:mt-0">
            <a href={telegram} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-white/5 bg-white/[0.01] hover:border-cyan-400/30 hover:bg-cyan-400/5 hover:shadow-[0_0_15px_rgba(0,200,240,0.1)] transition-all duration-300 group/btn">
              <span class="font-mono text-[10px] uppercase text-white/50 group-hover/btn:text-white transition-colors">Telegram Node</span>
              <span class="text-[var(--accent-cyan)] group-hover/btn:translate-x-0.5 transition-transform" style={{ color: slug === 'phat' ? '#00c8f0' : '#7c5cfc' }}>→</span>
            </a>
            <a href={linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-white/5 bg-white/[0.01] hover:border-purple-500/30 hover:bg-purple-500/5 hover:shadow-[0_0_15px_rgba(124,92,252,0.1)] transition-all duration-300 group/btn">
              <span class="font-mono text-[10px] uppercase text-white/50 group-hover/btn:text-white transition-colors">LinkedIn Hub</span>
              <span class="text-[var(--accent-purple)] group-hover/btn:translate-x-0.5 transition-transform" style={{ color: slug === 'phat' ? '#7c5cfc' : '#00c8f0' }}>→</span>
            </a>
          </div>
        </div>

        <!-- Column 2: CPO Diagnostics Console & Bio -->
        <div class="lg:col-span-6 flex flex-col justify-between bg-black/40 border border-white/5 p-8 rounded-2xl backdrop-blur-md hover:border-white/10 transition-colors duration-500 relative overflow-hidden group">
          <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-[var(--accent-purple)] to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-[scan-down_3.5s_linear_infinite]" style={{ '--accent-purple': slug === 'phat' ? '#7c5cfc' : '#00c8f0' }}></div>
          
          <div class="space-y-6">
            <div>
              <span class="font-mono text-[9px] uppercase tracking-widest text-[var(--accent-cyan)] mb-1 block" style={{ color: slug === 'phat' ? '#00c8f0' : '#7c5cfc' }}>[ OPERATIONAL_OVERVIEW ]</span>
              <h2 class="font-display text-2xl font-bold text-white uppercase">Operational Console</h2>
            </div>
            
            <p class="font-body text-slate-300 text-sm leading-[1.8] font-light">
              {authorBio}
            </p>
          </div>

          <!-- Live Terminal Simulator (Wow Factor) -->
          <div class="w-full bg-[#050810] border border-white/10 rounded-xl p-4 mt-8 font-mono text-[10px] text-cyan-400 space-y-1.5 shadow-2xl relative overflow-hidden group-hover:border-cyan-400/20 transition-all duration-500">
            <!-- Simulated grid pattern background inside terminal -->
            <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(0,200,240,0.02)_1px,transparent_1px)] bg-[size:100%_4px] pointer-events-none"></div>
            
            <div class="flex items-center gap-1.5 text-white/40 border-b border-white/5 pb-2 mb-2 justify-between">
              <span class="text-[9px]">DIAGNOSTICS_SHELL // V1.09</span>
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            </div>
            <div>&gt; INITIALIZING CORE_NODE_LOGS... <span class="text-white">[OK]</span></div>
            <div>&gt; OPERATOR // {authorName.toUpperCase().replace(/\s+/g, '_')}</div>
            <div>&gt; ROLE // {authorRole.toUpperCase().replace(/[^a-zA-Z]/g, '_')}</div>
            <div>&gt; ECOSYSTEM_STATUS // ONLINE_SECURED</div>
            {slug === 'phat' && (
              <>
                <div>&gt; TARGET_SYSTEMS // CMO_INTERN, COINSTORI</div>
                <div>&gt; PRODUCT_NODES // 3_ACTIVE_NODES</div>
              </>
            )}
            <div class="text-white animate-pulse">&gt; MONITORING SYSTEMS_ACTIVE_FEED_</div>
          </div>
        </div>

        <!-- Column 3: Ecosystem Products (Phat Vo Directives) -->
        <div class="lg:col-span-3 flex flex-col gap-4">
          <div class="font-mono text-[9px] uppercase tracking-widest text-slate-500 border-b border-white/5 pb-2">
            [ ECOSYSTEM_PRODUCT_NODES ]
          </div>
          
          {slug === 'phat' ? (
            phatProducts.map((p, idx) => (
              <a href={p.url} target={p.url.startsWith('http') ? "_blank" : "_self"} rel={p.url.startsWith('http') ? "noopener noreferrer" : ""} class="bg-black/40 border border-white/5 p-4 rounded-xl backdrop-blur-md hover:border-cyan-400/30 hover:bg-cyan-400/5 hover:-translate-y-1 transition-all duration-300 block group relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-[1.5px] bg-gradient-to-r from-transparent via-[var(--accent)] to-transparent opacity-0 group-hover:opacity-100 duration-500" style={{ '--accent': idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}></div>
                <div class="flex justify-between items-start">
                  <div>
                    <h3 class="font-display text-sm font-bold text-white group-hover:text-[var(--accent-cyan)] transition-colors" style={{ color: idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}>{p.name}</h3>
                    <span class="font-mono text-[8px] uppercase tracking-wider text-white/40 block mt-0.5">{p.tagline}</span>
                  </div>
                  <span class="text-xs text-white/30 group-hover:text-white transition-colors">↗</span>
                </div>
                <p class="font-body text-[11px] text-slate-400 leading-relaxed font-light mt-2.5">
                  {p.desc}
                </p>
              </a>
            ))
          ) : (
            <div class="bg-black/40 border border-white/5 p-6 rounded-xl backdrop-blur-md font-mono text-[10px] text-white/50 space-y-4">
              <span class="uppercase tracking-widest text-[var(--accent-cyan)]">[ DEFAULT_PRODUCT_SCHEME ]</span>
              <p class="font-body leading-relaxed font-light text-slate-400 text-xs">
                This operator directs cross-functional campaigns, marketing networks, and partner nodes within the Fintech24h corporate grid.
              </p>
            </div>
          )}
        </div>

      </div>

    </div>

    <!-- Section bottom fade transition -->
    <div class="absolute bottom-0 w-full h-32 bg-gradient-to-t from-[#020202] to-transparent pointer-events-none"></div>
  </section>

  <!-- Cyber Research Dossier (Timeline & Asymmetric Publications Layout) -->
  <section class="py-24 bg-[#020202] relative border-t border-white/5" id="publications" aria-label="Author Publications">
    <!-- Cyber grid background -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[850px] bg-[var(--gradient-glow-cyan)] rounded-full opacity-[0.03] filter blur-[120px]"></div>
      <div class="absolute inset-0 grid-pattern opacity-10"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-6">
      
      <!-- Section Header -->
      <div class="max-w-2xl mx-auto text-center mb-20" data-animate="fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-400/20 bg-cyan-400/5 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span>
          <span class="text-[10px] font-mono font-medium text-cyan-400 uppercase tracking-widest">Research Index</span>
        </div>
        <h2 class="font-display text-4xl font-bold text-white uppercase tracking-tight">
          Dossier Publications
        </h2>
        <p class="text-xs text-slate-500 font-mono uppercase tracking-[0.2em] mt-3">
          Verifiable marketing frameworks, research logs, and technical archives
        </p>
      </div>

      {posts.length > 0 ? (
        <!-- Vertical Timeline Guidance Line -->
        <div class="relative border-l border-white/10 ml-4 md:ml-32 pl-8 md:pl-12 space-y-16 py-8" data-animate="stagger">
          {posts.map((post, idx) => {
            const rTime = getReadingTime(post.content.rendered);
            const excerptText = getExcerpt(post, 180);
            const featuredImage = getFeaturedImage(post);
            
            // Asymmetric design elements (Alternating styles, featured gradients)
            const isFeatured = idx === 0;
            const accentColor = idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)';

            return (
              <div class="relative group" data-animate-child>
                
                <!-- Timeline dot node with ping effect -->
                <div class="absolute -left-[41px] md:-left-[57px] top-6 w-5 h-5 rounded-full bg-[#050810] border border-white/20 flex items-center justify-center group-hover:border-cyan-400 transition-colors duration-300 z-10">
                  <div class="w-2 h-2 rounded-full group-hover:scale-110 transition-transform" style={{ background: accentColor }}></div>
                  <div class="absolute inset-0 rounded-full animate-ping opacity-0 group-hover:opacity-40" style={{ background: accentColor }}></div>
                </div>

                <!-- Left Column monospaced absolute meta (Desktop only) -->
                <div class="absolute -left-[180px] top-4 hidden md:flex flex-col items-end text-right w-36 font-mono text-[10px] text-white/30 space-y-1">
                  <div class="text-white/60 tracking-wider">[{formatDate(post.date).toUpperCase()}]</div>
                  <div>ID // WP_0{post.id}</div>
                  <div class="text-[9px] uppercase tracking-widest" style={{ color: accentColor }}>{rTime} MIN READ</div>
                </div>

                <!-- Article Dossier Panel Card -->
                <div class={`relative p-6 md:p-8 rounded-2xl bg-black/40 border border-white/5 group-hover:border-white/10 hover:shadow-[0_20px_50px_rgba(0,0,0,0.7)] transition-all duration-500 overflow-hidden backdrop-blur-sm ${isFeatured ? 'ring-1 ring-cyan-500/10' : ''}`}>
                  
                  <!-- Glowing line laser sweep effect on hover -->
                  <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-[var(--accent)] to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-[scan-down_3.5s_linear_infinite]" style={{ '--accent': accentColor }}></div>

                  <!-- Asymmetric layout inside card -->
                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                    
                    {featuredImage.url && (
                      <div class="lg:col-span-4 relative aspect-[16/10] rounded-xl overflow-hidden border border-white/5 group-hover:border-white/15 transition-colors duration-500 bg-[#050810]">
                        <img 
                          src={featuredImage.url} 
                          alt={featuredImage.alt}
                          class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700" 
                          loading={isFeatured ? "eager" : "lazy"}
                        />
                      </div>
                    )}
                    
                    <div class={`${featuredImage.url ? 'lg:col-span-8' : 'lg:col-span-12'} space-y-4`}>
                      <!-- HUD Category Tag & Index -->
                      <div class="flex justify-between items-center text-[9px] font-mono tracking-widest text-slate-500">
                        <span>[ ARCHIVE_INDEX // 0{idx + 1} ]</span>
                        <span class="uppercase pl-2" style={{ color: accentColor }}>PUBLISHED_POST</span>
                      </div>

                      <!-- Title -->
                      <h3 class="font-display text-xl md:text-2xl font-bold text-white leading-tight group-hover:text-cyan-400 transition-colors">
                        <a href={`/blog/${post.slug}`} set:html={post.title.rendered} />
                      </h3>

                      <!-- Excerpt -->
                      <p class="text-xs text-slate-400 font-body leading-relaxed font-light line-clamp-3">
                        {excerptText}
                      </p>

                      <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                        <!-- Mobile Meta Fallback -->
                        <span class="font-mono text-[9px] text-white/30 md:hidden">{formatDate(post.date)} · {rTime} MIN</span>
                        <span class="font-mono text-[9px] text-white/20 hidden md:block">STATUS // ACTIVE_NODE_LOG</span>
                        
                        <a 
                          href={`/blog/${post.slug}`} 
                          class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan-400 hover:text-cyan-300 font-display uppercase tracking-wider transition-colors"
                          style={{ color: accentColor }}
                        >
                          Unlock Report
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                      </div>
                    </div>

                  </div>
                </div>

              </div>
            );
          })}
        </div>
      ) : (
        <!-- Fallback if no posts are published by this author -->
        <div class="max-w-md mx-auto text-center p-12 border border-white/5 rounded-2xl bg-black/40 backdrop-blur-sm" data-animate="scale-in">
          <svg class="w-12 h-12 text-slate-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          <span class="font-mono text-[9px] text-[var(--accent-purple)] uppercase tracking-[0.2em] block mb-2">Active Monitor Seeding</span>
          <p class="text-xs text-slate-400 font-body font-light leading-relaxed">
            No research drafts or publication modules are indexed under this node currently. Monitoring active updates.
          </p>
        </div>
      )}

    </div>
  </section>
</BaseLayout>

<style>
  /* Custom anim parameters */
  @keyframes spin-clockwise {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  @keyframes spin-counter {
    0% { transform: rotate(360deg); }
    100% { transform: rotate(0deg); }
  }
  .animate-spin-clockwise {
    animation: spin-clockwise 45s linear infinite;
  }
  .animate-spin-counter {
    animation: spin-counter 25s linear infinite;
  }
</style>
