---
// src/pages/author/[slug].astro
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import Pagination from '../../components/ui/Pagination.astro';
import { getUserBySlug, getPostsByAuthor, getPhatVoAuthorIds, isPhatVoWpAuthor, PHAT_VO_SLUG, PHAT_VO_WP_FALLBACK, POSTS_PER_PAGE, formatShortDate, getFeaturedImageSized, getPostCategories } from '../../lib/wordpress';
import type { WPPost } from '../../lib/wordpress';
import { getReadingTime } from '../../lib/utils';
import { team } from '../../data/team';

Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

// Routes: /author/{slug}  and  /author/{slug}/page/{n}  (n >= 2)
const segments = (Astro.params.path ?? '').split('/').filter(Boolean);
const slug = segments[0];
let pageNumber = 1;
if (segments.length === 3 && segments[1] === 'page' && /^\d+$/.test(segments[2])) {
  pageNumber = Number(segments[2]);
} else if (segments.length !== 1) {
  return Astro.rewrite('/404');
}
const suffix = (n: number) => (n > 1 ? `/page/${n}` : '');

// getPostAuthor() (lib/wordpress.ts) shows every post from the WP "admin"/"phat" accounts,
// and from any other account that isn't a team member (e.g. "editorfi24h"), as "Phat Vo"
// linking to /author/phat-vo, so those slugs all share one canonical profile.
if (slug === 'admin' || slug === 'phat') {
  return Astro.redirect(`/author/${PHAT_VO_SLUG}${suffix(pageNumber)}`, 301);
}
// Page 1 is the profile itself; queries never create variants.
if (segments.length === 3 && pageNumber <= 1) return Astro.redirect(`/author/${slug}`, 301);

const wpSlug = slug === 'phat-vo' ? 'phat' : slug;
// Phat Vo's profile must never 404 because a WordPress call failed (the users endpoint
// sometimes errors when the Workers cache is cold), so it falls back to the known account.
const user = (wpSlug ? await getUserBySlug(wpSlug) : null) ?? (slug === PHAT_VO_SLUG ? PHAT_VO_WP_FALLBACK : null);

if (!user) {
  // Render the 404 page here with a real 404 status (no soft-404 redirect).
  return Astro.rewrite('/404');
}
if (slug !== PHAT_VO_SLUG && isPhatVoWpAuthor(user)) {
  return Astro.redirect(`/author/${PHAT_VO_SLUG}${suffix(pageNumber)}`, 301);
}

const isPhatVo = slug === 'phat' || slug === 'phat-vo';

// Find local team member details (signature gradient, telegram, linkedin, etc)
const member = team.find(m => {
  const slugMatch = m.name.toLowerCase().replace(/\s+/g, '-') === slug || 
                    (slug === 'phat-vo' && m.name === 'Phat Vo') ||
                    (slug === 'phat' && m.name === 'Phat Vo') || 
                    (slug === 'vincent' && m.name === 'Vincent Nguyen') ||
                    (slug === 'jayc' && m.name === 'JayC') ||
                    (slug === 'gemi' && m.name === 'Gemi');
  return slugMatch;
});

// Merged Author Information
const authorName = member?.name || user.name;
const authorRole = member?.role || "Contributor";
const authorImage = member?.image || user.avatar_urls?.['96'] || 'https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp';
const signatureColor = member?.signatureColor || 'linear-gradient(135deg, #00c8f0 0%, #7c5cfc 100%)';
const telegram = member?.telegram || 'https://telegram.me/fintech24h';
const linkedin = member?.linkedin || 'https://www.linkedin.com/company/fintech24h/';
const email = member?.email; // Optional — only shown when the team member has one set

// Authentic CPO and Co-founder biography details for Phat Vo (No fabricated statistics)
const phatBio = "Co-Founder & Chief Product Officer of Fintech24h.com. Phat Vo directs the technical product roadmap, engineering nodes, and design systems for the entire Fintech24h ecosystem. He oversees the development of core platforms, manages cross-functional product teams, and spearheads business operations, ensuring seamless Web3 integration and client growth.";
const authorBio = isPhatVo ? phatBio : (member?.bio || user.description || "Fintech24h team member and contributor.");

// Fetch publications by the author
// Phat Vo's byline also covers every non-team WP account (legacy "admin", "editorfi24h", ...).
const authorIds = isPhatVo ? await getPhatVoAuthorIds() : [user.id];
let authorPage = await getPostsByAuthor(authorIds, pageNumber, POSTS_PER_PAGE);
// An empty result for Phat Vo usually means a WordPress call failed (rate limit or cold
// cache), not that there are no posts: try once more before deciding.
if (isPhatVo && authorPage.posts.length === 0) {
  authorPage = await getPostsByAuthor(authorIds, pageNumber, POSTS_PER_PAGE);
}
const { posts, total: totalPosts, totalPages } = authorPage;

// Phat Vo's profile (page 1) always renders: if the publications still can't be loaded
// it shows with an empty list instead of a 404, and that response is not cached.
// Other empty author archives (e.g. legacy WP accounts with zero published posts) and
// pages past the last one get a real 404 so they're not shown or indexed.
const keepProfile = isPhatVo && pageNumber === 1;
const postsUnavailable = keepProfile && posts.length === 0;
if (!keepProfile && (posts.length === 0 || pageNumber > totalPages)) {
  return Astro.rewrite('/404');
}
if (postsUnavailable) Astro.response.headers.set('Cache-Control', 'no-store');

// Publications section: research & news posts lead, DealMakers partner announcements
// (most of Phat Vo's posts) are grouped into compact tiles so they don't crowd the research.
const isPartnerPost = (p: WPPost) =>
  getPostCategories(p).some((c) => c.slug === 'dealmakers-pulse') || /\bmedia partner\b/i.test(p.title.rendered);
const partnerName = (title: string) =>
  /^(.+?)\s+(?:Named|Joins|Becomes)\b/i.exec(title)?.[1] ?? /Welcomes\s+(.+?)\s+as\b/i.exec(title)?.[1] ?? title;
const pubItems = posts.map((p) => ({
  id: p.id,
  href: `/blog/${p.slug}`,
  title: p.title.rendered,
  type: isPartnerPost(p) ? 'partner' : 'research',
  date: formatShortDate(p.date),
  readTime: getReadingTime(p.content.rendered),
  image: getFeaturedImageSized(p),
  partner: partnerName(p.title.rendered),
}));
const researchItems = pubItems.filter((i) => i.type === 'research');
const partnerItems = pubItems.filter((i) => i.type === 'partner');
const leadItem = researchItems[0];
const leadImage = leadItem ? getFeaturedImageSized(posts.find((p) => p.id === leadItem.id)!, 'large') : null;
const sideItems = researchItems.slice(1, 4);
const partnerTiles = partnerItems.slice(0, 8);
const shownIds = new Set([leadItem, ...sideItems, ...partnerTiles].filter(Boolean).map((i) => i!.id));
const moreItems = pubItems.filter((i) => !shownIds.has(i.id));
const hasBothTypes = researchItems.length > 0 && partnerItems.length > 0;
const pubTab = 'inline-flex items-center h-11 px-4 rounded-full border font-mono text-[13px] whitespace-nowrap transition-colors duration-200 border-[var(--border-default)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] aria-pressed:border-[color-mix(in_srgb,var(--accent-cyan)_45%,transparent)] aria-pressed:bg-[color-mix(in_srgb,var(--accent-cyan)_12%,transparent)] aria-pressed:text-[var(--text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]';
const viewBtn = 'w-9 h-9 inline-flex items-center justify-center rounded-lg text-[var(--text-muted)] aria-pressed:bg-[color-mix(in_srgb,var(--accent-cyan)_14%,transparent)] aria-pressed:text-[var(--accent-cyan)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]';
const badgeClass = (type: string) => type === 'research' ? 'text-[var(--accent-cyan)]' : 'text-[var(--accent-purple)]';

// Profile URL (schema / breadcrumb). The paginated URL is the page's own canonical, set by BaseLayout.
const currentUrl = `https://fintech24h.com/author/${slug}`;
const pageLabel = pageNumber > 1 ? `, Page ${pageNumber}` : '';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Blog', item: 'https://fintech24h.com/blog' },
  { name: authorName, item: currentUrl }
];

// Person Schema for SEO
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${currentUrl}#person`,
  "name": authorName,
  "jobTitle": authorRole,
  "worksFor": {
    "@type": "Organization",
    "@id": "https://fintech24h.com/#organization",
    "name": "Fintech24h",
    "url": "https://fintech24h.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp"
    }
  },
  "description": authorBio,
  "image": {
    "@type": "ImageObject",
    "url": authorImage,
    "caption": authorName
  },
  "url": currentUrl,
  ...(email ? { "email": email } : {}),
  "sameAs": [
    telegram,
    linkedin
  ].filter(Boolean),
  "knowsAbout": isPhatVo ? [
    "Web3 Product Strategy",
    "Product Design Systems",
    "Fintech Operations",
    "Front-end Engineering Architectures"
  ] : [
    "Blockchain Marketing",
    "Public Relations",
    "Community Management & Operations"
  ],
  "knowsLanguage": ["en", "vi"]
};

// Fintech24h Ecosystem products directed by Phat Vo (authentic products)
const phatProducts = [
  {
    name: "CMO Intern",
    tagline: "Web3 Growth Marketing Hub",
    desc: "A specialized platform connecting protocols with vetted marketing and community management talent to scale Web3 ecosystems.",
    url: "https://cmointern.com"
  },
  {
    name: "Coinstori",
    tagline: "Web3 Media Hub",
    desc: "A premium marketing and publication network amplifying brand presence across high-authority cryptocurrency news outlets.",
    url: "https://coinstori.com"
  },
  {
    name: "Custom Client Solutions",
    tagline: "Enterprise Architectures",
    desc: "Bespoke technology dashboards, automated lead generation funnels, and programmatic growth engines for enterprise clients.",
    url: "/services/custom-solutions"
  }
];

---

<BaseLayout
  title={`${authorName} — ${authorRole}${pageLabel} | Fintech24h CPO Profile`}
  description={pageNumber > 1 ? `Publications by ${authorName}, page ${pageNumber} of ${totalPages}. ${authorBio}`.slice(0, 300) : authorBio}
  schema={personSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- Premium Futuristic 3-Column HUD Dashboard Hero -->
  <section class="relative min-h-screen flex items-center justify-center px-4 overflow-hidden bg-[var(--bg-primary)] pt-32 pb-20" aria-label="Author Profile Hero">
    <!-- Background mesh & custom orbs -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <div class="absolute top-[15%] left-1/2 -translate-x-1/2 w-[80vw] h-[65vh] rounded-full filter blur-[130px] opacity-[0.18]" style={{ background: signatureColor }}></div>
      <div class="absolute bottom-[-15%] right-[5%] w-[400px] h-[400px] rounded-full filter blur-[110px] opacity-10 animate-[float-slow_15s_infinite_ease-in-out]" style={{ background: signatureColor }}></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#00c8f005_1px,transparent_1px),linear-gradient(to_bottom,#00c8f005_1px,transparent_1px)] bg-[size:5rem_5rem] opacity-20"></div>
    </div>

    <!-- Scanning line overlay -->
    <div class="absolute inset-0 pointer-events-none z-10 scanlines-overlay opacity-[0.02]"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full">
      
      <!-- Top Cyber Tag -->
      <div class="flex justify-between items-center mb-8 border-b border-[var(--border-default)] pb-4">
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-full animate-ping" style={{ background: signatureColor }}></span>
          <span class="font-mono text-[10px] text-[var(--text-secondary)] opacity-70 tracking-[0.3em] uppercase">SYSTEM.STATUS // NODE_ONLINE</span>
        </div>
        <div class="font-mono text-[10px] text-[var(--text-muted)] hidden md:block">
          SECURE_CLEARANCE // LEVEL_4_CPO
        </div>
      </div>

      <!-- Main Dashboard Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Column 1: Operator Identity Dossier -->
        <div class="lg:col-span-3 flex flex-col justify-between bg-[var(--bg-glass)] border border-[var(--border-subtle)] p-6 rounded-2xl backdrop-blur-md hover:border-[var(--border-default)] transition-colors duration-500 relative overflow-hidden group">
          <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-[var(--accent-cyan)] to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-[scan-down_3s_linear_infinite]" style={{ '--accent-cyan': isPhatVo ? '#00c8f0' : '#7c5cfc' }}></div>
          
          <div class="flex flex-col items-center lg:items-start">
            <!-- HUD Interactive Avatar -->
            <div class="relative mb-6">
              <div class="absolute -inset-2.5 rounded-full border border-dashed border-[var(--border-default)] group-hover:border-cyan-400/20 transition-colors duration-500 animate-[spin_45s_linear_infinite] z-0"></div>
              <div class="absolute -inset-1.5 rounded-full border border-double border-purple-500/10 group-hover:border-purple-500/20 transition-colors duration-500 animate-[spin_25s_linear_infinite_reverse] z-0"></div>
              
              <div class="relative w-36 h-36 rounded-full p-[2px] z-10 transition-transform duration-500 group-hover:scale-[1.02]" style={{ background: signatureColor }}>
                <div class="w-full h-full rounded-full bg-[var(--bg-primary)] overflow-hidden flex items-center justify-center border border-[var(--border-default)]">
                  <img 
                    src={authorImage} 
                    alt={authorName} 
                    class="w-full h-full object-cover filter grayscale opacity-95 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500"
                  />
                </div>
              </div>
            </div>

            <!-- Identity info -->
            <div class="text-center lg:text-left space-y-1">
              <span class="font-mono text-[9px] uppercase tracking-widest text-[var(--text-muted)] block">Operator ID // 0x47C02</span>
              <h1 class="font-display text-3xl font-bold text-[var(--text-primary)] uppercase tracking-tight">
                {authorName}
              </h1>
              <span class="font-mono text-xs uppercase font-medium tracking-wider" style={{ background: signatureColor, webkitBackgroundClip: 'text', webkitTextFillColor: 'transparent', backgroundClip: 'text' }}>
                {authorRole}
              </span>
            </div>

            <!-- Monospaced Credentials Badge -->
            <div class="w-full bg-[var(--surface-soft)] border border-[var(--border-default)] p-3 rounded-lg font-mono text-[10px] text-[color-mix(in_srgb,var(--text-primary)_60%,transparent)] space-y-1 mt-6">
              <div class="flex justify-between"><span>NODE:</span><span class="text-[var(--text-primary)]">F24H_ROOT_2</span></div>
              <div class="flex justify-between"><span>STATUS:</span><span class="text-emerald-400">ACTIVE</span></div>
              <div class="flex justify-between"><span>OPERATIONS:</span><span class="text-[var(--text-primary)]">CO-FOUNDER</span></div>
            </div>
          </div>

          <!-- Social Matrix connections -->
          <div class="space-y-2 mt-8 lg:mt-0">
            <!-- Email: the primary contact, so it is the most prominent row: readable
                 lowercase address at full text contrast, an icon, and a copy button
                 (mailto links do nothing on some devices). -->
            {email && (
              <div class="rounded-xl border border-[color-mix(in_srgb,var(--accent-cyan)_35%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_7%,transparent)] p-1.5">
                <a href={`mailto:${email}`} class="group/email flex items-center gap-2.5 rounded-lg p-2 transition-colors duration-200 hover:bg-[color-mix(in_srgb,var(--accent-cyan)_10%,transparent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[color-mix(in_srgb,var(--accent-cyan)_14%,transparent)] text-[var(--accent-cyan)]" aria-hidden="true">
                    <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
                  </span>
                  <span class="min-w-0">
                    <span class="block font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--text-secondary)]">Email</span>
                    <span class="block break-words font-body text-[14px] font-medium leading-snug text-[var(--text-primary)] group-hover/email:text-[var(--accent-cyan)] transition-colors duration-200">{email}</span>
                  </span>
                </a>
                <button type="button" data-copy-email={email} class="mt-1 flex w-full items-center justify-center gap-2 rounded-lg border-t border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] px-3 py-2 font-mono text-[11px] uppercase tracking-[0.1em] text-[var(--text-primary)] transition-colors duration-200 hover:text-[var(--accent-cyan)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]" aria-label={`Copy ${email}`}>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                  <span data-copy-label>Copy email</span>
                </button>
              </div>
            )}
            <a href={telegram} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-faint)] hover:border-cyan-400/30 hover:bg-cyan-400/5 hover:shadow-[0_0_15px_rgba(0,200,240,0.1)] transition-all duration-300 group/btn">
              <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-[var(--text-secondary)] group-hover/btn:text-[var(--text-primary)] transition-colors">Telegram Node</span>
              <span class="text-[var(--accent-cyan)] group-hover/btn:translate-x-0.5 transition-transform" style={{ color: isPhatVo ? '#00c8f0' : '#7c5cfc' }}>→</span>
            </a>
            <a href={linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-faint)] hover:border-purple-500/30 hover:bg-purple-500/5 hover:shadow-[0_0_15px_rgba(124,92,252,0.1)] transition-all duration-300 group/btn">
              <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-[var(--text-secondary)] group-hover/btn:text-[var(--text-primary)] transition-colors">LinkedIn Hub</span>
              <span class="text-[var(--accent-purple)] group-hover/btn:translate-x-0.5 transition-transform" style={{ color: isPhatVo ? '#7c5cfc' : '#00c8f0' }}>→</span>
            </a>
          </div>
        </div>

        <!-- Column 2: CPO Diagnostics Console & Bio -->
        <div class="lg:col-span-6 flex flex-col justify-between bg-[var(--bg-glass)] border border-[var(--border-subtle)] p-8 rounded-2xl backdrop-blur-md hover:border-[var(--border-default)] transition-colors duration-500 relative overflow-hidden group">
          <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-[var(--accent-purple)] to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-[scan-down_3.5s_linear_infinite]" style={{ '--accent-purple': isPhatVo ? '#7c5cfc' : '#00c8f0' }}></div>
          
          <div class="space-y-6">
            <div>
              <span class="font-mono text-[9px] uppercase tracking-widest text-[var(--accent-cyan)] mb-1 block" style={{ color: isPhatVo ? '#00c8f0' : '#7c5cfc' }}>[ OPERATIONAL_OVERVIEW ]</span>
              <h2 class="font-display text-2xl font-bold text-[var(--text-primary)] uppercase">Operational Console</h2>
            </div>
            
            <p class="font-body text-[var(--text-secondary)] text-sm leading-[1.8] font-light">
              {authorBio}
            </p>
          </div>

          <!-- Live Terminal Simulator (Wow Factor) -->
          <div class="w-full bg-[#050810] border border-[var(--border-default)] rounded-xl p-4 mt-8 font-mono text-[10px] text-cyan-400 space-y-1.5 shadow-2xl relative overflow-hidden group-hover:border-cyan-400/20 transition-all duration-500">
            <!-- Simulated grid pattern background inside terminal -->
            <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(0,200,240,0.02)_1px,transparent_1px)] bg-[size:100%_4px] pointer-events-none"></div>
            
            <div class="flex items-center gap-1.5 text-[var(--text-muted)] border-b border-[var(--border-subtle)] pb-2 mb-2 justify-between">
              <span class="text-[9px]">DIAGNOSTICS_SHELL // V1.09</span>
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            </div>
            <div>&gt; INITIALIZING CORE_NODE_LOGS... <span class="text-[var(--text-primary)]">[OK]</span></div>
            <div>&gt; OPERATOR // {authorName.toUpperCase().replace(/\s+/g, '_')}</div>
            <div>&gt; ROLE // {authorRole.toUpperCase().replace(/[^a-zA-Z]/g, '_')}</div>
            <div>&gt; ECOSYSTEM_STATUS // ONLINE_SECURED</div>
            {isPhatVo && (
              <>
                <div>&gt; TARGET_SYSTEMS // CMO_INTERN, COINSTORI</div>
                <div>&gt; PRODUCT_NODES // 3_ACTIVE_NODES</div>
              </>
            )}
            <div class="text-[var(--text-primary)] animate-pulse">&gt; MONITORING SYSTEMS_ACTIVE_FEED_</div>
          </div>
        </div>

        <!-- Column 3: Ecosystem Products (Phat Vo Directives) -->
        <div class="lg:col-span-3 flex flex-col gap-4">
          <div class="font-mono text-[9px] uppercase tracking-widest text-[var(--text-muted)] border-b border-[var(--border-subtle)] pb-2">
            [ ECOSYSTEM_PRODUCT_NODES ]
          </div>
          
          {isPhatVo ? (
            phatProducts.map((p, idx) => (
              <a href={p.url} target={p.url.startsWith('http') ? "_blank" : "_self"} rel={p.url.startsWith('http') ? "noopener noreferrer" : ""} class="bg-[var(--bg-glass)] border border-[var(--border-subtle)] p-4 rounded-xl backdrop-blur-md hover:border-cyan-400/30 hover:bg-cyan-400/5 hover:-translate-y-1 transition-all duration-300 block group relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-[1.5px] bg-gradient-to-r from-transparent via-[var(--accent)] to-transparent opacity-0 group-hover:opacity-100 duration-500" style={{ '--accent': idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}></div>
                <div class="flex justify-between items-start">
                  <div>
                    <h3 class="font-display text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-cyan)] transition-colors" style={{ color: idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}>{p.name}</h3>
                    <span class="font-mono text-[8px] uppercase tracking-wider text-[var(--text-muted)] block mt-0.5">{p.tagline}</span>
                  </div>
                  <span class="text-xs text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-colors">↗</span>
                </div>
                <p class="font-body text-[11px] text-[var(--text-secondary)] leading-relaxed font-light mt-2.5">
                  {p.desc}
                </p>
              </a>
            ))
          ) : (
            <div class="bg-[var(--bg-glass)] border border-[var(--border-subtle)] p-6 rounded-xl backdrop-blur-md font-mono text-[10px] text-[var(--text-secondary)] opacity-70 space-y-4">
              <span class="uppercase tracking-widest text-[var(--accent-cyan)]">[ DEFAULT_PRODUCT_SCHEME ]</span>
              <p class="font-body leading-relaxed font-light text-[var(--text-secondary)] text-xs">
                This operator directs cross-functional campaigns, marketing networks, and partner nodes within the Fintech24h corporate grid.
              </p>
            </div>
          )}
        </div>

      </div>

    </div>

    <!-- Section bottom fade transition -->
    <div class="absolute bottom-0 w-full h-32 bg-gradient-to-t from-[var(--bg-primary)] to-transparent pointer-events-none"></div>
  </section>

  <!-- Publications: lead research + partner tiles, with a type filter and a grid/list switch -->
  <section class="py-20 lg:py-28 bg-[var(--bg-primary)] relative border-t border-[var(--border-subtle)]" id="publications" aria-labelledby="publications-heading">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-purple w-[640px] h-[640px] absolute -top-64 left-1/2 -translate-x-1/2 opacity-15"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center flex flex-col items-center gap-4 mb-10 lg:mb-12" data-animate="fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[color-mix(in_srgb,var(--accent-cyan)_25%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_5%,transparent)] font-mono text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--accent-cyan)]">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span>Research Index
        </div>
        <h2 id="publications-heading" class="font-display text-h2 font-bold text-[var(--text-primary)]">Publications by <span class="gradient-text-cyan">{authorName}</span></h2>
        <p class="font-body text-base lg:text-lg text-[var(--text-secondary)] leading-relaxed max-w-xl">Research, market news and DealMakers partner announcements, newest first.</p>
        {totalPosts > 0 && (
          <p class="flex flex-wrap justify-center gap-x-5 gap-y-1 font-mono text-xs text-[var(--text-muted)]">
            <span><span class="text-[var(--text-primary)]">{totalPosts}</span> articles</span>
            <span>{totalPages} {totalPages === 1 ? 'page' : 'pages'}</span>
            {posts[0] && pageNumber === 1 && <span>latest {formatShortDate(posts[0].date)}</span>}
          </p>
        )}
      </div>

      {posts.length > 0 ? (
        <div data-pubs>
          <div data-pubs-toolbar hidden class="[&[hidden]]:hidden flex flex-wrap items-center justify-between gap-3 py-3.5 mb-6 lg:mb-8 border-y border-[var(--border-default)]">
            <div class="flex gap-2 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="group" aria-label="Filter publications">
              {hasBothTypes && <>
                <button type="button" data-pubs-filter="all" aria-pressed="true" class={pubTab}>All publications</button>
                <button type="button" data-pubs-filter="research" aria-pressed="false" class={pubTab}>Research &amp; news</button>
                <button type="button" data-pubs-filter="partner" aria-pressed="false" class={pubTab}>Partner announcements</button>
              </>}
            </div>
            <div class="flex p-1 rounded-xl border border-[var(--border-default)]" role="group" aria-label="View">
              <button type="button" data-pubs-view="grid" aria-pressed="true" aria-label="Grid view" class={viewBtn}><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></button>
              <button type="button" data-pubs-view="list" aria-pressed="false" aria-label="List view" class={viewBtn}><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></button>
            </div>
          </div>

          <!-- Grid, all types (default; also the no-JavaScript view) -->
          <div data-pubs-panel="hub" class="[&[hidden]]:hidden flex flex-col gap-10 lg:gap-12">
            {leadItem && leadImage && (
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6">
                <article class="card-default rounded-3xl overflow-hidden lg:col-span-7 flex flex-col">
                  <a href={leadItem.href} tabindex="-1" aria-hidden="true" class="block aspect-[16/9] overflow-hidden bg-[var(--surface-soft)]">
                    <img src={leadImage.url} alt={leadImage.alt} width="1200" height="675" class="w-full h-full object-cover" loading="eager" decoding="async" />
                  </a>
                  <div class="p-5 sm:p-7 lg:p-8 flex flex-col gap-3">
                    <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-[var(--text-muted)]">
                      <span class="px-2.5 py-1 rounded bg-[color-mix(in_srgb,var(--accent-purple)_14%,transparent)] text-[var(--accent-purple)] uppercase tracking-[0.1em]">Latest research</span>
                      <span>{leadItem.date}</span><span aria-hidden="true">·</span><span>{leadItem.readTime} min read</span>
                    </div>
                    <h3 class="font-display font-bold text-[clamp(1.375rem,2.3vw,1.75rem)] leading-[1.22] text-[var(--text-primary)]"><a href={leadItem.href} class="hover:text-[var(--accent-cyan)] transition-colors duration-200">{leadItem.title}</a></h3>
                    <a href={leadItem.href} class="mt-1 self-start inline-flex items-center gap-2 font-display font-bold text-sm text-[var(--accent-cyan)] hover:opacity-80 transition-opacity duration-200">Read article <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                  </div>
                </article>
                {sideItems.length > 0 && (
                  <div class="lg:col-span-5 flex flex-col gap-3 lg:gap-4">
                    {sideItems.map((i) => (
                      <article class="card-default overflow-hidden flex flex-1">
                        <a href={i.href} tabindex="-1" aria-hidden="true" class="block shrink-0 w-28 sm:w-40 overflow-hidden bg-[var(--surface-soft)]"><img src={i.image.url} alt={i.image.alt} width="320" height="240" class="w-full h-full object-cover" loading="lazy" decoding="async" /></a>
                        <div class="p-4 sm:p-5 flex flex-col justify-center gap-2 min-w-0">
                          <span class="font-mono text-[11px] text-[var(--text-muted)]">{i.date} · {i.readTime} min</span>
                          <h3 class="font-display font-bold text-[15px] sm:text-[17px] leading-snug text-[var(--text-primary)] line-clamp-3"><a href={i.href} class="hover:text-[var(--accent-cyan)] transition-colors duration-200">{i.title}</a></h3>
                        </div>
                      </article>
                    ))}
                  </div>
                )}
              </div>
            )}

            {partnerTiles.length > 0 && (
              <div>
                <div class="flex flex-wrap justify-between items-baseline gap-2 mb-4">
                  <h3 class="font-display text-lg lg:text-xl font-bold text-[var(--text-primary)]">DealMakers partner announcements</h3>
                  <a href="/blog/category/dealmakers-pulse" class="font-mono text-xs text-[var(--accent-cyan)] hover:opacity-80">All announcements →</a>
                </div>
                <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4">
                  {partnerTiles.map((i) => (
                    <li>
                      <a href={i.href} class="card-default h-full flex items-center gap-3.5 p-2.5 pr-4">
                        <img src={i.image.url} alt="" width="96" height="70" class="w-16 h-12 sm:w-24 sm:h-[70px] shrink-0 rounded-lg sm:rounded-[10px] object-cover" loading="lazy" decoding="async" />
                        <span class="flex flex-col gap-1 min-w-0">
                          <span class="font-display text-[15px] font-bold text-[var(--text-primary)] truncate">{i.partner}</span>
                          <span class="font-mono text-[11px] text-[var(--text-muted)] whitespace-nowrap">Media Partner · {i.date.replace(/, \d{4}$/, '')}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {moreItems.length > 0 && (
              <div>
                <h3 class="font-display text-lg lg:text-xl font-bold text-[var(--text-primary)] mb-4">More on this page</h3>
                <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 lg:gap-4">
                  {moreItems.map((i) => (
                    <li>
                      <article class="card-default h-full overflow-hidden flex">
                        <a href={i.href} tabindex="-1" aria-hidden="true" class="block shrink-0 w-28 overflow-hidden bg-[var(--surface-soft)]"><img src={i.image.url} alt={i.image.alt} width="224" height="224" class="w-full h-full object-cover" loading="lazy" decoding="async" /></a>
                        <div class="p-4 flex flex-col justify-center gap-1.5 min-w-0">
                          <span class="font-mono text-[10px] text-[var(--text-muted)]"><span class:list={['uppercase tracking-[0.1em] mr-2', badgeClass(i.type)]}>{i.type === 'research' ? 'Research' : 'Partner'}</span>{i.date}</span>
                          <h4 class="font-display font-bold text-[15px] leading-snug text-[var(--text-primary)] line-clamp-3"><a href={i.href} class="hover:text-[var(--accent-cyan)] transition-colors duration-200">{i.title}</a></h4>
                        </div>
                      </article>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <!-- Grid, one type -->
          <ul data-pubs-panel="cards" hidden class="[&[hidden]]:hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-5">
            {pubItems.map((i) => (
              <li data-type={i.type}>
                <article class="card-default h-full overflow-hidden flex md:flex-col">
                  <a href={i.href} tabindex="-1" aria-hidden="true" class="block shrink-0 w-28 md:w-full aspect-square md:aspect-[16/10] overflow-hidden bg-[var(--surface-soft)]"><img src={i.image.url} alt={i.image.alt} width="400" height="250" class="w-full h-full object-cover" loading="lazy" decoding="async" /></a>
                  <div class="p-4 md:p-5 flex flex-col gap-2 min-w-0">
                    <span class="flex justify-between gap-2 font-mono text-[11px] text-[var(--text-muted)]"><span class:list={['uppercase tracking-[0.1em]', badgeClass(i.type)]}>{i.type === 'research' ? 'Research' : 'Partner'}</span><span>{i.date}</span></span>
                    <h3 class="font-display font-bold text-[15px] md:text-base leading-snug text-[var(--text-primary)] line-clamp-3"><a href={i.href} class="hover:text-[var(--accent-cyan)] transition-colors duration-200">{i.title}</a></h3>
                  </div>
                </article>
              </li>
            ))}
          </ul>

          <!-- List -->
          <ol data-pubs-panel="list" hidden class="[&[hidden]]:hidden card-default rounded-2xl py-1.5">
            {pubItems.map((i) => (
              <li data-type={i.type} class="border-b border-[var(--border-subtle)] last:border-b-0">
                <a href={i.href} class="group grid grid-cols-[1fr_auto] md:grid-cols-[110px_120px_1fr_64px_20px] items-center gap-x-5 gap-y-1 px-4 md:px-7 py-3.5 hover:bg-[var(--surface-soft)] transition-colors duration-200">
                  <span class="font-mono text-xs text-[var(--text-muted)] md:order-none order-1">{i.date}</span>
                  <span class:list={['font-mono text-[11px] uppercase tracking-[0.1em] order-2 md:order-none text-right md:text-left', badgeClass(i.type)]}>{i.type === 'research' ? 'Research' : 'Partner'}</span>
                  <span class="col-span-2 md:col-span-1 order-3 md:order-none font-display text-[15px] md:text-base font-medium text-[var(--text-primary)] group-hover:text-[var(--accent-cyan)] transition-colors duration-200 md:truncate">{i.title}</span>
                  <span class="hidden md:block font-mono text-xs text-[var(--text-muted)] text-right">{i.readTime} min</span>
                  <svg class="hidden md:block w-4 h-4 text-[var(--accent-cyan)]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ) : (
        <div class="max-w-md mx-auto text-center p-10 card-default rounded-2xl">
          <p class="font-body text-sm text-[var(--text-secondary)] leading-relaxed">
            {postsUnavailable
              ? <>Publications could not be loaded right now. Browse every article on the <a href="/blog" class="text-[var(--accent-cyan)] underline">Fintech24h blog</a>.</>
              : 'No publications yet.'}
          </p>
        </div>
      )}

      <div class="mt-10 lg:mt-12">
        <Pagination currentPage={pageNumber} totalPages={totalPages} basePath={`/author/${slug}`} label="Publications pagination" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Copy-email button on the author profile. If the clipboard is unavailable
  // the label says so; the address itself stays visible and selectable.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) {
    btn.addEventListener('click', async () => {
      const email = btn.dataset.copyEmail || '';
      const label = btn.querySelector('[data-copy-label]');
      if (!label) return;
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Copy failed';
      }
      setTimeout(() => { label.textContent = 'Copy email'; }, 1800);
    });
  }
</script>

<style>
  /* Custom anim parameters */
  @keyframes spin-clockwise {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  @keyframes spin-counter {
    0% { transform: rotate(360deg); }
    100% { transform: rotate(0deg); }
  }
  .animate-spin-clockwise {
    animation: spin-clockwise 45s linear infinite;
  }
  .animate-spin-counter {
    animation: spin-counter 25s linear infinite;
  }
</style>

<script>
  // Publications: type filter + grid/list view. Without JavaScript the toolbar stays
  // hidden and the default grid (all types) shows every post on the page.
  document.querySelectorAll<HTMLElement>('[data-pubs]').forEach((root) => {
    const toolbar = root.querySelector<HTMLElement>('[data-pubs-toolbar]');
    const panels = {
      hub: root.querySelector<HTMLElement>('[data-pubs-panel="hub"]'),
      cards: root.querySelector<HTMLElement>('[data-pubs-panel="cards"]'),
      list: root.querySelector<HTMLElement>('[data-pubs-panel="list"]'),
    };
    let filter = 'all';
    let view = 'grid';
    const render = () => {
      if (panels.hub) panels.hub.hidden = !(view === 'grid' && filter === 'all');
      if (panels.cards) panels.cards.hidden = !(view === 'grid' && filter !== 'all');
      if (panels.list) panels.list.hidden = view !== 'list';
      [panels.cards, panels.list].forEach((panel) => panel?.querySelectorAll<HTMLElement>('[data-type]').forEach((item) => {
        item.hidden = filter !== 'all' && item.dataset.type !== filter;
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-pubs-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pubsFilter === filter)));
      root.querySelectorAll<HTMLButtonElement>('[data-pubs-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pubsView === view)));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-pubs-filter]').forEach((b) => b.addEventListener('click', () => { filter = b.dataset.pubsFilter ?? 'all'; render(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-pubs-view]').forEach((b) => b.addEventListener('click', () => { view = b.dataset.pubsView ?? 'grid'; render(); }));
    if (toolbar) toolbar.hidden = false;
    render();
  });
</script>
