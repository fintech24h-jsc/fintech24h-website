---
// src/pages/index.astro
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import GlobalNetwork from '../components/sections/GlobalNetwork.astro';
import CaseStudyWidget from '../components/sections/CaseStudyWidget.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import BlogHighlight from '../components/sections/BlogHighlight.astro';

Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');
import FaqSection from '../components/sections/FaqSection.astro';
import FooterLeadForm from '../components/sections/FooterLeadForm.astro';
import PrCtaSection from '../components/sections/PrCtaSection.astro';
import KolCtaSection from '../components/sections/KolCtaSection.astro';
import { getFeaturedCaseStudy } from '../lib/wordpress';

const featuredCase = await getFeaturedCaseStudy();

// Homepage FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What services does Fintech24h offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fintech24h offers 6 core services for blockchain and Web3 projects: KOL Marketing, PR Campaigns, Community Growth, Event Marketing, AI Marketing, and Business Development."
      }
    },
    {
      "@type": "Question",
      "name": "How much does blockchain marketing cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our pricing starts at $3,000/month for starter packages, with Growth packages at $5,000–$10,000/month and Enterprise solutions from $15,000/month. Custom packages are available based on your specific needs."
      }
    },
    {
      "@type": "Question",
      "name": "What markets does Fintech24h cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We specialize in Tier 1 markets including Vietnam, Singapore, and UAE, with strong presence in Tier 2 markets: Indonesia, Thailand, and India. We have established KOL networks and PR relationships in all these regions."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to see results?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Community building and social media growth typically show results within 30–60 days. PR coverage begins within the first 2 weeks. KOL campaigns can generate immediate reach. Full-funnel results typically materialize within 90 days."
      }
    }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Fintech24h",
  "url": "https://fintech24h.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://fintech24h.com/blog?s={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  "name": "Fintech24h",
  "description": "Blockchain & AI Marketing Agency — KOL Marketing, PR, Community Growth, Business Development for Web3 projects in Vietnam, Singapore, UAE.",
  "image": "https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp",
  "url": "https://fintech24h.com",
  "email": "info@fintech24h.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1014 Đường Phạm Văn Đồng, Hiệp Bình",
    "addressLocality": "Thành phố Hồ Chí Minh",
    "addressRegion": "Hồ Chí Minh",
    "addressCountry": "VN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 10.8404,
    "longitude": 106.7520
  },
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
    "opens": "09:00",
    "closes": "18:00"
  }],
  "priceRange": "$$$$",
  "currenciesAccepted": "USD, USDT",
  "paymentAccepted": "Bank Transfer, Cryptocurrency",
  "areaServed": ["VN","SG","AE","ID","TH","IN"],
  "sameAs": [
    "https://www.linkedin.com/company/fintech24h/",
    "https://www.facebook.com/fintech24hnews",
    "https://x.com/fintech24h_com",
    "https://t.me/fintech24h",
    "https://medium.com/@fintech24h",
    "https://www.instagram.com/fintech24h/"
  ]
};

const combinedSchema = [faqSchema, websiteSchema, localBusinessSchema];
---

<BaseLayout
  title="Fintech24h — Blockchain & AI Marketing Agency | Growth Partner"
  description="Fintech24h is the growth partner and marketing authority for Blockchain, Fintech & AI projects — KOL marketing, PR, community growth, and business development."
  schema={combinedSchema}
>
  <HeroSection />



  <TrustBar />
  <ServicesGrid />
  <GlobalNetwork />
  {featuredCase && <CaseStudyWidget caseStudy={featuredCase} />}
  <ProcessSection />

  <!-- PR CTA Section (Newspaper Mockup) -->
  <PrCtaSection isHero={false} />

  <BlogHighlight />

  <!-- KOL CTA Section -->
  <KolCtaSection isHero={false} />

  <FaqSection />
  <FooterLeadForm />
</BaseLayout>
