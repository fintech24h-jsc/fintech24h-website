---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import CaseStudyWidget from '../components/sections/CaseStudyWidget.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import FooterLeadForm from '../components/sections/FooterLeadForm.astro';
import { getFeaturedCaseStudy } from '../lib/wordpress';

const featuredCase = await getFeaturedCaseStudy();

// Homepage FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What services does Fintech24h offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fintech24h offers 6 core services for blockchain and Web3 projects: KOL & Influencer Marketing, PR & Media, Community Management, Growth & Airdrop Campaigns, B2B Business Development, and Content Strategy & SEO."
      }
    },
    {
      "@type": "Question",
      "name": "How much does blockchain marketing cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our pricing starts at $3,000/month for starter packages, with Growth packages at $5,000–$10,000/month and Enterprise solutions from $15,000/month. Custom packages are available based on your specific needs."
      }
    },
    {
      "@type": "Question",
      "name": "What markets does Fintech24h cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We specialize in Tier 1 markets including Vietnam, Singapore, and UAE, with strong presence in Tier 2 markets: Indonesia, Thailand, and India. We have established KOL networks and PR relationships in all these regions."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to see results?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Community building and social media growth typically show results within 30–60 days. PR coverage begins within the first 2 weeks. KOL campaigns can generate immediate reach. Full-funnel results typically materialize within 90 days."
      }
    }
  ]
};
---

<BaseLayout
  title="Fintech24h — Blockchain & AI Marketing Agency | Web3 Growth Experts"
  description="Scale your blockchain, DeFi, or AI project globally. Fintech24h delivers KOL marketing, PR, community management, and growth hacking for Web3 startups in Vietnam, Singapore, UAE, and beyond."
  schema={faqSchema}
>
  <HeroSection />
  <TrustBar />
  <ServicesGrid />
  {featuredCase && <CaseStudyWidget caseStudy={featuredCase} />}
  <ProcessSection />
  <TestimonialsSection />
  <FaqSection />
  <FooterLeadForm />
</BaseLayout>
