---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import CaseStudyWidget from '../components/sections/CaseStudyWidget.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import CampaignCalculator from '../components/ui/CampaignCalculator.tsx';
import FaqSection from '../components/sections/FaqSection.astro';
import FooterLeadForm from '../components/sections/FooterLeadForm.astro';
import MultiStepForm from '../components/ui/MultiStepForm.tsx';
import { getFeaturedCaseStudy } from '../lib/wordpress';

const featuredCase = await getFeaturedCaseStudy();

// Homepage FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What services does Fintech24h offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fintech24h offers 6 core services for blockchain and Web3 projects: KOL & Influencer Marketing, PR & Media, Community Management, Growth & Airdrop Campaigns, B2B Business Development, and Content Strategy & SEO."
      }
    },
    {
      "@type": "Question",
      "name": "How much does blockchain marketing cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our pricing starts at $3,000/month for starter packages, with Growth packages at $5,000–$10,000/month and Enterprise solutions from $15,000/month. Custom packages are available based on your specific needs."
      }
    },
    {
      "@type": "Question",
      "name": "What markets does Fintech24h cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We specialize in Tier 1 markets including Vietnam, Singapore, and UAE, with strong presence in Tier 2 markets: Indonesia, Thailand, and India. We have established KOL networks and PR relationships in all these regions."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to see results?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Community building and social media growth typically show results within 30–60 days. PR coverage begins within the first 2 weeks. KOL campaigns can generate immediate reach. Full-funnel results typically materialize within 90 days."
      }
    }
  ]
};
---

<BaseLayout
  title="Fintech24h — Blockchain & AI Marketing Agency | Web3 Growth Experts"
  description="Scale your blockchain, DeFi, or AI project globally. Fintech24h delivers KOL marketing, PR, community management, and growth hacking for Web3 startups in Vietnam, Singapore, UAE, and beyond."
  schema={faqSchema}
>
  <HeroSection />

  <!-- Dedicated Strategy Form Section (Separated from Hero) -->
  <section id="strategy-section" class="py-24 bg-[var(--bg-secondary)] relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute w-[500px] h-[500px] rounded-full"
        style="background: var(--gradient-glow-purple); top: -10%; left: -5%; filter: blur(90px); opacity: 0.1;">
      </div>
      <div class="absolute inset-0 grid-pattern" style="opacity: 0.05;"></div>
    </div>
    <div class="relative z-10 max-w-3xl mx-auto px-4">
      <div class="card-default p-8 lg:p-12 relative overflow-hidden z-10" data-animate="fade-up">
        <div class="absolute inset-0 bg-radial-gradient(circle, rgba(0, 200, 240, 0.03) 0%, transparent 60%) pointer-events-none"></div>
        <div class="text-center mb-10 relative z-10">
          <h2 class="font-display text-3xl font-bold text-[var(--text-primary)] mb-3">
            Get Your Free Strategy
          </h2>
          <p class="text-sm text-[var(--text-secondary)] font-body max-w-xl mx-auto">
            Tell us about your project. We'll build a custom growth plan in 24 hours.
          </p>
        </div>
        <div class="relative z-10">
          <MultiStepForm client:load />
        </div>
      </div>
    </div>
  </section>

  <TrustBar />
  <ServicesGrid />
  {featuredCase && <CaseStudyWidget caseStudy={featuredCase} />}
  <ProcessSection />

  <!-- Interactive Campaign ROI Calculator Section -->
  <section class="py-24 bg-[var(--bg-primary)] relative overflow-hidden" aria-label="Campaign ROI Calculator">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute w-[600px] h-[600px] rounded-full"
        style="background: var(--gradient-glow-cyan); top: 20%; left: -10%; filter: blur(90px); opacity: 0.15;">
      </div>
      <div class="absolute inset-0 grid-pattern" style="opacity: 0.1;"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16" data-animate="fade-up">
        <p class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.15em] mb-4 flex items-center justify-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]"></span>
          ROI Simulator
        </p>
        <h2 class="font-display text-h2 font-bold text-[var(--text-primary)] mb-4">
          Estimate Your <span class="bg-gradient-to-r from-[var(--accent-cyan)] to-[#ff9966] bg-clip-text text-transparent">Growth Impact</span>
        </h2>
        <p class="text-base text-[var(--text-secondary)] font-body leading-relaxed">
          Select your market sector, targeting geography, and monthly budget to view estimated 90-day reach, community acquisition, and average ROI.
        </p>
      </div>

      <CampaignCalculator client:load />
    </div>
  </section>

  <FaqSection />
  <FooterLeadForm />
</BaseLayout>
