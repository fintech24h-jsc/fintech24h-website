---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import { team, advisors } from '../data/team';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'About Us', item: 'https://fintech24h.com/about' }
];

const aboutSchema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Fintech24h",
    "url": "https://fintech24h.com/about",
    "description": "Fintech24h is a growth partner for Blockchain, Fintech & AI projects scaling across Vietnam, Singapore, UAE, and beyond. Learn about our team and approach.",
    "mainEntity": { "@type": "Organization", "@id": "https://fintech24h.com/#organization" }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://fintech24h.com/#organization",
    "name": "Fintech24h",
    "url": "https://fintech24h.com",
    "logo": "https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp",
    "foundingDate": "2020",
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": "30" },
    "knowsAbout": [
      "Blockchain Marketing","Web3 Growth Hacking","KOL Marketing","Crypto PR",
      "Community Management","DeFi Marketing","NFT Campaigns","Token Launch Marketing"
    ],
    "member": team.map(m => ({
      "@type": "OrganizationRole",
      "member": {
        "@type": "Person",
        "name": m.name,
        "jobTitle": m.role,
        "description": m.bio,
        ...(m.linkedin ? { "sameAs": m.linkedin } : {})
      },
      "roleName": m.role,
      "startDate": "2020"
    }))
  }
];
---

<BaseLayout
  title="About Fintech24h — Blockchain & AI Marketing Agency"
  description="Fintech24h is a growth partner for Blockchain, Fintech & AI projects scaling across Vietnam, Singapore, UAE, and beyond. Learn about our team and approach."
  schema={aboutSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- About Hero -->
  <section class="relative py-24 lg:py-32 overflow-hidden" aria-label="About Us Hero">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-cyan w-[600px] h-[600px] absolute -top-40 -left-32 opacity-15"></div>
      <div class="bg-orb bg-orb-purple w-[500px] h-[500px] absolute bottom-0 -right-32 opacity-10"></div>
      <div class="grid-pattern absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-20" data-animate="fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-400/30 bg-cyan-400/5 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
          <span class="text-xs font-semibold text-cyan-400 font-body uppercase tracking-wider">Our Story</span>
        </div>
        <h1 class="font-display text-h1 font-bold text-[#f0f4ff] mb-6">
          We Build Marketing That's Native to Blockchain <br/>
          <span class="text-cyan-400">— Not Adapted for It.</span>
        </h1>
        <p class="text-lg text-[#94a3b8] font-body leading-relaxed">
          Fintech24h was built to bridge the gap between complex blockchain technologies and scalable user acquisition. We replace speculative hype with quantitative, OKR-driven marketing strategies.
        </p>
      </div>

      <!-- Core Philosophy Grid -->
      <div class="grid md:grid-cols-3 gap-6 mb-24" data-animate="stagger">
        
        <div class="glass-card rounded-2xl p-8 border-white/5" data-animate-child>
          <div class="w-10 h-10 rounded-xl bg-cyan-400/10 border border-cyan-400/20 flex items-center justify-center text-cyan-400 mb-6">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-[#f0f4ff] mb-3">Vetted Integrity</h3>
          <p class="text-xs text-[#94a3b8] font-body leading-relaxed">
            Every influencer, publication, and community manager in our network is audited for bot traffic and sybil activity to protect your ad budget.
          </p>
        </div>

        <div class="glass-card rounded-2xl p-8 border-white/5" data-animate-child>
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-400/20 flex items-center justify-center text-purple-400 mb-6">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-[#f0f4ff] mb-3">Data-Driven Models</h3>
          <p class="text-xs text-[#94a3b8] font-body leading-relaxed">
            We tie influencer campaigns, community growth, and PR coverages directly to measurable conversion goals using an Objectives and Key Results framework.
          </p>
        </div>

        <div class="glass-card rounded-2xl p-8 border-white/5" data-animate-child>
          <div class="w-10 h-10 rounded-xl bg-cyan-400/10 border border-cyan-400/20 flex items-center justify-center text-cyan-400 mb-6">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-[#f0f4ff] mb-3">Plug & Play Efficiency</h3>
          <p class="text-xs text-[#94a3b8] font-body leading-relaxed">
            No long onboarding delays. We deploy pre-configured moderation bots, verified marketing briefs, and PR lists within 72 hours of retainer sign-off.
          </p>
        </div>

      </div>

      <!-- Core Leadership Team -->
      <div class="mb-24">
        <div class="text-center max-w-2xl mx-auto mb-16" data-animate="fade-up">
          <h2 class="font-display text-3xl font-bold text-[#f0f4ff] mb-4">
            Core Leadership
          </h2>
          <p class="text-sm text-[#94a3b8] font-body">
            Meet the crypto growth engineers and operators guiding campaigns across international hubs.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6" data-animate="stagger">
          {team.map((t) => (
            <div class="glass-card rounded-2xl p-6 border-white/5 flex flex-col justify-between group" data-animate-child>
              <div>
                <div class="w-full aspect-[4/5] rounded-xl bg-[#0a0f1e] border border-white/5 overflow-hidden mb-4 relative">
                  <div class="absolute inset-0 flex items-center justify-center font-display text-cyan-400/30 text-4xl font-bold">
                    {t.name.split(' ').map(n => n[0]).join('')}
                  </div>
                </div>
                <h3 class="font-display text-sm font-bold text-[#f0f4ff] group-hover:text-cyan-400 transition-colors mb-1">{t.name}</h3>
                <div class="text-[10px] text-cyan-400 font-body uppercase tracking-wider mb-3">{t.role}</div>
                <p class="text-xs text-[#94a3b8] font-body leading-relaxed mb-4">{t.bio}</p>
              </div>

              {t.linkedin && (
                <a
                  href={t.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[10px] text-[#475569] hover:text-cyan-400 transition-colors font-display font-semibold uppercase tracking-wider flex items-center gap-1 mt-auto"
                >
                  LinkedIn
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Strategic Advisors -->
      <div>
        <div class="text-center max-w-2xl mx-auto mb-16" data-animate="fade-up">
          <h2 class="font-display text-3xl font-bold text-[#f0f4ff] mb-4">
            Strategic Advisors
          </h2>
          <p class="text-sm text-[#94a3b8] font-body">
            Venture capitalists and economists lending market intelligence and liquidity relations expertise.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-4xl mx-auto" data-animate="stagger">
          {advisors.map((t) => (
            <div class="glass-card rounded-2xl p-8 border-purple-500/10 flex flex-col sm:flex-row gap-6 items-start" data-animate-child>
              <div class="w-20 h-20 rounded-xl bg-purple-500/10 border border-purple-400/20 flex items-center justify-center font-display text-purple-400 font-bold text-2xl shrink-0">
                {t.name.split(' ').map(n => n[0]).join('')}
              </div>
              <div>
                <h3 class="font-display text-base font-bold text-[#f0f4ff] mb-1">{t.name}</h3>
                <div class="text-xs text-purple-400 font-body uppercase tracking-wider mb-3">{t.role}</div>
                <p class="text-xs text-[#94a3b8] font-body leading-relaxed mb-4">{t.bio}</p>
                {t.linkedin && (
                  <a href={t.linkedin} target="_blank" rel="noopener noreferrer" class="text-[10px] text-[#475569] hover:text-cyan-400 transition-colors font-display font-semibold uppercase tracking-wider inline-flex items-center gap-1">
                    LinkedIn →
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
