<style>
  summary::-webkit-details-marker { display: none; }
  
  .reveal { 
    opacity: 0; 
    filter: blur(10px); 
    transform: translateY(30px); 
    transition: opacity 0.8s ease, filter 0.8s ease, transform 0.8s ease; 
  }
  .reveal.revealed { 
    opacity: 1; 
    filter: blur(0); 
    transform: translateY(0); 
  }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }

  @keyframes float-slow {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-15px) scale(1.05); }
  }

  @keyframes matrix-fall {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  @keyframes scan-down {
    0% { transform: translateY(0); }
    50% { transform: translateY(360px); }
    100% { transform: translateY(360px); }
  }

  @keyframes scan-up {
    0% { transform: translateY(0); }
    50% { transform: translateY(-360px); }
    100% { transform: translateY(-360px); }
  }

  @keyframes rotate-clockwise {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes rotate-counter {
    0% { transform: rotate(360deg); }
    100% { transform: rotate(0deg); }
  }

  @keyframes particle-pulse {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.4); }
  }

  @keyframes glitch-flicker {
    0%, 100% { opacity: 1; }
    41% { opacity: 1; }
    42% { opacity: 0.3; }
    43% { opacity: 0.8; }
    44% { opacity: 0.3; }
    45% { opacity: 1; }
    90% { opacity: 1; }
    91% { opacity: 0.4; }
    92% { opacity: 0.9; }
    93% { opacity: 1; }
  }

  .grid-pattern {
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  /* Scanlines Retro-CRT Overlay */
  .scanlines-overlay {
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.3) 50%);
    background-size: 100% 4px;
  }

  /* Glitch Text Hover Effect */
  .hover-glitch {
    transition: text-shadow 0.3s ease, color 0.3s ease;
  }
  .hover-glitch:hover {
    text-shadow: 
      2px -1px 0 rgba(0, 200, 240, 0.5), 
      -2px 1px 0 rgba(124, 92, 252, 0.5);
    color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) { 
    .reveal { opacity: 1; filter: none; transform: none; transition: none; } 
    .cyber-ring, .scanlines-overlay { animation: none !important; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>
