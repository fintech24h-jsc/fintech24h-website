---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import ServiceInquiryForm from '../components/ui/ServiceInquiryForm';
import { team } from '../data/team';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'About Us', item: 'https://fintech24h.com/about' }
];

const aboutSchema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Fintech24h",
    "url": "https://fintech24h.com/about",
    "description": "Meet the core architects of Fintech24h and learn about our future-consensus-driven vision and mission for the global blockchain community.",
    "mainEntity": { "@type": "Organization", "@id": "https://fintech24h.com/#organization" }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://fintech24h.com/#organization",
    "name": "Fintech24h",
    "url": "https://fintech24h.com",
    "logo": "https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp",
    "foundingDate": "2020",
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": "30" },
    "knowsAbout": [
      "Blockchain Marketing","Web3 Growth Hacking","KOL Marketing","Crypto PR",
      "Community Management","DeFi Marketing","NFT Campaigns","Token Launch Marketing"
    ],
    "member": team.map(m => ({
      "@type": "OrganizationRole",
      "member": {
        "@type": "Person",
        "name": m.name,
        "jobTitle": m.role,
        "description": m.bio,
        ...(m.linkedin ? { "sameAs": m.linkedin } : {})
      },
      "roleName": m.role,
      "startDate": "2020"
    }))
  }
];
---

<BaseLayout
  title="About Fintech24h — Architects of the Consensus Future"
  description="Meet the core architects of Fintech24h and learn about our future-consensus-driven vision and mission for the global blockchain community."
  schema={aboutSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO (Cinematic HUD Spotlight & Cybernetic Ring) -->
  <section class="relative min-h-screen flex flex-col justify-center items-center px-4 overflow-hidden bg-[#020202]">
    <!-- CRT Scanlines Filter Overlay -->
    <div class="absolute inset-0 pointer-events-none z-30 scanlines-overlay opacity-[0.03]"></div>

    <!-- Spotlight Effect -->
    <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[80vw] h-[80vh] bg-[radial-gradient(ellipse_at_top,rgba(0,200,240,0.15),transparent_60%)] pointer-events-none z-10"></div>
    <div class="absolute bottom-[-10%] left-[10%] w-[400px] h-[400px] rounded-full bg-[var(--gradient-glow-purple)] opacity-10 filter blur-[100px] pointer-events-none animate-[float-slow_15s_infinite_ease-in-out]"></div>
    
    <!-- Cyber Grid Background -->
    <div class="absolute inset-0 pointer-events-none opacity-25 z-0" aria-hidden="true">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#00c8f015_1px,transparent_1px),linear-gradient(to_bottom,#00c8f015_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
      <div class="absolute top-0 left-[15%] w-[1px] h-full bg-gradient-to-b from-transparent via-[var(--accent-cyan)] to-transparent opacity-30 animate-[matrix-fall_5s_linear_infinite]"></div>
      <div class="absolute top-0 right-[25%] w-[1px] h-full bg-gradient-to-b from-transparent via-[var(--accent-purple)] to-transparent opacity-20 animate-[matrix-fall_7s_linear_infinite_1.5s]"></div>
      <div class="absolute inset-0 grid-pattern opacity-10"></div>
    </div>

    <!-- Rotating Cyber Ring (HUD Visual Element) -->
    <div class="absolute w-[500px] h-[500px] md:w-[700px] md:h-[700px] rounded-full border border-dashed border-cyan-400/10 pointer-events-none z-0 animate-[rotate-clockwise_40s_linear_infinite] flex items-center justify-center">
      <div class="w-[85%] h-[85%] rounded-full border border-double border-purple-500/10 animate-[rotate-counter_30s_linear_infinite]"></div>
      <div class="w-[70%] h-[70%] rounded-full border border-dashed border-cyan-400/5"></div>
    </div>

    <!-- HUD Indicators -->
    <div class="absolute top-28 left-8 hidden lg:block font-mono text-[9px] text-[var(--accent-cyan)] opacity-60 space-y-1 z-20">
      <div class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span> SYS.STATUS // ONLINE</div>
      <div>CORE.INTEGRITY // SECURED_OK</div>
      <div class="text-white/30">PROTOCOL // DECENTRALIZED_NODE</div>
    </div>
    
    <div class="absolute top-28 right-8 hidden lg:block font-mono text-[9px] text-[var(--accent-purple)] opacity-60 space-y-1 z-20 text-right">
      <div>LATENCY // 12ms</div>
      <div>NETWORK // BLOCKCHAIN</div>
      <div class="text-white/30">OPERATOR // AB_US_V3.1</div>
    </div>

    <!-- Floating Cyber Particles -->
    <div class="absolute inset-0 pointer-events-none z-10">
      <div class="absolute w-2 h-2 bg-cyan-400/20 rounded-full top-[30%] left-[20%] animate-[particle-pulse_4s_infinite]"></div>
      <div class="absolute w-1.5 h-1.5 bg-purple-400/30 rounded-full top-[70%] left-[15%] animate-[particle-pulse_5s_infinite_1s]"></div>
      <div class="absolute w-2.5 h-2.5 bg-cyan-400/10 rounded-full top-[25%] right-[20%] animate-[particle-pulse_6s_infinite_2s]"></div>
      <div class="absolute w-2 h-2 bg-purple-400/20 rounded-full top-[60%] right-[15%] animate-[particle-pulse_4s_infinite_3s]"></div>
    </div>

    <div class="relative z-20 text-center max-w-5xl mx-auto mt-20">
      <div class="reveal">
        <p class="font-mono text-[10px] uppercase tracking-[0.4em] text-[var(--accent-cyan)] mb-6 animate-[glitch-flicker_2s_infinite]">[ DIRECTORY // CORE_TEAM ]</p>
      </div>

      <h1 class="font-display font-light max-w-5xl mx-auto reveal reveal-delay-1 leading-[1.05]">
        <span class="block text-[clamp(2.5rem,5vw,4.5rem)] tracking-widest text-white/40 uppercase mb-2">RE-ENGINEERING TRUST</span>
        <span class="block text-[clamp(3rem,6vw,5.5rem)] font-bold tracking-tight text-white uppercase drop-shadow-[0_0_30px_rgba(0,200,240,0.25)] hover-glitch">FOR THE DECENTRALIZED ERA</span>
      </h1>

      <p class="font-body text-base md:text-lg text-white/60 max-w-2xl mx-auto mt-8 mb-16 leading-[1.8] reveal reveal-delay-2 font-light">
        We replace speculative hype with quantitative, OKR-driven marketing strategies. By merging deep data analytics with target-driven community building, we establish permanent authority for high-growth protocols.
      </p>

      <div class="reveal reveal-delay-3 flex justify-center gap-4">
        <a href="#registry" class="inline-flex items-center justify-center border border-[var(--accent-cyan)]/30 bg-[var(--accent-cyan)]/5 px-8 py-4 text-white font-mono text-xs uppercase tracking-[0.2em] hover:bg-[var(--accent-cyan)] hover:text-[var(--text-inverted)] hover:shadow-[0_0_30px_rgba(0,200,240,0.4)] hover:-translate-y-1 transition-all duration-500 backdrop-blur-sm">
          View Node Registry
        </a>
        <a href="#connect" class="inline-flex items-center justify-center border border-white/10 px-8 py-4 text-white/50 font-mono text-xs uppercase tracking-[0.2em] hover:border-white/30 hover:text-white hover:-translate-y-1 transition-all duration-500 backdrop-blur-sm">
          Establish Contact
        </a>
      </div>
    </div>
    
    <!-- Cinematic Bottom Fade -->
    <div class="absolute bottom-0 w-full h-48 bg-gradient-to-t from-[#020202] to-transparent pointer-events-none"></div>
  </section>

  <!-- SECTION 2 — THE BLUEPRINT (Vision & Mission Ticket Layout) -->
  <section class="py-32 bg-[#020202] relative z-10 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-24 reveal">
        <span class="block font-mono text-[10px] uppercase tracking-[0.3em] text-[var(--accent-purple)] mb-4">THE BLUEPRINT</span>
        <h2 class="font-display text-[clamp(2.5rem,4vw,3.5rem)] text-white uppercase tracking-wider font-bold">Consensus Horizons</h2>
        <div class="w-16 h-px bg-white/20 mx-auto mt-6"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 max-w-5xl mx-auto">
        {[
          { 
            step: 'VISION', 
            title: 'Empowering the Future of Blockchain, Fintech & AI', 
            desc: 'We envision a globally connected ecosystem where transformative technologies achieve mass adoption through strategic marketing, meaningful partnerships, and thriving communities.', 
            marker: 'EST. FUTURE',
            glowClass: 'hover:shadow-[0_0_30px_rgba(0,200,240,0.12)] hover:border-[var(--accent-cyan)]/30'
          },
          { 
            step: 'MISSION', 
            title: 'Scale from Visibility to Market Leadership', 
            desc: 'By combining KOL marketing, PR, community growth, event marketing, AI-powered campaigns, and business development, we deliver measurable growth and sustainable success for the world\'s most ambitious technology companies.', 
            marker: 'ACTIVE_RUN',
            glowClass: 'hover:shadow-[0_0_30px_rgba(124,92,252,0.12)] hover:border-[var(--accent-purple)]/30'
          }
        ].map((item, i) => (
          <div class={`relative bg-[#080808] border border-white/10 rounded-lg flex flex-col md:flex-row overflow-hidden group transition-all duration-500 ${item.glowClass} reveal`}>
            <!-- Ticket Left Tear -->
            <div class="hidden md:flex flex-col justify-between items-center w-16 bg-white/5 border-r border-white/10 border-dashed py-6 relative">
              <div class="w-6 h-6 rounded-full bg-[#020202] absolute -left-3 top-6 border-r border-white/10"></div>
              <div class="w-6 h-6 rounded-full bg-[#020202] absolute -left-3 bottom-6 border-r border-white/10"></div>
              <span class="transform -rotate-90 font-mono text-[9px] text-white/30 tracking-[0.3em] whitespace-nowrap">{item.marker}</span>
            </div>
            
            <!-- Ticket Content -->
            <div class="p-8 md:p-10 flex-1">
              <span class="font-mono text-[10px] text-white/40 tracking-[0.2em] uppercase block mb-4" style={{ color: i === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}>{item.step}</span>
              <h3 class="font-display text-2xl text-white font-medium mb-4 group-hover:text-white transition-colors">{item.title}</h3>
              <p class="font-body text-white/50 text-sm leading-relaxed font-light">{item.desc}</p>
            </div>
            
            <!-- Ticket Right Barcode -->
            <div class="hidden md:flex flex-col justify-center items-center w-16 bg-white/[0.01] border-l border-white/10">
              <div class="flex gap-1 h-20 opacity-20 group-hover:opacity-40 transition-opacity">
                <div class="w-1 h-full bg-white"></div>
                <div class="w-[2px] h-full bg-white"></div>
                <div class="w-2.5 h-full bg-white"></div>
                <div class="w-1 h-full bg-white"></div>
                <div class="w-[2px] h-full bg-white"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    </div>
  </section>

  <!-- SECTION 3 — CORE VALUES (Holographic Databanks) -->
  <section class="py-32 bg-[#020202] relative z-10 border-t border-white/5">
    <!-- Ambient glow -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[var(--gradient-glow-cyan)] rounded-full opacity-[0.03] filter blur-[100px]"></div>
      <div class="absolute inset-0 grid-pattern opacity-10"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="text-center mb-20 reveal">
        <span class="block font-mono text-[10px] uppercase tracking-[0.3em] text-[var(--accent-cyan)] mb-4">SYSTEM_PARAMETERS</span>
        <h2 class="font-display text-[clamp(2rem,3.5vw,3rem)] text-white uppercase tracking-wider font-bold">Core Values</h2>
        <div class="w-16 h-px bg-white/20 mx-auto mt-6"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { 
            id: '01', title: 'Ownership & Empowerment', 
            desc: 'We trust our people to lead, make decisions, and create impact. Every team member is encouraged to take initiative and own outcomes.', 
            gradient: 'via-[var(--accent-cyan)]', badge: 'bg-[var(--accent-cyan)]/10 text-[var(--accent-cyan)] border-[var(--accent-cyan)]/20', dot: 'group-hover:bg-[var(--accent-cyan)]', corner: 'group-hover:border-[var(--accent-cyan)]/50'
          },
          { 
            id: '02', title: 'Creativity Without Limits', 
            desc: 'Innovation starts with bold ideas. We embrace experimentation, challenge conventional thinking, and continuously explore new possibilities.', 
            gradient: 'via-[var(--accent-purple)]', badge: 'bg-[var(--accent-purple)]/10 text-[var(--accent-purple)] border-[var(--accent-purple)]/20', dot: 'group-hover:bg-[var(--accent-purple)]', corner: 'group-hover:border-[var(--accent-purple)]/50'
          },
          { 
            id: '03', title: 'Global Mindset', 
            desc: 'We operate beyond borders, connecting diverse perspectives, markets, and opportunities across the world.', 
            gradient: 'via-[var(--accent-cyan)]', badge: 'bg-[var(--accent-cyan)]/10 text-[var(--accent-cyan)] border-[var(--accent-cyan)]/20', dot: 'group-hover:bg-[var(--accent-cyan)]', corner: 'group-hover:border-[var(--accent-cyan)]/50'
          },
          { 
            id: '04', title: 'Results With Integrity', 
            desc: 'Growth matters, but sustainable growth matters more. We prioritize transparency, accountability, and long-term value creation.', 
            gradient: 'via-[var(--accent-purple)]', badge: 'bg-[var(--accent-purple)]/10 text-[var(--accent-purple)] border-[var(--accent-purple)]/20', dot: 'group-hover:bg-[var(--accent-purple)]', corner: 'group-hover:border-[var(--accent-purple)]/50'
          },
          { 
            id: '05', title: 'Collaboration First', 
            desc: 'Great achievements are built together. We cultivate strong partnerships with clients, communities, investors, and ecosystem leaders.', 
            gradient: 'via-[var(--accent-cyan)]', badge: 'bg-[var(--accent-cyan)]/10 text-[var(--accent-cyan)] border-[var(--accent-cyan)]/20', dot: 'group-hover:bg-[var(--accent-cyan)]', corner: 'group-hover:border-[var(--accent-cyan)]/50'
          },
          { 
            id: '06', title: 'Move Fast, Learn Faster', 
            desc: 'The technology landscape evolves rapidly. We adapt quickly, learn continuously, and execute with speed and precision.', 
            gradient: 'via-[var(--accent-purple)]', badge: 'bg-[var(--accent-purple)]/10 text-[var(--accent-purple)] border-[var(--accent-purple)]/20', dot: 'group-hover:bg-[var(--accent-purple)]', corner: 'group-hover:border-[var(--accent-purple)]/50'
          }
        ].map((v, i) => (
          <div class="group relative bg-[#080808] border border-white/5 p-8 rounded-xl overflow-hidden hover:-translate-y-1 transition-all duration-500 reveal hover:shadow-[0_10px_40px_rgba(0,0,0,0.5)] hover:border-white/10" style={`transition-delay: ${i * 0.1}s`}>
            <!-- Neon Accent Line -->
            <div class={`absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent ${v.gradient} to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
            
            <div class="flex items-center justify-between mb-8">
              <span class={`font-mono text-[10px] tracking-widest px-2.5 py-1 border ${v.badge} rounded-md`}>
                VAL_NODE_{v.id}
              </span>
              <div class="flex gap-1.5">
                <span class={`w-1.5 h-1.5 rounded-full bg-white/10 ${v.dot} transition-colors duration-300`}></span>
                <span class={`w-1.5 h-1.5 rounded-full bg-white/10 ${v.dot} transition-colors duration-300 delay-75`}></span>
                <span class={`w-1.5 h-1.5 rounded-full bg-white/10 ${v.dot} transition-colors duration-300 delay-150`}></span>
              </div>
            </div>
            
            <h3 class="font-display text-xl text-white font-bold mb-3">{v.title}</h3>
            <p class="font-body text-white/50 text-sm leading-relaxed font-light">{v.desc}</p>
            
            <!-- Corner Brackets -->
            <div class={`absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-transparent ${v.corner} transition-colors duration-500 m-4 rounded-br-lg`}></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4 — FUTURISTIC NODE REGISTRY (Team Access Passes) -->
  <section class="py-32 bg-[#050505] relative z-10 border-t border-white/5" id="registry">
    <div class="max-w-7xl mx-auto px-6">
      <!-- Section Header with giant outline index numbers -->
      <div class="mb-20 reveal border-b border-white/10 pb-8 flex flex-col md:flex-row justify-between items-end gap-6">
        <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] font-bold text-white leading-tight uppercase max-w-2xl">
          Core Leadership Nodes
        </h2>
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 max-w-[250px] text-right">
          Verifiable identities of the platform operators.
        </p>
      </div>

      <!-- Passes Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {team.map((t, idx) => {
          // General specifications (strictly without specific unproven statistics)
          const specMetrics = idx === 0 ? [
            'Web3 Growth Architecture', 'Global Ecosystem Seeding', 'Launchpad Advisory Node'
          ] : idx === 1 ? [
            'Advanced UI/UX Protocols', 'Web3 Client Integrations', 'Front-end Architecture'
          ] : idx === 2 ? [
            'Community Infrastructure', 'Interactive Campaign Design', 'Multi-channel Moderation'
          ] : [
            'Strategic Capital Matchmaking', 'CEX/DEX Integrations', 'Global BD Pipeline'
          ];

          return (
            <div class="bg-black border border-white/10 p-8 hover:-translate-y-1.5 transition-all duration-500 group relative reveal overflow-hidden flex flex-col justify-between min-h-[360px]"
                 style={{ 
                   boxShadow: '0 10px 30px rgba(0,0,0,0.5)',
                   borderColor: 'rgba(255,255,255,0.06)'
                 }}>
              <!-- Dual Scanning Laser Line Sweep Effect on Hover -->
              <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-[var(--theme-accent)] to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-[scan-down_3s_linear_infinite] shadow-[0_0_12px_var(--theme-accent)]" 
                   style={{ '--theme-accent': idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}></div>
              <div class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-[var(--theme-accent)] to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-[scan-up_3s_linear_infinite] shadow-[0_0_12px_var(--theme-accent)]" 
                   style={{ '--theme-accent': idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}></div>
              
              <!-- Hover border glow highlight -->
              <div class="absolute inset-0 rounded-none border border-transparent group-hover:border-[var(--theme-accent)]/30 transition-colors duration-500 pointer-events-none"
                   style={{ '--theme-accent': idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}></div>

              <div>
                <!-- Operator Pass Header -->
                <div class="flex justify-between items-start mb-10">
                  <div class="flex gap-4 items-center">
                    {t.image && (
                      <div class="relative w-16 h-16 rounded-full overflow-hidden border border-white/10 group-hover:border-[var(--theme-accent)] transition-colors duration-500 shrink-0" style={{ '--theme-accent': idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}>
                        <div class="absolute inset-0 bg-[var(--theme-accent)]/10 animate-pulse mix-blend-overlay z-10 pointer-events-none"></div>
                        {t.name === 'Phat Vo' ? (
                          <a href="/author/phat-vo" class="w-full h-full block">
                            <img src={t.image} alt={t.name} width="64" height="64" class="w-full h-full object-cover filter grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500 relative z-0" />
                          </a>
                        ) : (
                          <img src={t.image} alt={t.name} width="64" height="64" class="w-full h-full object-cover filter grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500 relative z-0" />
                        )}
                      </div>
                    )}
                    <div class="flex flex-col">
                      <span class="font-mono text-[9px] text-white/40 tracking-[0.25em]">OPERATOR_NODE_0{idx + 1}</span>
                      <h3 class="font-display text-2xl text-white font-bold tracking-tight uppercase mt-1 transition-colors group-hover:text-[var(--theme-accent)]" style={{ '--theme-accent': idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}>
                        {t.name === 'Phat Vo' ? (
                          <a href="/author/phat-vo" class="hover:underline hover:text-[var(--theme-accent)] transition-colors">{t.name}</a>
                        ) : (
                          t.name
                        )}
                      </h3>
                      <span class="font-mono text-[10px] tracking-wider uppercase mt-1.5" style={{ color: idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}>
                        {t.role}
                      </span>
                    </div>
                  </div>
                  
                  <!-- Virtual Network ID Signature -->
                  <div class="flex flex-col items-end text-right font-mono text-[9px] text-white/30">
                    <div>STATUS // ONLINE</div>
                    <div class="text-[8px] text-white/20">ADDR // 0x71C...8E{idx}F</div>
                  </div>
                </div>

                <!-- Proof-point Specifications (Generic Roles, No Fluff Text, No Hardcoded Stats) -->
                <div class="space-y-3.5 mb-10">
                  <div class="font-mono text-[9px] uppercase tracking-widest text-white/30 border-b border-white/5 pb-2">Operational Node Registry:</div>
                  {specMetrics.map((spec) => (
                    <div class="flex items-center gap-3 font-mono text-xs text-white/80 group-hover:text-white transition-colors">
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse" style={{ backgroundColor: idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}></span>
                      {spec}
                    </div>
                  ))}
                </div>
              </div>

              <!-- Action Link Connections -->
              <div class="flex items-center gap-4 border-t border-white/5 pt-6 mt-auto">
                <a
                  href={t.telegram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 rounded-lg border border-white/10 bg-white/[0.01] font-mono text-[10px] uppercase tracking-wider text-white/70 hover:text-white hover:border-[var(--accent-cyan)]/30 hover:bg-[var(--accent-cyan)]/5 hover:shadow-[0_0_15px_rgba(0,200,240,0.1)] transition-all duration-300"
                >
                  <svg class="w-3.5 h-3.5 text-white/40" viewBox="0 0 24 24" fill="currentColor">
