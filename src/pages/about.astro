---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import ServiceInquiryForm from '../components/ui/ServiceInquiryForm';
import { team } from '../data/team';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'About Us', item: 'https://fintech24h.com/about' }
];

const aboutSchema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Fintech24h",
    "url": "https://fintech24h.com/about",
    "description": "Meet the core architects of Fintech24h and learn about our future-consensus-driven vision and mission for the global blockchain community.",
    "mainEntity": { "@type": "Organization", "@id": "https://fintech24h.com/#organization" }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://fintech24h.com/#organization",
    "name": "Fintech24h",
    "url": "https://fintech24h.com",
    "logo": "https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp",
    "foundingDate": "2020",
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": "30" },
    "knowsAbout": [
      "Blockchain Marketing","Web3 Growth Hacking","KOL Marketing","Crypto PR",
      "Community Management","DeFi Marketing","NFT Campaigns","Token Launch Marketing"
    ],
    "member": team.map(m => ({
      "@type": "OrganizationRole",
      "member": {
        "@type": "Person",
        "name": m.name,
        "jobTitle": m.role,
        "description": m.bio,
        ...(m.linkedin ? { "sameAs": m.linkedin } : {})
      },
      "roleName": m.role,
      "startDate": "2020"
    }))
  }
];
---

<BaseLayout
  title="About Fintech24h — Architects of the Consensus Future"
  description="Meet the core architects of Fintech24h and learn about our future-consensus-driven vision and mission for the global blockchain community."
  schema={aboutSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO (Cinematic HUD Spotlight) -->
  <section class="relative min-h-screen flex flex-col justify-center items-center px-4 overflow-hidden bg-[#020202]">
    <!-- Spotlight Effect -->
    <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[80vw] h-[80vh] bg-[radial-gradient(ellipse_at_top,rgba(0,200,240,0.12),transparent_60%)] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[10%] w-[400px] h-[400px] rounded-full bg-[var(--gradient-glow-purple)] opacity-10 filter blur-[100px] pointer-events-none animate-[float-slow_15s_infinite_ease-in-out]"></div>
    
    <!-- Cyber Grid Background -->
    <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#00c8f015_1px,transparent_1px),linear-gradient(to_bottom,#00c8f015_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
      <div class="absolute top-0 left-[15%] w-[1px] h-full bg-gradient-to-b from-transparent via-[var(--accent-cyan)] to-transparent opacity-30 animate-[matrix-fall_5s_linear_infinite]"></div>
      <div class="absolute top-0 right-[25%] w-[1px] h-full bg-gradient-to-b from-transparent via-[var(--accent-purple)] to-transparent opacity-20 animate-[matrix-fall_7s_linear_infinite_1.5s]"></div>
      <div class="absolute inset-0 grid-pattern opacity-10"></div>
    </div>

    <!-- HUD Indicators -->
    <div class="absolute top-28 left-8 hidden lg:block font-mono text-[9px] text-[var(--accent-cyan)] opacity-50 space-y-1">
      <div class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span> SYS.STATUS // ACTIVE</div>
      <div>CORE.INTEGRITY // VETTED_OK</div>
      <div class="text-white/30">PROTOCOL // AB_US_V3.0</div>
    </div>

    <div class="relative z-10 text-center max-w-5xl mx-auto mt-20">
      <div class="reveal">
        <p class="font-mono text-[10px] uppercase tracking-[0.4em] text-[var(--accent-cyan)] mb-6">[ DIRECTORY // CORE_TEAM ]</p>
      </div>

      <h1 class="font-display font-light max-w-5xl mx-auto reveal reveal-delay-1 leading-[1.05]">
        <span class="block text-[clamp(2.5rem,5vw,4.5rem)] tracking-widest text-white/40 uppercase mb-2">RE-ENGINEERING TRUST</span>
        <span class="block text-[clamp(3rem,6vw,5.5rem)] font-bold tracking-tight text-white uppercase drop-shadow-[0_0_30px_rgba(0,200,240,0.2)]">FOR THE DECENTRALIZED ERA</span>
      </h1>

      <p class="font-body text-base md:text-lg text-white/60 max-w-2xl mx-auto mt-8 mb-16 leading-[1.8] reveal reveal-delay-2 font-light">
        We replace speculative hype with quantitative, OKR-driven marketing strategies. By merging deep data analytics with target-driven community building, we establish permanent authority for high-growth protocols.
      </p>

      <div class="reveal reveal-delay-3 flex justify-center gap-4">
        <a href="#registry" class="inline-flex items-center justify-center border border-[var(--accent-cyan)]/30 bg-[var(--accent-cyan)]/5 px-8 py-4 text-white font-mono text-xs uppercase tracking-[0.2em] hover:bg-[var(--accent-cyan)] hover:text-black hover:shadow-[0_0_30px_rgba(0,200,240,0.3)] transition-all duration-500 backdrop-blur-sm">
          View Node Registry
        </a>
        <a href="#connect" class="inline-flex items-center justify-center border border-white/10 px-8 py-4 text-white/50 font-mono text-xs uppercase tracking-[0.2em] hover:border-white/30 hover:text-white transition-all duration-500 backdrop-blur-sm">
          Establish Contact
        </a>
      </div>
    </div>
    
    <!-- Cinematic Bottom Fade -->
    <div class="absolute bottom-0 w-full h-48 bg-gradient-to-t from-[#020202] to-transparent pointer-events-none"></div>
  </section>

  <!-- SECTION 2 — THE BLUEPRINT (Vision & Mission Ticket Layout) -->
  <section class="py-32 bg-[#020202] relative z-10 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-24 reveal">
        <span class="block font-mono text-[10px] uppercase tracking-[0.3em] text-[var(--accent-purple)] mb-4">THE BLUEPRINT</span>
        <h2 class="font-display text-[clamp(2.5rem,4vw,3.5rem)] text-white uppercase tracking-wider font-bold">Consensus Horizons</h2>
        <div class="w-16 h-px bg-white/20 mx-auto mt-6"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 max-w-5xl mx-auto">
        {[
          { 
            step: 'VISION', 
            title: 'Consensus Horizon', 
            desc: 'Architecting the convergence of decentralized ledgers and intelligence interfaces. We envision a global community sustained by cryptographically secure trust, transparent consensus, and uncompromised user sovereignty.', 
            marker: 'EST. FUTURE' 
          },
          { 
            step: 'MISSION', 
            title: 'The Growth Engine', 
            desc: 'Accelerating Web3 adoption through data-driven performance marketing and direct community seeding. We empower decentralization protocols by engineering scalable growth loops and transparent, high-integrity network distribution.', 
            marker: 'ACTIVE_RUN' 
          }
        ].map((item, i) => (
          <div class="relative bg-[#080808] border border-white/10 rounded-lg flex flex-col md:flex-row overflow-hidden group hover:border-white/30 transition-all duration-500 reveal">
            <!-- Ticket Left Tear -->
            <div class="hidden md:flex flex-col justify-between items-center w-16 bg-white/5 border-r border-white/10 border-dashed py-6 relative">
              <div class="w-6 h-6 rounded-full bg-[#020202] absolute -left-3 top-6 border-r border-white/10"></div>
              <div class="w-6 h-6 rounded-full bg-[#020202] absolute -left-3 bottom-6 border-r border-white/10"></div>
              <span class="transform -rotate-90 font-mono text-[9px] text-white/30 tracking-[0.3em] whitespace-nowrap">{item.marker}</span>
            </div>
            
            <!-- Ticket Content -->
            <div class="p-8 md:p-10 flex-1">
              <span class="font-mono text-[10px] text-white/40 tracking-[0.2em] uppercase block mb-4" style={{ color: i === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}>{item.step}</span>
              <h3 class="font-display text-2xl text-white font-medium mb-4 group-hover:text-white transition-colors">{item.title}</h3>
              <p class="font-body text-white/50 text-sm leading-relaxed font-light">{item.desc}</p>
            </div>
            
            <!-- Ticket Right Barcode -->
            <div class="hidden md:flex flex-col justify-center items-center w-16 bg-white/[0.01] border-l border-white/10">
              <div class="flex gap-1 h-20 opacity-20 group-hover:opacity-40 transition-opacity">
                <div class="w-1 h-full bg-white"></div>
                <div class="w-[2px] h-full bg-white"></div>
                <div class="w-2.5 h-full bg-white"></div>
                <div class="w-1 h-full bg-white"></div>
                <div class="w-[2px] h-full bg-white"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — FUTURISTIC NODE REGISTRY (Team Access Passes - NO AVATARS) -->
  <section class="py-32 bg-[#050505] relative z-10 border-t border-white/5" id="registry">
    <div class="max-w-7xl mx-auto px-6">
      <!-- Section Header with giant outline index numbers -->
      <div class="mb-20 reveal border-b border-white/10 pb-8 flex flex-col md:flex-row justify-between items-end gap-6">
        <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] font-bold text-white leading-tight uppercase max-w-2xl">
          Core Leadership Nodes
        </h2>
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 max-w-[250px] text-right">
          Verifiable cryptographic identities of the platform operators.
        </p>
      </div>

      <!-- Passes Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {team.map((t, idx) => {
          // Custom achievements list with real metrics parsed from signature logic or details
          const specMetrics = idx === 0 ? [
            '8+ Years Web3 Scale', '200+ Projects Advised', 'Ex-CMO Tier-1 Launchpad'
          ] : idx === 1 ? [
            '50+ Interfaces Shipped', '10+ Web3 Engines Integrated', '99.9% Client Retention SLA'
          ] : idx === 2 ? [
            '150K+ Community Members Managed', '45+ Global AMA Tours Completed', '<2 Mins Response Time SLA'
          ] : [
            '25+ Exchanges Connected', '80+ VC Networks Managed', '$12M+ BD Pipeline Closed'
          ];

          return (
            <div class="bg-black border border-white/10 p-8 hover:border-white/30 transition-all duration-500 group relative reveal overflow-hidden flex flex-col justify-between min-h-[360px]">
              <!-- Scanning Laser Line Sweep Effect on Hover -->
              <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-[var(--accent-cyan)] to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-[scan_2.5s_linear_infinite] shadow-[0_0_12px_var(--accent-cyan)]" style={{ '--accent-cyan': idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}></div>
              
              <div>
                <!-- Operator Pass Header -->
                <div class="flex justify-between items-start mb-10">
                  <div class="flex flex-col">
                    <span class="font-mono text-[9px] text-white/40 tracking-[0.25em]">OPERATOR_NODE_0{idx + 1}</span>
                    <h3 class="font-display text-2xl text-white font-bold tracking-tight uppercase mt-1">{t.name}</h3>
                    <span class="font-mono text-[10px] tracking-wider uppercase mt-1.5" style={{ color: idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}>
                      {t.role}
                    </span>
                  </div>
                  
                  <!-- Virtual Network ID Signature -->
                  <div class="flex flex-col items-end text-right font-mono text-[9px] text-white/30">
                    <div>STATUS // ONLINE</div>
                    <div class="text-[8px] text-white/20">ADDR // 0x71C...8E{idx}F</div>
                  </div>
                </div>

                <!-- Proof-point Specifications (Actual Metrics Only, No Fluff Text) -->
                <div class="space-y-3.5 mb-10">
                  <div class="font-mono text-[9px] uppercase tracking-widest text-white/30 border-b border-white/5 pb-2">Technical Specifications:</div>
                  {specMetrics.map((spec) => (
                    <div class="flex items-center gap-3 font-mono text-xs text-white/80 group-hover:text-white transition-colors">
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse" style={{ backgroundColor: idx % 2 === 0 ? 'var(--accent-cyan)' : 'var(--accent-purple)' }}></span>
                      {spec}
                    </div>
                  ))}
                </div>
              </div>

              <!-- Action Link Connections -->
              <div class="flex items-center gap-4 border-t border-white/5 pt-6 mt-auto">
                <a
                  href={t.telegram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 rounded-lg border border-white/10 bg-white/[0.01] font-mono text-[10px] uppercase tracking-wider text-white/70 hover:text-white hover:border-[var(--accent-cyan)]/30 hover:bg-[var(--accent-cyan)]/5 transition-all duration-300"
                >
                  <svg class="w-3.5 h-3.5 text-white/40" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.11.02-1.93 1.23-5.46 3.62-.51.35-.98.53-1.39.51-.46-.01-1.35-.26-2.01-.48-.81-.27-1.46-.42-1.4-.88.03-.24.36-.49.99-.75 3.88-1.69 6.46-2.8 7.74-3.32 3.69-1.5 4.44-1.76 4.95-1.77.11 0 .36.03.52.16.13.11.17.26.19.37z" />
                  </svg>
                  Connect Telegram
                </a>
                <a
                  href={t.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 rounded-lg border border-white/10 bg-white/[0.01] font-mono text-[10px] uppercase tracking-wider text-white/70 hover:text-white hover:border-[var(--accent-purple)]/30 hover:bg-[var(--accent-purple)]/5 transition-all duration-300"
                >
                  <svg class="w-3.5 h-3.5 text-white/40" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                  </svg>
                  Connect LinkedIn
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- SECTION 4 — INTERACTIVE APPLICATIONS (HubSpot Lead capture form & Social ecosystem links) -->
  <section class="py-32 bg-[#020202] relative overflow-hidden" id="connect" aria-label="Direct Proposal Contacts">
    <div class="absolute inset-0 pointer-events-none z-0">
      <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] rounded-full bg-[var(--gradient-glow-cyan)] opacity-[0.06] filter blur-[120px] animate-[float-slow_12s_infinite_ease-in-out]"></div>
      <div class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px] rounded-full bg-[var(--gradient-glow-purple)] opacity-[0.06] filter blur-[120px] animate-[float-slow_15s_infinite_ease-in-out_3s]"></div>
      <div class="absolute inset-0 grid-pattern opacity-10"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-12 gap-16 items-center">
        
        <!-- Social Matrix Content -->
        <div class="lg:col-span-5 space-y-8" data-animate="fade-up">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--accent-purple)]/25 bg-[var(--accent-purple)]/5 mb-4">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-purple)] animate-pulse"></span>
              <span class="text-[10px] font-mono font-medium text-[var(--accent-purple)] uppercase tracking-[0.2em]">Ecosystem Matrix</span>
            </div>
            <h2 class="font-display text-4xl sm:text-5xl font-bold text-white leading-tight uppercase">
              OPERATE ON THE <br />
              <span class="text-gradient">MATRIX.</span>
            </h2>
            <p class="text-sm text-white/50 font-body leading-relaxed mt-4 font-light">
              Connect to our broadcast nodes, corporate channels, and resources globally across the decentralization spectrum.
            </p>
          </div>

          <!-- Social Matrix Nodes -->
          <div class="grid grid-cols-2 gap-4">
            <a href="https://t.me/fintech24h" target="_blank" rel="noopener noreferrer" class="group p-5 rounded-lg bg-white/[0.01] border border-white/[0.05] hover:border-[var(--accent-cyan)]/30 hover:bg-[var(--accent-cyan)]/5 transition-all duration-300">
              <span class="text-[9px] font-mono text-white/30 uppercase tracking-wider block mb-1">Direct Chat</span>
              <span class="font-display text-sm font-bold text-white group-hover:text-[var(--accent-cyan)] transition-colors">Telegram Channel</span>
              <span class="text-[9px] font-mono text-[var(--accent-cyan)] block mt-2">t.me/fintech24h →</span>
            </a>

            <a href="https://www.linkedin.com/company/fintech24h/" target="_blank" rel="noopener noreferrer" class="group p-5 rounded-lg bg-white/[0.01] border border-white/[0.05] hover:border-[var(--accent-purple)]/30 hover:bg-[var(--accent-purple)]/5 transition-all duration-300">
              <span class="text-[9px] font-mono text-white/30 uppercase tracking-wider block mb-1">Corporate Node</span>
              <span class="font-display text-sm font-bold text-white group-hover:text-[var(--accent-purple)] transition-colors">LinkedIn Hub</span>
              <span class="text-[9px] font-mono text-[var(--accent-purple)] block mt-2">linkedin.com/... →</span>
            </a>

            <a href="https://x.com/fintech24h_com" target="_blank" rel="noopener noreferrer" class="group p-5 rounded-lg bg-white/[0.01] border border-white/[0.05] hover:border-white/20 hover:bg-white/[0.03] transition-all duration-300">
              <span class="text-[9px] font-mono text-white/30 uppercase tracking-wider block mb-1">Broadcasts</span>
              <span class="font-display text-sm font-bold text-white group-hover:text-[var(--accent-cyan)] transition-colors">X / Twitter</span>
              <span class="text-[9px] font-mono text-white/40 block mt-2">x.com/fintech24h →</span>
            </a>

            <a href="https://medium.com/@fintech24h" target="_blank" rel="noopener noreferrer" class="group p-5 rounded-lg bg-white/[0.01] border border-white/[0.05] hover:border-white/20 hover:bg-white/[0.03] transition-all duration-300">
              <span class="text-[9px] font-mono text-white/30 uppercase tracking-wider block mb-1">Publications</span>
              <span class="font-display text-sm font-bold text-white group-hover:text-[var(--accent-purple)] transition-colors">Medium Blog</span>
              <span class="text-[9px] font-mono text-white/40 block mt-2">medium.com/... →</span>
            </a>
          </div>

          <!-- Secondary ecosystem links -->
          <div class="flex items-center gap-6 text-[10px] text-white/30 font-mono uppercase tracking-widest pt-4">
            <span class="flex items-center gap-2">
              Ecosystem: 
              <a href="https://coinstori.com" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--accent-cyan)] transition-colors">Coinstori</a>
              | 
              <a href="https://cmointern.com" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--accent-purple)] transition-colors">CMO Intern</a>
            </span>
          </div>
        </div>

        <!-- Inquiries Lead Form Card -->
        <div class="lg:col-span-7" data-animate="scale-in">
          <div class="relative p-8 md:p-10 rounded-xl bg-black border border-white/10 shadow-[0_30px_60px_rgba(0,0,0,0.8)] overflow-hidden">
            <!-- Decorative interior spotlight -->
            <div class="absolute inset-0 pointer-events-none z-0" style="background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(0,200,240,0.04) 0%, transparent 60%);"></div>

            <div class="relative z-10 space-y-6">
              <div>
                <h3 class="font-display text-2xl font-bold text-white uppercase">Direct Project Application</h3>
                <p class="text-xs text-white/40 font-body leading-relaxed mt-2 font-light">
                  Input your project credentials below. Our operations network reviews all applications within 24 hours.
                </p>
              </div>

              <!-- Inquiry Form Component (React) -->
              <ServiceInquiryForm client:load />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  
  .reveal { 
    opacity: 0; 
    filter: blur(10px); 
    transform: translateY(30px); 
    transition: opacity 0.8s ease, filter 0.8s ease, transform 0.8s ease; 
  }
  .reveal.revealed { 
    opacity: 1; 
    filter: blur(0); 
    transform: translateY(0); 
  }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }

  @keyframes float-slow {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-15px) scale(1.05); }
  }

  @keyframes matrix-fall {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  @keyframes scan {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(100%); }
    100% { transform: translateY(100%); }
  }

  .grid-pattern {
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  @media (prefers-reduced-motion: reduce) { 
    .reveal { opacity: 1; filter: none; transform: none; transition: none; } 
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>
