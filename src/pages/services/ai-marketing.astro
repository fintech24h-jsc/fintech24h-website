---
// src/pages/services/ai-marketing.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FooterLeadForm from '../../components/sections/FooterLeadForm.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services/' },
  { name: 'AI Marketing', item: 'https://fintech24h.com/services/ai-marketing/' }
];

const faqs = [
  {
    q: "Do you build custom AI models?",
    a: "We don't build LLMs from scratch. We fine-tune existing top-tier models (GPT-4, Claude 3, Llama) on your specific project documentation, tone of voice, and historical data to create specialized agents for moderation and content."
  },
  {
    q: "Will the community know they are talking to an AI?",
    a: "We advocate for transparency. The best AI integrations are clearly labeled as AI assistants but are so useful that the community prefers talking to them for instant, accurate technical answers."
  },
  {
    q: "How does AI handle sentiment analysis?",
    a: "Our bots continuously scrape Telegram, Discord, and Twitter, assigning sentiment scores (-1 to +1) to keywords and topics. If negative sentiment spikes around a specific feature, you get an automated alert before it becomes a crisis."
  },
  {
    q: "Can AI completely replace human moderators?",
    a: "No. AI replaces the repetitive, low-value work (answering 'wen token', filtering spam, providing contract addresses). Humans are still required for complex dispute resolution and genuine community relationship building."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "AI Marketing",
  "provider": {
    "@type": "Organization",
    "name": "Fintech24h"
  },
  "url": "https://fintech24h.com/services/ai-marketing/",
  "description": "Go-to-market strategy and marketing execution for AI products and AI startups. Fintech24h positions AI products clearly, credibly, and distinctively in a crowded market."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

const combinedSchema = [serviceSchema, faqSchema];
---

<BaseLayout
  title="AI Product Marketing & GTM Strategy for AI Startups | Fintech24h"
  description="Go-to-market strategy and marketing execution for AI products and AI startups. Fintech24h positions AI products clearly, credibly, and distinctively in a crowded market."
  schema={combinedSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO (The Live Code Narrative) -->
  <section class="relative min-h-[100vh] flex flex-col justify-center pt-32 pb-20 px-4 overflow-hidden bg-[#05080C]">
    <!-- Cyber Grid Background & Falling Data -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#00c8f01a_1px,transparent_1px),linear-gradient(to_bottom,#00c8f01a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_50%,#000_80%,transparent_100%)] opacity-20"></div>
      <!-- Matrix-style falling code lines simulation -->
      <div class="absolute top-0 left-[10%] w-[1px] h-full bg-gradient-to-b from-transparent via-[var(--accent-cyan)] to-transparent opacity-30 animate-[matrix-fall_4s_linear_infinite]"></div>
      <div class="absolute top-0 left-[30%] w-[1px] h-full bg-gradient-to-b from-transparent via-[var(--accent-cyan)] to-transparent opacity-10 animate-[matrix-fall_6s_linear_infinite_1s]"></div>
      <div class="absolute top-0 right-[20%] w-[1px] h-full bg-gradient-to-b from-transparent via-[var(--accent-cyan)] to-transparent opacity-20 animate-[matrix-fall_5s_linear_infinite_2s]"></div>
    </div>

    <!-- HUD Elements -->
    <div class="absolute top-24 left-8 hidden lg:block font-mono text-[10px] text-[var(--accent-cyan)] opacity-60">
      <div class="mb-1 flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span> SYS.STATUS // ONLINE</div>
      <div class="mb-1">NODE.ID // 0x4F9...A1B</div>
      <div class="mb-1 text-[var(--text-secondary)] opacity-70">PROTOCOL // FINTECH24H_AI_V2</div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto w-full">
      <h1 class="sr-only">AI Marketing by Fintech24h</h1>
      
      <!-- The Massive Terminal Window -->
      <div class="w-full bg-[#030508] border border-[var(--accent-cyan)]/30 rounded-md overflow-hidden shadow-[0_0_50px_rgba(0,200,240,0.1)] reveal">
        <!-- Terminal Header -->
        <div class="bg-[#0A0F15] border-b border-[var(--accent-cyan)]/30 px-4 py-2 flex items-center justify-between">
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500/20 border border-red-500/50"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/20 border border-yellow-500/50"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/20 border border-green-500/50"></div>
          </div>
          <div class="font-mono text-[10px] text-[var(--accent-cyan)]/50 tracking-widest">root@fintech24h:~ /deploy_marketing.sh</div>
        </div>
        
        <!-- Terminal Body with Narrative -->
        <div class="p-6 md:p-10 font-mono text-sm md:text-base leading-relaxed text-[var(--text-secondary)]">
          <div class="typing-line text-[var(--accent-cyan)]" style="animation-delay: 0.1s, 0.1s">> INITIALIZING SYSTEM DIAGNOSTICS... [OK]</div>
          <div class="typing-line text-[var(--accent-cyan)]" style="animation-delay: 1.5s, 1.5s">> SCANNING MARKET CONDITIONS...</div>
          <div class="typing-line text-red-400" style="animation-delay: 3s, 3s">> [WARNING] 90% of "AI Marketing" is empty hype.</div>
          <div class="typing-line text-red-400" style="animation-delay: 4.5s, 4.5s">> [ERROR] Projects burning capital on ineffective engagement.</div>
          <div class="typing-line text-[var(--text-secondary)]" style="animation-delay: 6s, 6s">> COMPILING SOLUTION...</div>
          <div class="typing-line text-[var(--text-primary)] font-bold" style="animation-delay: 7.5s, 7.5s">> MOUNTING: Fintech24h AI Marketing Suite.</div>
          <div class="typing-line text-[var(--accent-cyan)]" style="animation-delay: 9s, 9s">> EXECUTING: Data-driven narratives & Targeted deployment.</div>
          <div class="typing-line text-green-400" style="animation-delay: 10.5s, 10.5s">> STATUS: System Ready for Dominance. <span class="animate-pulse">_</span></div>
        </div>
      </div>

      <div class="flex justify-center reveal reveal-delay-3 mt-12">
        <a href="/contact/" class="relative overflow-hidden font-mono text-sm uppercase tracking-widest font-bold text-[var(--text-primary)] border border-[var(--accent-cyan)]/40 bg-[var(--accent-cyan)]/10 backdrop-blur-xl px-10 py-5 rounded-2xl hover:bg-[var(--accent-cyan)]/20 hover:border-[var(--accent-cyan)] hover:shadow-[0_0_40px_rgba(0,200,240,0.4)] transition-all duration-500 group">
          <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]"></span>
          <span class="relative z-10 flex items-center gap-2 drop-shadow-[0_0_8px_rgba(0,200,240,0.8)]">
            [EXECUTE_STRATEGY]
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — SYSTEM MODULES (Advanced Neural Interfaces) -->
  <section class="py-24 bg-[#0A0F15] relative z-10 border-t border-[var(--accent-cyan)]/20">
    <div class="max-w-7xl mx-auto px-4 lg:px-8">
      <div class="mb-16 reveal flex items-center gap-4 border-b border-[var(--accent-cyan)]/30 pb-4">
        <div class="w-3 h-3 bg-[var(--accent-cyan)] animate-pulse"></div>
        <h2 class="font-mono text-2xl text-[var(--accent-cyan)] uppercase tracking-widest">ACTIVE_MODULES</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {[
          { id: 'MOD_01', title: 'Automated Moderation & Q&A', desc: 'Custom LLMs trained on your whitepaper and docs. They answer complex technical questions instantly in Discord/Telegram, resolving high-volume queries with extreme precision.', chart: 'M0,100 L20,80 L40,85 L60,40 L80,50 L100,10' },
          { id: 'MOD_02', title: 'Sentiment Scraping', desc: 'Real-time analysis of Twitter, Reddit, and Telegram. The AI assigns sentiment scores and flags potential FUD or viral trends before they fully materialize.', chart: 'M0,50 L20,40 L40,60 L60,20 L80,30 L100,5' },
          { id: 'MOD_03', title: 'Programmatic Content', desc: 'AI-assisted generation of localized social media posts, translation into 15+ languages, and automated distribution pipelines timed for optimal global engagement.', chart: 'M0,90 L20,70 L40,75 L60,30 L80,20 L100,0' },
          { id: 'MOD_04', title: 'Predictive Churn Analytics', desc: 'Analyzing on-chain wallet behavior combined with social engagement to predict which power users are at risk of leaving your ecosystem, triggering retention campaigns.', chart: 'M0,10 L20,30 L40,25 L60,80 L80,70 L100,90' }
        ].map((mod, i) => (
          <div class="bg-black/60 border border-[var(--accent-cyan)]/20 p-8 hover:border-[var(--accent-cyan)] transition-colors group relative reveal overflow-hidden" style={`transition-delay: ${i * 0.15}s`}>
            <!-- Scanning Line Effect on Hover -->
            <div class="absolute top-0 left-0 w-full h-[2px] bg-[var(--accent-cyan)] opacity-0 group-hover:opacity-100 group-hover:animate-[scan_2s_linear_infinite] shadow-[0_0_10px_var(--accent-cyan)]"></div>
            
            <div class="flex justify-between items-start mb-8">
              <span class="font-mono text-xs text-[var(--accent-cyan)] border border-[var(--accent-cyan)]/30 px-2 py-1 bg-[var(--accent-cyan)]/5">{mod.id}</span>
              <div class="w-8 h-8 opacity-20 group-hover:opacity-100 transition-opacity">
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-cyan)" stroke-width="1"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
            </div>
            
            <h3 class="font-display text-2xl text-[var(--text-primary)] font-bold mb-4 uppercase tracking-tight">{mod.title}</h3>
            <p class="font-mono text-sm text-[var(--text-secondary)] leading-relaxed mb-8">{mod.desc}</p>
            
            <!-- Neural Chart Visualization -->
            <div class="w-full h-16 border-t border-[var(--accent-cyan)]/10 pt-4 relative">
              <svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 100">
                <path d={mod.chart} fill="none" stroke="var(--accent-cyan)" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-dasharray="200" stroke-dashoffset="200" class="group-hover:animate-[draw_2s_ease-out_forwards]"></path>
                <path d={`${mod.chart} L100,100 L0,100 Z`} fill="var(--accent-cyan)" opacity="0" class="group-hover:opacity-10 transition-opacity duration-1000" />
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — PERFORMANCE COMPARISON (Command Line Data Table - NO PRICING) -->
  <section class="py-24 bg-[#05080C] relative z-10 border-t border-[var(--accent-cyan)]/20">
    <div class="max-w-5xl mx-auto px-4 lg:px-8">
      <div class="text-center mb-16 reveal">
        <h2 class="font-mono text-2xl text-[var(--text-primary)] uppercase tracking-widest border border-[var(--border-default)] inline-block px-6 py-2 bg-[var(--surface-soft)]">BENCHMARK_RESULTS</h2>
      </div>

      <div class="bg-[#030508] border border-[var(--accent-cyan)]/30 p-4 md:p-8 font-mono text-xs md:text-sm shadow-[0_0_30px_rgba(0,0,0,0.8)] reveal">
        <div class="flex border-b border-[var(--accent-cyan)]/50 pb-4 text-[var(--accent-cyan)] uppercase font-bold tracking-wider">
          <div class="w-2/5">METRIC_TYPE</div>
          <div class="w-1/5 text-center hidden sm:block opacity-50">HUMAN_STANDARD</div>
          <div class="w-full sm:w-2/5 text-right">FINTECH24H_AI</div>
        </div>
        
        {[
          { m: 'Avg Support Resolution', h: '3-5 Minutes', a: '< 5 Seconds' },
          { m: 'Crisis Detection', h: 'Reactive (Post-event)', a: 'Predictive (Pre-event)' },
          { m: 'Sentiment Tracking', h: 'Weekly Reports', a: 'Real-Time Streaming' },
          { m: 'Content Localization', h: '2-3 Locales', a: '15+ Native Translations' }
        ].map((row, i) => (
          <div class="flex border-b border-[var(--accent-cyan)]/10 py-5 hover:bg-[var(--accent-cyan)]/10 transition-colors group">
            <div class="w-2/5 text-[var(--text-primary)] group-hover:text-[var(--accent-cyan)] transition-colors">{row.m}</div>
            <div class="w-1/5 text-center text-[var(--text-muted)] line-through hidden sm:block">{row.h}</div>
            <div class="w-full sm:w-2/5 text-right text-[var(--accent-cyan)] font-bold">{row.a}</div>
          </div>
        ))}
        
        <div class="pt-6 text-[var(--accent-cyan)]/50 text-[10px]">
          > STATUS: All benchmarks exceeded. Processing capacity optimized.
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION (Query Database) -->
  <section class="py-24 bg-[#0A0F15] border-t border-[var(--accent-cyan)]/20">
    <div class="max-w-4xl mx-auto px-4 lg:px-8">
      <div class="mb-12 reveal border-b border-[var(--accent-cyan)]/30 pb-4">
        <h2 class="font-mono text-xl text-[var(--accent-cyan)]">C:\FAQ\query_database.exe</h2>
      </div>
      
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="group bg-[#030508] border border-[var(--accent-cyan)]/20 reveal hover:border-[var(--accent-cyan)]/60 transition-colors" style={`transition-delay: ${i * 0.1}s`}>
            <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-mono text-sm md:text-base text-[var(--text-primary)]">
              <span class="flex items-start gap-4">
                <span class="text-[var(--accent-cyan)] mt-1">></span>
                <span>{faq.q}</span>
              </span>
              <span class="text-[var(--accent-cyan)] group-open:rotate-90 transition-transform ml-4 shrink-0">]</span>
            </summary>
            <div class="p-6 pt-0 text-[var(--text-secondary)] font-mono text-sm leading-relaxed border-t border-[var(--accent-cyan)]/10 mt-2 bg-black/40">
              <span class="text-green-400 mr-2">RESPONSE:</span> {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION (Unified FooterLeadForm) -->
  <FooterLeadForm defaultService="AI Marketing" />

</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  
  /* Reveal Animations */
  .reveal { opacity: 0; transform: scale(0.98) translateY(10px); transition: opacity 0.5s ease, transform 0.5s ease; }
  .reveal.revealed { opacity: 1; transform: scale(1) translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  
  /* Typing Animation System */
  .typing-line {
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid transparent;
  }
  .revealed .typing-line {
    animation: 
      fade-in 0.1s forwards,
      typewriter 1.5s steps(40, end) forwards;
  }
  
  /* Background Matrix Effect */
  @keyframes matrix-fall {
    0% { transform: translateY(-100vh); }
    100% { transform: translateY(100vh); }
  }
  
  /* Scanner Effect */
  @keyframes scan {
    0% { transform: translateY(0); opacity: 0.5; }
    50% { opacity: 1; }
    100% { transform: translateY(300px); opacity: 0; }
  }
  
  /* Drawing SVGs */
  @keyframes draw { to { stroke-dashoffset: 0; } }
  
  @keyframes fade-in { to { opacity: 1; } }
  @keyframes typewriter {
    from { width: 0; }
    to { width: 100%; border-right-color: transparent; }
  }
  
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }

  @media (prefers-reduced-motion: reduce) { 
    .reveal { opacity: 1; transform: none; transition: none; } 
    .typing-line { opacity: 1; animation: none; width: auto; border: none; }
    .group-hover\:animate-\[draw_2s_ease-out_forwards\] { stroke-dashoffset: 0; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>
