---
// src/pages/services/ai-marketing.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import ServiceInquiryForm from '../../components/ui/ServiceInquiryForm.tsx';
import AnimatedCounter from '../../components/ui/AnimatedCounter.tsx';
import { services } from '../../data/services';

const service = services.find((s) => s.slug === 'ai-marketing')!;

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: service.title, item: `https://fintech24h.com/services/${service.slug}` }
];
---

<BaseLayout
  title={`${service.title} | Automated Web3 Marketing Solutions`}
  description={service.shortDescription}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- 1. Hero Section: Technical & Precision focus -->
  <section class="relative min-h-[90vh] flex flex-col justify-center pt-32 pb-20 px-4 overflow-hidden">
    <!-- Ambient Background: Tech style -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute w-[800px] h-[800px] rounded-full" style="background:radial-gradient(ellipse, rgba(0,200,240,0.12) 0%, transparent 60%); top:10%; right:-20%; filter:blur(60px);"></div>
      <div class="grid-pattern absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto w-full text-center">
      <div class="inline-flex items-center gap-2 mb-8 border border-[var(--accent-cyan)]/20 bg-[var(--bg-glass)] px-4 py-1.5 rounded-sm" data-hero-line>
        <span class="w-2 h-2 bg-[var(--accent-cyan)] animate-pulse"></span>
        <span class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.2em]">
          System_Status: Operational
        </span>
      </div>

      <h1 class="font-display font-bold max-w-5xl mx-auto" data-hero-line>
        <span class="block text-[clamp(2.5rem,5.5vw,5rem)] tracking-[-0.03em] leading-[1.05] text-[var(--text-primary)]">
          Intelligence at Scale.
        </span>
        <span class="block text-[clamp(2.5rem,5.5vw,5rem)] tracking-[-0.03em] leading-[1.05] bg-gradient-to-r from-[var(--accent-cyan)] via-[#a78bfa] to-[var(--text-primary)] bg-clip-text text-transparent pb-2">
          Zero Human Error.
        </span>
      </h1>

      <p class="font-body text-[clamp(1.1rem,2vw,1.35rem)] text-[var(--text-secondary)] max-w-2xl mx-auto mt-8 mb-12 leading-relaxed" data-hero-line>
        Deploy specialized AI agents to automate data scraping, run sentiment analysis, and moderate your community 24/7. Marketing powered by machine precision.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-4" data-hero-line>
        <a href="#book-call" class="btn-ghost border-[var(--accent-cyan)] text-[var(--accent-cyan)] hover:bg-[var(--accent-cyan)]/10 px-8 py-4 text-base font-mono uppercase tracking-widest">
          [ Initialize_Audit ]
        </a>
      </div>

      <!-- Hero Stats: Terminal Style -->
      <div class="mt-20 max-w-4xl mx-auto" data-animate="fade-up">
        <div class="grid grid-cols-3 divide-x divide-[#00c8f0]/20 bg-[#050810]/80 border border-[#00c8f0]/30 rounded-lg backdrop-blur-xl shadow-[0_0_30px_rgba(0,200,240,0.1)]">
          {service.metrics.map((m, i) => {
            const numStr = m.value.replace(/[^0-9.]/g, '');
            const suffix = m.value.replace(/[0-9.]/g, '');
            return (
              <div class="text-center px-4 py-8 md:px-8 relative overflow-hidden group">
                <div class="absolute inset-0 bg-[#00c8f0]/5 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
                <div class="font-mono text-3xl md:text-4xl font-bold text-[var(--accent-cyan)] mb-2 relative z-10">
                  <AnimatedCounter target={parseFloat(numStr)} suffix={suffix} duration={1.5 + (i * 0.2)} client:visible />
                </div>
                <div class="font-mono text-[10px] md:text-xs text-[var(--text-muted)] uppercase tracking-[0.2em] relative z-10">{m.label}</div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. AI Capabilities Section -->
  <section class="py-24 relative z-10 border-t border-white/[0.03]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-20" data-animate="fade-up">
        <div class="inline-flex items-center gap-2">
          <div class="w-6 h-px bg-[var(--accent-cyan)]"></div>
          <span class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.12em]">Capabilities</span>
          <div class="w-6 h-px bg-[var(--accent-cyan)]"></div>
        </div>
        <h2 class="font-display text-h2 font-bold text-[var(--text-primary)]">
          The <span class="bg-gradient-to-r from-[var(--accent-cyan)] to-[#60a5fa] bg-clip-text text-transparent">AI Tech Stack</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Card 1: Data Scraping -->
        <div class="card-default p-8 border-l-4 border-l-[var(--accent-cyan)] bg-[var(--bg-secondary)]" data-animate="scale-in">
          <div class="font-mono text-xs text-[var(--accent-cyan)] mb-4">Module 01 // Data_Acquisition</div>
          <h3 class="font-display text-2xl font-bold text-[var(--text-primary)] mb-4">Deep Data Scraping</h3>
          <p class="font-body text-[var(--text-secondary)] leading-relaxed mb-6">
            Our bots monitor Twitter, Discord, and Telegram across millions of endpoints. We aggregate competitor strategies, influencer mentions, and high-intent leads instantly.
          </p>
          <div class="bg-black/50 p-4 rounded-md border border-white/5 font-mono text-xs text-[#a78bfa] overflow-x-auto">
            > SELECT target_handles FROM social_graph<br/>
            > EXTRACT intent_signals WHERE sentiment > 0.8<br/>
            > EXECUTING... [2,401 LEADS FOUND]
          </div>
        </div>

        <!-- Card 2: Sentiment Analysis -->
        <div class="card-default p-8 border-l-4 border-l-[#a78bfa] bg-[var(--bg-secondary)]" data-animate="scale-in" style="--delay: 0.1s">
          <div class="font-mono text-xs text-[#a78bfa] mb-4">Module 02 // NLP_Processing</div>
          <h3 class="font-display text-2xl font-bold text-[var(--text-primary)] mb-4">Real-Time Sentiment Analysis</h3>
          <p class="font-body text-[var(--text-secondary)] leading-relaxed mb-6">
            Stop guessing how the community feels. Our NLP models analyze chat velocity, emotion markers, and FUD triggers to alert you before a crisis happens.
          </p>
          <ul class="space-y-3 font-mono text-sm text-[var(--text-secondary)]">
            <li class="flex items-center gap-2"><span class="text-green-400">●</span> Bullish Signals detected</li>
            <li class="flex items-center gap-2"><span class="text-yellow-400">●</span> Neutral/Inquiries tracked</li>
            <li class="flex items-center gap-2"><span class="text-red-400">●</span> FUD Risk isolated & flagged</li>
          </ul>
        </div>

        <!-- Card 3: Auto Moderation -->
        <div class="card-default p-8 md:col-span-2 border-[var(--accent-cyan)]/20 bg-gradient-to-br from-[var(--accent-cyan)]/5 to-[var(--accent-purple)]/5" data-animate="scale-in" style="--delay: 0.2s">
          <div class="flex flex-col md:flex-row gap-8 items-center">
            <div class="flex-1">
              <div class="font-mono text-xs text-[var(--text-muted)] mb-4">Module 03 // Autonomous_Action</div>
              <h3 class="font-display text-3xl font-bold text-[var(--text-primary)] mb-4">Context-Aware Moderation Bots</h3>
              <p class="font-body text-[var(--text-secondary)] text-lg leading-relaxed mb-6">
                Replace generic FAQ bots with LLM-powered agents that understand context. They ban scammers, explain complex tokenomics, and guide users to your dApp with human-like precision 24/7.
              </p>
            </div>
            <div class="flex-1 w-full bg-[#050810] p-6 rounded-lg border border-[var(--accent-cyan)]/30 shadow-[0_0_20px_rgba(0,200,240,0.1)] relative">
              <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[var(--accent-cyan)] to-transparent"></div>
              <div class="space-y-4">
                <div class="flex gap-3">
                  <div class="w-6 h-6 rounded-full bg-white/10 flex-shrink-0"></div>
                  <div class="bg-white/5 p-3 rounded-r-xl rounded-bl-xl text-sm font-body text-white/80">How does the staking APR calculation work?</div>
                </div>
                <div class="flex gap-3 flex-row-reverse">
                  <div class="w-6 h-6 rounded-full bg-[var(--accent-cyan)]/20 border border-[var(--accent-cyan)] flex-shrink-0 flex items-center justify-center">
                    <svg class="w-3 h-3 text-[var(--accent-cyan)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path><path d="M5 10h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z"></path></svg>
                  </div>
                  <div class="bg-[var(--accent-cyan)]/10 p-3 rounded-l-xl rounded-br-xl text-sm font-body text-white/90 border border-[var(--accent-cyan)]/20">
                    The APR is dynamically calculated based on total locked value and the current epoch rewards pool. You can view the live formula in our <a href="#" class="text-[var(--accent-cyan)] underline">Docs</a>.
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Inquiry Form Section (Đã thay thế Calendly) -->
  <section id="book-call" class="py-24 relative">
    <div class="max-w-3xl mx-auto px-4">
      <div class="p-8 lg:p-12 rounded-[24px] border border-[#ff5e62]/20 bg-gradient-to-br from-[rgba(255,94,98,0.05)] via-transparent to-transparent shadow-[0_15px_35px_rgba(255,94,98,0.06)] relative overflow-hidden">
        <div class="absolute inset-0 bg-radial-gradient(circle, rgba(255,94,98,0.05) 0%, transparent 70%) pointer-events-none"></div>
        <div class="text-center max-w-2xl mx-auto mb-10 relative z-10">
          <h2 class="font-display text-3xl font-bold text-[var(--text-primary)] mb-4">
            Thiết lập hệ thống AI Marketing
          </h2>
          <p class="text-sm text-[var(--text-secondary)] font-body">
            Điền thông tin dự án, đội ngũ kỹ thuật của Fintech24h sẽ lên phương án tự động hóa và demo luồng tiếp cận gửi bạn trong vòng 24h.
          </p>
        </div>
        <div class="relative z-10">
          <ServiceInquiryForm client:load defaultService={service.title} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    
    const heroLines = document.querySelectorAll('[data-hero-line]');
    if (heroLines.length) {
      gsap.fromTo(heroLines,
        { opacity: 0, y: 15 },
        { opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power2.out', delay: 0.1 }
      );
    }
  });
</script>
