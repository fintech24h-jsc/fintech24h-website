---
// src/pages/services/ai-marketing.astro
//
// Positioning: using AI to OPERATE marketing for crypto, blockchain, Web3,
// fintech and AI startups, always with human oversight. This page is NOT the
// AI SEO / GEO service (getting cited by ChatGPT, Perplexity...), which will
// live on its own page at /services/ai-seo-geo/.
//
// Content rules for this page: no unverified numbers, no outcome promises,
// no em-dash in visible copy, no model version numbers. All copy, FAQ and
// JSON-LD are rendered in the static HTML so crawlers that do not run JS
// (GPTBot, ClaudeBot, PerplexityBot) see everything.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FooterLeadForm from '../../components/sections/FooterLeadForm.astro';

// Flip to `true` ONLY once /services/ai-seo-geo/ is published (returns 200).
// While false, the block below is not rendered at all, so no link to a 404
// page ever reaches the HTML.
const SHOW_AI_SEO_GEO_LINK = false;

const PAGE_URL = 'https://fintech24h.com/services/ai-marketing/';
const META_DESCRIPTION =
  'Crypto AI marketing for blockchain, Web3 and AI startups: human-supervised community bots, sentiment monitoring and multilingual content, clear reporting.';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services/' },
  { name: 'AI Marketing', item: PAGE_URL }
];

const linkClass =
  'text-[var(--accent-cyan)] underline decoration-[color-mix(in_srgb,var(--accent-cyan)_40%,transparent)] underline-offset-4 hover:decoration-[var(--accent-cyan)] transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)] rounded-sm';

const problems = [
  {
    label: 'No source',
    title: 'Bots that guess.',
    body: 'An unsupervised bot answers even when it does not know. In crypto, one wrong answer about a contract or a launch date can cost users money and cost you their trust.'
  },
  {
    label: 'No owner',
    title: 'Tools nobody watches.',
    body: 'A sentiment dashboard that nobody reads is not monitoring. An alert only matters when a person checks it and decides what to do.'
  },
  {
    label: 'No report',
    title: 'Claims nobody can check.',
    body: '"AI-powered" in a pitch deck means little if you cannot see what the AI actually did last week.'
  }
];

const modules = [
  {
    id: '01',
    title: 'AI Community Support',
    channels: 'Telegram · Discord',
    ai: 'An AI assistant set up on your docs, whitepaper and FAQ. It answers common questions, points users to official resources and filters obvious spam. Every reply is clearly labeled as AI.',
    human: 'Complex, sensitive or account-specific questions go to a real moderator. Contract addresses and official links come only from a list your project approves.'
  },
  {
    id: '02',
    title: 'Sentiment & Narrative Monitoring',
    channels: 'X · Telegram · Reddit · Discord',
    ai: 'Tracks public conversation about your project and flags early signs of FUD, misinformation and issues that keep coming up.',
    human: 'Our team checks each alert against the facts before recommending a response. You get context, not just a red flag.'
  },
  {
    id: '03',
    title: 'Multilingual Content Engine',
    channels: 'Posts · Announcements · Updates',
    ai: 'Drafts and localizes social posts, announcements and community updates. The languages covered depend on your markets and are agreed in the project scope.',
    human: 'An editor reviews every piece for accuracy, tone and local context before it is published.'
  },
  {
    id: '04',
    title: 'Retention Signal Analysis',
    channels: 'On-chain activity · Community engagement',
    ai: 'Reads signals from on-chain activity and community engagement to find user groups that may need attention, for example active members who have gone quiet.',
    human: 'Scope depends on your project and the data available. Our team turns the findings into re-engagement ideas that you approve before anything runs.'
  }
];

const safeguards = [
  {
    key: 'review',
    title: 'Human review before anything sensitive goes out',
    body: 'Public posts, announcements and replies on sensitive topics are checked by a person first.'
  },
  {
    key: 'sources',
    title: 'Approved sources only',
    body: 'The AI works from material your project confirms: docs, official links and announcements. Not from guesses or random pages on the web.'
  },
  {
    key: 'changelog',
    title: 'A change log you can read',
    body: 'Every change to prompts, sources or the approved link list is recorded, with who made it and when.'
  },
  {
    key: 'reporting',
    title: 'Regular reporting',
    body: 'You see what the AI handled, what it passed to the team and what we adjusted.'
  }
];

const steps = [
  { n: '01', title: 'Scope & data sources', body: 'We agree on goals, channels, languages and the sources the AI is allowed to use.' },
  { n: '02', title: 'Setup & training on your docs', body: 'We configure the tools on your approved docs, tone of voice and escalation rules.' },
  { n: '03', title: 'Supervised launch', body: 'The AI goes live with our team reviewing its work closely while it settles in.' },
  { n: '04', title: 'Weekly reporting & tuning', body: 'Each week you get a report, and we adjust prompts, sources and rules based on what we see.' }
];

const faqs = [
  {
    q: 'What is crypto AI marketing?',
    a: 'Crypto AI marketing is the use of AI tools to run day-to-day marketing work for crypto, blockchain and Web3 projects, such as community support, sentiment monitoring and content localization. At Fintech24h, every AI workflow has a defined scope, uses only sources the project approves, and is supervised by our team.'
  },
  {
    q: 'Is this the same as AI SEO or GEO?',
    a: 'No. This service uses AI to operate your marketing: community support, monitoring and content. AI SEO, also called GEO (generative engine optimization), helps your project get mentioned by AI search tools such as ChatGPT and Perplexity. That is a separate service.'
  },
  {
    q: 'Do you build custom AI models?',
    a: "We don't build models from scratch. We select current leading models (for example from OpenAI, Anthropic, Google and Meta) per task and adapt them to your docs, tone and approved sources."
  },
  {
    q: 'Will the community know they are talking to an AI?',
    a: 'Yes. Every reply from the assistant is clearly labeled as AI. A community trusts a bot more when it knows what it is talking to, and when there is a clear way to reach a real person.'
  },
  {
    q: 'Can the AI share contract addresses and official links?',
    a: 'Only from an approved list. The assistant shares contract addresses and official links taken from a source list that your project confirms and the Fintech24h team reviews. It never generates an address on its own, and any change to that list must be approved by a person before it goes live. This protects your community from phishing and fake links.'
  },
  {
    q: 'How does sentiment monitoring work?',
    a: 'The AI follows public conversation about your project on X, Telegram, Reddit and Discord and flags unusual shifts, such as a wave of complaints, rumors or misinformation. Our team checks each alert against the facts before recommending a response, so you act on verified signals, not noise.'
  },
  {
    q: 'Can AI completely replace human moderators?',
    a: `No. AI handles repetitive work, such as answering common questions and filtering spam. People handle disputes, sensitive conversations and the relationships that hold a community together. Our <a href="/services/community-growth/" class="${linkClass}">community growth and management</a> team works alongside the assistant.`
  },
  {
    q: 'Do you adapt AI marketing for Singapore and Southeast Asia?',
    a: `Yes. Content and tone are set separately for each market. <a href="/blockchain-marketing-agency-singapore/" class="${linkClass}">Singapore</a> has a more institutional audience, while retail communities in Indonesia and Thailand need local language and a different tone.`
  },
  {
    q: 'Does AI marketing work for Dubai and the UAE?',
    a: `Yes. <a href="/blockchain-marketing-agency-dubai/" class="${linkClass}">Dubai</a> moves fast, so we set content cadence and monitoring to match it, with the same human review in place.`
  },
  {
    q: 'Do you run AI marketing for Vietnamese audiences?',
    a: `Yes. Our team is based in Ho Chi Minh City, so Vietnamese content is reviewed by native speakers before it goes out. See our <a href="/blockchain-marketing-agency-vietnam/" class="${linkClass}">blockchain marketing agency in Vietnam</a> page.`
  }
];

const stripTags = (html: string) => html.replace(/<[^>]+>/g, '');

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Crypto & Blockchain AI Marketing',
  alternateName: ['Blockchain AI Marketing', 'Crypto AI Marketing', 'AI Marketing for Web3'],
  serviceType: 'AI marketing',
  url: PAGE_URL,
  description: META_DESCRIPTION,
  provider: {
    // Same entity, values copied from the site-wide Organization in BaseLayout.
    '@type': 'Organization',
    '@id': 'https://fintech24h.com/#organization',
    name: 'Fintech24h',
    url: 'https://fintech24h.com',
    logo: 'https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp',
    sameAs: [
      'https://www.linkedin.com/company/fintech24h/',
      'https://www.facebook.com/fintech24hnews',
      'https://x.com/fintech24h_com',
      'https://t.me/fintech24h',
      'https://medium.com/@fintech24h',
      'https://www.instagram.com/fintech24h/'
    ]
  },
  // Same markets as the Organization contactPoint (VN, SG, AE, ID, TH, IN).
  areaServed: [
    { '@type': 'Country', name: 'Vietnam' },
    { '@type': 'Country', name: 'Singapore' },
    { '@type': 'Country', name: 'United Arab Emirates' },
    { '@type': 'Country', name: 'Indonesia' },
    { '@type': 'Country', name: 'Thailand' },
    { '@type': 'Country', name: 'India' }
  ]
};

// Built from the same `faqs` array that renders on the page, so the schema
// can never contain a question that is not visible.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(faq.a) }
  }))
};

const combinedSchema = [serviceSchema, faqSchema];

// Decorative terminal (aria-hidden). Kept short so lines fit at 375px.
const terminalLines = [
  { text: '> load sources --approved-only  [OK]', tone: 'text-[var(--accent-cyan)]' },
  { text: '> index: docs, whitepaper, FAQ  [OK]', tone: 'text-[var(--accent-cyan)]' },
  { text: '> label replies: "AI assistant" [OK]', tone: 'text-[var(--accent-cyan)]' },
  { text: '> sensitive question -> human team', tone: 'text-[var(--text-primary)]' },
  { text: '> watch: X, Telegram, Reddit, Discord', tone: 'text-[var(--text-secondary)]' },
  { text: '> mode: supervised | report: weekly', tone: 'text-green-400' }
];
---

<BaseLayout
  title="Crypto & Blockchain AI Marketing Agency | Fintech24h"
  description={META_DESCRIPTION}
  ogImage="https://fintech24h.com/og-ai-marketing.png"
  schema={combinedSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1: HERO -->
  <section class="relative min-h-[90vh] flex flex-col justify-center pt-32 pb-20 px-4 overflow-hidden bg-[var(--bg-primary)]">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#00c8f01a_1px,transparent_1px),linear-gradient(to_bottom,#00c8f01a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_50%,#000_80%,transparent_100%)] opacity-20"></div>
      <div class="matrix-line absolute top-0 left-[10%] w-[1px] h-full bg-gradient-to-b from-transparent via-[var(--accent-cyan)] to-transparent opacity-30 animate-[matrix-fall_4s_linear_infinite]"></div>
      <div class="matrix-line absolute top-0 left-[30%] w-[1px] h-full bg-gradient-to-b from-transparent via-[var(--accent-cyan)] to-transparent opacity-10 animate-[matrix-fall_6s_linear_infinite_1s]"></div>
      <div class="matrix-line absolute top-0 right-[20%] w-[1px] h-full bg-gradient-to-b from-transparent via-[var(--accent-cyan)] to-transparent opacity-20 animate-[matrix-fall_5s_linear_infinite_2s]"></div>
    </div>

    <div class="absolute top-24 left-8 hidden xl:block font-mono text-[10px] text-[var(--accent-cyan)] opacity-60" aria-hidden="true">
      <div class="mb-1 flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span> SYS.STATUS // SUPERVISED</div>
      <div class="mb-1">NODE.ID // 0x4F9...A1B</div>
      <div class="mb-1 text-[var(--text-secondary)] opacity-70">PROTOCOL // HUMAN_IN_THE_LOOP</div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto w-full grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-14 items-center">
      <div>
        <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[color-mix(in_srgb,var(--accent-cyan)_25%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_6%,transparent)] text-[var(--accent-cyan)] text-xs font-mono font-medium tracking-widest uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]" aria-hidden="true"></span>
          AI Marketing · Human oversight
        </p>
        <h1 class="mt-6 font-display text-h1 font-bold text-[var(--text-primary)]">
          Crypto &amp; Blockchain
          <span class="block bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)] bg-clip-text text-transparent">AI Marketing Agency</span>
        </h1>
        <p class="mt-5 font-display text-lg md:text-xl text-[var(--text-primary)] max-w-xl leading-snug">
          For Web3, fintech and AI startups that want AI with clear scope and human oversight.
        </p>
        <p class="mt-5 font-body text-base text-[var(--text-secondary)] max-w-xl leading-relaxed">
          Fintech24h is a blockchain AI marketing agency for crypto, Web3, fintech and AI projects. Our crypto AI marketing work covers community support, sentiment monitoring and multilingual content, with a person reviewing what matters before it goes out. Every project gets a clear scope, approved data sources and a report you can read.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/contact/" class="relative overflow-hidden font-mono text-sm uppercase tracking-widest font-bold text-[var(--text-primary)] border border-[color-mix(in_srgb,var(--accent-cyan)_40%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_10%,transparent)] backdrop-blur-xl px-8 py-4 rounded-2xl hover:bg-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] hover:border-[var(--accent-cyan)] hover:shadow-[0_0_40px_rgba(0,200,240,0.4)] transition-all duration-300 group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]">
            <span class="shimmer absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]" aria-hidden="true"></span>
            <span class="relative z-10">Talk to our team</span>
          </a>
          <a href="#how-we-work" class="font-mono text-sm text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)] rounded-sm">
            See how we work →
          </a>
        </div>
      </div>

      <!-- Decorative terminal. Real content is the text column on the left. -->
      <div class="w-full bg-[#030508] border border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] rounded-md overflow-hidden shadow-[0_0_50px_rgba(0,200,240,0.1)] reveal" data-theme-surface="midnight" aria-hidden="true">
        <div class="bg-[#0A0F15] border-b border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] px-4 py-2 flex items-center justify-between">
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500/20 border border-red-500/50"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/20 border border-yellow-500/50"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/20 border border-green-500/50"></div>
          </div>
          <div class="font-mono text-[10px] text-[var(--accent-cyan)] tracking-widest">root@fintech24h:~ /supervised_ai.sh</div>
        </div>
        <div class="p-5 md:p-8 font-mono text-xs sm:text-sm leading-relaxed">
          {terminalLines.map((line, i) => (
            <div class={`typing-line ${line.tone}`} style={`animation-delay: ${0.2 + i * 0.7}s, ${0.2 + i * 0.7}s`}>{line.text}</div>
          ))}
          <span class="cursor text-[var(--accent-cyan)] animate-pulse">_</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: THE PROBLEM -->
  <section class="py-24 md:py-28 bg-[var(--bg-secondary)] relative z-10 border-t border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)]">
    <div class="max-w-6xl mx-auto px-4 lg:px-8 grid lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-20">
      <div>
        <p class="font-mono text-xs tracking-widest uppercase text-[var(--accent-cyan)]">The hard truth</p>
        <h2 class="mt-4 font-display text-h2 font-bold text-[var(--text-primary)]">
          Every project talks about AI. Few can show what it does.
        </h2>
        <p class="mt-5 font-body text-base text-[var(--text-secondary)] leading-relaxed max-w-md">
          The projects that earn trust use AI with a clear job, a person in charge and a report anyone on the team can read.
        </p>
      </div>
      <ol class="divide-y divide-[var(--border-default)] border-y border-[var(--border-default)]">
        {problems.map((p) => (
          <li class="py-6 grid sm:grid-cols-[8rem_1fr] gap-2 sm:gap-6">
            <span class="font-mono text-xs uppercase tracking-widest text-[var(--text-muted)] pt-1">{p.label}</span>
            <div>
              <p class="font-display text-lg font-bold text-[var(--text-primary)]">{p.title}</p>
              <p class="mt-1 font-body text-base text-[var(--text-secondary)] leading-relaxed">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SECTION 3: SERVICE MODULES -->
  <section class="py-24 md:py-32 bg-[var(--bg-primary)] relative z-10 border-t border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)]">
    <div class="max-w-6xl mx-auto px-4 lg:px-8">
      <div class="max-w-3xl">
        <p class="font-mono text-xs tracking-widest uppercase text-[var(--accent-cyan)] flex items-center gap-3">
          <span class="w-2.5 h-2.5 bg-[var(--accent-cyan)]" aria-hidden="true"></span> Service modules
        </p>
        <h2 class="mt-4 font-display text-h2 font-bold text-[var(--text-primary)]">
          Blockchain AI marketing with human oversight
        </h2>
        <p class="mt-5 font-body text-base text-[var(--text-secondary)] leading-relaxed">
          Four modules. You can start with one. Each has a clear job, a defined data source and a person responsible for it.
        </p>
      </div>

      <div class="mt-14 border-t border-[color-mix(in_srgb,var(--accent-cyan)_25%,transparent)]">
        {modules.map((mod) => (
          <article class="module-row group grid lg:grid-cols-[5rem_1fr_1.35fr] gap-4 lg:gap-10 py-10 border-b border-[var(--border-default)]">
            <span class="font-mono text-3xl lg:text-4xl font-medium text-[color-mix(in_srgb,var(--accent-cyan)_55%,transparent)] group-hover:text-[var(--accent-cyan)] transition-colors duration-300" aria-hidden="true">{mod.id}</span>
            <div>
              <h3 class="font-display text-h3 font-bold text-[var(--text-primary)]">{mod.title}</h3>
              <p class="mt-2 font-mono text-xs uppercase tracking-widest text-[var(--text-muted)]">{mod.channels}</p>
            </div>
            <div class="space-y-4">
              <p class="font-body text-base text-[var(--text-secondary)] leading-relaxed">{mod.ai}</p>
              <p class="font-body text-base text-[var(--text-primary)] leading-relaxed border-l-2 border-[var(--accent-purple)] pl-4">
                <span class="block font-mono text-xs uppercase tracking-widest text-[var(--accent-purple)] mb-1">Human checkpoint</span>
                {mod.human}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4: ACCOUNTABILITY (replaces the old benchmark table; no numbers) -->
  <section class="py-24 md:py-28 bg-[var(--bg-secondary)] relative z-10 border-t border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)]">
    <div class="max-w-5xl mx-auto px-4 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="font-display text-h2 font-bold text-[var(--text-primary)]">How we keep AI accountable</h2>
        <p class="mt-4 font-body text-base text-[var(--text-secondary)] leading-relaxed">
          Four rules apply to every project, whatever the scope.
        </p>
      </div>

      <div class="mt-12 bg-[#030508] border border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] rounded-md p-5 md:p-8 shadow-[0_0_30px_rgba(0,0,0,0.5)]" data-theme-surface="midnight">
        <ul class="divide-y divide-[color-mix(in_srgb,var(--accent-cyan)_12%,transparent)]">
          {safeguards.map((s) => (
            <li class="py-5 grid md:grid-cols-[9rem_1fr] gap-2 md:gap-6">
              <span class="font-mono text-xs md:text-sm text-[var(--accent-cyan)] pt-0.5">[{s.key}]</span>
              <div>
                <p class="font-display text-lg font-bold text-[var(--text-primary)]">{s.title}</p>
                <p class="mt-1 font-body text-base text-[var(--text-secondary)] leading-relaxed">{s.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <p class="mt-10 text-center font-body text-base text-[var(--text-secondary)] max-w-2xl mx-auto leading-relaxed">
        AI supports the work. It does not replace the people behind it. Most projects pair this service with our <a href="/services/community-growth/" class={linkClass}>community growth and management</a> team or our <a href="/services/pr-media/" class={linkClass}>PR &amp; media</a> work.
      </p>
    </div>
  </section>

  <!-- SECTION 5: PROCESS -->
  <section id="how-we-work" class="py-24 md:py-28 bg-[var(--bg-primary)] relative z-10 border-t border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 lg:px-8">
      <h2 class="font-display text-h2 font-bold text-[var(--text-primary)]">How we work</h2>
      <ol class="mt-12 grid md:grid-cols-4 gap-8 md:gap-6 relative">
        {steps.map((s) => (
          <li class="relative pl-6 md:pl-0 md:pt-8 border-l md:border-l-0 md:border-t border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)]">
            <span class="absolute -left-[5px] top-1 md:left-0 md:-top-[5px] w-2.5 h-2.5 rounded-full bg-[var(--accent-cyan)]" aria-hidden="true"></span>
            <span class="font-mono text-xs text-[var(--accent-cyan)] tracking-widest">STEP {s.n}</span>
            <h3 class="mt-2 font-display text-lg font-bold text-[var(--text-primary)]">{s.title}</h3>
            <p class="mt-2 font-body text-base text-[var(--text-secondary)] leading-relaxed">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SECTION 6: MARKETS -->
  <section class="py-20 bg-[var(--bg-secondary)] relative z-10 border-t border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)]">
    <div class="max-w-4xl mx-auto px-4 lg:px-8 text-center">
      <h2 class="font-display text-h2 font-bold text-[var(--text-primary)]">Where we work</h2>
      <p class="mt-5 font-body text-base text-[var(--text-secondary)] leading-relaxed">
        Our team is based in Ho Chi Minh City and works with projects across Southeast Asia, the Middle East and beyond. Each market gets its own language, tone and channels. For market-specific approaches, see our pages for <a href="/blockchain-marketing-agency-vietnam/" class={linkClass}>Vietnam</a>, <a href="/blockchain-marketing-agency-singapore/" class={linkClass}>Singapore</a> and <a href="/blockchain-marketing-agency-dubai/" class={linkClass}>Dubai</a>.
      </p>
    </div>
  </section>

  <!-- SECTION 7: FAQ (answers are in the static HTML via <details>) -->
  <section class="py-24 bg-[var(--bg-primary)] border-t border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)]">
    <div class="max-w-4xl mx-auto px-4 lg:px-8">
      <div class="mb-10 border-b border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] pb-4">
        <p class="font-mono text-xs tracking-widest uppercase text-[var(--accent-cyan)]">FAQ</p>
        <h2 class="mt-3 font-display text-h2 font-bold text-[var(--text-primary)]">Questions founders ask us</h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-[#030508] border border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] rounded-md hover:border-[color-mix(in_srgb,var(--accent-cyan)_60%,transparent)] transition-colors duration-300" data-theme-surface="midnight">
            <summary class="flex justify-between items-center gap-4 p-5 md:p-6 cursor-pointer list-none font-display text-base md:text-lg font-medium text-[var(--text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)] rounded-md">
              <h3 class="faq-q flex items-start gap-4">
                <span class="font-mono text-[var(--accent-cyan)]" aria-hidden="true">&gt;</span>
                <span>{faq.q}</span>
              </h3>
              <span class="font-mono text-[var(--accent-cyan)] group-open:rotate-90 transition-transform duration-200 shrink-0" aria-hidden="true">]</span>
            </summary>
            <div class="px-5 md:px-6 pb-6 pt-4 font-body text-base text-[var(--text-secondary)] leading-relaxed border-t border-[color-mix(in_srgb,var(--accent-cyan)_10%,transparent)]">
              <p set:html={faq.a} />
            </div>
          </details>
        ))}
      </div>

      {SHOW_AI_SEO_GEO_LINK && (
        <aside class="mt-10 p-6 border border-[var(--border-default)] rounded-md bg-[var(--surface-soft)]">
          <p class="font-body text-base text-[var(--text-secondary)] leading-relaxed">
            Want your project to be mentioned by ChatGPT, Perplexity and other AI search tools? That is a different job. See our <a href="/services/ai-seo-geo/" class={linkClass}>AI SEO &amp; GEO service</a>.
          </p>
        </aside>
      )}
    </div>
  </section>

  <!-- CTA SECTION (Unified FooterLeadForm, unchanged) -->
  <FooterLeadForm defaultService="AI Marketing" />

</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  .faq-q { font: inherit; margin: 0; }

  /* Entrance: only the hero terminal uses it. Content is hidden only when JS
     can run AND motion is allowed, so no-JS readers always see everything. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .reveal { opacity: 0; transform: scale(0.98) translateY(10px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal.revealed { opacity: 1; transform: scale(1) translateY(0); }

    .typing-line { opacity: 0; overflow: hidden; white-space: nowrap; }
    .revealed .typing-line {
      animation:
        fade-in 0.1s forwards,
        typewriter 1.2s steps(36, end) forwards;
    }
  }

  .typing-line { white-space: nowrap; overflow: hidden; text-overflow: clip; }

  @keyframes matrix-fall {
    0% { transform: translateY(-100vh); }
    100% { transform: translateY(100vh); }
  }
  @keyframes fade-in { to { opacity: 1; } }
  @keyframes typewriter {
    from { width: 0; }
    to { width: 100%; }
  }
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .matrix-line, .shimmer, .cursor, .animate-pulse { animation: none !important; }
    .typing-line { opacity: 1; width: auto; }
  }
</style>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  }
</script>
