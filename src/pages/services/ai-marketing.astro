---
// src/pages/services/ai-marketing.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FooterLeadForm from '../../components/sections/FooterLeadForm.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: 'AI Marketing', item: 'https://fintech24h.com/services/ai-marketing' }
];

const faqs = [
  {
    q: "Do you build custom AI models?",
    a: "We don't build LLMs from scratch. We fine-tune existing top-tier models (GPT-4, Claude 3, Llama) on your specific project documentation, tone of voice, and historical data to create specialized agents for moderation and content."
  },
  {
    q: "Will the community know they are talking to an AI?",
    a: "We advocate for transparency. The best AI integrations are clearly labeled as AI assistants but are so useful that the community prefers talking to them for instant, accurate technical answers."
  },
  {
    q: "How does AI handle sentiment analysis?",
    a: "Our bots continuously scrape Telegram, Discord, and Twitter, assigning sentiment scores (-1 to +1) to keywords and topics. If negative sentiment spikes around a specific feature, you get an automated alert before it becomes a crisis."
  },
  {
    q: "Can AI completely replace human moderators?",
    a: "No. AI replaces the repetitive, low-value work (answering 'wen token', filtering spam, providing contract addresses). Humans are still required for complex dispute resolution and genuine community relationship building."
  }
];
---

<BaseLayout
  title="AI-Powered Marketing & Automation | Fintech24h"
  description="Deploy custom AI solutions to supercharge your marketing operations. From sentiment analysis to automated content pipelines, we scale your signal."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO (Cyber HUD / Terminal) -->
  <section class="relative min-h-[100vh] flex flex-col justify-center pt-32 pb-20 px-4 overflow-hidden bg-[#0A0F15]">
    <!-- Cyber Grid Background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#00c8f01a_1px,transparent_1px),linear-gradient(to_bottom,#00c8f01a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_50%,#000_70%,transparent_100%)] opacity-30"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[var(--accent-cyan)] opacity-[0.05] blur-[100px] rounded-full"></div>
    </div>

    <!-- HUD Elements -->
    <div class="absolute top-24 left-8 hidden lg:block font-mono text-[10px] text-[var(--accent-cyan)] opacity-50">
      <div class="mb-1">SYS.STATUS // ONLINE</div>
      <div class="mb-1">NODE.ID // 0x4F9...A1B</div>
      <div class="mb-1">SYNC // 99.9%</div>
    </div>
    
    <div class="absolute bottom-12 right-8 hidden lg:block font-mono text-[10px] text-[var(--accent-cyan)] opacity-50 text-right">
      <div class="flex gap-1 mb-1 justify-end">
        <span class="w-2 h-4 bg-[var(--accent-cyan)] opacity-20"></span>
        <span class="w-2 h-4 bg-[var(--accent-cyan)] opacity-50"></span>
        <span class="w-2 h-4 bg-[var(--accent-cyan)] opacity-100"></span>
        <span class="w-2 h-4 bg-[var(--accent-cyan)] opacity-100 animate-pulse"></span>
      </div>
      <div>DATA.STREAM // ACTIVE</div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto w-full text-center">
      <div class="inline-block mb-8 reveal">
        <div class="relative px-6 py-2 border border-[var(--accent-cyan)]/30 bg-[#00c8f00a] text-[var(--accent-cyan)] font-mono text-xs uppercase tracking-widest overflow-hidden group">
          <div class="absolute top-0 left-0 w-full h-[1px] bg-[var(--accent-cyan)] opacity-50 transform -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
          AI MARKETING & AUTOMATION
          <div class="absolute bottom-0 right-0 w-2 h-2 border-r border-b border-[var(--accent-cyan)]"></div>
          <div class="absolute top-0 left-0 w-2 h-2 border-l border-t border-[var(--accent-cyan)]"></div>
        </div>
      </div>

      <h1 class="font-display font-bold max-w-4xl mx-auto reveal reveal-delay-1 relative">
        <span class="block text-[clamp(2.5rem,6vw,5rem)] tracking-tight text-white mb-2 leading-none" style="text-shadow: 0 0 20px rgba(255,255,255,0.1);">
          Automate the Noise.
        </span>
        <span class="block text-[clamp(2.5rem,6vw,5rem)] tracking-tight text-[var(--accent-cyan)] relative inline-block group">
          Scale the Signal.
          <!-- Glitch Effect Layer -->
          <span class="absolute top-0 left-0 w-full h-full text-[var(--accent-cyan)] opacity-0 group-hover:opacity-100 animate-[glitch_0.2s_linear_infinite] pointer-events-none mix-blend-screen" style="clip-path: polygon(0 0, 100% 0, 100% 45%, 0 45%); transform: translate(-2px, 2px);">Scale the Signal.</span>
        </span>
      </h1>

      <div class="font-mono text-sm text-[var(--text-secondary)] max-w-3xl mx-auto mt-12 mb-12 leading-relaxed reveal reveal-delay-2 p-6 border border-white/10 bg-black/40 text-left relative">
        <div class="absolute -top-3 -left-3 text-[var(--accent-cyan)]/30 text-2xl">┌</div>
        <div class="absolute -bottom-3 -right-3 text-[var(--accent-cyan)]/30 text-2xl">┘</div>
        <div class="overflow-hidden whitespace-normal border-r-2 border-[var(--accent-cyan)] pr-2 animate-[typing_2s_steps(40,end),blink-caret_1s_step-end_infinite]">
          > Every startup claims AI. Projects that win trust communicate what their AI actually does, clearly and without hype. We integrate custom AI solutions to supercharge your marketing operations.
        </div>
      </div>

      <div class="flex justify-center reveal reveal-delay-3 mt-8">
        <a href="#book-call" class="relative overflow-hidden font-mono text-sm uppercase tracking-widest font-bold text-black bg-[var(--accent-cyan)] px-8 py-4 hover:shadow-[0_0_30px_var(--accent-cyan)] transition-all duration-300 group">
          <span class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></span>
          <span class="relative z-10 flex items-center gap-2">
            [DEPLOY_AI_MARKETING]
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — THE DASHBOARD (Simulated Data) -->
  <section class="py-24 bg-[#05080C] relative z-10 border-t border-[var(--accent-cyan)]/20">
    <div class="max-w-7xl mx-auto px-4 lg:px-8">
      <div class="mb-16 reveal flex items-center gap-4 border-b border-white/10 pb-4">
        <div class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>
        <h2 class="font-mono text-2xl text-white uppercase tracking-widest">SYSTEM_MODULES</h2>
      </div>

      <!-- Dashboard Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { id: 'MOD_01', title: 'Automated Moderation & Q&A', desc: 'Custom LLMs trained on your whitepaper and docs. They answer complex technical questions instantly in Discord/Telegram, resolving 80% of queries without human intervention.', metric: '80% Ticket Reduction', chart: 'M0,100 L20,80 L40,85 L60,40 L80,50 L100,10' },
          { id: 'MOD_02', title: 'Sentiment Scraping', desc: 'Real-time analysis of Twitter, Reddit, and Telegram. The AI assigns sentiment scores and flags potential FUD or viral trends before they fully materialize.', metric: 'Real-time Alerts', chart: 'M0,50 L20,40 L40,60 L60,20 L80,30 L100,5' },
          { id: 'MOD_03', title: 'Programmatic Content', desc: 'AI-assisted generation of localized social media posts, translation into 15+ languages, and automated distribution pipelines timed for optimal engagement.', metric: '15+ Languages', chart: 'M0,90 L20,70 L40,75 L60,30 L80,20 L100,0' },
          { id: 'MOD_04', title: 'Predictive Churn Analytics', desc: 'Analyzing on-chain wallet behavior combined with social engagement to predict which power users are at risk of leaving your ecosystem, triggering retention campaigns.', metric: 'Predictive Modeling', chart: 'M0,10 L20,30 L40,25 L60,80 L80,70 L100,90' }
        ].map((mod, i) => (
          <div class="border border-[var(--accent-cyan)]/20 bg-[#0A0F15] p-6 hover:border-[var(--accent-cyan)]/60 transition-colors group relative reveal" style={`transition-delay: ${i * 0.15}s`}>
            <!-- Cyber Corners -->
            <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-[var(--accent-cyan)] opacity-50 group-hover:opacity-100"></div>
            <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-[var(--accent-cyan)] opacity-50 group-hover:opacity-100"></div>
            
            <div class="flex justify-between items-start mb-6">
              <span class="font-mono text-xs text-[var(--accent-cyan)]">{mod.id}</span>
              <span class="font-mono text-xs text-white/40 bg-white/5 px-2 py-1">{mod.metric}</span>
            </div>
            <h3 class="font-display text-xl text-white font-bold mb-3">{mod.title}</h3>
            <p class="font-mono text-sm text-[var(--text-secondary)] leading-relaxed mb-6">{mod.desc}</p>
            
            <!-- Simulated Chart -->
            <div class="w-full h-16 border-t border-[var(--accent-cyan)]/10 pt-4 relative opacity-50 group-hover:opacity-100 transition-opacity">
              <svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 100">
                <path d={mod.chart} fill="none" stroke="var(--accent-cyan)" stroke-width="2" vector-effect="non-scaling-stroke" stroke-dasharray="200" stroke-dashoffset="200">
                  <animate attributeName="stroke-dashoffset" values="200;0" dur="2s" fill="freeze" />
                </path>
                <path d={`${mod.chart} L100,100 L0,100 Z`} fill="var(--accent-cyan)" opacity="0.1" />
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — IMPACT (Monospace Data List) -->
  <section class="py-24 bg-[#0A0F15] relative z-10 border-t border-[var(--accent-cyan)]/20">
    <div class="max-w-5xl mx-auto px-4 lg:px-8">
      <div class="text-center mb-16 reveal">
        <h2 class="font-mono text-2xl text-[var(--accent-cyan)] uppercase tracking-widest">PERFORMANCE_METRICS</h2>
      </div>

      <div class="bg-black border border-[var(--accent-cyan)]/30 p-8 font-mono text-sm md:text-base">
        <div class="flex border-b border-[var(--accent-cyan)]/30 pb-4 text-[var(--accent-cyan)]/60 uppercase">
          <div class="w-1/3">METRIC_TYPE</div>
          <div class="w-1/3 text-center">HUMAN_ONLY</div>
          <div class="w-1/3 text-right text-[var(--accent-cyan)]">AI_AUGMENTED</div>
        </div>
        
        {[
          { m: 'Avg Response Time', h: '3-5 Mins', a: '< 5 Seconds' },
          { m: 'Cost per Query', h: '$1.50', a: '$0.002' },
          { m: 'Sentiment Tracking', h: 'Weekly Reports', a: 'Real-Time Streaming' },
          { m: 'Content Localization', h: '3 Languages', a: '15+ Languages' }
        ].map((row, i) => (
          <div class="flex border-b border-[var(--accent-cyan)]/10 py-4 hover:bg-[var(--accent-cyan)]/5 transition-colors reveal" style={`transition-delay: ${i * 0.1}s`}>
            <div class="w-1/3 text-white">{row.m}</div>
            <div class="w-1/3 text-center text-white/40">{row.h}</div>
            <div class="w-1/3 text-right text-[var(--accent-cyan)]">{row.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION (Terminal Accordion) -->
  <section class="py-24 bg-[#05080C] border-t border-[var(--accent-cyan)]/20">
    <div class="max-w-4xl mx-auto px-4 lg:px-8">
      <div class="mb-12 reveal">
        <h2 class="font-mono text-xl text-[var(--accent-cyan)]">C:\FAQ\query_database.exe</h2>
      </div>
      
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="group bg-[#0A0F15] border border-[var(--accent-cyan)]/20 reveal" style={`transition-delay: ${i * 0.1}s`}>
            <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-mono text-sm md:text-base text-white hover:bg-[var(--accent-cyan)]/10 transition-colors">
              <span class="flex items-center gap-4">
                <span class="text-[var(--accent-cyan)]">></span>
                {faq.q}
              </span>
              <span class="text-[var(--accent-cyan)] group-open:rotate-90 transition-transform">]</span>
            </summary>
            <div class="p-6 pt-0 text-[var(--text-secondary)] font-mono text-sm leading-relaxed border-t border-[var(--accent-cyan)]/10 mt-2 bg-black/40">
              <span class="text-green-500 mr-2">OK:</span> {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION (Unified FooterLeadForm) -->
  <FooterLeadForm defaultService="AI Marketing" />

</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  .reveal { opacity: 0; transform: scale(0.98) translateY(10px); transition: opacity 0.5s ease, transform 0.5s ease; }
  .reveal.revealed { opacity: 1; transform: scale(1) translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>
