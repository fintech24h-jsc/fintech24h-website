<script is:inline define:vars={{ categories, segments }}>
  // Pass template data to client side JS
  window.CUSTOM_CATEGORIES = categories;
  window.CUSTOM_SEGMENTS = segments;
</script>

<script>
  import { submitLead } from '../../lib/leadSubmit';

  interface Service {
    name: string;
    kpi: string;
    timeline: string;
  }
  interface Category {
    id: string;
    title: string;
    description: string;
    color: string;
    services: Service[];
  }
  interface Segment {
    id: string;
    title: string;
    pain: string;
    strategy: string;
  }

  declare global {
    interface Window {
      CUSTOM_CATEGORIES: Category[];
      CUSTOM_SEGMENTS: Segment[];
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // ══════════════════════════════════════════════════════════
    // 1. DYNAMIC SENTENCE BUILDER & INTERACTIVITY
    // ══════════════════════════════════════════════════════════
    const selectService = document.getElementById('sb-service') as HTMLSelectElement;
    const selectClient = document.getElementById('sb-client') as HTMLSelectElement;
    const selectTimeline = document.getElementById('sb-timeline') as HTMLSelectElement;
    const recommendationText = document.getElementById('sb-recommendation');
    const actionBtn = document.getElementById('sb-action');

    const updateRecommendation = () => {
      if (!selectService || !recommendationText) return;
      const svcVal = selectService.value;
      const text = selectService.options[selectService.selectedIndex].text;
      recommendationText.innerHTML = `⚡ SUGGESTED CATEGORY: <span class="text-white font-semibold uppercase">${text}</span>`;
    };

    if (selectService) selectService.addEventListener('change', updateRecommendation);
    if (selectClient) selectClient.addEventListener('change', updateRecommendation);
    if (selectTimeline) selectTimeline.addEventListener('change', updateRecommendation);

    if (actionBtn) {
      actionBtn.addEventListener('click', () => {
        const svcVal = selectService.value;
        // Scroll smoothly to blueprint tree category explorer
        const blueprintSec = document.getElementById('solutions-blueprint');
        if (blueprintSec) {
          blueprintSec.scrollIntoView({ behavior: 'smooth' });
          // Trigger tab change in node tree
          const catBtn = document.querySelector(`.cat-node-btn[data-cat-id="${svcVal}"]`) as HTMLButtonElement;
          if (catBtn) catBtn.click();
        }
      });
    }

    // ══════════════════════════════════════════════════════════
    // 2. 3D PARTICLE CONSTELLATION CANVAS
    // ══════════════════════════════════════════════════════════
    const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      if (ctx) {
        let width = canvas.width = canvas.offsetWidth;
        let height = canvas.height = canvas.offsetHeight;

        window.addEventListener('resize', () => {
          if (!canvas) return;
          width = canvas.width = canvas.offsetWidth;
          height = canvas.height = canvas.offsetHeight;
        });

        // 3D Particles coordinates
        interface Particle {
          x: number;
          y: number;
          z: number;
          ox: number;
          oy: number;
          oz: number;
          tx: number;
          ty: number;
          tz: number;
        }
        const particles: Particle[] = [];
        const numParticles = 60;
        const radius = Math.min(width, height) * 0.35;

        // Initialize particles on sphere surface
        for (let i = 0; i < numParticles; i++) {
          const theta = Math.acos(Math.random() * 2 - 1);
          const phi = Math.random() * Math.PI * 2;

          const x = radius * Math.sin(theta) * Math.cos(phi);
          const y = radius * Math.sin(theta) * Math.sin(phi);
          const z = radius * Math.cos(theta);

          particles.push({
            x, y, z,
            ox: x, oy: y, oz: z, // Original coordinates
            tx: x, ty: y, tz: z  // Target coordinates for morphing
          });
        }

        // Tilt controls
        let rotateX = 0.003;
        let rotateY = 0.004;
        let targetX = 0;
        let targetY = 0;
        let currentX = 0;
        let currentY = 0;

        // Mouse move parallax
        canvas.addEventListener('mousemove', (e) => {
          const rect = canvas.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          targetX = (e.clientX - cx) * 0.0003;
          targetY = (e.clientY - cy) * 0.0003;
        });

        canvas.addEventListener('mouseleave', () => {
          targetX = 0;
          targetY = 0;
        });

        // Morph shapes
        const morphToShape = (shapeType: string) => {
          particles.forEach((p) => {
            if (shapeType === 'blockchain') {
              // Morph to a cube grid pattern
              p.tx = (Math.random() * 2 - 1) * radius * 0.8;
              p.ty = (Math.random() * 2 - 1) * radius * 0.8;
              p.tz = (Math.random() * 2 - 1) * radius * 0.8;
            } else if (shapeType === 'ai') {
              // Morph to neuron-like double loop helix
              const factor = Math.random() * Math.PI * 2;
              p.tx = radius * 0.8 * Math.cos(factor);
              p.ty = (Math.random() * 2 - 1) * radius * 0.7;
              p.tz = radius * 0.8 * Math.sin(factor);
            } else {
              // Return to sphere
              p.tx = p.ox;
              p.ty = p.oy;
              p.tz = p.oz;
            }
          });
        };

        // Listen for dropdown changes to trigger canvas morphing
        if (selectService) {
          selectService.addEventListener('change', () => {
            morphToShape(selectService.value);
          });
        }

        const fov = 400;

        const animate = () => {
          ctx.clearRect(0, 0, width, height);

          // Smoothly lerp mouse rotation offset
          currentX += (targetX - currentX) * 0.1;
          currentY += (targetY - currentY) * 0.1;

          // Rotation matrices
          const rx = rotateX + currentY;
          const ry = rotateY + currentX;

          const cosX = Math.cos(rx);
          const sinX = Math.sin(rx);
          const cosY = Math.cos(ry);
          const sinY = Math.sin(ry);

          // Projects 3D points to 2D screen
          const projected: { sx: number; sy: number; sz: number; scale: number }[] = [];

          particles.forEach((p) => {
            // Lerp morph coordinates towards target
            p.x += (p.tx - p.x) * 0.05;
            p.y += (p.ty - p.y) * 0.05;
            p.z += (p.tz - p.z) * 0.05;

            // Rotate Y
            let x1 = p.x * cosY - p.z * sinY;
            let z1 = p.z * cosY + p.x * sinY;

            // Rotate X
            let y2 = p.y * cosX - z1 * sinX;
            let z2 = z1 * cosX + p.y * sinX;

            // Update particle coordinate values back for continuous rotation
            p.x = x1;
            p.y = y2;
            p.z = z2;

            // Update target values too so morph fits rotation
            let tx1 = p.tx * cosY - p.tz * sinY;
            let tz1 = p.tz * cosY + p.tx * sinY;
            let ty2 = p.ty * cosX - tz1 * sinX;
            let tz2 = tz1 * cosX + p.ty * sinX;
            p.tx = tx1; p.ty = ty2; p.tz = tz2;

            let ox1 = p.ox * cosY - p.oz * sinY;
            let oz1 = p.oz * cosY + p.ox * sinY;
            let oy2 = p.oy * cosX - oz1 * sinX;
            let oz2 = oz1 * cosX + p.oy * sinX;
            p.ox = ox1; p.oy = oy2; p.oz = oz2;

            // Perspective projection divide
            const scale = fov / (fov + z2);
            const sx = x1 * scale + width / 2;
            const sy = y2 * scale + height / 2;

            projected.push({ sx, sy, sz: z2, scale });
          });

          // Draw links/edges first for correct layering
          ctx.strokeStyle = 'rgba(0, 200, 240, 0.08)';
          ctx.lineWidth = 0.5;
          for (let i = 0; i < projected.length; i++) {
            for (let j = i + 1; j < projected.length; j++) {
              const dx = projected[i].sx - projected[j].sx;
              const dy = projected[i].sy - projected[j].sy;
              const dist = Math.sqrt(dx * dx + dy * dy);

              // Connect nodes that are close to each other
              if (dist < 75) {
                ctx.beginPath();
                ctx.moveTo(projected[i].sx, projected[i].sy);
                ctx.lineTo(projected[j].sx, projected[j].sy);
                ctx.stroke();
              }
            }
          }

          // Draw particle node dots
          projected.forEach((p) => {
            const size = Math.max(1, p.scale * 2.2);
            // Render depth with transparency gradients
            const alpha = Math.min(1, Math.max(0.1, (fov - p.sz) / (fov * 2)));
            ctx.fillStyle = `rgba(0, 200, 240, ${alpha * 0.8})`;

            ctx.beginPath();
            ctx.arc(p.sx, p.sy, size, 0, Math.PI * 2);
            ctx.fill();

            // Glow core
            if (p.sz < 0) {
              ctx.fillStyle = `rgba(139, 92, 246, ${alpha * 0.4})`;
              ctx.beginPath();
              ctx.arc(p.sx, p.sy, size * 2, 0, Math.PI * 2);
              ctx.fill();
            }
          });

          requestAnimationFrame(animate);
        };

        animate();
      }
    }

    // ══════════════════════════════════════════════════════════
    // 3. MOUSE-TRACKING SPOTLIGHT HOVER FOR BENTO CARDS
    // ══════════════════════════════════════════════════════════
    const bentoCards = document.querySelectorAll('.bento-card');
    bentoCards.forEach((card) => {
      card.addEventListener('mousemove', (e: Event) => {
        const me = e as MouseEvent;
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = me.clientX - rect.left;
        const y = me.clientY - rect.top;
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      });
    });

    // ══════════════════════════════════════════════════════════
    // 4. INTERACTIVE CLIENT SEGMENTS SELECTOR
    // ══════════════════════════════════════════════════════════
    const segTabs = document.querySelectorAll('.seg-tab');
    const segTitle = document.getElementById('seg-display-title');
    const segPain = document.getElementById('seg-display-pain');
    const segStrategy = document.getElementById('seg-display-strategy');
    const segBox = document.getElementById('seg-display-box');

    segTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const segId = tab.getAttribute('data-segment-id') || '';
        const segmentData = window.CUSTOM_SEGMENTS.find(s => s.id === segId);
        if (!segmentData || !segTitle || !segPain || !segStrategy || !segBox) return;

        // Visual fade out transition
        segBox.style.opacity = '0.3';
        segBox.style.transform = 'translateY(4px)';

        setTimeout(() => {
          segTitle.innerText = segmentData.title;
          segPain.innerText = segmentData.pain;
          segStrategy.innerText = segmentData.strategy;

          // Toggle tab button styling classes
          segTabs.forEach(t => {
            t.classList.remove('border-[var(--accent-cyan)]', 'bg-[var(--accent-cyan)]/10', 'text-[var(--accent-cyan)]');
            t.classList.add('border-white/5', 'bg-white/[0.005]', 'text-white/50');
          });
          tab.classList.remove('border-white/5', 'bg-white/[0.005]', 'text-white/50');
          tab.classList.add('border-[var(--accent-cyan)]', 'bg-[var(--accent-cyan)]/10', 'text-[var(--accent-cyan)]');

          segBox.style.opacity = '1';
          segBox.style.transform = 'translateY(0)';
        }, 150);
      });
    });

    // ══════════════════════════════════════════════════════════
    // 5. BLUEPRINT NODE TREE CONSOLE INTERACTIVE CART
    // ══════════════════════════════════════════════════════════
    const catBtns = document.querySelectorAll('.cat-node-btn');
    const servicesGrid = document.getElementById('services-node-grid');
    const activeTitle = document.getElementById('active-cat-title');
    const activeDesc = document.getElementById('active-cat-desc');

    const selectedModules = new Set<string>();

    const rfpDrawer = document.getElementById('floating-rfp-drawer');
    const rfpCountBadge = document.getElementById('rfp-count-badge');
    const rfpCheckoutBtn = document.getElementById('rfp-checkout-btn');
    const formSelectedInput = document.getElementById('form-selected-modules') as HTMLTextAreaElement;

    // Updates cart drawer display status
    const updateRfpCart = () => {
      if (!rfpDrawer || !rfpCountBadge || !formSelectedInput) return;
      const count = selectedModules.size;
      rfpCountBadge.innerText = String(count);

      if (count > 0) {
        rfpDrawer.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
        rfpDrawer.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        formSelectedInput.value = Array.from(selectedModules).join('\n');
      } else {
        rfpDrawer.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
        rfpDrawer.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
        formSelectedInput.value = '';
      }
    };

    const renderServices = (catId: string) => {
      const categoryData = window.CUSTOM_CATEGORIES.find(c => c.id === catId);
      if (!categoryData || !servicesGrid || !activeTitle || !activeDesc) return;

      activeTitle.innerText = categoryData.title;
      activeDesc.innerText = categoryData.description;

      servicesGrid.innerHTML = '';

      categoryData.services.forEach(srv => {
        const isSelected = selectedModules.has(srv.name);

        const card = document.createElement('div');
        card.className = `p-4 rounded-xl border transition-all duration-300 flex flex-col justify-between min-h-[110px] group/node relative overflow-hidden cursor-pointer ${isSelected ? 'bg-emerald-950/20 border-emerald-500/40 shadow-[0_0_12px_rgba(16,185,129,0.1)]' : 'bg-white/[0.01] border-white/5 hover:border-white/20'}`;
        card.setAttribute('data-service-name', srv.name);

        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="font-display text-xs font-bold text-white uppercase group-hover/node:text-[var(--accent-cyan)] transition-colors">${srv.name}</span>
              <span class="text-[9px] font-mono text-white/30">${srv.timeline}</span>
            </div>
            <div class="font-mono text-[9px] text-[var(--accent-cyan)]/70 uppercase tracking-widest font-semibold">${srv.kpi}</div>
          </div>
          <div class="mt-3 flex justify-end">
            <span class="node-badge font-mono text-[8px] uppercase tracking-wider py-1 px-2.5 rounded border transition-all ${isSelected ? 'bg-emerald-500/20 border-emerald-500 text-emerald-400' : 'bg-white/5 border-white/10 text-white/50 group-hover/node:border-[var(--accent-cyan)]/30 group-hover/node:text-white'}">
              ${isSelected ? '✓ Loaded' : '+ Add Node'}
            </span>
          </div>
        `;

        // Click handler to toggle selection
        card.addEventListener('click', () => {
          const badge = card.querySelector('.node-badge') as HTMLElement;
          if (selectedModules.has(srv.name)) {
            selectedModules.delete(srv.name);
            card.classList.remove('bg-emerald-950/20', 'border-emerald-500/40', 'shadow-[0_0_12px_rgba(16,185,129,0.1)]');
            card.classList.add('bg-white/[0.01]', 'border-white/5');
            badge.innerText = '+ Add Node';
            badge.className = 'node-badge font-mono text-[8px] uppercase tracking-wider py-1 px-2.5 rounded border bg-white/5 border-white/10 text-white/50 group-hover/node:border-[var(--accent-cyan)]/30 group-hover/node:text-white';
          } else {
            selectedModules.add(srv.name);
            card.classList.remove('bg-white/[0.01]', 'border-white/5');
            card.classList.add('bg-emerald-950/20', 'border-emerald-500/40', 'shadow-[0_0_12px_rgba(16,185,129,0.1)]');
            badge.innerText = '✓ Loaded';
            badge.className = 'node-badge font-mono text-[8px] uppercase tracking-wider py-1 px-2.5 rounded border bg-emerald-500/20 border-emerald-500 text-emerald-400';
          }
          updateRfpCart();
        });

        servicesGrid.appendChild(card);
      });
    };

    // Category button click handlers
    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const catId = btn.getAttribute('data-cat-id') || '';
        renderServices(catId);

        catBtns.forEach(b => {
          b.classList.remove('bg-[var(--accent-cyan)]/5', 'border-[var(--accent-cyan)]/30', 'text-white');
          b.classList.add('bg-transparent', 'border-transparent', 'text-white/40');
        });
        btn.classList.remove('bg-transparent', 'border-transparent', 'text-white/40');
        btn.classList.add('bg-[var(--accent-cyan)]/5', 'border-[var(--accent-cyan)]/30', 'text-white');
      });
    });

    // Initial render
    renderServices('ai');

    // Float checkout click scrolls to Contact Form
    if (rfpCheckoutBtn) {
      rfpCheckoutBtn.addEventListener('click', () => {
        const formSec = document.getElementById('inquiry-form-section');
        if (formSec) {
          formSec.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // ══════════════════════════════════════════════════════════
    // 6. SCROLL-LINKED PIPELINE TIMELINE PROGRESS BAR
    // ══════════════════════════════════════════════════════════
    const timeline = document.getElementById('pipeline-timeline');
    const glowBar = document.getElementById('timeline-glow-bar');
    const stepsElements = document.querySelectorAll('.timeline-step');

    if (timeline && glowBar) {
      const observerOptions = {
        root: null,
        rootMargin: '0px 0px -25% 0px',
        threshold: 0.15
      };

      const stepObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.setAttribute('data-active', 'true');
            
            // Calculate height of the timeline bar based on active step index
            const stepIdx = parseInt(entry.target.getAttribute('data-step-index') || '0');
            const totalSteps = stepsElements.length;
            const percentage = ((stepIdx) / (totalSteps - 1)) * 100;
            
            // Set height to index height bounds
            const stepRect = entry.target.getBoundingClientRect();
            const timelineRect = timeline.getBoundingClientRect();
            const relativeOffset = (stepRect.top - timelineRect.top) + 12;
            glowBar.style.height = `${relativeOffset}px`;
          }
        });
      }, observerOptions);

      stepsElements.forEach(st => stepObserver.observe(st));
    }

    // ══════════════════════════════════════════════════════════
    // 7. UNIFIED FORM SUBMISSION (Sheet + Telegram + Email)
    // ══════════════════════════════════════════════════════════
    const formElement = document.getElementById('custom-rfp-form') as HTMLFormElement;
    const formErrorAlert = document.getElementById('form-error-alert');
    const formSuccessAlert = document.getElementById('form-success-alert');
    const formGridWrapper = document.querySelector('.form-grid-wrapper') as HTMLElement;
    const formSubmitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement;

    const formName = document.getElementById('form-name') as HTMLInputElement;
    const formEmail = document.getElementById('form-email') as HTMLInputElement;
    const formContactHandle = document.getElementById('form-contact-handle') as HTMLInputElement;
    const formWebsite = document.getElementById('form-website') as HTMLInputElement;
    const formMessage = document.getElementById('form-message') as HTMLTextAreaElement;

    if (formElement) {
      formElement.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (!formName || !formEmail || !formContactHandle || !formSubmitBtn || !formErrorAlert || !formSuccessAlert || !formGridWrapper) return;

        if (!formName.value || !formEmail.value || !formContactHandle.value) {
          formErrorAlert.innerText = 'Please fill in all required fields (*).';
          formErrorAlert.classList.remove('hidden');
          return;
        }

        formSubmitBtn.disabled = true;
        formSubmitBtn.innerText = 'SUBMITTING...';
        formErrorAlert.classList.add('hidden');

        const messageContent = `[Selected Modules]:\n${formSelectedInput.value || 'None'}\n\n[Message]:\n${formMessage?.value || ''}`;

        const result = await submitLead({
          name: formName.value,
          email: formEmail.value,
          telegram: formContactHandle.value,
          website: formWebsite?.value || '',
          serviceInterest: 'Custom Solutions RFP',
          message: messageContent
        }, 'Custom Solutions RFP', [
          { name: 'firstname', value: formName.value.split(' ')[0] || formName.value },
          { name: 'lastname', value: formName.value.split(' ').slice(1).join(' ') || '' },
          { name: 'email', value: formEmail.value },
          { name: 'telegram_handle', value: formContactHandle.value },
          { name: 'website', value: formWebsite?.value || '' },
          { name: 'service_interest', value: 'Custom Solutions RFP' },
          { name: 'message', value: messageContent }
        ]);

        if (result.ok) {
          formGridWrapper.style.display = 'none';
          formSuccessAlert.classList.remove('hidden');
          // Reset selected modules
          selectedModules.clear();
          updateRfpCart();
        } else {
          formSubmitBtn.disabled = false;
          formSubmitBtn.innerText = 'SUBMIT RFP PACKAGE';
          formErrorAlert.innerText = result.error || 'Submission failed. Please try again or email info@fintech24h.com';
          formErrorAlert.classList.remove('hidden');
        }
      });
    }
  });
</script>
