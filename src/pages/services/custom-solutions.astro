<style>
  summary::-webkit-details-marker { display: none; }
  .faq-q { margin: 0; }

  .seg-tab { border-color: var(--border-subtle); color: var(--text-secondary); }
  .seg-tab:hover { color: var(--text-primary); border-color: var(--border-default); }
  .seg-tab[aria-pressed='true'] { border-color: var(--accent-cyan); color: var(--accent-cyan); background: color-mix(in srgb, var(--accent-cyan) 10%, transparent); }

  .cat-node-btn { border-color: transparent; color: var(--text-secondary); }
  .cat-node-btn:hover { color: var(--text-primary); background: var(--surface-soft); }
  .cat-node-btn[aria-pressed='true'] { color: var(--text-primary); background: color-mix(in srgb, var(--accent-cyan) 6%, transparent); border-color: color-mix(in srgb, var(--accent-cyan) 30%, transparent); }

  .node-card { background: var(--surface-faint); border-color: var(--border-subtle); }
  .node-card:hover { border-color: var(--border-default); }
  .node-card .node-badge { background: var(--surface-soft); border-color: var(--border-default); color: var(--text-secondary); }
  .node-card[aria-pressed='true'] { background: color-mix(in srgb, var(--color-success) 8%, transparent); border-color: color-mix(in srgb, var(--color-success) 45%, transparent); }
  .node-card[aria-pressed='true'] .node-badge { background: color-mix(in srgb, var(--color-success) 18%, transparent); border-color: var(--color-success); color: var(--color-success); }

  .seg-panel, .cat-panel { animation: panel-in 0.25s ease-out; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .seg-panel, .cat-panel { animation: none; }
    #timeline-glow-bar { transition: none; }
  }
</style>

<script>
  import { submitLead } from '../../lib/leadSubmit';

  document.addEventListener('DOMContentLoaded', () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Toggle groups (client types and module categories): one panel visible.
    const wireToggle = (buttonSelector: string, idAttr: string, panelPrefix: string) => {
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(buttonSelector));
      const show = (id: string) => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', b.getAttribute(idAttr) === id ? 'true' : 'false'));
        buttons.forEach((b) => {
          const panel = document.getElementById(`${panelPrefix}${b.getAttribute(idAttr)}`);
          if (panel) panel.hidden = b.getAttribute(idAttr) !== id;
        });
      };
      buttons.forEach((b) => b.addEventListener('click', () => show(b.getAttribute(idAttr) || '')));
      return show;
    };
    wireToggle('.seg-tab', 'data-segment-id', 'seg-');
    const showCategory = wireToggle('.cat-node-btn', 'data-cat-id', 'cat-');

    // 2. Sentence builder: suggestion text + jump to the matching module category.
    const selectService = document.getElementById('sb-service') as HTMLSelectElement | null;
    const recommendation = document.getElementById('sb-recommendation');
    const actionBtn = document.getElementById('sb-action');
    selectService?.addEventListener('change', () => {
      if (!recommendation) return;
      const label = selectService.options[selectService.selectedIndex].text;
      recommendation.innerHTML = '';
      recommendation.append('SUGGESTED MODULES: ');
      const strong = document.createElement('span');
      strong.className = 'text-[var(--text-primary)] font-semibold uppercase';
      strong.textContent = label;
      recommendation.append(strong);
    });
    actionBtn?.addEventListener('click', () => {
      if (!selectService) return;
      showCategory(selectService.value);
      document.getElementById('solutions-blueprint')?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
    });

    // 3. Particle canvas: slow rotation, paused off-screen, static for reduced motion.
    const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    if (canvas && ctx) {
      let width = (canvas.width = canvas.offsetWidth);
      let height = (canvas.height = canvas.offsetHeight);
      window.addEventListener('resize', () => {
        width = canvas.width = canvas.offsetWidth;
        height = canvas.height = canvas.offsetHeight;
      });

      const radius = Math.min(width, height) * 0.35;
      const particles = Array.from({ length: 60 }, () => {
        const theta = Math.acos(Math.random() * 2 - 1);
        const phi = Math.random() * Math.PI * 2;
        return {
          x: radius * Math.sin(theta) * Math.cos(phi),
          y: radius * Math.sin(theta) * Math.sin(phi),
          z: radius * Math.cos(theta)
        };
      });
      const fov = 400;
      const speedX = 0.0015;
      const speedY = 0.002;
      let running = false;

      const draw = (rotate: boolean) => {
        ctx.clearRect(0, 0, width, height);
        const cosX = Math.cos(speedX), sinX = Math.sin(speedX);
        const cosY = Math.cos(speedY), sinY = Math.sin(speedY);
        const projected = particles.map((p) => {
          if (rotate) {
            const x1 = p.x * cosY - p.z * sinY;
            const z1 = p.z * cosY + p.x * sinY;
            const y2 = p.y * cosX - z1 * sinX;
            const z2 = z1 * cosX + p.y * sinX;
            p.x = x1; p.y = y2; p.z = z2;
          }
          const scale = fov / (fov + p.z);
          return { sx: p.x * scale + width / 2, sy: p.y * scale + height / 2, sz: p.z, scale };
        });
        ctx.strokeStyle = 'rgba(0, 200, 240, 0.08)';
        ctx.lineWidth = 0.5;
        for (let i = 0; i < projected.length; i++) {
          for (let j = i + 1; j < projected.length; j++) {
            const dx = projected[i].sx - projected[j].sx;
            const dy = projected[i].sy - projected[j].sy;
            if (dx * dx + dy * dy < 75 * 75) {
              ctx.beginPath();
              ctx.moveTo(projected[i].sx, projected[i].sy);
              ctx.lineTo(projected[j].sx, projected[j].sy);
              ctx.stroke();
            }
          }
        }
        projected.forEach((p) => {
          const size = Math.max(1, p.scale * 2.2);
          const alpha = Math.min(1, Math.max(0.1, (fov - p.sz) / (fov * 2)));
          ctx.fillStyle = `rgba(0, 200, 240, ${alpha * 0.8})`;
          ctx.beginPath();
          ctx.arc(p.sx, p.sy, size, 0, Math.PI * 2);
          ctx.fill();
          if (p.sz < 0) {
            ctx.fillStyle = `rgba(124, 92, 252, ${alpha * 0.4})`;
            ctx.beginPath();
            ctx.arc(p.sx, p.sy, size * 2, 0, Math.PI * 2);
            ctx.fill();
          }
        });
      };
      const loop = () => {
        if (!running) return;
        draw(true);
        requestAnimationFrame(loop);
      };

      if (reduceMotion) {
        draw(false);
      } else {
        new IntersectionObserver(([entry]) => {
          const wasRunning = running;
          running = entry.isIntersecting && !document.hidden;
          if (running && !wasRunning) requestAnimationFrame(loop);
        }).observe(canvas);
      }
    }

    // 4. Spotlight hover on bento cards.
    document.querySelectorAll<HTMLElement>('.bento-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
    });

    // 5. Module cart.
    const selected = new Set<string>();
    const drawer = document.getElementById('floating-rfp-drawer');
    const countBadge = document.getElementById('rfp-count-badge');
    const checkoutBtn = document.getElementById('rfp-checkout-btn');
    const selectedField = document.getElementById('form-selected-modules') as HTMLTextAreaElement | null;

    const updateCart = () => {
      if (!drawer || !countBadge || !selectedField) return;
      countBadge.textContent = String(selected.size);
      selectedField.value = Array.from(selected).join('\n');
      const open = selected.size > 0;
      drawer.classList.toggle('translate-y-24', !open);
      drawer.classList.toggle('opacity-0', !open);
      drawer.classList.toggle('pointer-events-none', !open);
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      checkoutBtn?.setAttribute('tabindex', open ? '0' : '-1');
    };

    document.querySelectorAll<HTMLButtonElement>('.node-card').forEach((card) => {
      card.addEventListener('click', () => {
        const name = card.getAttribute('data-service-name') || '';
        const badge = card.querySelector('.node-badge');
        const isOn = selected.has(name);
        if (isOn) selected.delete(name); else selected.add(name);
        card.setAttribute('aria-pressed', isOn ? 'false' : 'true');
        if (badge) badge.textContent = isOn ? '+ Add module' : '✓ Added';
        updateCart();
      });
    });

    checkoutBtn?.addEventListener('click', () => {
      document.getElementById('inquiry-form-section')?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
    });

    // 6. Scroll-linked pipeline progress (transform only).
    const timeline = document.getElementById('pipeline-timeline');
    const glowBar = document.getElementById('timeline-glow-bar');
    if (timeline && glowBar) {
      const stepObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute('data-active', 'true');
          const stepTop = entry.target.getBoundingClientRect().top - timeline.getBoundingClientRect().top + 12;
          const ratio = Math.min(1, stepTop / timeline.getBoundingClientRect().height);
          const current = parseFloat(glowBar.dataset.ratio || '0');
          if (ratio > current) {
            glowBar.dataset.ratio = String(ratio);
            glowBar.style.transform = `scaleY(${ratio})`;
          }
        });
      }, { rootMargin: '0px 0px -25% 0px', threshold: 0.15 });
      document.querySelectorAll('.timeline-step').forEach((st) => stepObserver.observe(st));
    }

    // 7. Form submission (Sheet + Telegram + Email via Apps Script).
    const form = document.getElementById('custom-rfp-form') as HTMLFormElement | null;
    const errorAlert = document.getElementById('form-error-alert');
    const successAlert = document.getElementById('form-success-alert');
    const fields = document.querySelector('.form-grid-wrapper') as HTMLElement | null;
    const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;
    const nameEl = document.getElementById('form-name') as HTMLInputElement | null;
    const emailEl = document.getElementById('form-email') as HTMLInputElement | null;
    const handleEl = document.getElementById('form-contact-handle') as HTMLInputElement | null;
    const websiteEl = document.getElementById('form-website') as HTMLInputElement | null;
    const messageEl = document.getElementById('form-message') as HTMLTextAreaElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!nameEl || !emailEl || !handleEl || !submitBtn || !errorAlert || !successAlert || !fields) return;

      if (!nameEl.value || !emailEl.value || !handleEl.value) {
        errorAlert.textContent = 'Please fill in all required fields (*).';
        errorAlert.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'SENDING...';
      errorAlert.classList.add('hidden');

      const messageContent = `[Selected Modules]:\n${selectedField?.value || 'None'}\n\n[Message]:\n${messageEl?.value || ''}`;

      const result = await submitLead({
        name: nameEl.value,
        email: emailEl.value,
        telegram: handleEl.value,
        website: websiteEl?.value || '',
        serviceInterest: 'Custom Solutions RFP',
        message: messageContent
      }, 'Custom Solutions RFP', [
        { name: 'firstname', value: nameEl.value.split(' ')[0] || nameEl.value },
        { name: 'lastname', value: nameEl.value.split(' ').slice(1).join(' ') || '' },
        { name: 'email', value: emailEl.value },
        { name: 'telegram_handle', value: handleEl.value },
        { name: 'website', value: websiteEl?.value || '' },
        { name: 'service_interest', value: 'Custom Solutions RFP' },
        { name: 'message', value: messageContent }
      ]);

      if (result.ok) {
        fields.style.display = 'none';
        successAlert.classList.remove('hidden');
        selected.clear();
        document.querySelectorAll('.node-card').forEach((c) => c.setAttribute('aria-pressed', 'false'));
        document.querySelectorAll('.node-badge').forEach((b) => { b.textContent = '+ Add module'; });
        updateCart();
      } else {
        submitBtn.disabled = false;
        submitBtn.textContent = 'SEND PROPOSAL REQUEST';
        errorAlert.textContent = result.error || 'Submission failed. Please try again or email info@fintech24h.com';
        errorAlert.classList.remove('hidden');
      }
    });
  });
</script>
