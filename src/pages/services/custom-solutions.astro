---
// src/pages/services/custom-solutions.astro
// Repositioned (owner decision 2026-10-22) as the crypto & Web3 go-to-market /
// dedicated growth team page. Focus keyword: "crypto go-to-market strategy".
// Each module category links to its dedicated service page so this page does
// not compete with them. No KPI numbers. All content is in the static HTML;
// JS only toggles panels, the module cart and the canvas.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import Badge from '../../components/ui/Badge.astro';
import { buildServiceSchema, buildFaqSchema } from '../../lib/serviceSchema';

const canonical = 'https://fintech24h.com/services/custom-solutions/';
const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services/' },
  { name: 'Go-To-Market & Custom Programs', item: canonical },
];

const linkClass =
  'text-[var(--accent-cyan)] underline decoration-[color-mix(in_srgb,var(--accent-cyan)_40%,transparent)] underline-offset-4 hover:decoration-[var(--accent-cyan)] transition-colors duration-200 rounded-sm';

const differentiators = [
  { title: 'Built around your launch', desc: 'Every plan starts from your stage, chain, audience and budget, not from a package someone else bought.', tone: 'cyan', icon: 'check' },
  { title: 'One dedicated team', desc: 'A single lead coordinates strategy, KOLs, PR, community, events and BD, so nothing falls between agencies.', tone: 'purple', icon: 'team' },
  { title: 'Flexible engagement', desc: 'Monthly retainers, fixed-scope sprints or milestone-based programs, agreed before any work starts.', tone: 'green', icon: 'coin' },
  { title: 'Asia & Middle East reach', desc: 'Local teams and partners across Vietnam, Singapore, the UAE, Indonesia, Thailand and India.', tone: 'green', icon: 'globe' },
  { title: 'Plain reporting', desc: 'Weekly updates and a shared view of what ran, what worked and what changes next.', tone: 'cyan', icon: 'chat' },
  { title: 'From startup to institution', desc: 'The same method for a first token launch and for an established exchange or fintech entering a new market.', tone: 'purple', icon: 'layers' }
];

const phases = [
  {
    name: 'Pre-launch',
    goal: 'Build belief before there is anything to buy.',
    items: ['Positioning, narrative and messaging', 'Tokenomics and launch timeline review', 'Community setup on Telegram and Discord', 'Waitlist, quests and early KOL seeding', 'Investor and partner introductions']
  },
  {
    name: 'Launch',
    goal: 'Make launch week count.',
    items: ['Coordinated KOL and PR waves', 'Exchange and launchpad coordination', 'AMAs, X Spaces and launch events', 'Moderation and crisis plan for launch day', 'Tracked links and daily reporting']
  },
  {
    name: 'Scale',
    goal: 'Turn attention into a lasting user base.',
    items: ['Always-on content and thought leadership', 'Ambassador and retention programs', 'New market entry in Asia and the Gulf', 'Conference season activations', 'Ecosystem partnerships and integrations']
  }
];

// Module categories for the RFP builder. No KPI numbers; each links to the
// dedicated page where one exists.
const categories = [
  {
    id: 'marketing', title: 'Marketing & Growth', href: '/services/kol-marketing/', hrefLabel: 'Crypto KOL & influencer marketing',
    description: 'Acquisition, brand and community growth for crypto, Web3 and fintech products.',
    services: [
      { name: 'Go-to-market strategy', note: 'Launch plan, channels and budget split' },
      { name: 'KOL campaigns', note: 'Vetted crypto KOLs on X, YouTube and Telegram' },
      { name: 'Community building', note: 'Telegram and Discord setup and moderation' },
      { name: 'Content marketing', note: 'Articles, threads and explainers' },
      { name: 'Social media management', note: 'Always-on presence on X and other channels' },
      { name: 'Performance marketing', note: 'Paid campaigns where crypto ads are allowed' },
      { name: 'Brand positioning', note: 'Narrative, messaging and visual direction' }
    ]
  },
  {
    id: 'pr', title: 'PR & Media', href: '/services/pr-media/', hrefLabel: 'Blockchain PR agency',
    description: 'Earned and sponsored coverage that builds credibility with investors and users.',
    services: [
      { name: 'Press releases', note: 'News-style announcements for launches and listings' },
      { name: 'Media relations', note: 'Pitching reporters who cover your niche' },
      { name: 'Sponsored articles', note: 'Guaranteed timing, always labeled' },
      { name: 'Founder thought leadership', note: 'Op-eds, interviews and commentary' },
      { name: 'Podcast placements', note: 'Long-form conversations with relevant hosts' },
      { name: 'Crisis communications', note: 'Holding statements and FUD response' }
    ]
  },
  {
    id: 'bd', title: 'Business Development', href: '/services/business-development/', hrefLabel: 'Web3 business development',
    description: 'Warm introductions to the exchanges, investors and partners that fit your stage.',
    services: [
      { name: 'Exchange listing readiness', note: 'Review and introductions, never guaranteed listings' },
      { name: 'Investor introductions', note: 'Funds, angels and family offices' },
      { name: 'Ecosystem partnerships', note: 'Integrations that add real utility' },
      { name: 'Market entry', note: 'Local partners in Southeast Asia and the UAE' },
      { name: 'B2B sales support', note: 'Pipeline for Web3 and fintech products' }
    ]
  },
  {
    id: 'events', title: 'Events & Community', href: '/services/event-marketing/', hrefLabel: 'Crypto event marketing',
    description: 'Conference presence, side events and online sessions that create real conversations.',
    services: [
      { name: 'Conference marketing', note: 'Sponsorship, booth and speaking strategy' },
      { name: 'Side events & dinners', note: 'Curated guest lists during conference weeks' },
      { name: 'X Spaces & AMAs', note: 'Online sessions for the wider community' },
      { name: 'Hackathons & workshops', note: 'Reach builders, not just traders' },
      { name: 'Meetups', note: 'Local community gatherings' }
    ]
  },
  {
    id: 'ai', title: 'AI Solutions', href: '/services/ai-marketing/', hrefLabel: 'Crypto AI marketing',
    description: 'Supervised AI for community support, monitoring and content, plus custom AI workflows.',
    services: [
      { name: 'AI strategy consulting', note: 'Where AI helps your team and where it does not' },
      { name: 'AI community support', note: 'Answers from approved sources, humans on escalation' },
      { name: 'AI workflow automation', note: 'Internal tools that save repetitive work' },
      { name: 'AI knowledge base', note: 'Searchable docs for users and staff' },
      { name: 'AI agent development', note: 'Task-specific agents with human review' }
    ]
  },
  {
    id: 'blockchain', title: 'Blockchain & Web3 Advisory', href: '', hrefLabel: '',
    description: 'Advisory and coordination for the product and token side of a launch.',
    services: [
      { name: 'Blockchain consulting', note: 'Use-case and market-fit review' },
      { name: 'Tokenomics review', note: 'Distribution, vesting and incentives' },
      { name: 'Smart contract coordination', note: 'Development partners and audit preparation' },
      { name: 'DAO & governance design', note: 'Proposals, voting and community roles' },
      { name: 'NFT strategy', note: 'Collections and holder utility' }
    ]
  },
  {
    id: 'tech', title: 'Technology Development', href: '', hrefLabel: '',
    description: 'Websites, apps and integrations that support your marketing and product.',
    services: [
      { name: 'Website development', note: 'Fast, search-friendly project sites' },
      { name: 'Landing pages', note: 'Campaign and waitlist pages' },
      { name: 'Dashboards', note: 'Metrics views for teams and communities' },
      { name: 'API & CRM integration', note: 'Connect forms, CRM and analytics' },
      { name: 'Custom software', note: 'Scoped builds with a clear handover' }
    ]
  }
];

const segments = [
  { id: 'blockchain', title: 'Blockchain Projects', single: 'blockchain project', pain: 'Ecosystem growth, developer adoption, community retention and exchange readiness, often all at the same time.', strategy: 'A phased go-to-market plan combining KOL waves, community programs, tokenomics review, hackathons and multi-channel PR.' },
  { id: 'fintech', title: 'Fintech Companies', single: 'fintech company', pain: 'Building trust, high acquisition costs and strict rules on what marketing can claim.', strategy: 'Regulation-aware messaging, PR in business and finance media, partnership pipelines and education-first content.' },
  { id: 'ai', title: 'AI Companies', single: 'AI company', pain: 'Standing out in a crowded market, earning developer trust and explaining what the product really does.', strategy: 'Clear positioning, technical thought leadership, community building and focused acquisition campaigns.' },
  { id: 'vc', title: 'Venture Funds', single: 'venture fund', pain: 'Deal flow, portfolio support and a clear position in the Web3 and AI landscape.', strategy: 'Co-marketing for portfolio companies, curated founder events and business development introductions.' },
  { id: 'enterprise', title: 'Enterprises & Institutions', single: 'enterprise', pain: 'Exploring blockchain or AI without the risk of hype-driven projects.', strategy: 'Advisory, pilot scoping, partner selection and communications for internal and external audiences.' }
];

const steps = [
  { step: '01', name: 'Discovery', desc: 'We learn your product, goals, audience, competitors and constraints, and agree what success should look like.', outcomes: ['Current state review', 'Competitor map', 'Positioning notes'] },
  { step: '02', name: 'Strategy', desc: 'We design the go-to-market roadmap: phases, channels, budget split and the team that will run it.', outcomes: ['Roadmap', 'Channel plan', 'Budget allocation'] },
  { step: '03', name: 'Proposal', desc: 'You receive a written proposal with deliverables, milestones, pricing and how we will report.', outcomes: ['Scope of work', 'Milestones', 'Reporting plan'] },
  { step: '04', name: 'Execution', desc: 'A dedicated team runs the plan with weekly check-ins, approvals and quality control.', outcomes: ['Weekly updates', 'Campaign launch', 'Approvals log'] },
  { step: '05', name: 'Optimization', desc: 'We watch what works, move budget toward it and drop what does not.', outcomes: ['Test results', 'Targeting changes', 'Budget shifts'] },
  { step: '06', name: 'Reporting', desc: 'Plain reports on progress and next steps, with a roadmap for the following phase.', outcomes: ['Shared dashboard', 'Monthly report', 'Next-phase plan'] }
];

const faqs = [
  {
    q: 'What is a crypto go-to-market strategy?',
    a: 'It is the plan for how a crypto, Web3 or fintech product reaches its first users, investors and partners: positioning, launch timeline, channels, budget and the team that runs it. A good plan covers pre-launch, launch week and the months after, not just the announcement.'
  },
  {
    q: 'How is this different from your individual services?',
    a: `Our individual services, such as <a href="/services/kol-marketing/" class="${linkClass}">KOL marketing</a>, <a href="/services/pr-media/" class="${linkClass}">PR</a> and <a href="/services/community-growth/" class="${linkClass}">community management</a>, cover one channel each. A go-to-market program combines them under one plan and one team lead, with a shared timeline and budget.`
  },
  {
    q: 'What does a dedicated Web3 growth team include?',
    a: 'Usually a strategy lead, a project manager and specialists for KOLs, PR, community and events, with business development and design support when needed. The mix depends on your phase and budget.'
  },
  {
    q: 'How do engagements work and how are they priced?',
    a: 'We offer monthly retainers, fixed-scope sprints and milestone-based programs. Pricing depends on scope, markets and channels, and is agreed in a written proposal before any work starts.'
  },
  {
    q: 'Can you work alongside our in-house marketing team?',
    a: 'Yes. Many clients keep an internal lead and use us for the channels, markets or launch moments they cannot cover alone. We share plans and reporting so both teams work from the same view.'
  },
  {
    q: 'Do you build products or only market them?',
    a: 'Our core is marketing, communications and business development. For websites, dashboards, AI workflows and similar builds we scope projects directly or coordinate trusted development partners.'
  },
  {
    q: 'Which markets can a go-to-market program cover?',
    a: `Global English-speaking audiences plus local execution in <a href="/blockchain-marketing-agency-vietnam/" class="${linkClass}">Vietnam</a>, <a href="/blockchain-marketing-agency-singapore/" class="${linkClass}">Singapore</a>, <a href="/blockchain-marketing-agency-dubai/" class="${linkClass}">Dubai and the UAE</a>, Indonesia, Thailand and India.`
  },
  {
    q: 'How quickly can you start?',
    a: 'After a discovery call we send a proposal, and work can start as soon as the scope is agreed. For launches we recommend starting well before the date so the community and narrative have time to build.'
  }
];

const META_DESCRIPTION =
  'Crypto and Web3 go-to-market strategy with a dedicated growth team. Fintech24h plans your launch and runs KOL, PR, community, events and BD as one program.';

const serviceSchema = buildServiceSchema({
  name: 'Crypto & Web3 Go-To-Market Strategy',
  alternateName: ['Web3 GTM Strategy', 'Dedicated Web3 Growth Team', 'Custom Blockchain Marketing Programs', 'Crypto Launch Strategy'],
  serviceType: 'Go-to-market strategy',
  url: canonical,
  description: META_DESCRIPTION
});
const faqSchema = buildFaqSchema(faqs);
const combinedSchema = [serviceSchema, faqSchema];

const toneClass: Record<string, { bg: string; text: string; glow: string }> = {
  cyan: { bg: 'bg-[color-mix(in_srgb,var(--accent-cyan)_10%,transparent)]', text: 'text-[var(--accent-cyan)]', glow: '0, 200, 240' },
  purple: { bg: 'bg-[color-mix(in_srgb,var(--accent-purple)_10%,transparent)]', text: 'text-[var(--accent-purple)]', glow: '124, 92, 252' },
  green: { bg: 'bg-[color-mix(in_srgb,var(--color-success)_10%,transparent)]', text: 'text-[var(--color-success)]', glow: '16, 185, 129' }
};

const labelClass = 'font-mono text-xs text-[var(--text-secondary)] uppercase tracking-wider block';
const inputClass = 'w-full bg-[var(--surface-soft)] border border-[var(--border-default)] focus:border-[var(--accent-cyan)] focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--accent-cyan)] px-4 py-3 rounded-lg text-base text-[var(--text-primary)] transition-colors placeholder:text-[var(--text-muted)]';
---

<BaseLayout
  title="Crypto & Web3 Go-To-Market Strategy Agency | Fintech24h"
  description={META_DESCRIPTION}
  canonical={canonical}
  schema={combinedSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />
  <div class="relative overflow-hidden pt-32 pb-24 min-h-screen text-[var(--text-primary)] bg-[var(--bg-primary)]">

    <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-[color-mix(in_srgb,var(--accent-cyan)_5%,transparent)] blur-[150px] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-20 right-1/4 w-[500px] h-[500px] bg-[color-mix(in_srgb,var(--accent-purple)_5%,transparent)] blur-[150px] pointer-events-none" aria-hidden="true"></div>

    <!-- HERO: H1 = focus keyword, sentence builder, particle canvas -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-8">
        <Badge variant="cyan">GO-TO-MARKET &amp; CUSTOM PROGRAMS</Badge>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight uppercase leading-[1.1]">
          Crypto &amp; Web3 <span class="text-[var(--accent-cyan)] whitespace-nowrap">Go-To-Market</span> Strategy
        </h1>
        <p class="font-display text-lg sm:text-xl text-[var(--text-primary)]">
          One plan, one dedicated team, every channel your launch needs.
        </p>
        <p class="font-body text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed max-w-xl">
          We design and run go-to-market programs for crypto, Web3, fintech and AI companies, combining KOLs, PR, community, events and business development under one roadmap instead of five separate agencies.
        </p>

        <div class="relative bg-[var(--surface-soft)] border border-[var(--border-default)] p-6 sm:p-8 rounded-3xl backdrop-blur-xl shadow-2xl overflow-hidden">
          <div class="absolute -top-10 -right-10 w-40 h-40 bg-[var(--accent-cyan)] opacity-5 blur-3xl pointer-events-none" aria-hidden="true"></div>
          <p class="font-display text-base sm:text-xl leading-relaxed text-[var(--text-primary)]">
            I am looking for a
            <span class="relative inline-block mx-1">
              <label for="sb-service" class="sr-only">Solution type</label>
              <select id="sb-service" class="appearance-none bg-[var(--bg-secondary)] border-b-2 border-[var(--accent-cyan)] text-[var(--accent-cyan)] font-bold px-3 py-1 pr-6 rounded cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]">
                {categories.map((c, i) => <option value={c.id} selected={i === 0}>{c.title}</option>)}
              </select>
            </span>
            program, tailored for my
            <span class="relative inline-block mx-1">
              <label for="sb-client" class="sr-only">Organization type</label>
              <select id="sb-client" class="appearance-none bg-[var(--bg-secondary)] border-b-2 border-[var(--accent-purple)] text-[var(--accent-purple)] font-bold px-3 py-1 pr-6 rounded cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]">
                {segments.map((s, i) => <option value={s.id} selected={i === 0}>{s.single}</option>)}
              </select>
            </span>
            , to launch within
            <span class="relative inline-block mx-1">
              <label for="sb-timeline" class="sr-only">Timeline</label>
              <select id="sb-timeline" class="appearance-none bg-[var(--bg-secondary)] border-b-2 border-[var(--color-success)] text-[var(--color-success)] font-bold px-3 py-1 pr-6 rounded cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]">
                <option value="immediate" selected>a month</option>
                <option value="quarter">a quarter</option>
                <option value="flexible">six months or more</option>
              </select>
            </span>.
          </p>
          <div class="mt-8 flex flex-wrap gap-4 items-center justify-between border-t border-[var(--border-subtle)] pt-6">
            <p id="sb-recommendation" class="text-xs font-mono text-[var(--text-secondary)] tracking-wider" aria-live="polite">
              SUGGESTED MODULES: <span class="text-[var(--text-primary)] font-semibold uppercase">{categories[0].title}</span>
            </p>
            <button id="sb-action" type="button" class="btn-liquid-glass-primary px-5 py-3 text-xs font-bold tracking-widest">
              BUILD MY PLAN
            </button>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 flex justify-center items-center relative min-h-[350px] sm:min-h-[400px]" aria-hidden="true">
        <div class="absolute inset-0 bg-gradient-to-tr from-[color-mix(in_srgb,var(--accent-cyan)_5%,transparent)] to-[color-mix(in_srgb,var(--accent-purple)_5%,transparent)] rounded-full filter blur-2xl opacity-50"></div>
        <canvas id="particle-canvas" class="w-full max-w-[420px] aspect-square relative z-10"></canvas>
      </div>
    </section>

    <!-- DEFINITION -->
    <section class="mt-32 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5 space-y-4">
        <Badge variant="purple">THE BASICS</Badge>
        <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase tracking-wide">What a Crypto Go-To-Market Plan Includes</h2>
      </div>
      <div class="lg:col-span-7 space-y-5 font-body text-lg text-[var(--text-secondary)] leading-relaxed">
        <p class="text-[var(--text-primary)] text-xl">
          A crypto go-to-market strategy decides who you launch to, what you say, which channels carry the message, in what order, and with what budget. Fintech24h turns that plan into a program run by one dedicated team, from the first community post to the months after launch.
        </p>
        <p>
          Most Web3 launches fail on coordination, not ideas. KOLs post before the community is ready, PR lands after the listing, and nobody owns the follow-up. A single roadmap with one lead keeps every channel pointed at the same goal at the same time.
        </p>
        <p>
          We build go-to-market programs for token launches, DeFi and infrastructure protocols, exchanges, fintech companies, AI products and funds supporting their portfolios.
        </p>
      </div>
    </section>

    <!-- LAUNCH PHASES -->
    <section class="mt-32 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-4">
        <Badge variant="cyan">THE ROADMAP</Badge>
        <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase tracking-wide">Web3 Launch Phases We Plan For</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {phases.map((p, i) => (
          <div class="bento-card group relative p-8 rounded-3xl bg-[var(--surface-faint)] border border-[var(--border-subtle)] overflow-hidden transition-colors duration-300 hover:border-[var(--border-default)]">
            <div class="spotlight-glow absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style="background: radial-gradient(300px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(0, 200, 240, 0.06), transparent 80%);" aria-hidden="true"></div>
            <div class="relative z-10 space-y-4">
              <span class="font-mono text-xs text-[var(--accent-cyan)] tracking-widest" aria-hidden="true">PHASE 0{i + 1}</span>
              <h3 class="font-display text-2xl font-bold text-[var(--text-primary)] uppercase tracking-wide">{p.name}</h3>
              <p class="font-body text-base text-[var(--text-primary)]">{p.goal}</p>
              <ul class="space-y-2 pt-2 border-t border-[var(--border-subtle)]">
                {p.items.map((it) => (
                  <li class="flex gap-2 font-body text-base text-[var(--text-secondary)] leading-relaxed">
                    <span class="mt-2.5 w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] shrink-0" aria-hidden="true"></span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- WHY US (spotlight bento) -->
    <section class="mt-32 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-4">
        <Badge variant="purple">WHAT MAKES US DIFFERENT</Badge>
        <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase tracking-wide">Why a Dedicated Web3 Growth Team</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {differentiators.map((d) => (
          <div class="bento-card group relative p-8 rounded-3xl bg-[var(--surface-faint)] border border-[var(--border-subtle)] overflow-hidden transition-all duration-300 hover:-translate-y-1">
            <div class="spotlight-glow absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style={`background: radial-gradient(300px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(${toneClass[d.tone].glow}, 0.06), transparent 80%);`} aria-hidden="true"></div>
            <div class="spotlight-border absolute inset-0 rounded-3xl pointer-events-none" style={`background: radial-gradient(150px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(${toneClass[d.tone].glow}, 0.25), transparent 80%); padding: 1px; mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask-composite: xor; mask-composite: exclude;`} aria-hidden="true"></div>
            <div class="relative z-10 space-y-4">
              <div class={`w-10 h-10 rounded-full ${toneClass[d.tone].bg} flex items-center justify-center ${toneClass[d.tone].text}`} aria-hidden="true">
                {d.icon === 'check' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>}
                {d.icon === 'team' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
                {d.icon === 'coin' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
                {d.icon === 'globe' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>}
                {d.icon === 'chat' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>}
