<style>
  summary::-webkit-details-marker { display: none; }
  .faq-q { margin: 0; }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    /* Section entrances: one per section. */
    .reveal { opacity: 0.01; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal.revealed { opacity: 1; transform: translateY(0); }

    /* Hero mockup: the deal path draws once on load. */
    .pipeline-path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw-path 1.6s cubic-bezier(0.22, 1, 0.36, 1) 0.4s forwards; }

    /* Ambient: the monolith glow breathes slowly. */
    .monolith-glow { animation: glow-breathe 12s ease-in-out infinite; }

    /* Readiness list: rows settle in order, max 0.4s delay. */
    .readiness.reveal { transform: none; }
    .readiness li { opacity: 0; transform: translateY(10px); transition: opacity 0.5s ease-out, transform 0.5s ease-out; }
    .readiness.revealed li { opacity: 1; transform: translateY(0); }
    .readiness.revealed li:nth-child(2) { transition-delay: 0.1s; }
    .readiness.revealed li:nth-child(3) { transition-delay: 0.2s; }
    .readiness.revealed li:nth-child(4) { transition-delay: 0.3s; }
    .readiness.revealed li:nth-child(5) { transition-delay: 0.4s; }
  }

  @keyframes draw-path { to { stroke-dashoffset: 0; } }
  @keyframes glow-breathe {
    0%, 100% { opacity: 0.04; }
    50% { opacity: 0.08; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      items.forEach((el) => el.classList.add('revealed'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    items.forEach((el) => observer.observe(el));
  });
</script>
