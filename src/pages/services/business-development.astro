---
// src/pages/services/business-development.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import CalendlyEmbed from '../../components/ui/CalendlyEmbed.tsx';
import AnimatedCounter from '../../components/ui/AnimatedCounter.tsx';
import { services } from '../../data/services';

const service = services.find((s) => s.slug === 'business-development')!;

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: service.title, item: `https://fintech24h.com/services/${service.slug}` }
];
---

<BaseLayout
  title={`${service.title} | Tier-1 Exchange & VC Network`}
  description={service.shortDescription}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- 1. Hero Section -->
  <section class="relative min-h-[85vh] flex flex-col justify-center pt-32 pb-20 px-4 overflow-hidden">
    <!-- Ambient Background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute w-[600px] h-[600px] rounded-full" style="background:var(--gradient-glow-cyan); top:20%; left:-10%; animation:orb-pulse 11s ease-in-out infinite, orb-drift 16s ease-in-out infinite; filter:blur(70px); opacity:0.15"></div>
      <div class="absolute w-[500px] h-[500px] rounded-full" style="background:var(--gradient-glow-purple); bottom:-10%; right:10%; animation:orb-pulse 13s ease-in-out infinite 2s, orb-drift 18s ease-in-out infinite 5s; filter:blur(60px); opacity:0.15"></div>
      <div class="grid-pattern absolute inset-0 opacity-15"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto w-full text-center">
      <div class="inline-flex items-center gap-2 mb-8" data-hero-line>
        <div class="w-6 h-px bg-[var(--text-secondary)]"></div>
        <span class="font-mono text-xs text-[var(--text-secondary)] uppercase tracking-[0.15em]">
          VC Matching · Launchpad Onboarding · Exchange Listings
        </span>
        <div class="w-6 h-px bg-[var(--text-secondary)]"></div>
      </div>

      <h1 class="font-display font-bold max-w-5xl mx-auto" data-hero-line>
        <span class="block text-[clamp(2.5rem,5.5vw,5rem)] tracking-[-0.03em] leading-[1.05] text-[var(--text-primary)]">
          Strategic Capital.
        </span>
        <span class="block text-[clamp(2.5rem,5.5vw,5rem)] tracking-[-0.03em] leading-[1.05] bg-gradient-to-r from-[var(--text-primary)] via-[#a78bfa] to-[var(--accent-cyan)] bg-clip-text text-transparent pb-2">
          Global Distribution.
        </span>
      </h1>

      <p class="font-body text-[clamp(1.1rem,2vw,1.35rem)] text-[var(--text-secondary)] max-w-2xl mx-auto mt-8 mb-14 leading-relaxed" data-hero-line>
        {service.shortDescription}
      </p>

      <div class="flex justify-center" data-hero-line>
        <a href="#book-call" class="btn-primary px-8 py-4 text-base">
          Request Partnership Audit →
        </a>
      </div>

      <!-- Hero Stats -->
      <div class="mt-24 max-w-4xl mx-auto" data-animate="fade-up">
        <div class="grid grid-cols-3 divide-x divide-white/[0.06] bg-[var(--bg-glass)] border border-white/[0.06] rounded-2xl backdrop-blur-md">
          {service.metrics.map((m, i) => {
            const numStr = m.value.replace(/[^0-9.]/g, '');
            const suffix = m.value.replace(/[0-9.]/g, '');
            const prefix = m.value.includes('$') ? '$' : '';
            return (
              <div class="text-center px-4 py-8 md:px-8">
                <div class="font-display text-4xl md:text-5xl font-bold text-[var(--text-primary)] mb-2">
                  <AnimatedCounter target={parseFloat(numStr)} prefix={prefix} suffix={suffix} duration={1.5 + (i * 0.2)} client:visible />
                </div>
                <div class="font-mono text-xs md:text-sm text-[var(--text-muted)] uppercase tracking-widest">{m.label}</div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Services Grid (Asymmetric) -->
  <section class="py-24 relative z-10 border-t border-white/[0.03]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-20" data-animate="fade-up">
        <div class="inline-flex items-center gap-2">
          <div class="w-6 h-px bg-[var(--text-secondary)]"></div>
          <span class="font-mono text-xs text-[var(--text-secondary)] uppercase tracking-[0.12em]">Network Access</span>
          <div class="w-6 h-px bg-[var(--text-secondary)]"></div>
        </div>
        <h2 class="font-display text-h2 font-bold text-[var(--text-primary)]">
          The Deal <span class="bg-gradient-to-r from-[var(--text-primary)] to-[var(--accent-purple)] bg-clip-text text-transparent">Flow</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-12 lg:col-span-8 card-default p-8 md:p-12 border-[var(--text-primary)]/10 bg-gradient-to-br from-white/5 to-transparent relative group" data-animate="scale-in">
          <h3 class="font-display text-3xl font-bold text-[var(--text-primary)] mb-6">VC Pitching & Fundraising</h3>
          <p class="font-body text-[var(--text-secondary)] text-lg mb-8 leading-relaxed max-w-2xl">
            {service.longDescription}
          </p>
          <div class="flex gap-4">
            <span class="px-4 py-2 rounded-full border border-white/10 bg-white/5 font-mono text-xs text-white uppercase tracking-wider">Pitch Deck Audit</span>
            <span class="px-4 py-2 rounded-full border border-white/10 bg-white/5 font-mono text-xs text-white uppercase tracking-wider">Warm Intros</span>
          </div>
        </div>

        <div class="md:col-span-6 lg:col-span-4 card-default p-8 relative group flex flex-col justify-between" data-animate="scale-in">
          <div>
            <h3 class="font-display text-2xl font-bold text-[var(--text-primary)] mb-4">CEX Listings</h3>
            <p class="font-body text-[var(--text-secondary)] leading-relaxed">
              Fast-track introductions to listing teams at Tier-1 and Tier-2 centralized exchanges. We negotiate terms and handle the compliance friction.
            </p>
          </div>
          <div class="mt-8 font-mono text-4xl font-bold text-[var(--accent-cyan)]">25+</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Calendly Section -->
  <section id="book-call" class="py-24 relative">
    <div class="max-w-5xl mx-auto px-4">
      <div class="card-default p-8 lg:p-12 border-white/20 relative overflow-hidden bg-[var(--bg-secondary)]">
        <div class="text-center max-w-2xl mx-auto mb-10 relative z-10">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-4">
            Accelerate Market Entry
          </h2>
          <p class="text-lg text-[var(--text-secondary)] font-body">
            Book a 15-minute BD call. Let's discuss your current roadmap and identify which partners can unlock your next growth stage.
          </p>
        </div>
        <div class="relative z-10">
          <CalendlyEmbed client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    
    const heroLines = document.querySelectorAll('[data-hero-line]');
    if (heroLines.length) {
      gsap.fromTo(heroLines,
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.9, stagger: 0.1, ease: 'power3.out', delay: 0.1 }
      );
    }
  });
</script>
