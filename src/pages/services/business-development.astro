---
// src/pages/services/business-development.astro
// Focus keyword: "Web3 business development agency". Variants covered in
// H2/H3/FAQ: crypto business development, exchange listing support, VC and
// investor introductions, launchpad & market maker intros, partnerships,
// fintech BD. No case-study numbers and no listing/investment guarantees.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { buildServiceSchema, buildFaqSchema } from '../../lib/serviceSchema';
import FooterLeadForm from '../../components/sections/FooterLeadForm.astro';

const PAGE_URL = 'https://fintech24h.com/services/business-development/';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services/' },
  { name: 'Business Development', item: PAGE_URL }
];

const linkClass =
  'text-[var(--accent-cyan)] underline decoration-[color-mix(in_srgb,var(--accent-cyan)_40%,transparent)] underline-offset-4 hover:decoration-[var(--accent-cyan)] transition-colors duration-200 rounded-sm';

const problems = [
  { title: 'Cold Outreach Fails', desc: 'Web3 runs on trust and warm introductions. If nobody they trust introduces you, your email sits at the bottom of the pile.' },
  { title: 'Paper Partnerships', desc: 'A partnership that is only a shared tweet does nothing. Real partnerships bring liquidity, users or a working integration.' },
  { title: 'Premature Exchange Applications', desc: 'Applying before you are ready wastes your first impression. Exchanges look closely at compliance, liquidity and real activity.' },
  { title: 'No Local Network', desc: 'Entering Asian or Gulf markets with a purely Western playbook rarely works. Local relationships decide who gets a meeting.' },
  { title: 'Founders Stuck Doing BD', desc: 'When technical founders spend most of their week chasing partners, the product slows down. BD is a full-time job.' }
];

const steps = [
  { step: '01', title: 'Readiness Review', desc: 'Before any introduction, we look at your project the way an exchange, investor or partner will: documentation, token structure, legal setup, traction and story. We fix the gaps before we go to market.' },
  { step: '02', title: 'Target Mapping & Strategy', desc: 'We list the exchanges, investors, protocols and enterprise partners that fit your stage, map the decision-makers and define what each of them gains from working with you.' },
  { step: '03', title: 'Warm Introductions & Representation', desc: 'We introduce you through people they already trust, represent the project in early conversations and bring you into meetings with partners who are genuinely interested.' },
  { step: '04', title: 'Deal Structuring & Negotiation', desc: 'From listing terms to co-marketing agreements, we explain standard market terms, flag hidden costs and help you negotiate structures that fit your tokenomics and runway.' },
  { step: '05', title: 'Post-Deal Activation', desc: 'Signing is the start. We follow through on integrations, co-marketing and announcements so the partnership delivers what both sides agreed.' }
];

const services = [
  { title: 'Exchange listing readiness & introductions', desc: 'Readiness assessment, warm introductions to listing teams, application support and coordination with market makers and launch partners.' },
  { title: 'VC & investor introductions', desc: 'Curated introductions to funds, angels and family offices that invest in your stage and sector, plus deck and data-room feedback.' },
  { title: 'Launchpads & IDO partners', desc: 'Introductions to launchpads and launch platforms that fit your community and token design.' },
  { title: 'Market maker introductions', desc: 'Meetings with market makers and help comparing their terms, so liquidity arrangements are clear before launch.' },
  { title: 'Ecosystem partnerships & integrations', desc: 'Integrations with protocols, wallets, infrastructure providers and dApps that add real utility for your users.' },
  { title: 'Grants & accelerator programs', desc: 'Finding the Layer 1, Layer 2 and ecosystem grant or accelerator programs that match your roadmap, and preparing strong applications.' },
  { title: 'Regional market entry', desc: 'Acting as your local BD team in Southeast Asia and the UAE, with partners, media and communities in each market.' },
  { title: 'B2B sales for Web3 & fintech', desc: 'Pipeline building and qualified meetings for infrastructure, payments and enterprise-facing Web3 products.' }
];

const partnerTypes = [
  'Centralized exchanges', 'DEXs & launchpads', 'VCs, angels & family offices', 'Market makers',
  'Wallets & infrastructure', 'Layer 1 & Layer 2 ecosystems', 'Fintech & payment companies', 'Media, KOLs & communities'
];

const canPromise = [
  'Warm introductions to people who fit your goal',
  'An honest readiness review before you apply',
  'Representation in early conversations',
  'Advice on standard terms and hidden costs',
  'Follow-through after the deal is signed'
];

const cannotPromise = [
  'A guaranteed listing on any exchange',
  'A guaranteed investment or valuation',
  'Fake volume, wash trading or paid "listings"',
  'Partnerships that exist only on paper'
];

const readiness = [
  { title: 'Legal & compliance', desc: 'A clear entity, legal opinion on the token where needed, and KYC/AML ready for exchange review.' },
  { title: 'Token & smart contracts', desc: 'Audited contracts, a clear token distribution and vesting schedule that partners can understand.' },
  { title: 'Liquidity plan', desc: 'A realistic plan for market making and liquidity on day one and after.' },
  { title: 'Real users & community', desc: 'Activity that comes from real people, not bots or farmed wallets.' },
  { title: 'Documentation & story', desc: 'Up-to-date docs, deck and one-page summary that explain why you matter now.' }
];

const markets = [
  { name: 'Southeast Asia', href: '/blockchain-marketing-agency-singapore/', anchor: 'blockchain marketing agency in Singapore', desc: 'Partners, exchanges and investors across Singapore, Indonesia and Thailand.' },
  { name: 'Vietnam', href: '/blockchain-marketing-agency-vietnam/', anchor: 'blockchain marketing agency in Vietnam', desc: 'Our home market and a large retail crypto audience, with local partners and communities.' },
  { name: 'Dubai & UAE', href: '/blockchain-marketing-agency-dubai/', anchor: 'blockchain marketing agency in Dubai', desc: 'Free-zone partners, regional funds and exchanges active in the Gulf.' }
];

const related = [
  { href: '/services/event-marketing/', title: 'Crypto Event Marketing', desc: 'Meet partners and investors in person during conference weeks.' },
  { href: '/services/pr-media/', title: 'Blockchain PR', desc: 'Announce listings and partnerships with credible coverage.' },
  { href: '/services/custom-solutions/', title: 'Crypto Go-To-Market', desc: 'Combine BD with a full launch plan.' }
];

const guides = [
  { href: '/blog/top-venture-capitalist-funds-for-web-3-0-startups-a-comprehensive-guide-for-entrepreneurs', title: 'Venture capital funds for Web3 startups' },
  { href: '/blog/web3-b2b-partnerships-revolutionizing-collaboration-in-the-digital-era', title: 'How Web3 B2B partnerships work' },
  { href: '/blog/fi24h-dealmakers-club-a-thriving-ecosystem-for-blockchain-collaboration-growth-and-innovation', title: 'Inside the Fi24h DealMakers Club' }
];

const faqs = [
  {
    q: 'What does a Web3 business development agency do?',
    a: 'It opens and manages the relationships that grow a crypto project: exchanges, investors, launchpads, market makers, ecosystem partners and enterprise customers. That covers readiness reviews, warm introductions, representation, negotiation support and making sure partnerships are actually activated.'
  },
  {
    q: 'How are you different from an in-house BD hire?',
    a: 'A new BD hire usually spends months building a network from scratch. We start with existing relationships across exchanges, investors and protocols in Southeast Asia, the UAE and Europe, so you reach the right people sooner. Many teams use us alongside an in-house lead.'
  },
  {
    q: 'Can you guarantee an exchange listing?',
    a: 'No. No agency can guarantee a legitimate listing on a major exchange, and anyone who promises one is either misleading you or planning to use a venue with fake volume. We commit to warm introductions, a well-prepared application and active advocacy.'
  },
  {
    q: 'What does a project need before applying for an exchange listing?',
    a: 'Typically a clear legal entity and compliance setup, audited smart contracts, a transparent token distribution and vesting schedule, a liquidity and market-making plan, real user activity and up-to-date documentation. We review all of this before making introductions.'
  },
  {
    q: 'Do you introduce projects to VCs and investors?',
    a: `Yes. We introduce founders to funds, angels and family offices that invest in their stage and sector, and help prepare the deck and data room. Our <a href="/dealmakers/" class="${linkClass}">DealMakers' Club</a> also connects verified founders and investors.`
  },
  {
    q: 'How do you charge for BD services?',
    a: 'Usually a monthly retainer plus a success fee tied to agreed outcomes. In selected cases with strong long-term alignment we may consider part of the fee in tokens or equity, evaluated case by case.'
  },
  {
    q: 'Can you help with exchange and VC introductions in Singapore?',
    a: `Yes. Our <a href="/blockchain-marketing-agency-singapore/" class="${linkClass}">Singapore</a> coverage extends to partner introductions in Indonesia and Thailand as well.`
  },
  {
    q: 'Can you help with exchange and VC introductions in Dubai?',
    a: `Yes, including free-zone partners and regional funds active in <a href="/blockchain-marketing-agency-dubai/" class="${linkClass}">Dubai</a> and the wider UAE market.`
  },
  {
    q: 'Do you work with fintech companies as well as crypto projects?',
    a: 'Yes. We help fintech, payments and wallet companies find distribution partners, exchanges and enterprise customers, with messaging that respects what their licences allow.'
  },
  {
    q: 'What size projects do you work with?',
    a: 'From seed-stage teams that need their first ecosystem partners to established protocols looking for new exchanges, investors or regional expansion.'
  }
];

const META_DESCRIPTION =
  'Web3 and crypto business development agency. Fintech24h connects blockchain projects with exchanges, investors and ecosystem partners via warm introductions.';

const serviceSchema = buildServiceSchema({
  name: 'Web3 & Crypto Business Development',
  alternateName: ['Blockchain Business Development', 'Web3 Partnerships', 'Crypto Investor Introductions', 'Exchange Listing Support'],
  serviceType: 'Business development',
  url: PAGE_URL,
  description: META_DESCRIPTION
});

const faqSchema = buildFaqSchema(faqs);

const combinedSchema = [serviceSchema, faqSchema];

const eyebrow = 'font-mono text-xs text-[var(--text-secondary)] uppercase tracking-[0.2em] mb-6';
const h2Class = 'font-display text-[clamp(2rem,4vw,3rem)] font-light text-[var(--text-primary)] leading-[1.15]';
---

<BaseLayout
  title="Web3 & Crypto Business Development Agency | Fintech24h"
  description={META_DESCRIPTION}
  schema={combinedSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1: HERO (glass monolith, H1 = focus keyword; no entrance on the
       H1 container so it renders immediately for LCP) -->
  <section class="min-h-screen flex items-center justify-center pt-24 pb-12 px-4 bg-[var(--bg-primary)] relative">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[var(--bg-secondary)] pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-[1400px] w-full mx-auto bg-[var(--surface-faint)] border border-[var(--border-subtle)] backdrop-blur-3xl rounded-3xl p-8 md:p-16 lg:p-24 relative overflow-hidden shadow-2xl">
      <div class="monolith-glow absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] bg-[var(--accent-purple)] opacity-[0.04] blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <span class="inline-block px-4 py-2 rounded-full border border-[var(--border-default)] bg-[var(--surface-soft)] font-mono text-xs text-[var(--text-secondary)] uppercase tracking-[0.2em] mb-8">
            Strategic Advisory &amp; Execution
          </span>
          <h1 class="font-display font-light text-[clamp(2.5rem,4vw,4.5rem)] text-[var(--text-primary)] leading-[1.1] tracking-tight mb-6">
            Web3 &amp; Crypto<br/>
            <span class="font-bold">Business Development Agency</span>
          </h1>
          <p class="font-display text-[clamp(1.15rem,1.8vw,1.5rem)] text-[var(--text-primary)] mb-6">
            The relationships that take years to build. <span class="text-[var(--text-secondary)]">We already have them.</span>
          </p>
          <p class="font-body text-lg text-[var(--text-secondary)] max-w-xl leading-relaxed mb-10">
            In Web3, who you integrate with, where you list and who backs you matters as much as what you build. We work as an extension of your team to open doors to exchanges, investors and partners through warm introductions.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact/" class="bg-[var(--text-primary)] text-[var(--bg-primary)] px-8 py-4 rounded-xl font-medium hover:opacity-90 transition-opacity duration-200 text-center shadow-[0_0_20px_rgba(255,255,255,0.1)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]">
              Discuss BD Strategy
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 hidden lg:flex justify-end relative" aria-hidden="true">
          <!-- Decorative deal-flow dashboard (fixed dark surface, like the site's other mockups) -->
          <div class="pipeline w-full max-w-md bg-[#050508]/80 border border-[var(--border-default)] rounded-3xl p-6 shadow-2xl backdrop-blur-xl relative overflow-hidden" data-theme-surface="midnight">
            <div class="flex justify-between items-center mb-8 border-b border-[var(--border-subtle)] pb-4">
              <div class="flex items-center gap-3">
                <div class="relative w-8 h-8 rounded-full bg-gradient-to-br from-[var(--accent-purple)] to-purple-800 flex items-center justify-center">
                  <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                </div>
                <div>
                  <div class="font-mono text-xs text-white/60 tracking-widest">NETWORK</div>
                  <div class="font-display text-sm text-white font-medium">Deal Pipeline</div>
                </div>
              </div>
              <div class="px-3 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 font-mono text-xs">CONNECTED</div>
            </div>

            <div class="mb-8 relative h-32 flex items-center justify-between px-2">
              <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 300 128" preserveAspectRatio="none">
                <path d="M40 64 C 100 20, 200 100, 260 64" fill="none" stroke="rgba(167, 139, 250, 0.2)" stroke-width="2" stroke-dasharray="4 4" />
                <path class="pipeline-path" d="M40 64 C 100 20, 200 100, 260 64" fill="none" stroke="var(--accent-purple)" stroke-width="2" pathLength="1" />
              </svg>
              <div class="relative z-10 flex flex-col items-center gap-2">
                <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/15 flex items-center justify-center"><span class="text-white font-display font-bold">P</span></div>
                <span class="font-mono text-[11px] text-white/50">PROJECT</span>
              </div>
              <div class="relative z-10 flex flex-col items-center gap-2 mt-12">
                <div class="w-10 h-10 rounded-full bg-white/5 border border-white/15 flex items-center justify-center">
                  <svg class="w-4 h-4 text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                </div>
                <span class="font-mono text-[11px] text-white/50">INVESTORS</span>
              </div>
              <div class="relative z-10 flex flex-col items-center gap-2">
                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[color-mix(in_srgb,var(--accent-purple)_25%,transparent)] to-transparent border border-[color-mix(in_srgb,var(--accent-purple)_45%,transparent)] flex items-center justify-center">
                  <span class="text-[#b9a6ff] font-display font-bold text-lg">CEX</span>
                </div>
                <span class="font-mono text-[11px] text-[#b9a6ff]">EXCHANGE</span>
              </div>
            </div>

            <div class="space-y-3 font-mono text-xs">
              <div class="flex items-center gap-3 text-white/55 bg-white/5 rounded-lg p-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span><span>Readiness review shared with team</span></div>
              <div class="flex items-center gap-3 text-white/55 bg-white/5 rounded-lg p-2"><span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span><span>Warm intro sent to partner</span></div>
              <div class="flex items-center gap-3 text-white/85 bg-[color-mix(in_srgb,var(--accent-purple)_12%,transparent)] border border-[color-mix(in_srgb,var(--accent-purple)_30%,transparent)] rounded-lg p-2"><span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-purple)]"></span><span>Follow-up call booked</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: DEFINITION -->
  <section class="py-24 md:py-32 bg-[var(--bg-secondary)] relative">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 reveal">
        <p class={eyebrow}>The Basics</p>
        <h2 class={h2Class}>What Web3 Business Development <span class="font-bold">Covers</span></h2>
      </div>
      <div class="lg:col-span-7 space-y-6 font-body text-lg text-[var(--text-secondary)] leading-relaxed">
        <p class="text-[var(--text-primary)] text-xl leading-relaxed">
          Web3 business development is the work of opening the right doors for a crypto project: exchanges, investors, launchpads, market makers, ecosystem partners and enterprise customers. As a crypto business development agency, Fintech24h prepares you for those conversations, introduces you through people they trust and follows each deal through to activation.
        </p>
        <p>
          Crypto BD is relationship-driven. Listing teams, funds and protocols receive far more requests than they can read, and most decisions start with a trusted introduction. Being well prepared and introduced by the right person is often the difference between a meeting and silence.
        </p>
        <p>
          We work with token projects, DeFi and infrastructure protocols, gaming and NFT teams, exchanges and fintech companies, from seed stage to established protocols expanding into new markets.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 3: THE PROBLEM -->
  <section class="py-24 md:py-32 bg-[var(--bg-primary)] relative">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 reveal">
        <h2 class={`${h2Class} max-w-2xl`}>Why Most Web3 BD Efforts <span class="font-bold">Stall</span></h2>
        <p class="font-mono text-xs text-[var(--text-secondary)] uppercase tracking-[0.2em] mt-6 md:mt-0">Market Realities</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-1">
        {problems.map((item, i) => (
          <div class={`bg-[var(--surface-soft)] p-8 md:p-10 ${i === 3 ? 'md:col-span-2' : ''}`}>
            <div class="w-10 h-10 border border-[var(--border-default)] rounded-lg flex items-center justify-center mb-10" aria-hidden="true">
              <span class="font-mono text-xs text-[var(--text-secondary)]">0{i + 1}</span>
            </div>
            <h3 class="font-display text-2xl text-[var(--text-primary)] font-light mb-4">{item.title}</h3>
            <p class="font-body text-base text-[var(--text-secondary)] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4: SERVICES -->
  <section class="py-24 md:py-32 bg-[var(--bg-secondary)]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="text-center mb-16 reveal">
        <p class={eyebrow}>What We Do</p>
        <h2 class={h2Class}>Our Crypto Business Development <span class="font-bold">Services</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
        {services.map((s) => (
          <div class="bg-[var(--bg-primary)] border border-[var(--border-subtle)] rounded-2xl p-8 hover:border-[var(--border-default)] transition-colors duration-300">
            <h3 class="font-display text-xl text-[var(--text-primary)] font-medium mb-4">{s.title}</h3>
            <p class="font-body text-base text-[var(--text-secondary)] leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
      <ul class="mt-12 flex flex-wrap justify-center gap-3" aria-label="Partner types we connect you with">
        {partnerTypes.map((p) => (
          <li class="px-4 py-2 rounded-full border border-[var(--border-default)] bg-[var(--surface-soft)] font-mono text-sm text-[var(--text-secondary)]">{p}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SECTION 5: EXECUTION FRAMEWORK -->
  <section class="py-24 md:py-32 bg-[var(--bg-primary)]">
    <div class="max-w-5xl mx-auto px-4 md:px-8">
      <div class="text-center mb-20 reveal">
        <p class={eyebrow}>How We Work</p>
        <h2 class={h2Class}>The BD Execution <span class="font-bold">Framework</span></h2>
      </div>
      <ol class="border-t border-[var(--border-default)]">
        {steps.map((item) => (
          <li class="group border-b border-[var(--border-default)] py-10 md:py-12 flex flex-col md:flex-row gap-6 md:gap-16 hover:bg-[var(--surface-faint)] transition-colors duration-300 px-6">
            <div class="font-mono text-sm text-[var(--text-secondary)] shrink-0 mt-1" aria-hidden="true">{item.step}</div>
            <div class="flex-1">
              <h3 class="font-display text-2xl md:text-3xl text-[var(--text-primary)] font-light mb-5">{item.title}</h3>
              <p class="font-body text-[var(--text-secondary)] text-lg leading-relaxed max-w-2xl">{item.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SECTION 6: WHAT WE CAN AND CANNOT PROMISE -->
  <section class="py-24 md:py-32 bg-[var(--bg-secondary)]">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div class="text-center mb-16 reveal">
        <p class={eyebrow}>Straight Talk</p>
        <h2 class={h2Class}>What We Promise, and What <span class="font-bold">Nobody Should</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-[var(--bg-primary)] border border-[var(--border-default)] rounded-2xl p-8 md:p-10">
          <h3 class="font-display text-xl text-[var(--text-primary)] font-medium mb-6">What we commit to</h3>
          <ul class="space-y-4">
            {canPromise.map((c) => (
              <li class="flex gap-3 font-body text-base text-[var(--text-secondary)] leading-relaxed">
                <svg class="w-5 h-5 mt-0.5 shrink-0 text-[var(--color-success)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[var(--bg-primary)] border border-[var(--border-default)] rounded-2xl p-8 md:p-10">
          <h3 class="font-display text-xl text-[var(--text-primary)] font-medium mb-6">What no honest agency can promise</h3>
          <ul class="space-y-4">
            {cannotPromise.map((c) => (
              <li class="flex gap-3 font-body text-base text-[var(--text-secondary)] leading-relaxed">
                <svg class="w-5 h-5 mt-0.5 shrink-0 text-[var(--color-danger)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6 6 18"/></svg>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 7: LISTING READINESS CHECKLIST -->
  <section class="py-24 md:py-32 bg-[var(--bg-primary)]">
    <div class="max-w-5xl mx-auto px-4 md:px-8">
      <div class="mb-14 reveal">
        <p class={eyebrow}>Before You Apply</p>
        <h2 class={h2Class}>Crypto Exchange Listing <span class="font-bold">Readiness Checklist</span></h2>
        <p class="mt-6 font-body text-lg text-[var(--text-secondary)] leading-relaxed max-w-2xl">
