---
// src/pages/services/business-development.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FooterLeadForm from '../../components/sections/FooterLeadForm.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: 'Business Development', item: `https://fintech24h.com/services/business-development` }
];

const faqs = [
  {
    q: "How are you different from an in-house BD hire?",
    a: "An in-house BD hire spends their first 6 months building a network from scratch. We come with an existing network of exchanges, investors, and protocols across Southeast Asia, UAE, and Europe. We plug you into that network immediately, reducing time-to-market."
  },
  {
    q: "Can you guarantee an exchange listing?",
    a: "No agency can guarantee a legitimate listing on a Tier 1 exchange. If someone promises that, they are either lying or planning to list you on an exchange with faked volume. What we guarantee is direct access to the decision-makers at target exchanges, a professionally structured application that meets their requirements, and active advocacy on your behalf."
  },
  {
    q: "Do you take equity or tokens as payment for BD services?",
    a: "We generally operate on a retainer + success fee model for BD engagements. In select cases where we see exceptional long-term alignment, we may consider a token/equity structure for a portion of the compensation. This is evaluated on a case-by-case basis."
  },
  {
    q: "What regions do you cover?",
    a: "Our core strength is in Southeast Asia (Vietnam, Thailand, Singapore, Indonesia), the UAE (Dubai/Abu Dhabi), and key European Web3 hubs. If you are a Western project looking to enter Asia, this is our exact specialty."
  },
  {
    q: "What size projects do you work with?",
    a: "We work with projects across the lifecycle — from seed-stage startups needing initial ecosystem partnerships, to established protocols looking for Tier 1 exchange listings or regional expansion."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Business Development",
  "provider": {
    "@type": "Organization",
    "name": "Fintech24h"
  },
  "url": "https://fintech24h.com/services/business-development",
  "description": "Open the doors that matter for your Web3 project. Fintech24h connects blockchain projects with strategic partners, investors, exchanges, and ecosystem players."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

const combinedSchema = [serviceSchema, faqSchema];
---

<BaseLayout
  title="Web3 Business Development — Partnerships & Investor Intros | Fintech24h"
  description="Open the doors that matter for your Web3 project. Fintech24h connects blockchain projects with strategic partners, investors, exchanges, and ecosystem players."
  schema={combinedSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO (Corporate Glass Monolith) -->
  <section class="min-h-screen flex items-center justify-center pt-24 pb-12 px-4 bg-[#0a0a0c] relative">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#121216] pointer-events-none"></div>
    
    <!-- Massive Glass Container -->
    <div class="max-w-[1400px] w-full mx-auto bg-white/[0.01] border border-white/5 backdrop-blur-3xl rounded-3xl p-8 md:p-16 lg:p-24 relative overflow-hidden shadow-2xl reveal">
      
      <!-- Subtle Purple Monolith Glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] bg-[#a78bfa] opacity-[0.03] blur-[120px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <span class="inline-block px-4 py-2 rounded-full border border-white/10 bg-white/5 font-mono text-[10px] text-white/70 uppercase tracking-[0.2em] mb-8">
            Strategic Advisory & Execution
          </span>
          <h1 class="font-display font-light text-[clamp(2.5rem,4vw,4.5rem)] text-white leading-[1.1] tracking-tight mb-8">
          The Relationships That Take Years to Build <br/>
          <span class="font-bold bg-clip-text text-transparent bg-gradient-to-r from-white to-white/50">— We Already Have Them.</span>
        </h1>
          <p class="font-body text-lg text-white/50 max-w-xl leading-relaxed mb-10 font-light">
            In Web3, who you integrate with, where you're listed, and who backs you is as important as what you've built. We operate as an extension of your team to secure the partnerships that drive real adoption.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#book-call" class="bg-white text-black px-8 py-4 rounded-xl font-medium hover:bg-white/90 transition-colors text-center shadow-[0_0_20px_rgba(255,255,255,0.1)]">
              Discuss BD Strategy
            </a>
          </div>
        </div>
        
        <div class="lg:col-span-5 hidden lg:flex justify-end relative">
          <!-- Abstract Monolith Graphic -->
          <div class="w-full max-w-sm aspect-[3/4] bg-gradient-to-br from-white/10 to-transparent border border-white/10 rounded-2xl p-6 flex flex-col justify-between backdrop-blur-md">
            <div class="flex justify-between items-start">
              <div class="w-12 h-12 rounded-full border border-white/20 flex items-center justify-center">
                <div class="w-4 h-4 bg-white/40 rounded-full"></div>
              </div>
              <span class="font-mono text-[10px] text-white/30">SECURE_NODE</span>
            </div>
            <div class="space-y-4">
              <div class="w-full h-1 bg-white/10 rounded-full overflow-hidden">
                <div class="w-3/4 h-full bg-white/50"></div>
              </div>
              <div class="w-full h-1 bg-white/10 rounded-full overflow-hidden">
                <div class="w-1/2 h-full bg-white/30"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — THE PROBLEM (Sleek Grid) -->
  <section class="py-32 bg-[#121216] relative">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-20 reveal">
        <h2 class="font-display text-4xl md:text-5xl font-light text-white max-w-2xl">
          Why Most Web3 BD Efforts <span class="font-bold text-white/50">Stall.</span>
        </h2>
        <p class="font-mono text-xs text-white/30 uppercase tracking-[0.2em] mt-6 md:mt-0">Market Realities</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-1">
        {[
          { title: 'Cold Outreach Fails', desc: 'Web3 runs on trust and warm introductions. If you aren\'t introduced by someone they already trust, you\'re at the bottom of the pile.' },
          { title: 'Paper Partnerships', desc: 'Announcing a partnership that consists only of a shared tweet is useless. It must drive liquidity, users, or tech integration.' },
          { title: 'Premature Exchange Apps', desc: 'Applying for listings before you are ready wastes your one shot at a good first impression. Exchanges care about compliance and volume.' },
          { title: 'Lack of Localization', desc: 'Entering Asian or UAE markets with a purely Western approach fails. Local networks control access.' },
          { title: 'Founders as BD', desc: 'When technical founders spend 80% of their time chasing partnerships, the product suffers. BD is a full-time function.' }
        ].map((item, i) => (
          <div class={`bg-white/[0.02] p-10 hover:bg-white/[0.04] transition-colors duration-500 reveal ${i === 3 ? 'md:col-span-2' : ''} ${i === 4 ? 'md:col-span-1' : ''}`} style={`transition-delay: ${i * 0.1}s`}>
            <div class="w-10 h-10 border border-white/10 rounded-lg flex items-center justify-center mb-16">
              <span class="font-mono text-xs text-white/40">0{i+1}</span>
            </div>
            <h3 class="font-display text-2xl text-white font-light mb-4">{item.title}</h3>
            <p class="font-body text-white/50 font-light leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — OUR APPROACH (Ultra-Clean Accordion List) -->
  <section class="py-32 bg-[#0a0a0c]">
    <div class="max-w-5xl mx-auto px-4 md:px-8">
      <div class="text-center mb-24 reveal">
        <h2 class="font-display text-4xl text-white font-light">The Execution Framework</h2>
      </div>

      <div class="space-y-0 border-t border-white/10">
        {[
          { step: '01', title: 'Asset Audit & Readiness Review', desc: 'Before making introductions, we audit your project through the lens of a potential partner or exchange. Are your metrics healthy? Is your documentation clear? Is your legal structure sound? We fix the gaps before we go to market.' },
          { step: '02', title: 'Target Mapping & Strategy', desc: 'We identify the specific exchanges, protocols, or enterprise partners that will move the needle for your project. We map the decision-makers, determine the value proposition for them, and define the engagement strategy.' },
          { step: '03', title: 'Warm Introductions & Representation', desc: 'We leverage our existing network to bypass the cold-email queue. We represent your project in initial conversations, filter out the noise, and only bring you into meetings with qualified, high-intent partners.' },
          { step: '04', title: 'Deal Structuring & Negotiation', desc: 'From exchange listing agreements to co-marketing partnerships, we advise on standard market terms, identify hidden costs, and help negotiate structures that align with your long-term tokenomics and runway.' },
          { step: '05', title: 'Post-Deal Activation', desc: 'Signing the partnership is the beginning, not the end. We oversee the activation phase — ensuring technical integrations happen, co-marketing is executed, and the partnership actually delivers the promised value.' }
        ].map((item, i) => (
          <div class="group border-b border-white/10 py-12 flex flex-col md:flex-row gap-8 md:gap-16 hover:bg-white/[0.01] transition-colors px-6 reveal">
            <div class="font-mono text-sm text-white/30 shrink-0 mt-1">{item.step}</div>
            <div class="flex-1">
              <h3 class="font-display text-3xl text-white font-light mb-6">{item.title}</h3>
              <p class="font-body text-white/50 text-lg leading-relaxed font-light max-w-2xl">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4 — SERVICES (Monolith Cards) -->
  <section class="py-32 bg-[#121216]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { title: 'Exchange Listings', desc: 'End-to-end management of the listing process. Readiness assessment, warm intros, application management, and market-making negotiation.' },
          { title: 'Ecosystem Partnerships', desc: 'Identifying and securing integrations with other protocols, wallets, infra providers, and dApps that increase utility.' },
          { title: 'Regional Market Entry', desc: 'Acting as your localized BD team in SE Asia and UAE. We navigate local culture and connect you with regional partners.' },
          { title: 'B2B Sales', desc: 'For enterprise-facing Web3 tools. We build the sales pipeline, manage outreach, and drive qualified leads to your tech team.' }
        ].map((s, i) => (
          <div class="bg-[#0a0a0c] border border-white/5 rounded-2xl p-8 hover:border-white/20 transition-all duration-500 reveal" style={`transition-delay: ${i * 0.1}s`}>
            <h3 class="font-display text-xl text-white font-medium mb-4">{s.title}</h3>
            <p class="font-body text-white/40 leading-relaxed font-light text-sm">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-32 bg-[#0a0a0c]">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="font-display text-3xl text-white font-light text-center mb-16 reveal">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="group bg-white/[0.02] border border-white/5 rounded-xl reveal" style={`transition-delay: ${i * 0.1}s`}>
            <summary class="flex justify-between items-center p-6 cursor-pointer list-none text-white/80 font-medium hover:text-white transition-colors">
              {faq.q}
              <span class="text-white/30 group-open:rotate-45 transition-transform duration-300">+</span>
            </summary>
            <div class="p-6 pt-0 text-white/50 font-light leading-relaxed">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION (Unified FooterLeadForm) -->
  <FooterLeadForm defaultService="Business Development" />

</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  .reveal { opacity: 0; transform: translateY(40px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .reveal.revealed { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>
