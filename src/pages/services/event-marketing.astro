---
// src/pages/services/event-marketing.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import ServiceInquiryForm from '../../components/ui/ServiceInquiryForm.tsx';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: 'Event Marketing', item: 'https://fintech24h.com/services/event-marketing' }
];

const faqs = [
  {
    q: "Do you handle booth design and fabrication?",
    a: "Yes. For major conferences like Token2049 or Consensus, we manage the entire booth lifecycle — from 3D conceptual design to local fabrication, logistics, and on-site assembly."
  },
  {
    q: "How do you ensure the right people show up to our side-events?",
    a: "We don't rely on open Eventbrite links. We use our proprietary CRM of VCs, founders, and KOLs to send targeted, personalized invitations. We manage the RSVP list rigorously to ensure a high-signal, low-noise environment."
  },
  {
    q: "Which regions do you cover for events?",
    a: "Our strongest physical presence is in Southeast Asia (Vietnam, Singapore, Thailand) and the UAE (Dubai). We have local vendors, venue partners, and VIP networks ready to activate in these hubs."
  },
  {
    q: "Do you provide on-site staff?",
    a: "Yes, we provide bilingual brand ambassadors, check-in staff, and technical coordinators to ensure your team can focus on networking rather than logistics."
  }
];
---

<BaseLayout
  title="Web3 Event Marketing & Side Events | Fintech24h"
  description="Host exclusive side-events, VC dinners, and hackathons. Fintech24h designs and manages high-impact offline experiences for Web3 projects."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO (Cinematic Spotlight) -->
  <section class="relative min-h-screen flex flex-col justify-center items-center px-4 overflow-hidden bg-[#020202]">
    <!-- Spotlight Effect -->
    <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[80vw] h-[80vh] bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.15),transparent_60%)] pointer-events-none"></div>
    <!-- Particles/Dust -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-20 pointer-events-none mix-blend-screen"></div>

    <div class="relative z-10 text-center max-w-5xl mx-auto mt-20">
      <div class="reveal">
        <p class="font-display text-[11px] uppercase tracking-[0.4em] text-white/50 mb-8">Premium Offline Experiences</p>
      </div>

      <h1 class="font-display font-light max-w-5xl mx-auto reveal reveal-delay-1">
        <span class="block text-[clamp(2.5rem,5vw,4.5rem)] tracking-widest text-white/40 uppercase mb-2">Digital Presence is Cheap.</span>
        <span class="block text-[clamp(3rem,6vw,5.5rem)] font-bold tracking-tight text-white uppercase drop-shadow-[0_0_30px_rgba(255,255,255,0.3)]">Real-World Authority is Earned.</span>
      </h1>

      <p class="font-body text-lg text-white/60 max-w-2xl mx-auto mt-8 mb-12 leading-[1.8] reveal reveal-delay-2 font-light">
        Conferences don't create opportunities — preparation and follow-through do. We handle every layer of event marketing, from Token2049 side-events to private VC dinners.
      </p>

      <div class="reveal reveal-delay-3">
        <a href="#book-call" class="inline-flex items-center justify-center border border-white/30 px-10 py-4 text-white font-mono text-xs uppercase tracking-[0.2em] hover:bg-white hover:text-black transition-all duration-500 backdrop-blur-sm">
          Plan Your Next Event
        </a>
      </div>
    </div>
    
    <!-- Cinematic Bottom Fade -->
    <div class="absolute bottom-0 w-full h-48 bg-gradient-to-t from-[#020202] to-transparent pointer-events-none"></div>
  </section>

  <!-- SECTION 2 — THE PROBLEM (Dark Minimal Text) -->
  <section class="py-32 bg-[#020202] relative z-10">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <h2 class="font-display text-2xl text-white/50 uppercase tracking-[0.2em] mb-16 reveal">Why Most Event Budgets Are Wasted</h2>
      
      <div class="space-y-16">
        {[
          { title: 'The Booth Trap', desc: 'Spending $50K on a conference booth just to collect spam emails and talk to retail investors who will never use your product.' },
          { title: 'Empty Side-Events', desc: 'Booking a luxury venue but relying on open Twitter links for RSVPs. You end up with 300 free-drink hunters and zero decision-makers.' },
          { title: 'Post-Event Amnesia', desc: 'Collecting 200 business cards and sending a generic follow-up email blast. No personalization means no closed deals.' }
        ].map((item, i) => (
          <div class="reveal" style={`transition-delay: ${i * 0.15}s`}>
            <h3 class="font-display text-[clamp(1.5rem,3vw,2.5rem)] text-white font-medium mb-4">{item.title}</h3>
            <p class="font-body text-white/40 max-w-2xl mx-auto text-lg leading-relaxed font-light">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — OUR APPROACH (Event Ticket Layout) -->
  <section class="py-32 bg-[#050505] relative z-10 border-y border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-24 reveal">
        <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] text-white uppercase tracking-wider font-bold">The Blueprint</h2>
        <div class="w-24 h-px bg-white/20 mx-auto mt-6"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8">
        {[
          { step: 'PHASE 01', title: 'Target Mapping & Strategy', desc: 'Months before the event, we identify exactly who you need to meet. We define the objective (fundraising, BD, or brand awareness) and design the physical experience backward from that goal.', time: 'T-Minus 60 Days' },
          { step: 'PHASE 02', title: 'Logistics & Fabrication', desc: 'We handle venue sourcing, booth fabrication, permits, AV setup, and F&B. You arrive in the city; everything is already built and tested.', time: 'T-Minus 30 Days' },
          { step: 'PHASE 03', title: 'Guest Curation', desc: 'We leverage our network to invite Tier-1 VCs, KOLs, and partners. We manually approve RSVPs to ensure the room is filled with high-intent individuals.', time: 'T-Minus 14 Days' },
          { step: 'PHASE 04', title: 'On-Site Execution & Follow-Up', desc: 'Our team manages check-in, flow, and VIP handling on the day. Afterward, we execute a segmented follow-up strategy to turn conversations into closed deals.', time: 'Event Day & Beyond' }
        ].map((item, i) => (
          <div class="relative bg-[#0a0a0a] border border-white/10 rounded-lg flex flex-col md:flex-row overflow-hidden group hover:border-white/30 transition-colors reveal">
            <!-- Ticket Left Tear -->
            <div class="hidden md:flex flex-col justify-between items-center w-16 bg-white/5 border-r border-white/10 border-dashed py-6 relative">
              <div class="w-6 h-6 rounded-full bg-[#050505] absolute -left-3 top-6 border-r border-white/10"></div>
              <div class="w-6 h-6 rounded-full bg-[#050505] absolute -left-3 bottom-6 border-r border-white/10"></div>
              <span class="transform -rotate-90 font-mono text-[10px] text-white/30 tracking-[0.3em] whitespace-nowrap">{item.time}</span>
            </div>
            
            <!-- Ticket Content -->
            <div class="p-8 md:p-10 flex-1">
              <span class="font-mono text-[10px] text-white/50 tracking-[0.2em] uppercase block mb-4">{item.step}</span>
              <h3 class="font-display text-2xl text-white font-medium mb-4 group-hover:text-white transition-colors">{item.title}</h3>
              <p class="font-body text-white/50 leading-relaxed font-light">{item.desc}</p>
            </div>
            
            <!-- Ticket Right Barcode -->
            <div class="hidden md:flex flex-col justify-center items-center w-20 bg-white/[0.02] border-l border-white/10">
              <div class="flex gap-1 h-24 opacity-20 group-hover:opacity-40 transition-opacity">
                <div class="w-1 h-full bg-white"></div>
                <div class="w-[2px] h-full bg-white"></div>
                <div class="w-2 h-full bg-white"></div>
                <div class="w-1 h-full bg-white"></div>
                <div class="w-[3px] h-full bg-white"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION (Cinematic Accordion) -->
  <section class="py-32 bg-[#020202]">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-20 reveal">
        <h2 class="font-display text-sm text-white/50 uppercase tracking-[0.3em]">Logistics & Operations</h2>
      </div>
      <div class="space-y-0 border-t border-white/10">
        {faqs.map((faq, i) => (
          <details class="group border-b border-white/10 reveal" style={`transition-delay: ${i * 0.1}s`}>
            <summary class="flex justify-between items-center py-8 cursor-pointer list-none">
              <span class="font-display text-xl text-white/70 group-hover:text-white transition-colors pr-8 font-light">{faq.q}</span>
              <span class="text-white/30 group-open:rotate-180 transition-transform duration-500 font-mono text-xl">↓</span>
            </summary>
            <div class="pb-8 pr-12 text-white/40 font-body text-base leading-relaxed font-light">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION (Spotlight Button) -->
  <section id="book-call" class="py-32 relative bg-[#050505] overflow-hidden text-center flex flex-col items-center border-t border-white/5">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.1),transparent_70%)] pointer-events-none"></div>
    <div class="max-w-2xl mx-auto px-6 relative z-10 reveal">
      <h2 class="font-display text-[clamp(2.5rem,4vw,4rem)] text-white uppercase tracking-tight mb-6 font-bold drop-shadow-[0_0_15px_rgba(255,255,255,0.2)]">Own The Room.</h2>
      <p class="font-body text-white/50 mb-12 text-lg font-light">Whether it's a 50-person VIP dinner or a 500-person afterparty, we ensure your brand leaves a lasting mark.</p>
      <ServiceInquiryForm client:load defaultService="Event Marketing" />
    </div>
  </section>

</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  .reveal { opacity: 0; filter: blur(10px); transform: translateY(30px); transition: opacity 0.8s ease, filter 0.8s ease, transform 0.8s ease; }
  .reveal.revealed { opacity: 1; filter: blur(0); transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; filter: none; transform: none; transition: none; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>
