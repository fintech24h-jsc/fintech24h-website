---
// src/pages/services/event-marketing.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import CalendlyEmbed from '../../components/ui/CalendlyEmbed.tsx';
import AnimatedCounter from '../../components/ui/AnimatedCounter.tsx';
import { services } from '../../data/services';

const service = services.find((s) => s.slug === 'event-marketing')!;

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: service.title, item: `https://fintech24h.com/services/${service.slug}` }
];

const eventTypes = [
  {
    title: 'Tier-1 Side Events',
    desc: 'Capitalize on major conferences like Token2049, Devcon, and Consensus. We host exclusive side-events that draw the highest-quality attendees away from the noise and directly into your brand experience.',
    icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>'
  },
  {
    title: 'Private VC Dinners',
    desc: 'Intimate, high-net-worth gatherings designed purely for deal-flow. We curate the guest list, source Michelin-level venues, and structure the evening to ensure you get face-time with the right capital allocators.',
    icon: '<path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line>'
  },
  {
    title: 'Hackathons & Builder Houses',
    desc: 'Accelerate ecosystem growth by putting developers in a room together. We handle venue logistics, technical mentorship coordination, and prize-pool marketing to attract top-tier Web3 engineers to your protocol.',
    icon: '<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>'
  }
];
---

<BaseLayout
  title={`${service.title} | Web3 Offline Experiences`}
  description={service.shortDescription}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- 1. Hero Section - Deep Immersive -->
  <section class="relative min-h-[90vh] flex flex-col justify-center pt-32 pb-20 px-4 overflow-hidden">
    <!-- Ambient Background: More dynamic for events -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute w-[800px] h-[800px] rounded-full" style="background:radial-gradient(ellipse, rgba(0,200,240,0.15) 0%, transparent 60%); top:-30%; left:-20%; animation:orb-pulse 8s ease-in-out infinite, orb-drift 12s ease-in-out infinite; filter:blur(60px);"></div>
      <div class="absolute w-[600px] h-[600px] rounded-full" style="background:radial-gradient(ellipse, rgba(124,92,252,0.15) 0%, transparent 60%); bottom:-10%; right:-10%; animation:orb-pulse 10s ease-in-out infinite 2s, orb-drift 14s ease-in-out infinite 3s; filter:blur(50px);"></div>
      <!-- Mesh grid overlay -->
      <div class="absolute inset-0" style="background-image:linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 64px 64px; animation:grid-shimmer 8s infinite;"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto w-full text-center">
      <div class="inline-flex items-center gap-2 mb-8" data-hero-line>
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
        <span class="font-mono text-xs text-white uppercase tracking-[0.2em] bg-white/10 px-4 py-1.5 rounded-full border border-white/20 backdrop-blur-md">
          Real-world Authority
        </span>
      </div>

      <h1 class="font-display font-bold max-w-5xl mx-auto" data-hero-line>
        <span class="block text-[clamp(2.5rem,5.5vw,5rem)] tracking-[-0.03em] leading-[1.05] text-[var(--text-primary)]">
          Digital Presence.
        </span>
        <span class="block text-[clamp(2.5rem,5.5vw,5rem)] tracking-[-0.03em] leading-[1.05] bg-gradient-to-r from-[var(--accent-cyan)] to-[#fdf8f6] bg-clip-text text-transparent pb-2">
          Physical Dominance.
        </span>
      </h1>

      <p class="font-body text-[clamp(1.1rem,2vw,1.35rem)] text-[var(--text-secondary)] max-w-2xl mx-auto mt-8 mb-12 leading-relaxed" data-hero-line>
        {service.longDescription.split('.')[0]}. {service.longDescription.split('.')[1]}.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-4" data-hero-line>
        <a href="#book-call" class="btn-primary px-8 py-4 text-base shadow-[0_0_32px_rgba(0,200,240,0.3)] hover:shadow-[0_0_60px_rgba(0,200,240,0.5)]">
          Plan Your Next Event →
        </a>
      </div>

      <!-- Hero Stats -->
      <div class="mt-20 max-w-4xl mx-auto" data-animate="fade-up">
        <div class="grid grid-cols-3 divide-x divide-white/[0.06] bg-black/40 border border-white/[0.1] rounded-2xl backdrop-blur-xl shadow-2xl">
          {service.metrics.map((m, i) => {
            const numStr = m.value.replace(/[^0-9.]/g, '');
            const suffix = m.value.replace(/[0-9.]/g, '');
            return (
              <div class="text-center px-4 py-8 md:px-8">
                <div class="font-display text-4xl md:text-5xl font-bold text-white mb-2">
                  <AnimatedCounter target={parseFloat(numStr)} suffix={suffix} duration={1.5 + (i * 0.2)} client:visible />
                </div>
                <div class="font-mono text-xs md:text-sm text-[var(--accent-cyan)] uppercase tracking-widest">{m.label}</div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Experiences Section (Masonry) -->
  <section class="py-24 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-20" data-animate="fade-up">
        <div class="inline-flex items-center gap-2">
          <div class="w-6 h-px bg-[var(--accent-cyan)]"></div>
          <span class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.12em]">Formats</span>
          <div class="w-6 h-px bg-[var(--accent-cyan)]"></div>
        </div>
        <h2 class="font-display text-h2 font-bold text-[var(--text-primary)]">
          Curated <span class="bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)] bg-clip-text text-transparent">Experiences</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        {eventTypes.map((event, i) => (
          <div class={`card-default p-8 md:p-12 border-[var(--accent-cyan)]/10 bg-[var(--bg-secondary)] relative group hover:bg-[var(--bg-tertiary)] transition-colors ${i === 0 ? 'md:col-span-12 lg:col-span-8' : i === 1 ? 'md:col-span-6 lg:col-span-4' : 'md:col-span-6 lg:col-span-12'}`} data-animate="scale-in">
            <div class="absolute inset-0 bg-gradient-to-br from-[var(--accent-cyan)]/0 to-[var(--accent-cyan)]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl pointer-events-none"></div>
            
            <div class="w-14 h-14 rounded-xl bg-white/[0.03] border border-white/[0.08] flex items-center justify-center mb-8 text-[var(--accent-cyan)] group-hover:scale-110 transition-transform duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={event.icon}></svg>
            </div>
            
            <h3 class="font-display text-2xl font-bold text-[var(--text-primary)] mb-4">{event.title}</h3>
            <p class="font-body text-[var(--text-secondary)] text-lg leading-relaxed max-w-3xl">
              {event.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Calendly Section -->
  <section id="book-call" class="py-24 relative">
    <div class="max-w-5xl mx-auto px-4">
      <div class="card-default p-8 lg:p-12 border-white/10 relative overflow-hidden bg-[var(--bg-secondary)]">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-10 pointer-events-none"></div>
        <div class="text-center max-w-2xl mx-auto mb-10 relative z-10">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-4">
            Secure Your Venue & Date
          </h2>
          <p class="text-lg text-[var(--text-secondary)] font-body">
            Book a 15-minute event strategy call. We'll discuss locations, guest list targeting, and budget requirements for your next offline activation.
          </p>
        </div>
        <div class="relative z-10">
          <CalendlyEmbed client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    
    const heroLines = document.querySelectorAll('[data-hero-line]');
    if (heroLines.length) {
      gsap.fromTo(heroLines,
        { opacity: 0, y: 30, filter: 'blur(10px)' },
        { opacity: 1, y: 0, filter: 'blur(0px)', duration: 1.2, stagger: 0.15, ease: 'power4.out', delay: 0.1 }
      );
    }
  });
</script>
