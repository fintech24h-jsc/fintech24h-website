<style>
  summary::-webkit-details-marker { display: none; }
  .faq-q { margin: 0; }

  /* Hero channel cards: theme tokens only, so light mode works. */
  .channel-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1.25rem 1rem;
    border-radius: 1rem;
    border: 1px solid var(--border-default);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    transition: border-color 0.3s ease-out, transform 0.3s ease-out;
  }
  .channel-card:hover {
    border-color: color-mix(in srgb, var(--accent-cyan) 25%, transparent);
    transform: translateY(-4px);
  }
  .channel-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--accent-cyan) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-cyan) 15%, transparent);
  }
  .channel-label {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }
  .channel-note {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-align: center;
  }

  /* Entrance: one per section. Hidden only when JS can reveal it; 0.01 (not 0)
     keeps the hero H1 eligible as LCP. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .reveal { opacity: 0.01; transform: translateY(20px); transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
    .reveal.revealed { opacity: 1; transform: translateY(0); }

    /* The chat thread is the problem section's single entrance: bubbles
       arrive in order like messages, last one at 0.45s. */
    .chat-thread.reveal { transform: none; }
    .chat-thread .chat-msg { opacity: 0; transform: translateY(12px); transition: opacity 0.5s ease-out, transform 0.5s ease-out; }
    .chat-thread.revealed .chat-msg { opacity: 1; transform: translateY(0); }
    .chat-thread.revealed .chat-msg:nth-child(2) { transition-delay: 0.09s; }
    .chat-thread.revealed .chat-msg:nth-child(3) { transition-delay: 0.18s; }
    .chat-thread.revealed .chat-msg:nth-child(4) { transition-delay: 0.27s; }
    .chat-thread.revealed .chat-msg:nth-child(5) { transition-delay: 0.36s; }
    .chat-thread.revealed .chat-msg:nth-child(6) { transition-delay: 0.45s; }

    /* Funnel: level bars fill left to right once, as part of the same entrance. */
    .funnel.reveal { transform: none; }
    .funnel .funnel-bar { transform: scaleX(0); transform-origin: left; transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.2s; }
    .funnel.revealed .funnel-bar { transform: scaleX(1); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      items.forEach((el) => el.classList.add('revealed'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    items.forEach((el) => observer.observe(el));
  });
</script>
