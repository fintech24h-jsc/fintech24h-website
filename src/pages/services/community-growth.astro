---
// src/pages/services/community-growth.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FooterLeadForm from '../../components/sections/FooterLeadForm.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: 'Community Growth', item: 'https://fintech24h.com/services/community-growth' }
];

const faqs = [
  {
    q: "How do you prevent airdrop farmers and Sybil attacks?",
    a: "We implement multi-layered Sybil defense. This includes linking Web2 accounts (Discord, Twitter) with minimum age requirements, utilizing on-chain reputation scores (like Gitcoin Passport or Galxe credentials), and actively monitoring IP clustering and wallet behavioral patterns to filter out bots."
  },
  {
    q: "Do you handle 24/7 moderation?",
    a: "Yes. Crypto never sleeps. We deploy a global team of moderators across different time zones to ensure your Discord and Telegram groups are always monitored, minimizing spam and answering user queries instantly."
  },
  {
    q: "Can you help transition a Web2 community to Web3?",
    a: "Absolutely. The key is education and frictionless onboarding. We design campaigns that teach your existing users how to set up wallets, interact with smart contracts, and earn their first on-chain rewards without overwhelming them with jargon."
  },
  {
    q: "What platforms do you manage?",
    a: "Our core focus is Discord (for core community and governance), Telegram (for rapid updates and local communities), and Zealy/Galxe/QuestN (for task-based growth and viral loops)."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Community Growth",
  "provider": {
    "@type": "Organization",
    "name": "Fintech24h"
  },
  "url": "https://fintech24h.com/services/community-growth",
  "description": "Build active, loyal communities that drive organic growth. Fintech24h manages Telegram and Discord communities."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

const combinedSchema = [serviceSchema, faqSchema];
---

<BaseLayout
  title="Web3 Community Growth & Management | Telegram, Discord | Fintech24h"
  description="Build active, loyal communities that drive organic growth. Fintech24h manages Telegram and Discord communities, runs ambassador programs, and creates engagement loops that work."
  schema={combinedSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO (Gamified Discord/Chat Style) -->
  <section class="relative min-h-[100vh] flex flex-col justify-center pt-32 pb-20 px-4 overflow-hidden bg-[#1E1F29]">
    <!-- Gamified Background Elements -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <!-- Floating Emojis / Badges -->
      <div class="absolute top-[20%] left-[10%] text-5xl animate-[float-slow_4s_ease-in-out_infinite] opacity-50 drop-shadow-[0_0_15px_rgba(255,255,255,0.5)]">🚀</div>
      <div class="absolute top-[40%] right-[15%] text-6xl animate-[float-fast_3s_ease-in-out_infinite_reverse] opacity-40 drop-shadow-[0_0_20px_rgba(88,101,242,0.8)]">💎</div>
      <div class="absolute bottom-[20%] left-[25%] text-4xl animate-[float-slow_5s_ease-in-out_infinite] opacity-60 drop-shadow-[0_0_10px_rgba(87,242,135,0.8)]">WAGMI</div>
      <div class="absolute bottom-[30%] right-[20%] text-5xl animate-[float-fast_4s_ease-in-out_infinite] opacity-30 drop-shadow-[0_0_15px_rgba(235,69,158,0.8)]">🔥</div>
      
      <!-- Abstract Discord-like Waves -->
      <svg class="absolute bottom-0 w-full h-auto text-[#2B2D31] opacity-50" viewBox="0 0 1440 320">
        <path fill="currentColor" fill-opacity="1" d="M0,224L48,213.3C96,203,192,181,288,186.7C384,192,480,224,576,218.7C672,213,768,171,864,144C960,117,1056,107,1152,112C1248,117,1344,139,1392,150.4L1440,160L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
      </svg>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto w-full text-center">
      <div class="inline-flex items-center justify-center gap-2 mb-8 bg-[#2B2D31] px-4 py-2 rounded-[8px] border border-white/5 shadow-lg reveal">
        <span class="w-3 h-3 rounded-full bg-[#57F287] animate-pulse"></span>
        <span class="font-mono text-sm text-white/80 font-bold tracking-wide">LFG // ONLINE</span>
      </div>

      <h1 class="font-display font-black max-w-5xl mx-auto reveal reveal-delay-1">
        <span class="block text-[clamp(2.5rem,6vw,5rem)] tracking-tight text-white mb-2" style="text-shadow: 0 4px 20px rgba(0,0,0,0.5);">
          A Community That Grows Your Project
        </span>
        <span class="block text-[clamp(2.5rem,6vw,5rem)] tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-[#5865F2] to-[#EB459E]" style="filter: drop-shadow(0 0 10px rgba(88,101,242,0.4));">
          — Not Just a Group That Gets Bigger.
        </span>
      </h1>

      <div class="max-w-2xl mx-auto mt-8 mb-12 p-6 bg-[#2B2D31]/80 backdrop-blur-md rounded-[16px] border border-white/10 shadow-2xl reveal reveal-delay-2 text-left relative overflow-hidden group">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#5865F2]"></div>
        <p class="font-body text-[16px] text-white/80 leading-[1.7]">
          <strong class="text-white">Daily active engagement</strong>, organic sharing, and community-led growth is what moves the needle. From anti-sybil airdrops to deep engagement tracking, we handle the entire funnel.
        </p>
      </div>

      <div class="flex justify-center reveal reveal-delay-3">
        <a href="#book-call" class="bg-[#5865F2] hover:bg-[#4752C4] text-white px-8 py-4 rounded-[8px] font-bold text-lg transition-colors flex items-center gap-3 shadow-[0_8px_20px_rgba(88,101,242,0.4)] hover:-translate-y-1 duration-300">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          Scale Your Community
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — THE PROBLEM (Chat Bubbles) -->
  <section class="py-20 bg-[#2B2D31] relative z-10 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-16 reveal">
        <h2 class="font-display text-3xl md:text-5xl font-black text-white">Why Most Communities Die</h2>
      </div>

      <div class="flex flex-col gap-6">
        {[
          { sender: 'Client', text: 'We have 50K members but no one is talking except bots saying "GM".', isUser: false },
          { sender: 'Fintech24h', text: 'That\'s the Bot & Bounty Trap. Airdrop hunters inflate numbers but destroy real engagement. You need anti-Sybil screening and value-based incentives.', isUser: true },
          { sender: 'Client', text: 'Our moderators just ban spam but don\'t actually guide the conversation.', isUser: false },
          { sender: 'Fintech24h', text: 'Moderators shouldn\'t just be janitors. They need to be community architects who ask questions, host voice AMAs, and foster genuine connections.', isUser: true },
          { sender: 'Client', text: 'Every time there is a dip, the community turns toxic.', isUser: false },
          { sender: 'Fintech24h', text: 'A lack of crisis management and transparent communication breeds FUD. You need a proactive narrative defense strategy before the dip happens.', isUser: true }
        ].map((msg, i) => (
          <div class={`flex ${msg.isUser ? 'justify-end' : 'justify-start'} reveal`} style={`transition-delay: ${i * 0.1}s`}>
            <div class={`max-w-[85%] md:max-w-[70%] p-5 rounded-2xl ${msg.isUser ? 'bg-[#5865F2] text-white rounded-tr-sm' : 'bg-[#1E1F29] text-white/90 rounded-tl-sm border border-white/5'}`}>
              <span class="block text-[10px] font-mono text-white/50 mb-1">{msg.sender}</span>
              <p class="font-body text-[15px] leading-relaxed">{msg.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — OUR APPROACH (Gamified Levels) -->
  <section class="py-24 bg-[#1E1F29] relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20 reveal">
        <h2 class="font-display text-3xl md:text-5xl font-black text-white">The Community Growth Funnel</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { level: 'LVL 1', title: 'Viral Loop Design', desc: 'We design Zealy/Galxe campaigns that require users to invite friends, create content, and engage deeply to earn roles, not just click buttons.', color: '#57F287' },
          { level: 'LVL 2', title: 'Sybil Defense', desc: 'We filter out bots and low-quality airdrop hunters using on-chain reputation scores, Discord age requirements, and CAPTCHA workflows.', color: '#FEE75C' },
          { level: 'LVL 3', title: 'Proactive Moderation', desc: 'Our 24/7 global team doesn\'t just delete spam. We spark conversations, answer technical questions, and identify power users.', color: '#EB459E' },
          { level: 'LVL 4', title: 'Advocate Activation', desc: 'We identify the top 1% of your community and recruit them into private Ambassador programs to scale your reach organically.', color: '#5865F2' }
        ].map((item, i) => (
          <div class="bg-[#2B2D31] rounded-[16px] p-6 border border-white/5 hover:-translate-y-2 transition-transform duration-300 relative overflow-hidden group reveal" style={`transition-delay: ${i * 0.15}s`}>
            <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${item.color}`}></div>
            <div class="w-12 h-12 rounded-[8px] flex items-center justify-center font-black text-black text-sm mb-6" style={`background-color: ${item.color}`}>
              {item.level}
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-3">{item.title}</h3>
            <p class="text-white/60 font-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION (Discord Channel Style) -->
  <section class="py-20 bg-[#2B2D31]">
    <div class="max-w-4xl mx-auto px-4 flex flex-col md:flex-row gap-8">
      <div class="w-full md:w-1/3 reveal">
        <h2 class="font-display text-2xl font-black text-white mb-6 uppercase"># faq-channel</h2>
        <div class="space-y-1 border-l-2 border-[#1E1F29] pl-3">
          <div class="py-2 text-[#5865F2] font-bold text-sm bg-[#1E1F29] px-3 rounded">1. Anti-Sybil</div>
          <div class="py-2 text-white/50 hover:text-white transition-colors text-sm px-3">2. Moderation</div>
          <div class="py-2 text-white/50 hover:text-white transition-colors text-sm px-3">3. Web2 to Web3</div>
          <div class="py-2 text-white/50 hover:text-white transition-colors text-sm px-3">4. Platforms</div>
        </div>
      </div>
      <div class="w-full md:w-2/3 space-y-4">
        {faqs.map((faq, i) => (
          <details class="bg-[#1E1F29] rounded-[8px] group reveal" style={`transition-delay: ${i * 0.1}s`}>
            <summary class="flex justify-between items-center p-5 cursor-pointer list-none font-bold text-white">
              <span class="flex items-center gap-2"><span class="text-white/30">Q:</span> {faq.q}</span>
              <span class="text-[#5865F2] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-5 pb-5 text-white/70 text-sm leading-relaxed border-t border-white/5 pt-3">
              <span class="text-[#57F287] font-bold">A:</span> {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION (Unified FooterLeadForm) -->
  <FooterLeadForm defaultService="Community Growth" />

</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.5s ease, transform 0.5s ease; }
  .reveal.revealed { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>
