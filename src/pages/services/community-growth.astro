---
// src/pages/services/community-growth.astro
// Focus keyword: "crypto community management agency". Variants covered in
// H2/H3/FAQ: Web3 community management, Telegram & Discord community
// management, ambassador program, NFT/DeFi community. No case-study numbers.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { buildServiceSchema, buildFaqSchema } from '../../lib/serviceSchema';
import FooterLeadForm from '../../components/sections/FooterLeadForm.astro';

const PAGE_URL = 'https://fintech24h.com/services/community-growth/';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services/' },
  { name: 'Community Management', item: PAGE_URL }
];

const linkClass =
  'text-[var(--accent-cyan)] underline decoration-[color-mix(in_srgb,var(--accent-cyan)_40%,transparent)] underline-offset-4 hover:decoration-[var(--accent-cyan)] transition-colors duration-200 rounded-sm';

// Hero channel cards (replaced the old member-count stat cards).
const channels = [
  { label: 'Telegram', note: 'Groups, channels & bots', icon: 'send' },
  { label: 'Discord', note: 'Servers, roles & governance', icon: 'chat' },
  { label: 'Quests & X', note: 'Campaigns, AMAs & Spaces', icon: 'spark' }
];

const chat = [
  { text: 'We have thousands of members but nobody talks except bots saying "GM".', isUser: false },
  { text: 'That is the Bot & Bounty Trap. Airdrop hunters inflate the count and drown out real users. You need Sybil screening and rewards tied to real contribution.', isUser: true },
  { text: 'Our moderators ban spam but never actually guide the conversation.', isUser: false },
  { text: 'Moderators should not just be janitors. They should ask questions, host AMAs, answer technical doubts and spot the members worth turning into ambassadors.', isUser: true },
  { text: 'Every time the market dips, the chat turns toxic.', isUser: false },
  { text: 'Silence breeds FUD. You need a crisis playbook and clear communication ready before the dip, not after it.', isUser: true }
];

const services = [
  {
    title: 'Telegram community management',
    desc: 'Group and announcement channel setup, anti-spam bots, pinned FAQs, welcome flows and daily moderation, with a tone that matches your brand.'
  },
  {
    title: 'Discord server setup & management',
    desc: 'Channel architecture, role and permission design, verification gates, ticket support, governance channels and bot integrations that scale with the project.'
  },
  {
    title: 'Moderation & support playbooks',
    desc: 'Written rules, escalation paths and answer libraries, with moderation shifts planned around the time zones your members actually live in.'
  },
  {
    title: 'Ambassador programs',
    desc: 'We find your most helpful members, give them clear roles and rewards, and run regular check-ins so advocates create content, translate and welcome newcomers.'
  },
  {
    title: 'Quests & growth campaigns',
    desc: 'Campaigns on Zealy, Galxe, QuestN or TaskOn that reward learning, product use and referrals, designed with Sybil filters so rewards reach real people.'
  },
  {
    title: 'AMAs, X Spaces & community events',
    desc: 'Founder AMAs, partner Spaces, trivia nights and launch-day watch parties that give members a reason to show up and stay.'
  },
  {
    title: 'Scam, impersonation & FUD defense',
    desc: 'Admin impersonation checks, fake-link filters, clear "we will never DM you" messaging and a prepared response for rumors, exploits and market drops.'
  },
  {
    title: 'Multilingual communities',
    desc: 'Local-language groups for Vietnam, Indonesia, Thailand and other markets, moderated by native speakers who understand local crypto culture.'
  },
  {
    title: 'Community analytics & reporting',
    desc: 'Regular reports on active participants, recurring questions, sentiment and ambassador output, so you see what the community is telling you.'
  }
];

const funnel = [
  {
    level: 'LVL 1',
    title: 'Viral Loop Design',
    desc: 'Quests on Zealy or Galxe that ask members to invite friends, create content and use the product to earn roles, not just click buttons.',
    bar: 'from-[var(--accent-cyan)] to-[var(--accent-cyan)]',
    badge: 'bg-[color-mix(in_srgb,var(--accent-cyan)_10%,transparent)] border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] text-[var(--accent-cyan)]'
  },
  {
    level: 'LVL 2',
    title: 'Sybil Defense',
    desc: 'We filter bots and low-quality airdrop hunters with on-chain reputation, account-age gates, verification flows and behavior checks.',
    bar: 'from-[var(--accent-cyan)] to-[var(--accent-purple)]',
    badge: 'bg-[color-mix(in_srgb,var(--accent-purple)_10%,transparent)] border-[color-mix(in_srgb,var(--accent-purple)_30%,transparent)] text-[var(--accent-purple)]'
  },
  {
    level: 'LVL 3',
    title: 'Proactive Moderation',
    desc: 'Moderators who start conversations, answer technical questions and flag the members who keep helping others.',
    bar: 'from-[var(--accent-purple)] to-[var(--accent-cyan)]',
    badge: 'bg-[color-mix(in_srgb,var(--accent-cyan)_10%,transparent)] border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] text-[var(--accent-cyan)]'
  },
  {
    level: 'LVL 4',
    title: 'Advocate Activation',
    desc: 'Your strongest members join a private ambassador program and carry the project into their own networks.',
    bar: 'from-[var(--accent-purple)] to-[var(--accent-purple)]',
    badge: 'bg-[color-mix(in_srgb,var(--accent-purple)_10%,transparent)] border-[color-mix(in_srgb,var(--accent-purple)_30%,transparent)] text-[var(--accent-purple)]'
  }
];

const platformRows = [
  { aspect: 'Best for', telegram: 'Fast announcements, price-sensitive communities and markets where Telegram is the default chat app', discord: 'Long-term builder and holder communities, support tickets and governance discussion' },
  { aspect: 'Structure', telegram: 'One main group plus announcement channel and local-language groups', discord: 'Many topic channels, roles and gated areas inside one server' },
  { aspect: 'Moderation', telegram: 'Bots for spam, captcha and link filters; heavy impersonation risk', discord: 'Fine-grained permissions, AutoMod and verification bots' },
  { aspect: 'Engagement', telegram: 'Quick AMAs, polls, launch-day chat', discord: 'Events, Stage channels, quests and role progression' }
];

const projectTypes = [
  { title: 'Token launch & airdrops', desc: 'Pre-launch waitlists, Sybil-filtered quests and a launch-day moderation plan, so the community survives the moment the token goes live.' },
  { title: 'DeFi & infrastructure protocols', desc: 'Technical support, documentation answers and governance channels for users who move real value and ask hard questions.' },
  { title: 'NFT & GameFi communities', desc: 'Lore, events, holder roles and creator programs for communities that come for culture and stay for each other.' },
  { title: 'Exchanges & wallets', desc: 'High-volume support, strict scam defense and clear escalation to your official support team.' },
  { title: 'Fintech apps moving into Web3', desc: 'Education-first onboarding that teaches existing users about wallets and on-chain rewards without drowning them in jargon.' }
];

const measures = [
  { title: 'Active participants', desc: 'Members who post, react or join events, instead of total member count.' },
  { title: 'Conversation quality', desc: 'Questions about the product and ecosystem, not only price and "wen" messages.' },
  { title: 'Newcomer retention', desc: 'Whether new members are still around after their first weeks.' },
  { title: 'Support response', desc: 'How quickly and how well questions are answered, and what keeps coming up.' },
  { title: 'Sentiment', desc: 'The mood of the community over time, with early warning on emerging FUD.' },
  { title: 'Ambassador output', desc: 'Content, translations and welcomes produced by your advocates.' }
];

const groundRules = [
  'We never buy members, bots or fake engagement.',
  'You keep full admin ownership of every channel.',
  'Sensitive questions go to your team, never guessed by a moderator.',
  'Campaign rules and rewards are published and fair.'
];

const markets = [
  { name: 'Vietnam', href: '/blockchain-marketing-agency-vietnam/', anchor: 'blockchain marketing agency in Vietnam', desc: 'Vietnamese Telegram and Facebook communities run by our Ho Chi Minh City team.' },
  { name: 'Singapore & Southeast Asia', href: '/blockchain-marketing-agency-singapore/', anchor: 'blockchain marketing agency in Singapore', desc: 'Regional communities, including Indonesian and Thai groups moderated in the local language.' },
  { name: 'Dubai & UAE', href: '/blockchain-marketing-agency-dubai/', anchor: 'blockchain marketing agency in Dubai', desc: 'X and Telegram communities for projects building in the Gulf crypto scene.' }
];

const related = [
  { href: '/services/kol-marketing/', title: 'Crypto KOL & Influencer Marketing', desc: 'Bring new members in through trusted voices.' },
  { href: '/services/ai-marketing/', title: 'Crypto AI Marketing', desc: 'AI-assisted community support with human review.' },
  { href: '/services/pr-media/', title: 'Blockchain PR', desc: 'Give your community news worth talking about.' }
];

const guides = [
  { href: '/blog/crypto-community-management-agency-top-tier-growth-strategies-fintech24h', title: 'Crypto community management: growth strategies that work' },
  { href: '/blog/the-ultimate-guide-to-becoming-a-web3-community-manager', title: 'The guide to becoming a Web3 community manager' },
  { href: '/blog/telegram-business-features-launched-enhance-your-business-communication', title: 'Telegram business features for project teams' }
];

const faqs = [
  {
    topic: 'Scope',
    q: 'What does a crypto community management agency do?',
    a: 'It runs the day-to-day life of your Telegram, Discord and social communities: moderation, support answers, engagement, events, quests and ambassador programs. The aim is a community of real users who help each other and carry your project further, not just a large member count.'
  },
  {
    topic: 'Anti-Sybil',
    q: 'How do you prevent airdrop farmers and Sybil attacks?',
    a: 'We layer the defenses: account-age and verification gates, on-chain reputation signals such as Gitcoin Passport or Galxe credentials, behavior checks for clustered wallets and accounts, and rewards that require real contribution rather than simple clicks.'
  },
  {
    topic: 'Moderation',
    q: 'Do you cover moderation outside office hours?',
    a: 'Yes. We plan moderation shifts around the time zones where your members are active and agree the coverage level with you before launch, including extra cover for launches, listings and AMAs.'
  },
  {
    topic: 'Platforms',
    q: 'Should my project use Telegram or Discord?',
    a: 'Often both. Telegram suits fast announcements and markets where it is the default chat app. Discord suits long-term builder and holder communities with support tickets, roles and governance. We recommend a setup based on your audience and stage.'
  },
  {
    topic: 'Platforms',
    q: 'Which platforms do you manage?',
    a: 'Telegram and Discord as core channels, X for public conversation and Spaces, and quest platforms such as Zealy, Galxe, QuestN and TaskOn for task-based growth.'
  },
  {
    topic: 'Ambassadors',
    q: 'How does an ambassador program work?',
    a: 'We pick members who already help others, give them defined roles such as moderator, content creator or translator, set clear rewards and run regular check-ins. Good ambassador programs are small, active and well supported.'
  },
  {
    topic: 'Web2 to Web3',
    q: 'Can you help transition a Web2 community to Web3?',
    a: 'Yes. We design onboarding that teaches existing users how to set up a wallet, use smart contracts safely and earn their first on-chain rewards, step by step and without jargon.'
  },
  {
    topic: 'Crisis',
    q: 'How do you handle FUD, scams and impersonators?',
    a: 'We prepare a crisis playbook in advance, keep scam warnings pinned, filter fake links, check for admin impersonators and coordinate public statements with your team so members hear one consistent message.'
  },
  {
    topic: 'Regions',
    q: 'Do you manage communities across Southeast Asia and the UAE?',
    a: `Yes. We run Vietnamese, Indonesian and Thai groups with native-speaking moderators, and X and Telegram communities for projects in <a href="/blockchain-marketing-agency-dubai/" class="${linkClass}">Dubai and the wider UAE</a>.`
  },
  {
    topic: 'Reporting',
    q: 'How do you measure community growth?',
    a: 'We report on active participants, conversation quality, newcomer retention, support response, sentiment and ambassador output. Member count alone is easy to fake, so we never use it as the headline.'
  }
];

const META_DESCRIPTION =
  'Crypto and Web3 community management agency. Fintech24h runs Telegram and Discord moderation, engagement and ambassador programs that keep members active.';

const serviceSchema = buildServiceSchema({
  name: 'Crypto & Web3 Community Management',
  alternateName: ['Telegram Community Management', 'Discord Community Management', 'Web3 Community Growth', 'Crypto Ambassador Programs'],
  serviceType: 'Community management',
  url: PAGE_URL,
  description: META_DESCRIPTION
});

const faqSchema = buildFaqSchema(faqs);

const combinedSchema = [serviceSchema, faqSchema];

const eyebrowCyan = 'inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_5%,transparent)] mb-4';
const h2Class = 'font-display text-3xl md:text-5xl font-black text-[var(--text-primary)]';
---

<BaseLayout
  title="Crypto & Web3 Community Management Agency | Fintech24h"
  description={META_DESCRIPTION}
  schema={combinedSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1: HERO (H1 = focus keyword) -->
  <section class="relative min-h-[100vh] flex flex-col justify-center pt-32 pb-24 px-4 overflow-hidden bg-[var(--bg-primary)]">
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="bg-orb bg-orb-cyan  w-[700px] h-[700px] absolute -top-40 -right-40 opacity-15"></div>
      <div class="bg-orb bg-orb-purple w-[600px] h-[600px] absolute bottom-0 -left-40 opacity-12"></div>
      <div class="grid-pattern absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto w-full text-center">
      <div class="inline-flex items-center justify-center gap-2 mb-8 px-4 py-2 rounded-full border border-[color-mix(in_srgb,var(--accent-cyan)_25%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_5%,transparent)] backdrop-blur-md reveal">
        <span class="w-2.5 h-2.5 rounded-full bg-[#57F287] shadow-[0_0_8px_rgba(87,242,135,0.8)] animate-pulse" aria-hidden="true"></span>
        <span class="font-mono text-sm text-[var(--accent-cyan)] font-bold tracking-widest uppercase">LFG // Online</span>
      </div>

      <h1 class="font-display font-black max-w-5xl mx-auto reveal">
        <span class="block text-[clamp(2.5rem,6vw,5rem)] leading-[1.05] tracking-tight text-[var(--text-primary)] mb-2">
          Crypto &amp; Web3
        </span>
        <span class="block text-[clamp(2.5rem,6vw,5rem)] leading-[1.05] tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)]" style="filter: drop-shadow(0 0 18px rgba(0,200,240,0.3));">
          Community Management Agency
        </span>
      </h1>

      <div class="max-w-2xl mx-auto mt-8 mb-12 p-6 bg-[var(--bg-glass)] backdrop-blur-md rounded-2xl border border-[var(--border-default)] shadow-2xl reveal text-left relative overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-[var(--accent-cyan)] to-[var(--accent-purple)] rounded-l-full" aria-hidden="true"></div>
        <p class="font-display text-lg md:text-xl font-bold text-[var(--text-primary)] pl-2 mb-2">
          A community that grows your project, not just a group that gets bigger.
        </p>
        <p class="font-body text-base text-[var(--text-secondary)] leading-[1.75] pl-2">
          We run Telegram and Discord communities for crypto, DeFi, NFT and fintech projects: moderation, support, quests, AMAs and ambassador programs, with Sybil defense built in from day one.
        </p>
      </div>

      <div class="flex justify-center reveal">
        <a
          href="/contact/"
          class="relative inline-flex items-center gap-3 px-8 py-4 rounded-xl font-bold text-base text-[var(--bg-primary)] bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)] shadow-[0_8px_28px_rgba(0,200,240,0.35)] hover:shadow-[0_8px_36px_rgba(0,200,240,0.5)] hover:-translate-y-1 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          Scale Your Community
        </a>
      </div>

      <ul class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-4 reveal" aria-label="Channels we manage">
        {channels.map((c) => (
          <li class="channel-card">
            <span class="channel-icon" aria-hidden="true">
              {c.icon === 'send' && (
                <svg class="w-5 h-5 text-[var(--accent-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z"/></svg>
              )}
              {c.icon === 'chat' && (
                <svg class="w-5 h-5 text-[var(--accent-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              )}
              {c.icon === 'spark' && (
                <svg class="w-5 h-5 text-[var(--accent-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/></svg>
              )}
            </span>
            <span class="channel-label">{c.label}</span>
            <span class="channel-note">{c.note}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="absolute bottom-0 left-0 w-full pointer-events-none text-[var(--bg-secondary)]" aria-hidden="true">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full block" preserveAspectRatio="none">
        <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="currentColor"/>
      </svg>
    </div>
  </section>

  <!-- SECTION 2: DEFINITION -->
  <section class="py-24 bg-[var(--bg-secondary)] relative z-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 reveal">
        <div class={eyebrowCyan}>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]" aria-hidden="true"></span>
          <span class="text-xs font-mono font-medium text-[var(--accent-cyan)] uppercase tracking-widest">The Basics</span>
        </div>
        <h2 class={h2Class}>What Crypto Community Management Covers</h2>
      </div>
      <div class="lg:col-span-7 space-y-5 font-body text-lg text-[var(--text-secondary)] leading-relaxed">
        <p class="text-[var(--text-primary)] text-xl">
          Crypto community management is the daily work of turning a Telegram group or Discord server into a place people want to return to. As a Web3 community management agency, Fintech24h moderates, answers questions, runs events and quests, and builds ambassador programs, so your members learn the product, trust the team and invite others.
        </p>
        <p>
          A crypto community is not a fan page. It is your support desk, your feedback loop, your first line of defense against scams and FUD, and often the place where investors decide whether a project is alive. That is why the work needs real people who understand both the technology and the culture.
        </p>
        <p>
          We work with token projects, DeFi protocols, NFT and GameFi teams, exchanges, wallets and fintech companies moving into Web3, from the first week of a new server to communities that need a reset after a hard market.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 3: THE PROBLEM (chat bubbles type in once, in order) -->
  <section class="py-20 bg-[var(--bg-primary)] relative z-10 border-t border-[var(--border-subtle)]">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-16 reveal">
        <div class={eyebrowCyan}>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]" aria-hidden="true"></span>
          <span class="text-xs font-mono font-medium text-[var(--accent-cyan)] uppercase tracking-widest">Real Conversations</span>
        </div>
        <h2 class={h2Class}>Why Most Crypto Communities Die</h2>
      </div>

      <div class="chat-thread flex flex-col gap-5 reveal">
        {chat.map((msg) => (
          <div class={`chat-msg flex ${msg.isUser ? 'justify-end' : 'justify-start'}`}>
            {msg.isUser ? (
              <div class="max-w-[85%] md:max-w-[70%] p-5 rounded-2xl rounded-tr-sm border border-[color-mix(in_srgb,var(--accent-cyan)_25%,transparent)] bg-gradient-to-br from-[color-mix(in_srgb,var(--accent-cyan)_12%,transparent)] to-[color-mix(in_srgb,var(--accent-purple)_10%,transparent)] backdrop-blur-md shadow-[0_4px_20px_rgba(0,200,240,0.08)]">
                <span class="block text-xs font-mono text-[var(--accent-cyan)] mb-1.5 tracking-wider">Fintech24h</span>
                <p class="font-body text-base leading-relaxed text-[var(--text-primary)]">{msg.text}</p>
              </div>
            ) : (
              <div class="max-w-[85%] md:max-w-[70%] p-5 rounded-2xl rounded-tl-sm border border-[var(--border-default)] bg-[var(--bg-secondary)]">
                <span class="block text-xs font-mono text-[var(--text-muted)] mb-1.5 tracking-wider">Client</span>
                <p class="font-body text-base leading-relaxed text-[var(--text-secondary)]">{msg.text}</p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4: SERVICES -->
  <section class="py-24 bg-[var(--bg-secondary)] relative z-10 border-t border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <div class={eyebrowCyan}>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]" aria-hidden="true"></span>
          <span class="text-xs font-mono font-medium text-[var(--accent-cyan)] uppercase tracking-widest">What We Run</span>
        </div>
        <h2 class={h2Class}>Our Community Management Services</h2>
        <p class="mt-6 font-body text-lg text-[var(--text-secondary)] leading-relaxed max-w-2xl mx-auto">
          Take the full program or only the parts your team cannot cover in-house.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {services.map((item) => (
          <div class="relative bg-[var(--bg-glass)] rounded-2xl p-6 md:p-7 border border-[var(--border-default)] hover:border-[color-mix(in_srgb,var(--accent-cyan)_25%,transparent)] transition-colors duration-300">
            <h3 class="font-display text-lg font-bold text-[var(--text-primary)] mb-3">{item.title}</h3>
            <p class="font-body text-base text-[var(--text-secondary)] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5: GROWTH FUNNEL (gamified levels; bars fill once) -->
  <section class="py-24 bg-[var(--bg-primary)] relative z-10">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-purple w-[500px] h-[500px] absolute top-20 right-0 opacity-10"></div>
      <div class="grid-pattern absolute inset-0 opacity-15"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20 reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[color-mix(in_srgb,var(--accent-purple)_20%,transparent)] bg-[color-mix(in_srgb,var(--accent-purple)_5%,transparent)] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-purple)]" aria-hidden="true"></span>
          <span class="text-xs font-mono font-medium text-[var(--accent-purple)] uppercase tracking-widest">Growth Framework</span>
        </div>
        <h2 class={h2Class}>The Web3 Community Growth Funnel</h2>
      </div>

      <div class="funnel grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 reveal">
        {funnel.map((item) => (
