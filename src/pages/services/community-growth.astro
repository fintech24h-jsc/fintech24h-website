---
// src/pages/services/community-growth.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FooterLeadForm from '../../components/sections/FooterLeadForm.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services/' },
  { name: 'Community Growth', item: 'https://fintech24h.com/services/community-growth/' }
];

const faqs = [
  {
    q: "How do you prevent airdrop farmers and Sybil attacks?",
    a: "We implement multi-layered Sybil defense. This includes linking Web2 accounts (Discord, Twitter) with minimum age requirements, utilizing on-chain reputation scores (like Gitcoin Passport or Galxe credentials), and actively monitoring IP clustering and wallet behavioral patterns to filter out bots."
  },
  {
    q: "Do you handle 24/7 moderation?",
    a: "Yes. Crypto never sleeps. We deploy a global team of moderators across different time zones to ensure your Discord and Telegram groups are always monitored, minimizing spam and answering user queries instantly."
  },
  {
    q: "Can you help transition a Web2 community to Web3?",
    a: "Absolutely. The key is education and frictionless onboarding. We design campaigns that teach your existing users how to set up wallets, interact with smart contracts, and earn their first on-chain rewards without overwhelming them with jargon."
  },
  {
    q: "What platforms do you manage?",
    a: "Our core focus is Discord (for core community and governance), Telegram (for rapid updates and local communities), and Zealy/Galxe/QuestN (for task-based growth and viral loops)."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Community Growth",
  "provider": {
    "@type": "Organization",
    "name": "Fintech24h"
  },
  "url": "https://fintech24h.com/services/community-growth/",
  "description": "Build active, loyal communities that drive organic growth. Fintech24h manages Telegram and Discord communities."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

const combinedSchema = [serviceSchema, faqSchema];
---

<BaseLayout
  title="Web3 Community Growth & Management | Telegram, Discord | Fintech24h"
  description="Build active, loyal communities that drive organic growth. Fintech24h manages Telegram and Discord communities, runs ambassador programs, and creates engagement loops that work."
  schema={combinedSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
  ═══════════════════════════════════════════════════ -->
  <section class="relative min-h-[100vh] flex flex-col justify-center pt-32 pb-20 px-4 overflow-hidden bg-[var(--bg-primary)]">

    <!-- Brand ambient glows — matches other service pages -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="bg-orb bg-orb-cyan  w-[700px] h-[700px] absolute -top-40 -right-40 opacity-15"></div>
      <div class="bg-orb bg-orb-purple w-[600px] h-[600px] absolute bottom-0 -left-40 opacity-12"></div>
      <div class="grid-pattern absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto w-full text-center">

      <!-- Status badge -->
      <div class="inline-flex items-center justify-center gap-2 mb-8 px-4 py-2 rounded-full border border-[var(--accent-cyan)]/25 bg-[var(--accent-cyan)]/5 backdrop-blur-md reveal">
        <span class="w-2.5 h-2.5 rounded-full bg-[#57F287] shadow-[0_0_8px_rgba(87,242,135,0.8)] animate-pulse"></span>
        <span class="font-mono text-sm text-[var(--accent-cyan)] font-bold tracking-widest uppercase">LFG // Online</span>
      </div>

      <h1 class="font-display font-black max-w-5xl mx-auto reveal reveal-delay-1">
        <span class="block text-[clamp(2.5rem,6vw,5rem)] tracking-tight text-[var(--text-primary)] mb-2">
          A Community That Grows Your Project
        </span>
        <span class="block text-[clamp(2.5rem,6vw,5rem)] tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)]" style="filter: drop-shadow(0 0 18px rgba(0,200,240,0.3));">
          — Not Just a Group That Gets Bigger.
        </span>
      </h1>

      <!-- Glass description card -->
      <div class="max-w-2xl mx-auto mt-8 mb-12 p-6 bg-[var(--bg-glass)] backdrop-blur-md rounded-2xl border border-white/[0.07] shadow-2xl reveal reveal-delay-2 text-left relative overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-[var(--accent-cyan)] to-[var(--accent-purple)] rounded-l-full"></div>
        <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75] pl-2">
          <strong class="text-[var(--text-primary)]">Daily active engagement</strong>, organic sharing, and community-led growth is what moves the needle. From anti-sybil airdrops to deep engagement tracking, we handle the entire funnel.
        </p>
      </div>

      <!-- CTA -->
      <div class="flex justify-center reveal reveal-delay-3">
        <a
          href="/contact/"
          class="relative inline-flex items-center gap-3 px-8 py-4 rounded-xl font-bold text-base text-[var(--bg-primary)] bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)] shadow-[0_8px_28px_rgba(0,200,240,0.35)] hover:shadow-[0_8px_36px_rgba(0,200,240,0.5)] hover:-translate-y-1 transition-all duration-300"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          Scale Your Community
        </a>
      </div>

      <!-- 3 floating stat cards (replacing emoji) -->
      <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-4 reveal reveal-delay-3">
        <div class="stat-card group">
          <div class="stat-icon">
            <!-- People / community icon -->
            <svg class="w-5 h-5 text-[var(--accent-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 0 0-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 0 1 5.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 0 1 9.288 0M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
          </div>
          <div class="stat-value">+500K</div>
          <div class="stat-label">Community Members Built</div>
        </div>
        <div class="stat-card group">
          <div class="stat-icon">
            <!-- Clock / 24h icon -->
            <svg class="w-5 h-5 text-[var(--accent-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/></svg>
          </div>
          <div class="stat-value">24/7</div>
          <div class="stat-label">Global Moderation Coverage</div>
        </div>
        <div class="stat-card group">
          <div class="stat-icon">
            <!-- Grid / platforms icon -->
            <svg class="w-5 h-5 text-[var(--accent-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <div class="stat-value">6</div>
          <div class="stat-label">Platforms Managed</div>
        </div>
      </div>

    </div>

    <!-- Wave transition into next section -->
    <div class="absolute bottom-0 left-0 w-full pointer-events-none" aria-hidden="true">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="rgba(8,13,26,0.9)"/>
      </svg>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — THE PROBLEM (Chat Bubbles)
  ═══════════════════════════════════════════════════ -->
  <section class="py-20 bg-[var(--bg-secondary)] relative z-10 border-t border-white/[0.04]">
    <div class="max-w-4xl mx-auto px-4">

      <div class="text-center mb-16 reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--accent-cyan)]/20 bg-[var(--accent-cyan)]/5 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]"></span>
          <span class="text-xs font-mono font-medium text-[var(--accent-cyan)] uppercase tracking-widest">Real Conversations</span>
        </div>
        <h2 class="font-display text-3xl md:text-5xl font-black text-[var(--text-primary)]">Why Most Communities Die</h2>
      </div>

      <div class="flex flex-col gap-5">
        {[
          { sender: 'Client', text: 'We have 50K members but no one is talking except bots saying "GM".', isUser: false },
          { sender: 'Fintech24h', text: 'That\'s the Bot & Bounty Trap. Airdrop hunters inflate numbers but destroy real engagement. You need anti-Sybil screening and value-based incentives.', isUser: true },
          { sender: 'Client', text: 'Our moderators just ban spam but don\'t actually guide the conversation.', isUser: false },
          { sender: 'Fintech24h', text: 'Moderators shouldn\'t just be janitors. They need to be community architects who ask questions, host voice AMAs, and foster genuine connections.', isUser: true },
          { sender: 'Client', text: 'Every time there is a dip, the community turns toxic.', isUser: false },
          { sender: 'Fintech24h', text: 'A lack of crisis management and transparent communication breeds FUD. You need a proactive narrative defense strategy before the dip happens.', isUser: true }
        ].map((msg, i) => (
          <div class={`flex ${msg.isUser ? 'justify-end' : 'justify-start'} reveal`} style={`transition-delay: ${i * 0.08}s`}>
            {msg.isUser ? (
              <div class="max-w-[85%] md:max-w-[70%] p-5 rounded-2xl rounded-tr-sm border border-[var(--accent-cyan)]/25 bg-gradient-to-br from-[var(--accent-cyan)]/12 to-[var(--accent-purple)]/10 backdrop-blur-md shadow-[0_4px_20px_rgba(0,200,240,0.08)]">
                <span class="block text-[10px] font-mono text-[var(--accent-cyan)] mb-1.5 tracking-wider">Fintech24h</span>
                <p class="font-body text-[15px] leading-relaxed text-[var(--text-primary)]">{msg.text}</p>
              </div>
            ) : (
              <div class="max-w-[85%] md:max-w-[70%] p-5 rounded-2xl rounded-tl-sm border border-white/[0.06] bg-[var(--bg-primary)] shadow-inner">
                <span class="block text-[10px] font-mono text-[var(--text-muted)] mb-1.5 tracking-wider">Client</span>
                <p class="font-body text-[15px] leading-relaxed text-[var(--text-secondary)]">{msg.text}</p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 3 — OUR APPROACH (Gamified Levels)
  ═══════════════════════════════════════════════════ -->
  <section class="py-24 bg-[var(--bg-primary)] relative z-10">

    <!-- Ambient glow -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-purple w-[500px] h-[500px] absolute top-20 right-0 opacity-10"></div>
      <div class="grid-pattern absolute inset-0 opacity-15"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-20 reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--accent-purple)]/20 bg-[var(--accent-purple)]/5 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-purple)]"></span>
          <span class="text-xs font-mono font-medium text-[var(--accent-purple)] uppercase tracking-widest">Growth Framework</span>
        </div>
        <h2 class="font-display text-3xl md:text-5xl font-black text-[var(--text-primary)]">The Community Growth Funnel</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          {
            level: 'LVL 1',
            title: 'Viral Loop Design',
            desc: 'We design Zealy/Galxe campaigns that require users to invite friends, create content, and engage deeply to earn roles, not just click buttons.',
            bar: 'from-[var(--accent-cyan)] to-[var(--accent-cyan)]',
            badge: 'bg-[var(--accent-cyan)]/10 border-[var(--accent-cyan)]/30 text-[var(--accent-cyan)]'
          },
          {
            level: 'LVL 2',
            title: 'Sybil Defense',
            desc: 'We filter out bots and low-quality airdrop hunters using on-chain reputation scores, Discord age requirements, and CAPTCHA workflows.',
            bar: 'from-[var(--accent-cyan)] to-[var(--accent-purple)]',
            badge: 'bg-[var(--accent-purple)]/10 border-[var(--accent-purple)]/30 text-[var(--accent-purple)]'
          },
          {
            level: 'LVL 3',
            title: 'Proactive Moderation',
            desc: 'Our 24/7 global team doesn\'t just delete spam. We spark conversations, answer technical questions, and identify power users.',
            bar: 'from-[var(--accent-purple)] to-[var(--accent-cyan)]',
            badge: 'bg-[var(--accent-cyan)]/10 border-[var(--accent-cyan)]/30 text-[var(--accent-cyan)]'
          },
          {
            level: 'LVL 4',
            title: 'Advocate Activation',
            desc: 'We identify the top 1% of your community and recruit them into private Ambassador programs to scale your reach organically.',
            bar: 'from-[var(--accent-purple)] to-[var(--accent-purple)]',
            badge: 'bg-[var(--accent-purple)]/10 border-[var(--accent-purple)]/30 text-[var(--accent-purple)]'
          }
        ].map((item, i) => (
          <div
            class="relative bg-[var(--bg-glass)] rounded-2xl p-6 border border-white/[0.06] hover:border-[var(--accent-cyan)]/25 hover:-translate-y-2 transition-all duration-300 overflow-hidden group reveal"
            style={`transition-delay: ${i * 0.12}s`}
          >
            <!-- Top gradient bar -->
            <div class={`absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r ${item.bar}`}></div>
            <!-- Hover glow -->
            <div class="absolute inset-0 bg-gradient-to-br from-[var(--accent-cyan)]/3 to-[var(--accent-purple)]/3 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl pointer-events-none"></div>

            <div class={`w-12 h-12 rounded-xl flex items-center justify-center font-black text-[11px] mb-6 border ${item.badge}`}>
              {item.level}
            </div>
            <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-3">{item.title}</h3>
            <p class="text-[var(--text-secondary)] font-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 4 — FAQ (Discord Channel Style)
  ═══════════════════════════════════════════════════ -->
  <section class="py-20 bg-[var(--bg-secondary)] border-t border-white/[0.04]">
    <div class="max-w-4xl mx-auto px-4 flex flex-col md:flex-row gap-10">

      <!-- Left: channel list -->
      <div class="w-full md:w-1/3 reveal">
        <h2 class="font-mono text-xl font-black text-[var(--text-primary)] mb-6 tracking-tight">
          <span class="text-[var(--accent-cyan)]">#</span> faq-channel
        </h2>
        <div class="space-y-1 border-l-2 border-white/[0.06] pl-3">
          <div class="py-2 text-[var(--accent-cyan)] font-bold text-sm bg-[var(--accent-cyan)]/8 px-3 rounded-lg border border-[var(--accent-cyan)]/15">
            1. Anti-Sybil
          </div>
          <div class="py-2 text-[var(--text-muted)] hover:text-[var(--text-secondary)] transition-colors text-sm px-3 cursor-default">2. Moderation</div>
          <div class="py-2 text-[var(--text-muted)] hover:text-[var(--text-secondary)] transition-colors text-sm px-3 cursor-default">3. Web2 to Web3</div>
          <div class="py-2 text-[var(--text-muted)] hover:text-[var(--text-secondary)] transition-colors text-sm px-3 cursor-default">4. Platforms</div>
        </div>
      </div>

      <!-- Right: FAQ items -->
      <div class="w-full md:w-2/3 space-y-3">
        {faqs.map((faq, i) => (
          <details class="bg-[var(--bg-primary)] rounded-xl border border-white/[0.06] group reveal" style={`transition-delay: ${i * 0.08}s`}>
            <summary class="flex justify-between items-center p-5 cursor-pointer list-none font-bold text-[var(--text-primary)] hover:text-[var(--accent-cyan)] transition-colors">
              <span class="flex items-center gap-2 text-sm">
                <span class="text-[var(--text-muted)] font-mono">Q:</span>
                {faq.q}
              </span>
              <svg class="w-4 h-4 text-[var(--accent-cyan)] shrink-0 ml-3 transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-5 pb-5 text-[var(--text-secondary)] text-sm leading-relaxed border-t border-white/[0.05] pt-3">
              <span class="text-[#57F287] font-bold font-mono">A:</span> {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <FooterLeadForm defaultService="Community Growth" />

</BaseLayout>

<style>
  /* ── FAQ details marker ── */
  summary::-webkit-details-marker { display: none; }

  /* ── Stat cards (replacing floating emoji) ── */
  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem 1rem;
    border-radius: 1rem;
    border: 1px solid rgba(255,255,255,0.06);
    background: rgba(8,13,26,0.6);
    backdrop-filter: blur(12px);
    transition: border-color 0.3s, transform 0.3s;
  }
  .stat-card:hover {
    border-color: rgba(0,200,240,0.25);
    transform: translateY(-4px);
  }
  .stat-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,200,240,0.08);
    border: 1px solid rgba(0,200,240,0.15);
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }
  .stat-label {
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
  }

  /* ── Scroll reveal ── */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .reveal.revealed { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.10s; }
  .reveal-delay-2 { transition-delay: 0.20s; }
  .reveal-delay-3 { transition-delay: 0.30s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>
