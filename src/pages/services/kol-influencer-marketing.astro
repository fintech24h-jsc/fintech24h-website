---
// src/pages/services/kol-influencer-marketing.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import ServiceInquiryForm from '../../components/ui/ServiceInquiryForm.tsx';
import AnimatedCounter from '../../components/ui/AnimatedCounter.tsx';
import { services } from '../../data/services';

const service = services.find((s) => s.slug === 'kol-influencer-marketing')!;

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: service.title, item: `https://fintech24h.com/services/${service.slug}` }
];
---

<BaseLayout
  title={`${service.title} | Tier-1 Crypto & Web3 Marketing`}
  description={service.shortDescription}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- 1. Custom Hero Section -->
  <section class="relative min-h-[85vh] flex flex-col justify-center pt-32 pb-20 px-4 overflow-hidden">
    <!-- Ambient Background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute w-[600px] h-[600px] rounded-full" style="background:var(--gradient-glow-cyan); top:-20%; left:-10%; animation:orb-pulse 10s ease-in-out infinite, orb-drift 15s ease-in-out infinite; filter:blur(50px); opacity:0.18"></div>
      <div class="absolute w-[500px] h-[500px] rounded-full" style="background:var(--gradient-glow-purple); bottom:0%; right:-10%; animation:orb-pulse 12s ease-in-out infinite 2s, orb-drift 18s ease-in-out infinite 4s; filter:blur(60px); opacity:0.12"></div>
      <div class="grid-pattern absolute inset-0 opacity-15"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto w-full text-center">
      <div class="inline-flex items-center gap-2 mb-8" data-hero-line>
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span>
        <span class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.15em]">
          Global Network · Tier-1 & Tier-2 Markets
        </span>
      </div>

      <h1 class="font-display font-bold max-w-5xl mx-auto" data-hero-line>
        <span class="block text-[clamp(3rem,6vw,5.5rem)] tracking-[-0.03em] leading-[1.05] text-[var(--text-primary)]">
          Massive Reach.
        </span>
        <span class="block text-[clamp(3rem,6vw,5.5rem)] tracking-[-0.03em] leading-[1.05] bg-gradient-to-r from-[var(--accent-cyan)] via-[#60a5fa] to-[#a78bfa] bg-clip-text text-transparent pb-2">
          Verified Conversions.
        </span>
      </h1>

      <p class="font-body text-[clamp(1.1rem,2vw,1.35rem)] text-[var(--text-secondary)] max-w-2xl mx-auto mt-8 mb-14 leading-relaxed" data-hero-line>
        {service.shortDescription}
      </p>

      <div class="flex justify-center" data-hero-line>
        <a href="#book-call" class="btn-primary px-8 py-4 text-base">
          Request Network Audit →
        </a>
      </div>

      <!-- Hero Stats -->
      <div class="mt-24 max-w-4xl mx-auto" data-animate="fade-up">
        <div class="grid grid-cols-3 divide-x divide-white/[0.06] bg-[var(--bg-glass)] border border-white/[0.06] rounded-2xl backdrop-blur-md">
          {service.metrics.map((m, i) => {
            const numStr = m.value.replace(/[^0-9.]/g, '');
            const suffix = m.value.replace(/[0-9.]/g, '');
            return (
              <div class="text-center px-4 py-8 md:px-8">
                <div class="font-display text-4xl md:text-5xl font-bold text-[var(--accent-cyan)] mb-2">
                  <AnimatedCounter target={parseFloat(numStr)} suffix={suffix} duration={1.5 + (i * 0.2)} client:visible />
                </div>
                <div class="font-mono text-xs md:text-sm text-[var(--text-muted)] uppercase tracking-widest">{m.label}</div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Asymmetric Features Section -->
  <section class="py-24 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-16" data-animate="fade-up">
        <div class="inline-flex items-center gap-2">
          <div class="w-6 h-px bg-[var(--accent-cyan)]"></div>
          <span class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.12em]">Execution</span>
          <div class="w-6 h-px bg-[var(--accent-cyan)]"></div>
        </div>
        <h2 class="font-display text-h2 font-bold text-[var(--text-primary)]">
          How We Drive <span class="text-gradient">Adoption</span>
        </h2>
      </div>

      <!-- Asymmetric Grid (2+1) from design system -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Featured Card (wide) -->
        <div class="md:col-span-2 card-default p-8 md:p-12 border-[var(--accent-cyan)]/20 bg-gradient-to-br from-[var(--accent-cyan)]/5 to-transparent relative group" data-animate="scale-in">
          <div class="absolute top-6 right-6 font-mono text-4xl font-bold text-white/5 group-hover:text-[var(--accent-cyan)]/10 transition-colors">01</div>
          <h3 class="font-display text-2xl font-bold text-[var(--text-primary)] mb-4">Strategic Targeting & Onboarding</h3>
          <p class="font-body text-[var(--text-secondary)] text-lg mb-6 leading-relaxed max-w-xl">
            {service.longDescription}
          </p>
          <ul class="space-y-3 font-body text-[var(--text-secondary)]">
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[var(--color-success)] shrink-0 mt-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Strict Sybil & Bot Filtering</li>
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[var(--color-success)] shrink-0 mt-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Audience Sentiment Alignment</li>
          </ul>
        </div>
        
        <!-- Small Card 2 -->
        <div class="card-default p-8 relative group" data-animate="scale-in">
          <div class="absolute top-6 right-6 font-mono text-4xl font-bold text-white/5 group-hover:text-white/10 transition-colors">02</div>
          <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-4 mt-8">Regional Penetration</h3>
          <p class="font-body text-[var(--text-secondary)] text-base mb-6 leading-relaxed">
            Deeply localized campaigns that fit culture and language in Tier 1 and Tier 2 markets (Vietnam, UAE, Singapore).
          </p>
        </div>

        <!-- Small Card 3 -->
        <div class="card-default p-8 relative group" data-animate="scale-in">
          <div class="absolute top-6 right-6 font-mono text-4xl font-bold text-white/5 group-hover:text-white/10 transition-colors">03</div>
          <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-4 mt-8">Performance Tracking</h3>
          <p class="font-body text-[var(--text-secondary)] text-base mb-6 leading-relaxed">
            Real-time analytics on impressions, CTR, and on-chain conversion data. You pay for performance, not vanity metrics.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Inquiry Form Section (Đã thay thế Calendly) -->
  <section id="book-call" class="py-24 relative">
    <div class="max-w-3xl mx-auto px-4">
      <div class="p-8 lg:p-12 rounded-[24px] border border-[#ff5e62]/20 bg-gradient-to-br from-[rgba(255,94,98,0.05)] via-transparent to-transparent shadow-[0_15px_35px_rgba(255,94,98,0.06)] relative overflow-hidden">
        <div class="absolute inset-0 bg-radial-gradient(circle, rgba(255,94,98,0.05) 0%, transparent 70%) pointer-events-none"></div>
        <div class="text-center max-w-2xl mx-auto mb-10 relative z-10">
          <h2 class="font-display text-3xl font-bold text-[var(--text-primary)] mb-4">
            Khởi động chiến dịch KOLs của bạn
          </h2>
          <p class="text-sm text-[var(--text-secondary)] font-body">
            Điền thông tin khảo sát nhanh bên dưới, đội ngũ Fintech24h sẽ chuẩn bị bản phân tích KOLs mẫu và gửi lại cho bạn trong vòng 24h.
          </p>
        </div>
        <div class="relative z-10">
          <ServiceInquiryForm client:load defaultService={service.title} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Hero line-by-line reveal
    const heroLines = document.querySelectorAll('[data-hero-line]');
    if (heroLines.length) {
      gsap.fromTo(heroLines,
        { opacity: 0, y: 24, filter: 'blur(6px)' },
        { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.9, stagger: 0.1, ease: 'power3.out', delay: 0.1 }
      );
    }
  });
</script>
