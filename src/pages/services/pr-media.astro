---
// src/pages/services/pr-media.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import ServiceInquiryForm from '../../components/ui/ServiceInquiryForm.tsx';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: 'PR Campaigns', item: `https://fintech24h.com/services/pr-media` }
];

const faqs = [
  {
    q: "Do you guarantee placement in specific publications?",
    a: "We don't guarantee specific placements because editorial decisions are ultimately made by journalists and editors. What we can tell you is our pitch success rate with established outlet contacts is significantly higher than cold outreach, and we will always be transparent with you about what's realistic for your project."
  },
  {
    q: "What's the difference between sponsored and editorial coverage?",
    a: "Editorial (earned) coverage means a journalist chose to cover your story based on newsworthiness — it carries the highest credibility. Sponsored coverage is paid placement, clearly labeled, and gives you more control over the content. We advise on the right mix for your objectives and budget."
  },
  {
    q: "How long does it take to secure coverage?",
    a: "Press release production and pitching takes 5–7 business days. Editorial lead times vary by publication — tier-1 outlets typically require 1–3 weeks from pitch to publication."
  },
  {
    q: "Can you handle PR in multiple languages?",
    a: "Yes. We produce content in English, Vietnamese, and through our partner network, Korean, Japanese, and Arabic for regional campaigns."
  },
  {
    q: "What if we have a crisis or negative coverage?",
    a: "Crisis PR is available as a standalone engagement. The earlier we're involved, the more options we have. Reach out directly for a confidential conversation."
  }
];
---

<BaseLayout
  title="Blockchain & Web3 PR Campaigns — Press Coverage That Builds Credibility | Fintech24h"
  description="Editorial placements in top-tier crypto and fintech media. Fintech24h writes, pitches, and places press coverage for Blockchain, DeFi, and Web3 projects across global media outlets."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO -->
  <section class="relative min-h-[100vh] flex flex-col justify-center pt-32 pb-20 px-4 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute w-[600px] h-[600px] rounded-full" style="background:var(--gradient-glow-purple); top:-20%; left:50%; transform:translateX(-50%); animation:orb-pulse 10s ease-in-out infinite; filter:blur(70px); opacity:0.06"></div>
      <div class="grid-pattern absolute inset-0 opacity-15"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto w-full text-center">
      <div class="inline-flex items-center justify-center mb-8 reveal reveal-delay-1">
        <span class="tag tag-purple font-mono text-xs uppercase tracking-[0.14em]">
          PR & MEDIA CAMPAIGNS
        </span>
      </div>

      <h1 class="font-display font-bold max-w-5xl mx-auto reveal reveal-delay-2">
        <span class="block text-[clamp(2.25rem,6vw,4.5rem)] tracking-[-0.02em] leading-[1.1] text-[var(--text-primary)]">
          Coverage in the Publications<br/>Your Investors Are Reading.
        </span>
      </h1>

      <p class="font-body text-[16px] text-[var(--text-secondary)] max-w-3xl mx-auto mt-6 mb-10 leading-[1.75] reveal reveal-delay-3">
        A press release distributed to 200 outlets nobody reads does nothing for your project. We place editorial coverage in media that actually moves perception — and builds the credibility that converts skeptics into stakeholders.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-4 reveal reveal-delay-4">
        <a href="#book-call" class="btn-primary">
          Request a PR Proposal
        </a>
        <a href="#media-network" class="btn-ghost">
          View Media Network
        </a>
      </div>

      <div class="mt-16 flex flex-wrap justify-center gap-4 reveal reveal-delay-4">
        <span class="glass-pill px-4 py-2 text-[13px] text-[var(--text-primary)] border border-white/10">Tier-1 editorial placements</span>
        <span class="glass-pill px-4 py-2 text-[13px] text-[var(--text-primary)] border border-white/10">50+ media outlets</span>
        <span class="glass-pill px-4 py-2 text-[13px] text-[var(--text-primary)] border border-white/10">Full content production</span>
        <span class="glass-pill px-4 py-2 text-[13px] text-[var(--text-primary)] border border-white/10">Coverage tracking & reporting</span>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — THE PROBLEM -->
  <section class="py-20 md:py-32 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-16 reveal">
        <p class="font-mono text-xs text-[#a78bfa] uppercase tracking-[0.14em]">WHY PR FAILS</p>
        <h2 class="font-display text-[clamp(1.5rem,3.5vw,2.75rem)] font-bold text-[var(--text-primary)] leading-[1.2]">
          What Goes Wrong With Most Crypto PR
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="card-default p-6 md:p-8 border-l-[2px] border-l-red-500/50 reveal reveal-delay-1">
          <h3 class="font-display text-[clamp(1.125rem,2vw,1.375rem)] font-bold text-white mb-3">Wire Distribution ≠ Real Coverage</h3>
          <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75]">Distributing a press release via a wire service creates the illusion of coverage. Hundreds of syndicated posts on low-authority sites don't move perception, don't rank on Google, and don't reach the audience that matters.</p>
        </div>
        <div class="card-default p-6 md:p-8 border-l-[2px] border-l-red-500/50 reveal reveal-delay-2">
          <h3 class="font-display text-[clamp(1.125rem,2vw,1.375rem)] font-bold text-white mb-3">Generic Press Releases Get Ignored</h3>
          <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75]">Crypto journalists receive hundreds of pitches per week. A press release that reads like a marketing brochure — vague claims, no story angle, no hook — gets deleted without being opened.</p>
        </div>
        <div class="card-default p-6 md:p-8 border-l-[2px] border-l-red-500/50 reveal reveal-delay-1">
          <h3 class="font-display text-[clamp(1.125rem,2vw,1.375rem)] font-bold text-white mb-3">Coverage Without Narrative Doesn't Convert</h3>
          <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75]">A feature article that describes what your project does without telling a compelling story doesn't move readers to act. Coverage needs a narrative: why this project, why now, why it matters.</p>
        </div>
        <div class="card-default p-6 md:p-8 border-l-[2px] border-l-red-500/50 reveal reveal-delay-2">
          <h3 class="font-display text-[clamp(1.125rem,2vw,1.375rem)] font-bold text-white mb-3">Missing the Timing Window</h3>
          <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75]">The news cycle in crypto moves fast. A funding announcement published two weeks after the raise is yesterday's news. PR that isn't timed to the moment has half the impact.</p>
        </div>
        <div class="card-default p-6 md:p-8 border-l-[2px] border-l-red-500/50 md:col-span-2 reveal reveal-delay-3">
          <h3 class="font-display text-[clamp(1.125rem,2vw,1.375rem)] font-bold text-white mb-3">No SEO Value</h3>
          <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75] max-w-4xl">Coverage that doesn't live on indexed, high-authority domains generates no long-term organic value. Good PR should still be driving traffic and trust signals 12 months after publication.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3 — OUR APPROACH -->
  <section class="py-20 md:py-32 relative z-10 bg-black/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-16 reveal">
        <p class="font-mono text-xs text-[#a78bfa] uppercase tracking-[0.14em]">HOW WE WORK</p>
        <h2 class="font-display text-[clamp(1.5rem,3.5vw,2.75rem)] font-bold text-[var(--text-primary)] leading-[1.2]">
          How We Secure Coverage That Actually Matters
        </h2>
      </div>

      <div class="relative max-w-4xl mx-auto">
        <div class="absolute left-[24px] md:left-[50px] top-0 bottom-0 w-px bg-white/10 hidden md:block"></div>
        
        <div class="space-y-12">
          {[
            { step: '01', title: 'Story Development', desc: 'Before pitching anything, we work with you to develop a media-ready narrative: What is the genuine news angle? What makes this story relevant to a journalist\'s readers right now? We identify the hook that gets the email opened.' },
            { step: '02', title: 'Pitch Writing', desc: 'We write tailored pitches for each media outlet — not a mass-distributed template. Each pitch is written for the specific publication\'s audience, tone, and editorial focus.' },
            { step: '03', title: 'Editorial Placement', desc: 'We pitch to our established contacts across tier-1 and tier-2 crypto media. Our relationships mean pitches are read, not filtered. Where appropriate, we also secure sponsored editorial placements that are clearly labeled and meet outlet quality standards.' },
            { step: '04', title: 'Content Production', desc: 'We write press releases, feature articles, founder interviews, op-eds, and contributed content. All content is written by writers with native crypto and fintech knowledge — not generalists adapting to a new industry.' },
            { step: '05', title: 'Coverage Tracking & Reporting', desc: 'After placement, you receive a live-links report with every published article, domain authority scores, estimated reach, and SEO indexing status. You know exactly what you got.' }
          ].map((s, i) => (
            <div class="relative flex flex-col md:flex-row gap-6 md:gap-12 reveal" style={`transition-delay: ${i * 0.1}s`}>
              <div class="flex items-center md:items-start gap-4 md:w-[120px] shrink-0 z-10">
                <div class="w-12 h-12 rounded-full border-[1.5px] border-[#a78bfa] bg-[var(--bg-primary)] flex items-center justify-center font-mono text-[#a78bfa] font-bold shrink-0 shadow-[0_0_15px_rgba(167,139,250,0.2)]">
                  {s.step}
                </div>
              </div>
              <div class="pt-2">
                <h3 class="font-display text-xl font-bold text-white mb-3">{s.title}</h3>
                <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75]">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — COVERAGE TYPES -->
  <section class="py-20 md:py-32 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-16 reveal">
        <p class="font-mono text-xs text-[#a78bfa] uppercase tracking-[0.14em]">WHAT WE OFFER</p>
        <h2 class="font-display text-[clamp(1.5rem,3.5vw,2.75rem)] font-bold text-[var(--text-primary)] leading-[1.2]">
          What We Produce and Place
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          { title: 'Press Release Distribution', desc: 'Structured press releases written to editorial standards and pitched to relevant media — not mass-distributed to low-quality wires.' },
          { title: 'Sponsored Articles', desc: 'Paid editorial placements on major crypto outlets — clearly disclosed, written to publication standards, and positioned to inform rather than advertise.' },
          { title: 'Founder Interviews', desc: 'Journalist-style Q&A features that build founder personal brand and establish thought leadership. Placed as editorial content in target publications.' },
          { title: 'Media Coverage (Organic)', desc: 'Pitching your project as a news source or story subject to journalists covering your sector. Earned media that carries the highest credibility.' },
          { title: 'Contributed Op-Eds', desc: 'Long-form opinion pieces authored under your name and placed in industry media — the most powerful format for establishing thought leadership.' }
        ].map((c, i) => (
          <div class={`card-default p-6 hover:border-[#a78bfa]/40 hover:bg-[#a78bfa]/[0.04] transition-all duration-300 reveal ${i === 4 ? 'md:col-span-2 lg:col-span-1' : ''}`} style={`transition-delay: ${i * 0.1}s`}>
            <h3 class="font-display text-[clamp(1.125rem,2vw,1.375rem)] font-bold text-white mb-3">{c.title}</h3>
            <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75]">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5 — MEDIA LANDSCAPE -->
  <section id="media-network" class="py-20 md:py-32 relative z-10 bg-black/20 border-y border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-16 reveal">
        <p class="font-mono text-xs text-[#a78bfa] uppercase tracking-[0.14em]">MEDIA LANDSCAPE</p>
        <h2 class="font-display text-[clamp(1.5rem,3.5vw,2.75rem)] font-bold text-[var(--text-primary)] leading-[1.2]">
          Where We Place Coverage
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white/[0.02] border border-white/5 rounded-xl p-8 reveal reveal-delay-1 text-center">
          <h3 class="font-display text-xl font-bold text-[#a78bfa] mb-4">Tier 1 Crypto Media</h3>
          <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75]">
            CoinDesk, Cointelegraph, The Block, Decrypt, BeInCrypto, Cryptonews
          </p>
        </div>
        <div class="bg-white/[0.02] border border-white/5 rounded-xl p-8 reveal reveal-delay-2 text-center">
          <h3 class="font-display text-xl font-bold text-[#a78bfa] mb-4">Fintech & Business Media</h3>
          <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75]">
            Forbes, Business Insider Crypto, Entrepreneur, FastCompany (tech desk)
          </p>
        </div>
        <div class="bg-white/[0.02] border border-white/5 rounded-xl p-8 reveal reveal-delay-3 text-center">
          <h3 class="font-display text-xl font-bold text-[#a78bfa] mb-4">Regional & Niche Media</h3>
          <p class="font-body text-[16px] text-[var(--text-secondary)] leading-[1.75]">
            Vietnam crypto publications, SEA media, UAE outlets, Korean & Japanese market media via partner network
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6 — FAQ -->
  <section class="py-20 md:py-32 relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-16 reveal">
        <p class="font-mono text-xs text-[#a78bfa] uppercase tracking-[0.14em]">FAQ</p>
        <h2 class="font-display text-[clamp(1.5rem,3.5vw,2.75rem)] font-bold text-[var(--text-primary)] leading-[1.2]">
          Common Questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="card-default p-0 border border-white/5 hover:border-[#a78bfa]/20 transition-all duration-300 group overflow-hidden reveal" style={`transition-delay: ${i * 0.1}s`}>
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <span class="font-display font-semibold text-base sm:text-[18px] text-white group-hover:text-[#a78bfa] transition-colors pr-6">
                {faq.q}
              </span>
              <div class="w-8 h-8 rounded-full bg-white/[0.04] border border-white/[0.06] flex items-center justify-center text-white/50 group-hover:text-[#a78bfa] group-hover:bg-[#a78bfa]/10 transition-all shrink-0">
                <svg class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </summary>
            <div class="px-6 pb-6 text-[16px] text-[var(--text-secondary)] font-body leading-relaxed border-t border-white/[0.03] pt-4">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 7 — CTA -->
  <section id="book-call" class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute w-[800px] h-[800px] rounded-full" style="background:var(--gradient-glow-purple); top:50%; left:50%; transform:translate(-50%, -50%); filter:blur(100px); opacity:0.1"></div>
    </div>
    
    <div class="max-w-3xl mx-auto px-4 text-center relative z-10 reveal">
      <h2 class="font-display text-[clamp(2rem,4vw,3rem)] font-bold text-white mb-4 leading-tight">
        Your Project Has a Story Worth Telling.
      </h2>
      <p class="font-body text-[16px] text-[var(--text-secondary)] max-w-xl mx-auto mb-10">
        Tell us what you're building — we'll identify the angles, the outlets, and the timing that puts you in front of the right readers.
      </p>
      <ServiceInquiryForm client:load defaultService="PR & Media Campaigns" />
    </div>
  </section>
</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  
  .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.55s ease, transform 0.55s ease; }
  .reveal.revealed { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  .reveal-delay-4 { transition-delay: 0.4s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>
