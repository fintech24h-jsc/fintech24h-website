---
// src/pages/services/pr-media.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FooterLeadForm from '../../components/sections/FooterLeadForm.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: 'PR Campaigns', item: 'https://fintech24h.com/services/pr-media' }
];

const faqs = [
  {
    q: "Can you guarantee coverage on Bloomberg or Forbes?",
    a: "We guarantee submission and advocacy through our direct editorial contacts. However, top-tier publications maintain strict editorial independence. We craft the narrative to maximize acceptance, but guaranteed placement on these specific sites is usually through sponsored content (which we can also facilitate)."
  },
  {
    q: "What is the difference between PR distribution and Editorial Placement?",
    a: "PR distribution (like PR Newswire) syndicates your exact text to hundreds of automated feeds — good for SEO, bad for credibility. Editorial placement involves pitching a journalist to write an original article about your project — harder to get, but infinitely more valuable."
  },
  {
    q: "Do you write the press releases?",
    a: "Yes. Our team of native English speakers and crypto-native writers handle the entire drafting process, ensuring the tone matches top-tier journalistic standards."
  },
  {
    q: "How do you measure PR success?",
    a: "We track total readership reach, domain authority of the publishing sites (for SEO impact), referral traffic to your website, and share-of-voice compared to your competitors."
  }
];

const logos = [
  "CoinTelegraph", "Yahoo Finance", "Bloomberg", "Decrypt", "The Block", "CoinDesk", "TechCrunch", "Forbes"
];
---

<BaseLayout
  title="Web3 PR & Media Campaigns | Fintech24h"
  description="Get featured on Tier-1 financial and crypto publications. Fintech24h crafts compelling narratives and secures premium editorial space for Web3 projects."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO (Editorial Split Style) -->
  <section class="relative min-h-[90vh] flex flex-col md:flex-row items-center pt-24 border-b border-white/10 bg-[#04060A]">
    <!-- Left: Typography Heavy -->
    <div class="w-full md:w-1/2 px-6 md:px-12 lg:px-24 pt-20 pb-16 relative z-10">
      <div class="reveal">
        <span class="block font-mono text-[10px] uppercase tracking-[0.3em] text-white/50 mb-6 border-b border-white/10 pb-4">
          PR & MEDIA CAMPAIGNS // ISSUE 01
        </span>
        <h1 class="font-display font-bold text-[clamp(3rem,8vw,6rem)] leading-[0.9] text-white tracking-[-0.04em] uppercase mb-8">
          Don't Just Make Noise.<br/>
          <span class="text-transparent text-stroke-white text-stroke-1 hover:text-white transition-colors duration-500">Make the News.</span>
        </h1>
        <p class="font-body text-lg text-white/70 max-w-md leading-relaxed mb-10 border-l-2 border-white/20 pl-6">
          A press release distributed to 200 outlets nobody reads does nothing. We place editorial coverage that builds credibility, trust, and search authority.
        </p>
        <a href="#book-call" class="inline-block bg-white text-black px-8 py-4 font-mono text-sm uppercase tracking-widest font-bold hover:bg-white/80 transition-colors">
          Get a PR Strategy
        </a>
      </div>
    </div>

    <!-- Right: Abstract Editorial Image/Graphic -->
    <div class="w-full md:w-1/2 h-[50vh] md:h-full relative overflow-hidden bg-[#0A0D14] border-l border-white/10 flex items-center justify-center">
      <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-20 mix-blend-overlay"></div>
      
      <!-- Abstract Newspaper Layout Element -->
      <div class="relative w-[80%] h-[80%] border border-white/10 flex flex-col p-6 reveal reveal-delay-2">
        <div class="w-full h-32 border-b border-white/10 mb-6 flex items-end pb-4">
          <div class="text-[8rem] leading-none font-display font-bold text-white/5 tracking-tighter">PR</div>
        </div>
        <div class="flex-1 grid grid-cols-2 gap-6">
          <div class="space-y-3">
            <div class="w-full h-2 bg-white/5"></div>
            <div class="w-5/6 h-2 bg-white/5"></div>
            <div class="w-4/6 h-2 bg-white/5"></div>
            <div class="w-full h-2 bg-white/5 mt-8"></div>
            <div class="w-3/6 h-2 bg-white/5"></div>
          </div>
          <div class="border-l border-white/10 pl-6 space-y-3">
            <div class="w-full h-2 bg-white/5"></div>
            <div class="w-full h-2 bg-[var(--accent-cyan)]/20 shadow-[0_0_10px_var(--accent-cyan)]"></div>
            <div class="w-4/6 h-2 bg-white/5"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE SECTION -->
  <div class="border-b border-white/10 bg-white/[0.02] overflow-hidden py-4 flex relative">
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-[#04060A] to-transparent z-10"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-[#04060A] to-transparent z-10"></div>
    <div class="flex gap-16 whitespace-nowrap animate-[marquee-scroll_20s_linear_infinite]">
      {[...logos, ...logos, ...logos].map(logo => (
        <span class="font-display font-bold text-2xl text-white/20 uppercase tracking-wider">{logo}</span>
      ))}
    </div>
  </div>

  <!-- SECTION 2 — THE PROBLEM (Editorial Columns) -->
  <section class="py-24 bg-[#04060A] relative z-10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
      <div class="mb-16 reveal border-b border-white/10 pb-8 flex flex-col md:flex-row justify-between items-end gap-6">
        <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] font-bold text-white leading-tight uppercase max-w-2xl">
          The Illusion of Coverage
        </h2>
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 max-w-[200px] text-right">
          Why most PR campaigns fail to deliver ROI.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border border-white/10">
        {[
          { title: 'The Syndication Trap', desc: 'Agencies sell you "200+ publications" but fail to mention they are all automated syndication feeds. It looks good on a report, but no human being ever reads them. Real influence requires real editorial placement.' },
          { title: 'Boring Narratives', desc: 'Crypto journalists receive hundreds of pitches daily. If your pitch is just "We launched a new token," it goes to the trash. If you don\'t have a narrative that connects to broader market trends, you are invisible.' },
          { title: 'Lack of SEO Strategy', desc: 'A great article is useless if it doesn\'t include a high-authority backlink. Many PR efforts fail to capitalize on the SEO benefits of media coverage, leaving long-term domain authority on the table.' }
        ].map((item, i) => (
          <div class={`p-10 border-b md:border-b-0 ${i !== 2 ? 'md:border-r border-white/10' : ''} hover:bg-white/[0.02] transition-colors group reveal`} style={`transition-delay: ${i * 0.15}s`}>
            <span class="block font-display text-[4rem] text-white/5 font-bold leading-none mb-6 group-hover:text-[var(--accent-cyan)]/20 transition-colors">0{i+1}</span>
            <h3 class="font-display text-xl font-bold text-white mb-4 uppercase">{item.title}</h3>
            <p class="font-body text-white/60 leading-relaxed text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — OUR APPROACH (Magazine Layout) -->
  <section class="py-24 bg-[#0A0D14] relative z-10 border-y border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
      <div class="text-center mb-20 reveal">
        <span class="block font-mono text-[10px] uppercase tracking-[0.3em] text-[var(--accent-cyan)] mb-4">THE STRATEGY</span>
        <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] font-bold text-white uppercase">How We Shape The Narrative</h2>
      </div>

      <div class="space-y-0 border-t border-white/10">
        {[
          { step: '01', title: 'Narrative Architecture', desc: 'Before pitching anyone, we find the "hook". We connect your product update to macroeconomic trends, regulatory shifts, or technological breakthroughs. We don\'t pitch a product; we pitch a story.' },
          { step: '02', title: 'Targeted Pitching', desc: 'We don\'t mass-email journalists. We match your story with specific editors and writers at Tier-1 publications who have a track record of covering your specific niche (DeFi, AI, Layer 2, etc.).' },
          { step: '03', title: 'Content Drafting', desc: 'Our team of native-English, crypto-fluent writers drafts the press releases and op-eds. We write in journalistic style (AP format), making it as easy as possible for an editor to hit publish.' },
          { step: '04', title: 'Distribution & Amplification', desc: 'Once published, we don\'t stop. We syndicate the coverage across Web3 communities, leverage KOLs to amplify the article, and ensure maximum eyeballs on the piece.' }
        ].map((item, i) => (
          <div class="flex flex-col md:flex-row border-b border-white/10 group reveal">
            <div class="w-full md:w-1/3 py-8 md:py-12 md:pr-12 border-b md:border-b-0 md:border-r border-white/10 flex items-center">
              <span class="font-mono text-sm text-[var(--accent-cyan)] mr-6">{item.step}</span>
              <h3 class="font-display text-2xl font-bold text-white uppercase group-hover:pl-4 transition-all duration-300">{item.title}</h3>
            </div>
            <div class="w-full md:w-2/3 py-8 md:py-12 md:pl-12 flex items-center">
              <p class="font-body text-white/70 leading-relaxed text-lg">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION (Minimal) -->
  <section class="py-24 bg-[#04060A]">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-16 reveal">
        <h2 class="font-display text-3xl font-bold text-white uppercase border-b border-white/10 pb-6">Editorial FAQ</h2>
      </div>
      <div class="space-y-2">
        {faqs.map((faq, i) => (
          <details class="group border-b border-white/10 pb-4 reveal" style={`transition-delay: ${i * 0.1}s`}>
            <summary class="flex justify-between items-center font-display text-lg text-white font-bold cursor-pointer list-none hover:text-[var(--accent-cyan)] transition-colors py-4">
              {faq.q}
              <span class="text-white/30 group-open:rotate-45 transition-transform duration-300 font-mono text-2xl">+</span>
            </summary>
            <div class="text-white/60 font-body text-sm leading-relaxed pb-4 pr-12">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION (Unified FooterLeadForm) -->
  <FooterLeadForm defaultService="PR Campaigns" />

</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  .text-stroke-white { -webkit-text-stroke: 1px rgba(255,255,255,0.2); }
  .text-stroke-1 { -webkit-text-stroke-width: 1px; }
  
  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal.revealed { opacity: 1; transform: translateY(0); }
  .reveal-delay-2 { transition-delay: 0.2s; }
  
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>
