---
// src/pages/services/kol-marketing.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FooterLeadForm from '../../components/sections/FooterLeadForm.astro';
import KolCtaSection from '../../components/sections/KolCtaSection.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: 'KOL Marketing', item: 'https://fintech24h.com/services/kol-marketing' }
];

const faqs = [
  {
    q: "How do you verify KOL audience quality?",
    a: "We use third-party analytics tools and our own historical database to check engagement-to-follower ratios, comment sentiment (filtering out bot replies), and audience geography. If a KOL has 1M followers but averages 10 real comments, they don't make our list."
  },
  {
    q: "Do you handle the payments to KOLs?",
    a: "Yes. We handle all contract negotiations, escrow, and milestone-based payments (usually 50% upfront, 50% upon successful delivery of content as briefed). You pay us a single invoice; we handle the complex distribution."
  },
  {
    q: "Can you guarantee ROI or token price impact?",
    a: "No agency can guarantee token price impact, as it depends on market conditions, your product, and broader macroeconomic factors. We guarantee reach, engagement, and click-through rates based on historical data of the KOLs we select."
  },
  {
    q: "Do KOLs disclose that the posts are sponsored?",
    a: "Yes, we require all KOLs to comply with local regulations (such as FTC guidelines in the US) regarding sponsored content disclosures, typically using #ad or #sponsored tags."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "KOL & Influencer Marketing",
  "provider": {
    "@type": "Organization",
    "name": "Fintech24h"
  },
  "url": "https://fintech24h.com/services/kol-marketing",
  "description": "Connect your project with vetted crypto KOLs across Twitter/X, YouTube, and Telegram. Fintech24h manages the full KOL lifecycle."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

const combinedSchema = [serviceSchema, faqSchema];
---

<BaseLayout
  title="KOL & Influencer Marketing for Blockchain & Web3 | Fintech24h"
  description="Connect your project with vetted crypto KOLs across Twitter/X, YouTube, and Telegram. Fintech24h manages the full KOL lifecycle — selection, briefing, activation, and reporting."
  schema={combinedSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO (The Network Concept) -->
  <KolCtaSection isHero={true} />

  <!-- SECTION 2 — THE PROBLEM (Bento Box Style) -->
  <section class="py-20 md:py-32 relative z-10 bg-black/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-16 reveal">
        <h2 class="font-display text-[clamp(1.5rem,3.5vw,2.75rem)] font-bold text-[var(--text-primary)] leading-[1.2]">
          Why Most KOL Campaigns Underperform
        </h2>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 auto-rows-[280px]">
        
        <!-- Bento 1 (Large) -->
        <div class="md:col-span-2 card-default border border-[var(--border-subtle)] bg-gradient-to-br from-white/[0.03] to-transparent p-8 flex flex-col justify-end group hover:border-red-500/30 transition-all reveal">
          <div class="absolute top-6 right-6 w-12 h-12 rounded-full bg-red-500/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
          </div>
          <h3 class="font-display text-2xl font-bold text-[var(--text-primary)] mb-2">Fake Followers, Real Budget Lost</h3>
          <p class="text-[var(--text-secondary)]">You pay for reach that doesn't exist. Inflated follower counts and bot-heavy audiences mean your message goes nowhere — and your budget evaporates with nothing to show.</p>
        </div>

        <!-- Bento 2 -->
        <div class="card-default border border-[var(--border-subtle)] bg-gradient-to-br from-white/[0.03] to-transparent p-8 flex flex-col justify-end group hover:border-[var(--accent-cyan)]/30 transition-all reveal reveal-delay-1">
          <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-2">Wrong Audience</h3>
          <p class="text-[var(--text-secondary)] text-sm">A KOL with 500K followers in gaming does nothing for a DeFi protocol. Reach without relevance is noise.</p>
        </div>

        <!-- Bento 3 -->
        <div class="card-default border border-[var(--border-subtle)] bg-gradient-to-br from-white/[0.03] to-transparent p-8 flex flex-col justify-end group hover:border-[#a78bfa]/30 transition-all reveal">
          <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-2">No Brief, No Direction</h3>
          <p class="text-[var(--text-secondary)] text-sm">When KOLs receive no brief, they default to generic content. Posts feel promotional and get low engagement.</p>
        </div>

        <!-- Bento 4 (Large) -->
        <div class="md:col-span-2 card-default border border-[var(--border-subtle)] bg-gradient-to-br from-white/[0.03] to-transparent p-8 flex flex-col justify-end relative overflow-hidden group hover:border-[var(--border-default)] transition-all reveal reveal-delay-1">
          <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=')] opacity-50"></div>
          <div class="relative z-10">
            <h3 class="font-display text-2xl font-bold text-[var(--text-primary)] mb-2">Bad Timing Kills Momentum</h3>
            <p class="text-[var(--text-secondary)] max-w-lg">A KOL drop one week before launch creates buzz that dies before TGE. One week after, you're chasing a market that's already moved on. Campaign timing is strategy, not a calendar exercise.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 3 — OUR APPROACH (Network Flow) -->
  <section class="py-20 md:py-32 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20 reveal">
        <p class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.14em] mb-4">THE FINTECH24H METHOD</p>
        <h2 class="font-display text-[clamp(1.5rem,3vw,2.5rem)] font-bold text-[var(--text-primary)]">How We Run KOL Campaigns That Work</h2>
      </div>

      <div class="relative">
        <!-- Connecting Line for Desktop -->
        <div class="absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-[var(--accent-cyan)] to-transparent hidden md:block opacity-30"></div>

        <div class="space-y-24">
          {[
            { step: '01', title: 'Audience-First Selection', desc: 'Before selecting any KOL, we audit their audience demographics, engagement quality, historical campaign performance, and topic alignment with your project. You get a shortlist with reasoning — not just names.', align: 'left' },
            { step: '02', title: 'Brief & Content Alignment', desc: 'We write structured campaign briefs for every KOL, covering project narrative, key messages, tone guidelines, and content formats. Every piece of content is reviewed and approved before going live.', align: 'right' },
            { step: '03', title: 'Phased Activation', desc: 'We don\'t release everything at once. KOL campaigns are deployed in phases: awareness seeding, followed by education and trust-building content, followed by conversion-focused calls to action.', align: 'left' },
            { step: '04', title: 'Live Tracking & Optimization', desc: 'During every campaign, we monitor performance in real time — impressions, engagement rate, click-through. Underperforming placements are paused and replaced. You see what\'s happening.', align: 'right' },
            { step: '05', title: 'Post-Campaign Reporting', desc: 'After every campaign, you receive a full performance breakdown: what worked, what didn\'t, audience quality analysis, and recommendations for the next cycle. Every campaign makes the next smarter.', align: 'left' }
          ].map((item, i) => (
            <div class={`flex flex-col md:flex-row items-center justify-between gap-8 md:gap-16 reveal ${item.align === 'right' ? 'md:flex-row-reverse' : ''}`}>
              <div class="w-full md:w-1/2 flex justify-center md:justify-end">
                <div class={`card-default p-8 max-w-lg w-full relative group ${item.align === 'left' ? 'md:text-right' : 'md:text-left text-left'}`}>
                  <div class={`absolute top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[var(--accent-cyan)] shadow-[0_0_15px_var(--accent-cyan)] hidden md:block ${item.align === 'left' ? '-right-10' : '-left-10'}`}></div>
                  <span class="font-mono text-[var(--accent-cyan)] text-lg mb-2 block">{item.step}.</span>
                  <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-3">{item.title}</h3>
                  <p class="text-[var(--text-secondary)] leading-relaxed">{item.desc}</p>
                </div>
              </div>
              <div class="hidden md:block w-full md:w-1/2"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — SERVICES COVERED (Floating Cards) -->
  <section class="py-20 md:py-32 relative z-10 bg-[var(--surface-soft)] border-y border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <h2 class="font-display text-[clamp(1.5rem,3.5vw,2.75rem)] font-bold text-[var(--text-primary)]">Campaign Types & Platforms</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { title: 'Influencer Campaign', desc: 'End-to-end management of multi-KOL campaigns — from selection to activation.' },
          { title: 'KOL Management', desc: 'Ongoing relationship management with a curated group of KOLs who become long-term advocates.' },
          { title: 'Ambassador Program', desc: 'Recruit, onboard, and activate community ambassadors who create organic content.' },
          { title: 'X Growth Campaign', desc: 'Coordinated Twitter/X amplification — threads, quote posts, Space promotions.' }
        ].map((s, i) => (
          <div class="card-default p-8 hover:-translate-y-2 transition-transform duration-300 reveal" style={`transition-delay: ${i * 0.1}s`}>
            <div class="w-10 h-10 rounded-full bg-[var(--surface-soft)] mb-6 flex items-center justify-center text-[var(--text-primary)] font-mono text-sm">{i+1}</div>
            <h3 class="font-display font-bold text-[var(--text-primary)] mb-3 text-lg">{s.title}</h3>
            <p class="text-[var(--text-secondary)] text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-20 md:py-32 max-w-4xl mx-auto px-4">
    <div class="text-center mb-16 reveal">
      <h2 class="font-display text-[clamp(1.5rem,3vw,2.5rem)] font-bold text-[var(--text-primary)]">Common Questions</h2>
    </div>
    <div class="space-y-4">
      {faqs.map((faq, i) => (
        <details class="card-default p-0 border border-[var(--border-subtle)] hover:border-[var(--accent-cyan)]/30 transition-all duration-300 group overflow-hidden reveal" style={`transition-delay: ${i * 0.1}s`}>
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <span class="font-display font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent-cyan)] transition-colors pr-6">{faq.q}</span>
            <div class="w-8 h-8 rounded-full border border-[var(--border-default)] flex items-center justify-center text-[var(--text-secondary)] opacity-70 group-hover:text-[var(--accent-cyan)] group-hover:border-[var(--accent-cyan)]/30 shrink-0">
              <svg class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </summary>
          <div class="px-6 pb-6 text-[var(--text-secondary)] border-t border-[var(--border-subtle)] pt-4">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA SECTION (Unified FooterLeadForm) -->
  <FooterLeadForm defaultService="KOL Marketing" />

</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .reveal.revealed { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  .reveal-delay-4 { transition-delay: 0.4s; }
  .line-reveal { transform: scaleX(0); transition: transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1); transform-origin: left; }
  .revealed .line-reveal { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal, svg').forEach(el => observer.observe(el));
  });
</script>
