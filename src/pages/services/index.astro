---
// src/pages/services/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { services } from '../../data/services';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services/' }
];
// Services ItemList Schema
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": services.map((s, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://fintech24h.com/services/${s.slug}/`,
    "name": s.title
  }))
};
---

<BaseLayout
  title="Our Services — Blockchain Marketing Solutions | Fintech24h"
  description="Explore Fintech24h's full-spectrum Blockchain & Web3 marketing services: KOL marketing, PR campaigns, community growth, event marketing, AI marketing, and business development."
  schema={itemListSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="relative py-24 lg:py-32 overflow-hidden" aria-label="Services Directory">
    <!-- Ambient background glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-purple w-[600px] h-[600px] absolute -top-40 -left-32 opacity-15"></div>
      <div class="bg-orb bg-orb-cyan w-[500px] h-[500px] absolute bottom-10 -right-32 opacity-10"></div>
      <div class="grid-pattern absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top header -->
      <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--accent-cyan)]/30 bg-[var(--accent-cyan)]/5 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]"></span>
          <span class="text-xs font-semibold text-[var(--accent-cyan)] font-body uppercase tracking-wider">Our Solutions</span>
        </div>
        <h1 class="font-display text-h1 font-bold text-[var(--text-primary)] mb-6">
          Blockchain Marketing Services
        </h1>
        <p class="text-lg text-[var(--text-secondary)] font-body leading-relaxed">
          From developer relations to retail investor onboarding, our plug-and-play strategies drive actual ROI.
        </p>
      </div>

      <!-- Services List Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" data-animate="stagger">
        {services.map((s) => (
          <div class="card-default p-8 sm:p-10 border border-white/5 flex flex-col justify-between group hover:border-[var(--accent-cyan)]/30 transition-all duration-300" data-animate-child>
            <div>
              <!-- Header info: Icon + Title -->
              <div class="flex items-start justify-between gap-4 mb-6">
                <div class="w-12 h-12 rounded-xl bg-[var(--accent-cyan)]/10 border border-[var(--accent-cyan)]/20 flex items-center justify-center text-[var(--accent-cyan)] group-hover:bg-[var(--accent-cyan)] group-hover:text-black transition-colors duration-300">
                  {s.icon === 'Users' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v-2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                  {s.icon === 'FileText' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                  {s.icon === 'MessageSquare' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                  {s.icon === 'TrendingUp' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18M17 6h6v6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                  {s.icon === 'Briefcase' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                  {s.icon === 'Search' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                </div>

                <!-- Main Metrics tag -->
                <div class="text-right">
                  <div class="text-xl font-display font-bold text-[var(--accent-cyan)]">{s.metrics[0].value}</div>
                  <div class="text-[9px] text-[var(--text-muted)] font-body uppercase tracking-wider">{s.metrics[0].label}</div>
                </div>
              </div>

              <!-- Title & Copy -->
              <h2 class="font-display text-xl sm:text-2xl font-bold text-[var(--text-primary)] mb-4 group-hover:text-[var(--accent-cyan)] transition-colors">
                {s.title}
              </h2>
              <p class="text-sm text-[var(--text-secondary)] font-body leading-relaxed mb-6">
                {s.shortDescription}
              </p>

              <!-- Mini bullet lists -->
              <ul class="space-y-2 mb-8 text-xs text-[var(--text-secondary)] font-body">
                {s.features.slice(0, 3).map((f) => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]"></span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Redirect Link -->
            <div class="flex items-center justify-between border-t border-[var(--border-subtle)] pt-6 mt-6">
              <span class="text-xs text-[var(--text-muted)] font-body"> plug & play ready </span>
              <a
                href={`/services/${s.slug}`}
                class="text-xs font-semibold text-[var(--accent-cyan)] hover:text-cyan-300 font-display uppercase tracking-wider flex items-center gap-2 transition-colors"
                aria-label={`Explore ${s.title}`}
              >
                Explore Service
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>
