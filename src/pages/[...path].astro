---
// Handle only legacy multi-segment URLs that have an equivalent destination.
// All other unmatched paths keep the site's real 404 response so removed,
// paginated, feed, and spam URLs do not become irrelevant soft-404 redirects.
export const prerender = false;

import { getPostBySlug } from '../lib/wordpress';

const { path } = Astro.params;
const key = path?.replace(/\/$/, '').toLowerCase();

const LEGACY_REDIRECTS: Record<string, string> = {
  'service-post/influencer-marketing': '/services/kol-marketing/',
  'service-post/pr-strategy': '/services/pr-media/',
  'service-post/promotion-growth-hacking': '/services/',
  'service-post/social-media-management-service': '/services/community-growth/',
  'service-post/b2b-pitching-partnership': '/services/business-development/',
  'case-studies/avalanche-growth-campaign': '/case-studies/',
};

if (key && LEGACY_REDIRECTS[key]) {
  return Astro.redirect(LEGACY_REDIRECTS[key], 301);
}

// WordPress exposed a per-post RSS feed at /{post-slug}/feed/. Redirect only
// when the post still exists, avoiding blanket redirects for invented paths.
const legacyPostFeed = key && /^([^/]+)\/feed$/.exec(key);
if (legacyPostFeed) {
  const post = await getPostBySlug(legacyPostFeed[1]);
  if (post) return Astro.redirect(`/blog/${post.slug}`, 301);
}

return Astro.rewrite('/404');
---
