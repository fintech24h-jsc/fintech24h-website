---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { getAllPosts, getAllCategories, formatDate, getExcerpt, getFeaturedImage } from '../../lib/wordpress';
import { getReadingTime } from '../../lib/utils';

const posts = await getAllPosts();
const categories = await getAllCategories();

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Blog', item: 'https://fintech24h.com/blog' }
];

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Fintech24h Insights",
  "url": "https://fintech24h.com/blog",
  "description": "Strategy, trends, and insights on Blockchain, Fintech & AI marketing — from KOL campaigns to growth hacking. Written by the Fintech24h team."
};
---

<BaseLayout
  title="Insights — Blockchain & Web3 Marketing Blog | Fintech24h"
  description="Strategy, trends, and insights on Blockchain, Fintech & AI marketing — from KOL campaigns to growth hacking. Written by the Fintech24h team."
  schema={blogSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="relative py-24 lg:py-32 overflow-hidden" aria-label="Blog Catalog">
    <!-- Ambient background glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-purple w-[600px] h-[600px] absolute -top-40 -left-32 opacity-15"></div>
      <div class="bg-orb bg-orb-cyan w-[500px] h-[500px] absolute bottom-10 -right-32 opacity-10"></div>
      <div class="grid-pattern absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16" data-animate="fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-400/30 bg-cyan-400/5 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
          <span class="text-xs font-semibold text-cyan-400 font-body uppercase tracking-wider">Research Hub</span>
        </div>
        <h1 class="font-display text-h1 font-bold text-[#f0f4ff] mb-6">
          Insights
        </h1>
        <p class="text-lg text-[#94a3b8] font-body leading-relaxed">
          Actionable frameworks, tokenomics research, and technical search engine optimization guides for blockchain builders.
        </p>
      </div>

      <!-- Categories Filter bar -->
      <div class="flex flex-wrap justify-center gap-3 mb-16" data-animate="fade-up">
        <a 
          href="/blog" 
          class="px-4 py-2 rounded-full border border-cyan-400 bg-cyan-400/10 text-cyan-400 text-xs font-semibold font-body transition-colors"
        >
          All Articles
        </a>
        {categories.map((c) => (
          <a
            href={`/blog/category/${c.slug}`}
            class="px-4 py-2 rounded-full border border-white/10 bg-white/5 hover:border-white/30 text-xs font-semibold font-body text-[#94a3b8] hover:text-[#f0f4ff] transition-all"
          >
            {c.name} ({c.count || 0})
          </a>
        ))}
      </div>

      <!-- Articles list grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate="stagger">
        {posts.map((post) => {
          const rTime = getReadingTime(post.content.rendered);
          const excerptText = getExcerpt(post, 140);
          const featuredImage = getFeaturedImage(post);
          return (
            <article class="card-default p-6 flex flex-col justify-between group" data-animate-child>
              <div>
                {/* Image */}
                {featuredImage.url && (
                  <div class="relative aspect-[16/10] rounded-xl overflow-hidden mb-5 border border-white/5 shadow-inner">
                    <img
                      src={featuredImage.url}
                      alt={featuredImage.alt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </div>
                )}

                <!-- Info row -->
                <div class="flex items-center gap-3 text-xs text-[#475569] font-body mb-4">
                  <span>{formatDate(post.date)}</span>
                  <span class="w-1 h-1 rounded-full bg-[#475569]"></span>
                  <span>{rTime} min read</span>
                </div>

                <!-- Title & Summary -->
                <h2 class="font-display text-lg font-bold text-[#f0f4ff] mb-3 group-hover:text-cyan-400 transition-colors line-clamp-2">
                  {post.title.rendered}
                </h2>
                <p class="text-xs text-[#94a3b8] font-body leading-relaxed mb-6 line-clamp-3">
                  {excerptText}
                </p>
              </div>

              <!-- Redirect link -->
              <div class="flex justify-end pt-4 border-t border-white/5 mt-6">
                <a
                  href={`/blog/${post.slug}`}
                  class="text-[10px] font-semibold text-cyan-400 hover:text-cyan-300 font-display uppercase tracking-wider flex items-center gap-1.5 transition-colors"
                  aria-label={`Read ${post.title.rendered}`}
                >
                  Read Article
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </section>
</BaseLayout>
