---
// src/pages/blog/index.astro
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import BlogIndexSection from '../../components/sections/BlogIndexSection.astro';
import { getPostsPage, getAllCategories } from '../../lib/wordpress';

// Legacy WordPress pagination (?paged=N / ?page=N) 301s to the real paginated URL
// (/blog/page/N); any other query (?amp=1, old hack spam params such as ?ku777=...)
// collapses to the clean /blog so no duplicate 200s pile up in
// "Crawled - currently not indexed".
if (Astro.url.search) {
  const legacy = Number(Astro.url.searchParams.get('paged') ?? Astro.url.searchParams.get('page'));
  return Astro.redirect(Number.isInteger(legacy) && legacy >= 2 ? `/blog/page/${legacy}` : '/blog', 301);
}

Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

const { posts, totalPages } = await getPostsPage(1);
const categories = await getAllCategories();

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Blog', item: 'https://fintech24h.com/blog' }
];

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Fintech24h Insights",
  "url": "https://fintech24h.com/blog",
  "description": "Strategy, trends, and insights on Blockchain, Fintech & AI marketing — from KOL campaigns to growth hacking. Written by the Fintech24h team."
};
---

<BaseLayout
  title="Insights — Blockchain & Web3 Marketing Blog | Fintech24h"
  description="Strategy, trends, and insights on Blockchain, Fintech & AI marketing — from KOL campaigns to growth hacking. Written by the Fintech24h team."
  schema={blogSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />
  <BlogIndexSection posts={posts} categories={categories} currentPage={1} totalPages={totalPages} />
</BaseLayout>
