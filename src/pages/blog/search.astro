---
// src/pages/blog/search.astro — /blog/search?q=…&category=…&page=N
// Full-text search through the WordPress REST API. Result pages are noindex.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/ui/BlogPostCard.astro';
import BlogSearchForm from '../../components/ui/BlogSearchForm.astro';
import { getAllCategories, getPostCategories, searchPosts } from '../../lib/wordpress';

Astro.response.headers.set('Cache-Control', 'no-store');

const params = Astro.url.searchParams;
const query = (params.get('q') ?? '').trim().slice(0, 100);
const pageRaw = params.get('page') ?? '1';
const page = /^\d{1,3}$/.test(pageRaw) && Number(pageRaw) >= 1 ? Number(pageRaw) : 1;

const categories = await getAllCategories();
const category = categories.find((c) => c.slug === params.get('category'));
const results = query ? await searchPosts(query, page, category?.id) : { posts: [], total: 0, totalPages: 0 };

const hrefFor = (overrides: Record<string, string | undefined>) => {
  const next = new URLSearchParams();
  const values = { q: query, category: category?.slug, page: undefined, ...overrides };
  Object.entries(values).forEach(([k, v]) => { if (v) next.set(k, v); });
  return `/blog/search?${next.toString()}`;
};

const chip = 'inline-flex items-center gap-2 h-11 px-4 rounded-full border font-mono text-[13px] whitespace-nowrap transition-colors duration-200';
const on = 'border-[color-mix(in_srgb,var(--accent-cyan)_45%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_12%,transparent)] text-[var(--text-primary)]';
const off = 'border-[var(--border-default)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
---

<BaseLayout
  title={query ? `Search: ${query} | Fintech24h Insights` : 'Search the blog | Fintech24h Insights'}
  description="Search Fintech24h research, news and partner updates on blockchain, Web3, fintech and AI marketing."
  canonical="https://fintech24h.com/blog/search"
  noIndex
>
  <div class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-purple w-[640px] h-[640px] absolute -top-56 left-1/4 opacity-20"></div>
    </div>

    <section class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 lg:pt-32 pb-8 flex flex-col gap-5">
      <nav aria-label="Breadcrumb" class="font-mono text-xs text-[var(--text-muted)]">
        <ol class="flex items-center gap-2.5"><li><a href="/blog" class="text-[var(--accent-cyan)] hover:opacity-80">Blog</a></li><li aria-hidden="true">/</li><li aria-current="page" class="text-[var(--text-primary)]">Search</li></ol>
      </nav>
      <h1 class="font-display font-bold text-[var(--text-primary)] text-[clamp(2rem,4vw,3.25rem)] leading-[1.08] tracking-[-0.03em]">
        {query ? <>Results for <span class="gradient-text-cyan">“{query}”</span></> : <>Search the <span class="gradient-text-cyan">research hub</span></>}
      </h1>
      {query && <p class="font-mono text-sm text-[var(--text-muted)]">{results.total} {results.total === 1 ? 'article' : 'articles'}{category && ` in ${category.name}`}</p>}
      <BlogSearchForm id="search-page" value={query} category={category?.slug} placeholder="Search articles: tokenomics, KOL, CBDC…" />
      {query && categories.length > 0 && (
        <ul class="flex gap-2 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap" aria-label="Filter by desk">
          <li><a href={hrefFor({ category: undefined })} class:list={[chip, category ? off : on]} aria-current={category ? undefined : 'page'}>All desks</a></li>
          {categories.map((c) => (
            <li><a href={hrefFor({ category: c.slug })} class:list={[chip, category?.slug === c.slug ? on : off]} aria-current={category?.slug === c.slug ? 'page' : undefined}>{c.name}</a></li>
          ))}
        </ul>
      )}
    </section>

    <section aria-label="Search results" class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-24 lg:pb-32">
      {query && results.posts.length === 0 && (
        <div class="text-center py-12 flex flex-col items-center gap-5">
          <p class="font-body text-[var(--text-secondary)]">No articles match that search. Try a broader term, or browse a desk:</p>
          <div class="flex flex-wrap justify-center gap-2">
            {categories.map((c) => <a href={`/blog/category/${c.slug}`} class:list={[chip, off]}>{c.name}</a>)}
          </div>
        </div>
      )}
      {results.posts.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-6">
          {results.posts.map((post) => <BlogPostCard post={post} label={getPostCategories(post)[0]?.name} />)}
        </div>
      )}
      {results.totalPages > 1 && (
        <nav aria-label="Search pagination" class="flex justify-center items-center gap-3 mt-12 font-mono text-sm">
          {page > 1 && <a href={hrefFor({ page: page > 2 ? String(page - 1) : undefined })} class:list={[chip, off]}>← Previous</a>}
          <span class="text-[var(--text-muted)] px-2">Page {page} of {results.totalPages}</span>
          {page < results.totalPages && <a href={hrefFor({ page: String(page + 1) })} class:list={[chip, off]}>Next →</a>}
        </nav>
      )}
    </section>
  </div>
</BaseLayout>
