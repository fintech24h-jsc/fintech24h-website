---
// src/pages/blog/category/[category].astro
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../../components/seo/BreadcrumbSchema.astro';
import CategoryListing from '../../../components/sections/CategoryListing.astro';
import { getAllCategories, getCategoryPostsPage } from '../../../lib/wordpress';

Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

const { category: categorySlug } = Astro.params;
const allCategories = await getAllCategories();
const category = allCategories.find(c => c.slug === categorySlug) || {
  id: 0,
  name: categorySlug || 'Category',
  slug: categorySlug || 'category',
  count: 0,
  description: ''
};
const { posts, totalPages } = categorySlug ? await getCategoryPostsPage(categorySlug, 1) : { posts: [], totalPages: 0 };

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Blog', item: 'https://fintech24h.com/blog' },
  { name: category.name, item: `https://fintech24h.com/blog/category/${category.slug}` }
];
---

<BaseLayout
  title={`${category.name} Archives — Insights Blog`}
  description={`Read our latest research and growth playbooks in ${category.name} from the Fintech24h strategy team.`}
>
  <BreadcrumbSchema items={breadcrumbs} />
  <CategoryListing category={category} allCategories={allCategories} posts={posts} currentPage={1} totalPages={totalPages} />
</BaseLayout>
