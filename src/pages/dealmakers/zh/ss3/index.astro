---
// src/pages/dealmakers/zh/ss3/index.astro
// Simplified Chinese mirror of /dealmakers/ss3/. Same components, locale="zh".
import DealMakersLayout from '../../../../layouts/DealMakersLayout.astro';
import BreadcrumbSchema from '../../../../components/seo/BreadcrumbSchema.astro';
import DealMakersHero from '../../../../components/sections/dealmakers/DealMakersHero.astro';
import TelegramJoinBanner from '../../../../components/sections/dealmakers/TelegramJoinBanner.astro';
import FeaturedDealMakers from '../../../../components/sections/dealmakers/FeaturedDealMakers.astro';
import USPSection from '../../../../components/sections/dealmakers/USPSection.astro';
import LastSeasonPartners from '../../../../components/sections/dealmakers/LastSeasonPartners.astro';
import CommunityActivity from '../../../../components/sections/dealmakers/CommunityActivity.tsx';
import QualifiedDirectory from '../../../../components/sections/dealmakers/QualifiedDirectory.tsx';
import HowItWorks from '../../../../components/sections/dealmakers/HowItWorks.astro';
import PricingPackages from '../../../../components/sections/dealmakers/PricingPackages.astro';
import PartnerTracks from '../../../../components/sections/dealmakers/PartnerTracks.astro';
import MediaPartners from '../../../../components/sections/dealmakers/MediaPartners.astro';
import ApplyForm from '../../../../components/sections/dealmakers/ApplyForm.tsx';
import FaqAccordion from '../../../../components/sections/dealmakers/FaqAccordion.astro';
import { getSS3Content } from '../../../../data/dealmakers/content';
import { dealMakersMembers } from '../../../../data/dealmakers/members';

const { seasonMeta, faq, pricingPackages } = getSS3Content('zh');
const dealMakersMembersCount = dealMakersMembers.length;

const breadcrumbs = [
  { name: '首页', item: 'https://fintech24h.com' },
  { name: 'DealMakers’ Club', item: 'https://fintech24h.com/dealmakers/zh/' },
  { name: 'Season 3', item: seasonMeta.canonical },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seasonMeta.title,
  description: seasonMeta.description,
  url: seasonMeta.canonical,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const packagesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${seasonMeta.name} Packages`,
  itemListElement: pricingPackages.map((pkg, i) => {
    const numericPrice = Number(pkg.price.replace(/[^0-9.]/g, ''));
    const isFromPrice = /from|起/i.test(pkg.price);
    return {
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: pkg.title,
        description: pkg.description,
        provider: { '@type': 'Organization', name: 'Fintech24h' },
        offers: {
          '@type': 'Offer',
          url: seasonMeta.canonical,
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          ...(isFromPrice
            ? { priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: numericPrice, priceCurrency: 'USD' } }
            : { price: numericPrice }),
        },
      },
    };
  }),
};
---

<DealMakersLayout locale="zh" title={seasonMeta.title} description={seasonMeta.description} canonical={seasonMeta.canonical} keywords={seasonMeta.keywords} schema={webPageSchema} ogImage={seasonMeta.ogImage}>
  <BreadcrumbSchema items={breadcrumbs} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(packagesSchema).replace(/</g, '\\u003c')} />

  <DealMakersHero locale="zh" />
  <TelegramJoinBanner locale="zh" />
  <FeaturedDealMakers locale="zh" />
  <USPSection locale="zh" />
  <LastSeasonPartners locale="zh" />
  <CommunityActivity locale="zh" client:load />

  <section class="relative py-12" aria-label="成员目录链接">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/dealmakers/zh/members/" class="dm-card group flex flex-col sm:flex-row items-center justify-between gap-5 p-6 sm:p-7 text-center sm:text-start" data-dm-reveal>
        <div>
          <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-2">成员目录</p>
          <h2 class="font-display font-semibold text-lg text-[var(--dm-text-primary)]">
            认识跨越所有赛季、超过 {dealMakersMembersCount} 位经验证的 DealMaker。
          </h2>
        </div>
        <span class="dm-btn-primary py-2.5 px-6 text-[10px] shrink-0 group-hover:translate-x-0.5 transition-transform">
          查看成员 <span>→</span>
        </span>
      </a>
    </div>
  </section>

  <section id="directory" class="relative py-20 lg:py-28" aria-label="资质入驻目录">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10" data-dm-reveal>
        <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">资质入驻目录</p>
        <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-4">
          示例档案，<span class="dm-text-gradient">每一份都是清晰的信号。</span>
        </h2>
        <p class="text-sm text-[var(--dm-text-secondary)]">
          以下档案展示了资质入驻的呈现形式。点击任意档案查看"我们提供"与"我们寻求"的详细信息，并通过 Fintech24h 提交请求引荐。
        </p>
      </div>
      <QualifiedDirectory locale="zh" client:load />
    </div>
  </section>

  <HowItWorks locale="zh" />
  <PricingPackages locale="zh" />
  <PartnerTracks locale="zh" />
  <MediaPartners locale="zh" />

  <section id="apply" class="relative py-20 lg:py-28" aria-label="申请加入">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute w-[480px] h-[480px] rounded-full opacity-30 mix-blend-screen dm-orb-gold"
        style="bottom: 0; left: -10%; filter: blur(90px); animation: orb-pulse 9s ease-in-out infinite;"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-start">
      <div data-dm-reveal>
        <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">立即申请加入 Season 3</p>
        <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-5">你有清晰的交易信号吗？</h2>
        <p class="text-sm text-[var(--dm-text-secondary)] leading-relaxed mb-6">
          先告诉我们你正在构建什么、能提供什么价值，以及你想见谁。如果存在匹配度，Fintech24h 团队将与你取得联系。
        </p>
        <ul class="space-y-3 text-sm text-[var(--dm-text-secondary)]">
          <li class="flex gap-2.5"><span class="text-[var(--dm-gold)]">✦</span>适合创始人、投资人、交易所、服务提供商及战略合作伙伴。</li>
          <li class="flex gap-2.5"><span class="text-[var(--dm-gold)]">✦</span>优先考虑有直接决策者参与的成员。</li>
          <li class="flex gap-2.5"><span class="text-[var(--dm-gold)]">✦</span>需要 Telegram，以便我们团队能尽快核实你的身份。</li>
        </ul>
      </div>
      <ApplyForm locale="zh" client:load />
    </div>
  </section>

  <FaqAccordion locale="zh" />
</DealMakersLayout>

<script is:inline>
  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target : null;
    if (!target) return;

    const introEl = target.closest('[data-dm-intro]');
    if (introEl) {
      window.dispatchEvent(new CustomEvent('dm:prefill', {
        detail: { interest: '加入 DealMakers’ Club', context: introEl.getAttribute('data-dm-intro') },
      }));
    }

    const interestEl = target.closest('[data-dm-prefill-interest]');
    if (interestEl) {
      window.dispatchEvent(new CustomEvent('dm:prefill', {
        detail: { interest: interestEl.getAttribute('data-dm-prefill-interest') },
      }));
    }

    const trackEl = target.closest('[data-dm-track]');
    if (trackEl) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'dealmakers_ss3_' + trackEl.getAttribute('data-dm-track'),
        label: trackEl.getAttribute('data-dm-track-label') || '',
      });
    }
  });

  const prefillInterest = new URLSearchParams(window.location.search).get('interest');
  if (prefillInterest) {
    let attempts = 0;
    const tryPrefill = () => {
      attempts += 1;
      window.dispatchEvent(new CustomEvent('dm:prefill', { detail: { interest: prefillInterest } }));
      if (attempts < 15) setTimeout(tryPrefill, 200);
    };
    tryPrefill();
  }
</script>
