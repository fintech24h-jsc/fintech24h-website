---
// src/pages/dealmakers/ar/ss3/index.astro
// Arabic (RTL) mirror of /dealmakers/ss3/. Same components, locale="ar".
import DealMakersLayout from '../../../../layouts/DealMakersLayout.astro';
import BreadcrumbSchema from '../../../../components/seo/BreadcrumbSchema.astro';
import DealMakersHero from '../../../../components/sections/dealmakers/DealMakersHero.astro';
import TelegramJoinBanner from '../../../../components/sections/dealmakers/TelegramJoinBanner.astro';
import FeaturedDealMakers from '../../../../components/sections/dealmakers/FeaturedDealMakers.astro';
import USPSection from '../../../../components/sections/dealmakers/USPSection.astro';
import LastSeasonPartners from '../../../../components/sections/dealmakers/LastSeasonPartners.astro';
import CommunityActivity from '../../../../components/sections/dealmakers/CommunityActivity.tsx';
import QualifiedDirectory from '../../../../components/sections/dealmakers/QualifiedDirectory.tsx';
import HowItWorks from '../../../../components/sections/dealmakers/HowItWorks.astro';
import PricingPackages from '../../../../components/sections/dealmakers/PricingPackages.astro';
import PartnerTracks from '../../../../components/sections/dealmakers/PartnerTracks.astro';
import MediaPartners from '../../../../components/sections/dealmakers/MediaPartners.astro';
import ApplyForm from '../../../../components/sections/dealmakers/ApplyForm.tsx';
import FaqAccordion from '../../../../components/sections/dealmakers/FaqAccordion.astro';
import { getSS3Content } from '../../../../data/dealmakers/content';
import { dealMakersMembers } from '../../../../data/dealmakers/members';

const { seasonMeta, faq, pricingPackages } = getSS3Content('ar');
const dealMakersMembersCount = dealMakersMembers.length;

const breadcrumbs = [
  { name: 'الرئيسية', item: 'https://fintech24h.com' },
  { name: 'DealMakers’ Club', item: 'https://fintech24h.com/dealmakers/ar/' },
  { name: 'Season 3', item: seasonMeta.canonical },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seasonMeta.title,
  description: seasonMeta.description,
  url: seasonMeta.canonical,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const packagesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${seasonMeta.name} Packages`,
  itemListElement: pricingPackages.map((pkg, i) => {
    const numericPrice = Number(pkg.price.replace(/[^0-9.]/g, ''));
    const isFromPrice = /from/i.test(pkg.price);
    return {
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: pkg.title,
        description: pkg.description,
        provider: { '@type': 'Organization', name: 'Fintech24h' },
        offers: {
          '@type': 'Offer',
          url: seasonMeta.canonical,
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          ...(isFromPrice
            ? { priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: numericPrice, priceCurrency: 'USD' } }
            : { price: numericPrice }),
        },
      },
    };
  }),
};
---

<DealMakersLayout locale="ar" title={seasonMeta.title} description={seasonMeta.description} canonical={seasonMeta.canonical} keywords={seasonMeta.keywords} schema={webPageSchema} ogImage={seasonMeta.ogImage}>
  <BreadcrumbSchema items={breadcrumbs} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(packagesSchema).replace(/</g, '\\u003c')} />

  <DealMakersHero locale="ar" />
  <TelegramJoinBanner locale="ar" />
  <FeaturedDealMakers locale="ar" />
  <USPSection locale="ar" />
  <LastSeasonPartners locale="ar" />
  <CommunityActivity locale="ar" client:load />

  <section class="relative py-12" aria-label="رابط دليل الأعضاء">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/dealmakers/ar/members/" class="dm-card group flex flex-col sm:flex-row items-center justify-between gap-5 p-6 sm:p-7 text-center sm:text-start" data-dm-reveal>
        <div>
          <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-2">دليل الأعضاء</p>
          <h2 class="font-display font-semibold text-lg text-[var(--dm-text-primary)]">
            تعرّف على أكثر من {dealMakersMembersCount} DealMaker موثّق عبر كل المواسم.
          </h2>
        </div>
        <span class="dm-btn-primary py-2.5 px-6 text-[10px] shrink-0 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform">
          عرض الأعضاء <span class="rtl:inline-block rtl:rotate-180">→</span>
        </span>
      </a>
    </div>
  </section>

  <section id="directory" class="relative py-20 lg:py-28" aria-label="دليل الإدراج المؤهّل">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10" data-dm-reveal>
        <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">دليل الإدراج المؤهّل</p>
        <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-4">
          10 ملفات موثّقة، <span class="dm-text-gradient">كل واحدة إشارة واضحة.</span>
        </h2>
        <p class="text-sm text-[var(--dm-text-secondary)]">
          انقر على أي ملف تعريفي لرؤية تفاصيل "نحن نقدّم" و"نحن نبحث عن"، وأرسل طلب تعارف عبر Fintech24h.
        </p>
      </div>
      <QualifiedDirectory locale="ar" client:load />
    </div>
  </section>

  <HowItWorks locale="ar" />
  <PricingPackages locale="ar" />
  <PartnerTracks locale="ar" />
  <MediaPartners locale="ar" />

  <section id="apply" class="relative py-20 lg:py-28" aria-label="التقديم للانضمام">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute w-[480px] h-[480px] rounded-full opacity-30 mix-blend-screen dm-orb-gold"
        style="bottom: 0; left: -10%; filter: blur(90px); animation: orb-pulse 9s ease-in-out infinite;"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-start">
      <div data-dm-reveal>
        <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">قدّم طلبك للانضمام · Season 3</p>
        <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-5">هل لديك إشارة صفقة واضحة؟</h2>
        <p class="text-sm text-[var(--dm-text-secondary)] leading-relaxed mb-6">
          ابدأ بإخبارنا بما تبنيه، والقيمة التي تقدّمها، ومن تريد مقابلته. سيتواصل فريق Fintech24h معك في حال وجود ملاءمة.
        </p>
        <ul class="space-y-3 text-sm text-[var(--dm-text-secondary)]">
          <li class="flex gap-2.5"><span class="text-[var(--dm-gold)]">✦</span>مناسب للمؤسسين، والمستثمرين، ومنصات التداول، ومزوّدي الخدمات، والشركاء الاستراتيجيين.</li>
          <li class="flex gap-2.5"><span class="text-[var(--dm-gold)]">✦</span>الأولوية للأعضاء الذين يشارك معهم صاحب قرار مباشر.</li>
          <li class="flex gap-2.5"><span class="text-[var(--dm-gold)]">✦</span>تيليجرام مطلوب حتى يتمكّن فريقنا من التحقق منك بأسرع وقت ممكن.</li>
        </ul>
      </div>
      <ApplyForm locale="ar" client:load />
    </div>
  </section>

  <FaqAccordion locale="ar" />
</DealMakersLayout>

<script is:inline>
  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target : null;
    if (!target) return;

    const introEl = target.closest('[data-dm-intro]');
    if (introEl) {
      window.dispatchEvent(new CustomEvent('dm:prefill', {
        detail: { interest: 'الانضمام إلى DealMakers’ Club', context: introEl.getAttribute('data-dm-intro') },
      }));
    }

    const interestEl = target.closest('[data-dm-prefill-interest]');
    if (interestEl) {
      window.dispatchEvent(new CustomEvent('dm:prefill', {
        detail: { interest: interestEl.getAttribute('data-dm-prefill-interest') },
      }));
    }

    const trackEl = target.closest('[data-dm-track]');
    if (trackEl) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'dealmakers_ss3_' + trackEl.getAttribute('data-dm-track'),
        label: trackEl.getAttribute('data-dm-track-label') || '',
      });
    }
  });

  const prefillInterest = new URLSearchParams(window.location.search).get('interest');
  if (prefillInterest) {
    let attempts = 0;
    const tryPrefill = () => {
      attempts += 1;
      window.dispatchEvent(new CustomEvent('dm:prefill', { detail: { interest: prefillInterest } }));
      if (attempts < 15) setTimeout(tryPrefill, 200);
    };
    tryPrefill();
  }
</script>
