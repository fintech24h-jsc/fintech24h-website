---
// src/pages/dealmakers/ar/ss3/join.astro
// Arabic mirror of /dealmakers/ss3/join/.
import DealMakersLayout from '../../../../layouts/DealMakersLayout.astro';
import BreadcrumbSchema from '../../../../components/seo/BreadcrumbSchema.astro';
import TelegramJoinForm from '../../../../components/sections/dealmakers/TelegramJoinForm.tsx';
import { getSS3Content } from '../../../../data/dealmakers/content';

const { telegramGroupName } = getSS3Content('ar');

const title = 'الانضمام إلى Fi24h DealMakers’ Club | Fintech24h';
const description = 'قدّم طلبك للانضمام إلى مجتمع Fi24h DealMakers’ Club على تيليجرام، وهي شبكة موثّقة من المؤسسين والمستثمرين والشركاء في Web3 والتكنولوجيا المالية.';
const canonical = 'https://fintech24h.com/dealmakers/ar/ss3/join/';

const breadcrumbs = [
  { name: 'الرئيسية', item: 'https://fintech24h.com' },
  { name: 'DealMakers’ Club', item: 'https://fintech24h.com/dealmakers/ar/' },
  { name: 'Season 3', item: 'https://fintech24h.com/dealmakers/ar/ss3/' },
  { name: 'الانضمام', item: canonical },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  isPartOf: {
    '@type': 'WebPage',
    name: 'Fintech24h DealMakers’ Club: F-Matching Season 3',
    url: 'https://fintech24h.com/dealmakers/ar/ss3/',
  },
};
---

<DealMakersLayout locale="ar" title={title} description={description} canonical={canonical} schema={webPageSchema} ogImage="https://fintech24h.com/dealmakers/og-ss3.png">
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="relative py-24 lg:py-32 overflow-hidden" aria-label="الانضمام إلى مجتمع تيليجرام">
    <div class="absolute inset-0" style="background: var(--dm-gradient-hero-bg);" aria-hidden="true"></div>
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute w-[420px] h-[420px] rounded-full opacity-30 mix-blend-screen dm-orb-gold"
        style="top: -8%; left: -6%; filter: blur(100px); animation: orb-pulse 10s ease-in-out infinite;"></div>
    </div>

    <div class="relative z-10 max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-10">
      <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-4">تقدّمه Fintech24h</p>
      <h1 class="font-display font-semibold text-h1 text-[var(--dm-text-primary)] mb-5">{telegramGroupName}</h1>
      <p class="text-sm sm:text-base text-[var(--dm-text-secondary)] max-w-xl mx-auto">
        مجتمع موثّق على تيليجرام للمؤسسين والمستثمرين والشركاء الاستراتيجيين في Web3 والتكنولوجيا المالية. تتم مراجعة كل عضو قبل الانضمام، لتبقى النقاشات ذات إشارة عالية.
      </p>
    </div>

    <div class="relative z-10 px-4">
      <TelegramJoinForm locale="ar" client:load />
    </div>
  </section>
</DealMakersLayout>
