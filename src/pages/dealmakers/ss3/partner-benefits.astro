---
// src/pages/dealmakers/ss3/partner-benefits.astro
// Full detail behind the condensed PartnerTracks section on the SS3 landing
// page — the complete Capital / Solution / Media / Project benefit lists
// plus the Partner Benefits Matrix comparison table. Kept off the main
// landing page deliberately (too dense for a scroll-through page); this is
// where a prospect who wants the full picture before applying lands.
import DealMakersLayout from '../../../layouts/DealMakersLayout.astro';
import BreadcrumbSchema from '../../../components/seo/BreadcrumbSchema.astro';
import {
  seasonMeta,
  partnerTracks,
  projectOnboardBenefits,
  partnerBenefitsMatrix,
  type MatrixValue,
} from '../../../data/dealmakers/ss3';

const title = 'Partner Benefits | F-Matching Season 3 — DealMakers’ Club';
const description = 'Compare Capital, Solution, Media, and Project benefits for F-Matching Season 3 — the full benefit list and partner comparison matrix.';
const canonical = 'https://fintech24h.com/dealmakers/ss3/partner-benefits/';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'DealMakers’ Club', item: 'https://fintech24h.com/dealmakers/' },
  { name: 'Season 3', item: 'https://fintech24h.com/dealmakers/ss3/' },
  { name: 'Partner Benefits', item: canonical },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  isPartOf: {
    '@type': 'WebPage',
    name: 'Fintech24h DealMakers’ Club: F-Matching Season 3',
    url: 'https://fintech24h.com/dealmakers/ss3/',
  },
};

// Project Onboard isn't a paid Category Partner track (see PricingPackages'
// Featured DealMaker / Qualified Listing), but it belongs in the same
// comparison since the Partner Benefits Matrix covers all four.
const projectCard = {
  id: 'project' as const,
  icon: 'PRJ',
  title: 'Project Onboard',
  description: 'For Web3, DeFi, AI × Web3, fintech, infrastructure, and other projects joining F-Matching.',
  fullBenefits: projectOnboardBenefits,
};

// Media comes last: it's an unpaid editorial exchange with the fewest
// benefits, deliberately ordered after the paid tracks and Project Onboard.
const [capitalTrack, solutionTrack, mediaTrack] = partnerTracks;
const allTracks = [capitalTrack, solutionTrack, projectCard, mediaTrack];

function applyHref(interest: string) {
  return `/dealmakers/ss3/?interest=${encodeURIComponent(interest)}#apply`;
}

const matrixCell: Record<MatrixValue, { icon: string; label: string; class: string }> = {
  yes: { icon: '✓', label: 'Included', class: 'text-[var(--dm-gold)]' },
  star: { icon: '★', label: 'Where relevant', class: 'text-[var(--dm-emerald)]' },
  optional: { icon: '+', label: 'Optional', class: 'text-[var(--dm-text-muted)]' },
  no: { icon: '—', label: 'Not included', class: 'text-[var(--dm-text-muted)]' },
};
---

<DealMakersLayout title={title} description={description} canonical={canonical} schema={webPageSchema} ogImage="https://fintech24h.com/dealmakers/og-ss3.png">
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="relative py-24 lg:py-28 overflow-hidden" aria-label="Partner benefits overview">
    <div class="absolute inset-0" style="background: var(--dm-gradient-hero-bg);" aria-hidden="true"></div>
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute w-[420px] h-[420px] rounded-full opacity-25 mix-blend-screen dm-orb-gold"
        style="top: -8%; left: -6%; filter: blur(100px); animation: orb-pulse 10s ease-in-out infinite;"></div>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-8">
      <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-4">{seasonMeta.name} · Partner Benefits</p>
      <h1 class="font-display font-semibold text-h1 text-[var(--dm-text-primary)] mb-5">
        Your brand, inside an active B2B ecosystem.
      </h1>
      <p class="text-sm sm:text-base text-[var(--dm-text-secondary)] max-w-2xl mx-auto leading-relaxed">
        We don’t simply offer sponsorship visibility. We put your brand where capital, projects, solutions, and decision-makers actually meet — Capital × Projects × Solutions × Media × Global Leaders.
      </p>
      <a href="/dealmakers/ss3/" class="dm-btn-ghost py-2.5 px-6 text-[10px] inline-flex items-center gap-1.5 mt-7">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Back to {seasonMeta.name}
      </a>
    </div>
  </section>

  <section class="relative pb-20 lg:pb-28" aria-label="Full benefit lists by partner type">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 gap-5">
        {allTracks.map((track, i) => (
          <div id={track.id} class="dm-card flex flex-col p-7 rounded-[20px] scroll-mt-24" data-dm-reveal style={`--dm-reveal-delay: ${i * 70}`}>
            <span class="w-11 h-11 rounded-xl bg-[var(--dm-bg-tertiary)] border border-[var(--dm-border)] flex items-center justify-center font-mono text-[11px] font-bold text-[var(--dm-gold)] mb-4" aria-hidden="true">
              {track.icon}
            </span>
            <h2 class="font-display font-semibold text-lg text-[var(--dm-text-primary)] mb-2">{track.title}</h2>
            <p class="text-xs text-[var(--dm-text-secondary)] leading-relaxed mb-5">{track.description}</p>

            <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-2.5 flex-1">
              {track.fullBenefits.map((b) => (
                <li class="flex items-start gap-2 text-xs text-[var(--dm-text-secondary)]">
                  <svg class="w-3 h-3 mt-0.5 shrink-0 text-[var(--dm-gold)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 13 4 4L19 7"/></svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>

            {'interest' in track && (
              <a
                href={applyHref((track as typeof partnerTracks[number]).interest)}
                class="dm-btn-primary justify-center text-xs w-full mt-6"
              >
                Apply as {track.title} <span aria-hidden="true">→</span>
              </a>
            )}
            {!('interest' in track) && (
              <a href="/dealmakers/ss3/#directory" class="dm-btn-ghost justify-center text-xs w-full mt-6">
                Submit a Project Listing <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative pb-24 lg:pb-28" aria-label="Partner benefits comparison matrix">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10" data-dm-reveal>
        <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">Side by side</p>
        <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-4">
          Partner benefits <span class="dm-text-gradient">at a glance.</span>
        </h2>
      </div>

      <div class="dm-card rounded-[20px] overflow-x-auto" data-dm-reveal>
        <table class="w-full min-w-[640px] text-left border-collapse">
          <thead>
            <tr class="border-b border-[var(--dm-border)]">
              <th class="p-4 sm:p-5 text-xs font-display font-semibold text-[var(--dm-text-primary)]">Benefit</th>
              <th class="p-4 sm:p-5 text-xs font-display font-semibold text-[var(--dm-text-primary)] text-center">Capital</th>
              <th class="p-4 sm:p-5 text-xs font-display font-semibold text-[var(--dm-text-primary)] text-center">Solution</th>
              <th class="p-4 sm:p-5 text-xs font-display font-semibold text-[var(--dm-text-primary)] text-center">Media</th>
              <th class="p-4 sm:p-5 text-xs font-display font-semibold text-[var(--dm-text-primary)] text-center">Project</th>
            </tr>
          </thead>
          <tbody>
            {partnerBenefitsMatrix.map((row) => (
              <tr class="border-b border-[var(--dm-border)] last:border-0">
                <th scope="row" class="p-4 sm:p-5 text-xs font-normal text-[var(--dm-text-secondary)] text-left">{row.label}</th>
                {(['capital', 'solution', 'media', 'project'] as const).map((col) => (
                  <td class="p-4 sm:p-5 text-center">
                    <span class={`text-sm font-semibold ${matrixCell[row[col]].class}`} title={matrixCell[row[col]].label} aria-label={matrixCell[row[col]].label}>
                      {matrixCell[row[col]].icon}
                    </span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-xs text-[var(--dm-text-muted)] mt-4">
        <span class="text-[var(--dm-gold)] font-semibold">✓</span> Included &nbsp;·&nbsp;
        <span class="text-[var(--dm-emerald)] font-semibold">★</span> Where relevant to your goals &nbsp;·&nbsp;
        <span class="font-semibold">+</span> Optional add-on &nbsp;·&nbsp;
        <span class="font-semibold">—</span> Not included
      </p>
    </div>
  </section>

  <section class="relative pb-24 lg:pb-32" aria-label="Talk to the team">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-dm-reveal>
      <h2 class="font-display font-semibold text-h3 text-[var(--dm-text-primary)] mb-4">
        Not sure which track fits?
      </h2>
      <p class="text-sm text-[var(--dm-text-secondary)] mb-7">
        Tell us what you’re building or offering, and the Fintech24h team will recommend the right fit — Capital, Solution, Media, or Project.
      </p>
      <a href="/dealmakers/ss3/#apply" class="dm-btn-primary justify-center text-xs px-7 py-3 inline-flex">
        Talk to the team <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</DealMakersLayout>
