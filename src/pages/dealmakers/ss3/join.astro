---
// src/pages/dealmakers/ss3/join.astro
// Standalone, shareable Telegram community join form. Deliberately its own
// URL (not just a modal on the main landing page) so the team can send this
// link directly to a prospect for vetting, without them having to hunt for
// a button on the full page first.
import DealMakersLayout from '../../../layouts/DealMakersLayout.astro';
import BreadcrumbSchema from '../../../components/seo/BreadcrumbSchema.astro';
import TelegramJoinForm from '../../../components/sections/dealmakers/TelegramJoinForm.tsx';
import { telegramGroupName } from '../../../data/dealmakers/ss3';

const title = 'Join Fi24h DealMakers’ Club | Fintech24h';
const description = 'Request to join the Fi24h DealMakers’ Club Telegram community, a vetted network of Web3 and fintech Founders, Investors, and partners.';
const canonical = 'https://fintech24h.com/dealmakers/ss3/join/';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'DealMakers’ Club', item: 'https://fintech24h.com/dealmakers/' },
  { name: 'Season 3', item: 'https://fintech24h.com/dealmakers/ss3/' },
  { name: 'Join', item: canonical },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  isPartOf: {
    '@type': 'WebPage',
    name: 'Fintech24h DealMakers’ Club: F-Matching Season 3',
    url: 'https://fintech24h.com/dealmakers/ss3/',
  },
};
---

<DealMakersLayout title={title} description={description} canonical={canonical} schema={webPageSchema} ogImage="https://fintech24h.com/dealmakers/og-ss3.png">
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="relative py-24 lg:py-32 overflow-hidden" aria-label="Join the Telegram community">
    <div class="absolute inset-0" style="background: var(--dm-gradient-hero-bg);" aria-hidden="true"></div>
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute w-[420px] h-[420px] rounded-full opacity-30 mix-blend-screen dm-orb-gold"
        style="top: -8%; left: -6%; filter: blur(100px); animation: orb-pulse 10s ease-in-out infinite;"></div>
    </div>

    <div class="relative z-10 max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-10">
      <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-4">Fintech24h presents</p>
      <h1 class="font-display font-semibold text-h1 text-[var(--dm-text-primary)] mb-5">{telegramGroupName}</h1>
      <p class="text-sm sm:text-base text-[var(--dm-text-secondary)] max-w-xl mx-auto">
        A vetted Telegram community for Web3 and fintech Founders, Investors, and strategic partners. Every member is reviewed before joining, so the conversations stay high signal.
      </p>
    </div>

    <div class="relative z-10 px-4">
      <TelegramJoinForm client:load />
    </div>
  </section>
</DealMakersLayout>
