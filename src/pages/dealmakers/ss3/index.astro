---
// src/pages/dealmakers/ss3/index.astro
// DealMakers' Club — F-Matching Season 3 landing page. Standalone microsite:
// its own layout/header/footer/color system (DealMakersLayout), not the
// main fintech24h.com chrome.
import DealMakersLayout from '../../../layouts/DealMakersLayout.astro';
import BreadcrumbSchema from '../../../components/seo/BreadcrumbSchema.astro';
import DealMakersHero from '../../../components/sections/dealmakers/DealMakersHero.astro';
import TelegramJoinBanner from '../../../components/sections/dealmakers/TelegramJoinBanner.astro';
import FeaturedDealMakers from '../../../components/sections/dealmakers/FeaturedDealMakers.astro';
import USPSection from '../../../components/sections/dealmakers/USPSection.astro';
import LastSeasonPartners from '../../../components/sections/dealmakers/LastSeasonPartners.astro';
import QualifiedDirectory from '../../../components/sections/dealmakers/QualifiedDirectory.tsx';
import HowItWorks from '../../../components/sections/dealmakers/HowItWorks.astro';
import PricingPackages from '../../../components/sections/dealmakers/PricingPackages.astro';
import MediaPartners from '../../../components/sections/dealmakers/MediaPartners.astro';
import ApplyForm from '../../../components/sections/dealmakers/ApplyForm.tsx';
import FaqAccordion from '../../../components/sections/dealmakers/FaqAccordion.astro';
import { seasonMeta, faq, pricingPackages } from '../../../data/dealmakers/ss3';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'DealMakers’ Club', item: 'https://fintech24h.com/dealmakers/' },
  { name: 'Season 3', item: seasonMeta.canonical },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seasonMeta.title,
  description: seasonMeta.description,
  url: seasonMeta.canonical,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

// "From $5,000" / "$1,000" / "$200" -> numeric price for schema. Packages
// with a leading "From" are a starting price, not a fixed one — expose
// that distinction with priceSpecification's minPrice instead of price.
// Modeled as Service, not Product: these are sponsorship/listing services,
// not physical or purchasable-inventory goods, and Google's Product rich
// result guidelines are specifically scoped to the latter.
const packagesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${seasonMeta.name} — Packages`,
  itemListElement: pricingPackages.map((pkg, i) => {
    const numericPrice = Number(pkg.price.replace(/[^0-9.]/g, ''));
    const isFromPrice = /from/i.test(pkg.price);
    return {
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: pkg.title,
        description: pkg.description,
        provider: { '@type': 'Organization', name: 'Fintech24h' },
        offers: {
          '@type': 'Offer',
          url: seasonMeta.canonical,
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          ...(isFromPrice
            ? { priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: numericPrice, priceCurrency: 'USD' } }
            : { price: numericPrice }),
        },
      },
    };
  }),
};
---

<DealMakersLayout title={seasonMeta.title} description={seasonMeta.description} canonical={seasonMeta.canonical} keywords={seasonMeta.keywords} schema={webPageSchema}>
  <BreadcrumbSchema items={breadcrumbs} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(packagesSchema).replace(/</g, '\\u003c')} />

  <DealMakersHero />
  <TelegramJoinBanner />
  <FeaturedDealMakers />
  <USPSection />
  <LastSeasonPartners />

  <section id="directory" class="relative py-20 lg:py-28" aria-label="Qualified Listing Directory">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10" data-dm-reveal>
        <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">Qualified Listing Directory</p>
        <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-4">
          10 verified profiles, <span class="dm-text-gradient">each one a clear signal.</span>
        </h2>
        <p class="text-sm text-[var(--dm-text-secondary)]">
          Click any profile to see We Offer, We Are Looking For details, and send a Request Introduction through Fintech24h.
        </p>
      </div>
      <QualifiedDirectory client:load />
    </div>
  </section>

  <HowItWorks />
  <PricingPackages />
  <MediaPartners />

  <section id="apply" class="relative py-20 lg:py-28" aria-label="Apply to Join">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute w-[480px] h-[480px] rounded-full opacity-30 mix-blend-screen dm-orb-gold"
        style="bottom: 0; left: -10%; filter: blur(90px); animation: orb-pulse 9s ease-in-out infinite;"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-start">
      <div data-dm-reveal>
        <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">Apply to join · Season 3</p>
        <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-5">Do you have a clear deal signal?</h2>
        <p class="text-sm text-[var(--dm-text-secondary)] leading-relaxed mb-6">
          Start by telling us what you’re building, the value you bring, and who you want to meet. The Fintech24h team will follow up if there’s a fit.
        </p>
        <ul class="space-y-3 text-sm text-[var(--dm-text-secondary)]">
          <li class="flex gap-2.5"><span class="text-[var(--dm-gold)]">✦</span>Fits Founders, Investors, Exchanges, Service Providers, and Strategic Partners.</li>
          <li class="flex gap-2.5"><span class="text-[var(--dm-gold)]">✦</span>Priority for members with a direct decision-maker involved.</li>
          <li class="flex gap-2.5"><span class="text-[var(--dm-gold)]">✦</span>Telegram is required so our team can verify you as fast as possible.</li>
        </ul>
      </div>
      <ApplyForm client:load />
    </div>
  </section>

  <FaqAccordion />
</DealMakersLayout>

<script is:inline>
  // Delegated click handling for the whole Season 3 page:
  // 1) [data-dm-intro] (Featured DealMaker cards) and [data-dm-prefill-interest]
  //    (package/media/request-intro CTAs) prefill the Apply form via a window event.
  // 2) [data-dm-track] pushes a namespaced event to GTM's dataLayer for
  //    campaign-specific analytics, independent from the site-wide GA4 stream.
  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target : null;
    if (!target) return;

    const introEl = target.closest('[data-dm-intro]');
    if (introEl) {
      window.dispatchEvent(new CustomEvent('dm:prefill', {
        detail: { interest: 'Join DealMakers’ Club', context: introEl.getAttribute('data-dm-intro') },
      }));
    }

    const interestEl = target.closest('[data-dm-prefill-interest]');
    if (interestEl) {
      window.dispatchEvent(new CustomEvent('dm:prefill', {
        detail: { interest: interestEl.getAttribute('data-dm-prefill-interest') },
      }));
    }

    const trackEl = target.closest('[data-dm-track]');
    if (trackEl) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'dealmakers_ss3_' + trackEl.getAttribute('data-dm-track'),
        label: trackEl.getAttribute('data-dm-track-label') || '',
      });
    }
  });
</script>
