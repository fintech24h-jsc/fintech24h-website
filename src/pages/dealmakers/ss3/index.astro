---
// src/pages/dealmakers/ss3/index.astro
// DealMakers' Club — F-Matching Season 3 landing page. Full 11-section build.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../../components/seo/BreadcrumbSchema.astro';
import DealMakersHero from '../../../components/sections/dealmakers/DealMakersHero.astro';
import FeaturedDealMakers from '../../../components/sections/dealmakers/FeaturedDealMakers.astro';
import USPSection from '../../../components/sections/dealmakers/USPSection.astro';
import LastSeasonPartners from '../../../components/sections/dealmakers/LastSeasonPartners.astro';
import QualifiedDirectory from '../../../components/sections/dealmakers/QualifiedDirectory.tsx';
import RequestIntroduction from '../../../components/sections/dealmakers/RequestIntroduction.astro';
import PricingPackages from '../../../components/sections/dealmakers/PricingPackages.astro';
import MediaPartners from '../../../components/sections/dealmakers/MediaPartners.astro';
import ApplyForm from '../../../components/sections/dealmakers/ApplyForm.tsx';
import FaqAccordion from '../../../components/sections/dealmakers/FaqAccordion.astro';
import { seasonMeta, faq } from '../../../data/dealmakers/ss3';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'DealMakers’ Club', item: 'https://fintech24h.com/dealmakers/' },
  { name: 'Season 3', item: seasonMeta.canonical },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seasonMeta.title,
  description: seasonMeta.description,
  url: seasonMeta.canonical,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout title={seasonMeta.title} description={seasonMeta.description} canonical={seasonMeta.canonical} schema={webPageSchema}>
  <BreadcrumbSchema items={breadcrumbs} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g, '\\u003c')} />

  <DealMakersHero />
  <FeaturedDealMakers />
  <USPSection />
  <LastSeasonPartners />

  <section id="directory" class="relative py-20 lg:py-28" aria-label="Qualified Listing Directory">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <p class="font-mono text-[10px] text-[var(--accent-cyan)] uppercase tracking-[0.18em] mb-3">Qualified Listing Directory</p>
        <h2 class="font-display font-bold text-h2 text-[var(--text-primary)] mb-4">
          10 profile đã xác minh, <span class="text-gradient">mỗi profile là một tín hiệu rõ ràng.</span>
        </h2>
        <p class="text-sm text-[var(--text-secondary)]">
          Nhấp vào bất kỳ profile nào để xem chi tiết We Offer, We Are Looking For và gửi Request Introduction qua Fintech24h.
        </p>
        <p class="text-xs text-[var(--text-muted)] mt-2">Các profile bên dưới là ví dụ minh hoạ để hình dung layout.</p>
      </div>
      <QualifiedDirectory client:load />
    </div>
  </section>

  <RequestIntroduction />
  <PricingPackages />
  <MediaPartners />

  <section id="apply" class="relative py-20 lg:py-28" aria-label="Apply to Join">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute w-[480px] h-[480px] rounded-full opacity-30 mix-blend-screen"
        style="bottom: 0; left: -10%; background: var(--gradient-glow-cyan); filter: blur(90px); animation: orb-pulse 9s ease-in-out infinite;"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <p class="font-mono text-[10px] text-[var(--accent-cyan)] uppercase tracking-[0.18em] mb-3">Apply to join · Season 3</p>
        <h2 class="font-display font-bold text-h2 text-[var(--text-primary)] mb-5">Bạn có một tín hiệu deal rõ ràng?</h2>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
          Hãy bắt đầu bằng việc cho chúng tôi biết bạn đang xây gì, mang lại giá trị gì và muốn gặp ai. Đội Fintech24h sẽ phản hồi nếu có mức độ phù hợp.
        </p>
        <ul class="space-y-3 text-sm text-[var(--text-secondary)]">
          <li class="flex gap-2.5"><span class="text-[var(--accent-cyan)]">✦</span>Phù hợp với Founder, Investor, Exchange, Service Provider và Strategic Partner.</li>
          <li class="flex gap-2.5"><span class="text-[var(--accent-cyan)]">✦</span>Ưu tiên thành viên có người ra quyết định trực tiếp tham gia.</li>
          <li class="flex gap-2.5"><span class="text-[var(--accent-cyan)]">✦</span>Telegram là bắt buộc để đội ngũ liên hệ xác minh nhanh nhất.</li>
        </ul>
      </div>
      <ApplyForm client:load />
    </div>
  </section>

  <FaqAccordion />
</BaseLayout>

<script is:inline>
  // Delegated click handling for the whole Season 3 page:
  // 1) [data-dm-intro] (Featured DealMaker cards) and [data-dm-prefill-interest]
  //    (package/media/request-intro CTAs) prefill the Apply form via a window event.
  // 2) [data-dm-track] pushes a namespaced event to GTM's dataLayer for
  //    campaign-specific analytics, independent from the site-wide GA4 stream.
  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target : null;
    if (!target) return;

    const introEl = target.closest('[data-dm-intro]');
    if (introEl) {
      window.dispatchEvent(new CustomEvent('dm:prefill', {
        detail: { interest: 'Tham gia DealMakers’ Club', context: introEl.getAttribute('data-dm-intro') },
      }));
    }

    const interestEl = target.closest('[data-dm-prefill-interest]');
    if (interestEl) {
      window.dispatchEvent(new CustomEvent('dm:prefill', {
        detail: { interest: interestEl.getAttribute('data-dm-prefill-interest') },
      }));
    }

    const trackEl = target.closest('[data-dm-track]');
    if (trackEl) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'dealmakers_ss3_' + trackEl.getAttribute('data-dm-track'),
        label: trackEl.getAttribute('data-dm-track-label') || '',
      });
    }
  });
</script>
