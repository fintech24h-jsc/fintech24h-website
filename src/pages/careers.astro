---
// src/pages/careers.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import Badge from '../components/ui/Badge.astro';
import JobApplicationForm from '../components/ui/JobApplicationForm';
import { jobs } from '../data/jobs';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Careers', item: 'https://fintech24h.com/careers/' }
];

const careersSchema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "Careers at Fintech24h",
    "url": "https://fintech24h.com/careers/",
    "description": "Join Fintech24h, the premier marketing authority in blockchain and AI. Explore remote-friendly careers in Web3 community management, KOL marketing, PR, and content creation.",
    "mainEntity": { "@type": "Organization", "@id": "https://fintech24h.com/#organization" }
  }
];

// Unique list of departments for filtering
const departments = ['All', ...new Set(jobs.map(job => job.department))];
---

<BaseLayout
  title="Careers at Fintech24h — Join the Web3 & Blockchain Growth Core"
  description="Join Fintech24h, the premier marketing authority in blockchain and AI. Explore remote-friendly careers in Web3 community management, KOL marketing, PR, and content creation."
  schema={careersSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- SECTION 1 — HERO (Web3 HUD Command Center & Glitch Spotlight) -->
  <section class="relative min-h-[95vh] flex flex-col justify-center items-center px-4 overflow-hidden bg-[var(--bg-primary)]">
    <!-- CRT Scanlines Filter Overlay -->
    <div class="absolute inset-0 pointer-events-none z-30 scanlines-overlay opacity-[0.03]" aria-hidden="true"></div>

    <!-- Spotlight / Neon Nebulae -->
    <div class="absolute top-[-15%] left-1/2 -translate-x-1/2 w-[85vw] h-[85vh] bg-[radial-gradient(ellipse_at_top,rgba(0,200,240,0.18),transparent_65%)] pointer-events-none z-10" aria-hidden="true"></div>
    <div class="absolute bottom-[-10%] right-[10%] w-[500px] h-[500px] rounded-full bg-[var(--gradient-glow-purple)] opacity-15 filter blur-[120px] pointer-events-none animate-[orb-drift_18s_infinite_ease-in-out]" aria-hidden="true"></div>
    <div class="absolute top-[30%] left-[-10%] w-[350px] h-[350px] rounded-full bg-[var(--gradient-glow-cyan)] opacity-10 filter blur-[90px] pointer-events-none animate-[orb-pulse_12s_infinite_ease-in-out]" aria-hidden="true"></div>

    <!-- Cyber Grid Background -->
    <div class="absolute inset-0 pointer-events-none opacity-20 z-0" aria-hidden="true">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#00c8f015_1px,transparent_1px),linear-gradient(to_bottom,#00c8f015_1px,transparent_1px)] bg-[size:3.5rem_3.5rem]"></div>
      <div class="absolute inset-0 grid-pattern opacity-10"></div>
    </div>

    <!-- Rotating Cyber Ring (HUD Visual Element) -->
    <div class="absolute w-[600px] h-[600px] md:w-[850px] md:h-[850px] rounded-full border border-dashed border-cyan-400/5 pointer-events-none z-0 animate-[spin-slow_60s_linear_infinite] flex items-center justify-center" aria-hidden="true">
      <div class="w-[90%] h-[90%] rounded-full border border-double border-purple-500/5 animate-[spin_40s_linear_infinite_reverse]"></div>
      <div class="w-[75%] h-[75%] rounded-full border border-dashed border-cyan-400/5"></div>
    </div>

    <!-- HUD Indicators -->
    <div class="absolute top-28 left-8 hidden lg:block font-mono text-[9px] text-[var(--accent-cyan)] opacity-60 space-y-1.5 z-20" aria-hidden="true">
      <div class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span> SYS.STATUS // ONLINE</div>
      <div>CORE.INTEGRITY // RECRUITMENT_OPEN</div>
      <div class="text-[var(--text-muted)]">PROTOCOL // TALENT_NODE_INDEX</div>
    </div>
    
    <div class="absolute top-28 right-8 hidden lg:block font-mono text-[9px] text-[var(--accent-purple)] opacity-60 space-y-1.5 z-20 text-right" aria-hidden="true">
      <div>LATENCY // 7ms</div>
      <div>NETWORK // FINTECH24H_ECOSYSTEM</div>
      <div class="text-[var(--text-muted)]">SEC_OP // CYBER_CORE_V3.8</div>
    </div>

    <div class="relative z-20 text-center max-w-5xl mx-auto mt-20 px-4">
      <div class="reveal">
        <p class="font-mono text-[10px] uppercase tracking-[0.4em] text-[var(--accent-cyan)] mb-6 animate-[pulse_3s_infinite]">// CAREERS // TALENT INDEX</p>
      </div>

      <h1 class="font-display max-w-5xl mx-auto leading-[1.1] tracking-tight">
        <span class="block text-[clamp(2.5rem,6vw,5.5rem)] font-bold tracking-tight text-[var(--text-primary)] uppercase drop-shadow-[0_0_40px_rgba(0,200,240,0.15)]">
          Shape the Future of <br class="hidden sm:inline" />
          <span class="text-[var(--accent-cyan)] drop-shadow-[0_0_30px_rgba(0,200,240,0.25)] font-extrabold">
            Web3 Marketing
          </span>
        </span>
      </h1>

      <p class="font-body text-base md:text-lg text-[color-mix(in_srgb,var(--text-primary)_60%,transparent)] max-w-2xl mx-auto mt-8 mb-16 leading-[1.8] font-light">
        We replace standard marketing speculations with quantitative, data-driven Web3 architectures. Fintech24h is recruiting top-tier specialists to accelerate global blockchain protocols.
      </p>

      <!-- Futuristic Metrics Dashboard Panel -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto mb-16 relative z-20" data-animate="scale-in">
        <!-- Metric Node 1 -->
        <div class="liquid-glass-premium p-6 relative group hover:-translate-y-1 transition-all duration-300">
          <div class="absolute top-0 right-0 p-2 font-mono text-[7px] text-[color-mix(in_srgb,var(--text-primary)_10%,transparent)] select-none">// SCALE_01</div>
          <div class="text-[clamp(1.8rem,4vw,2.5rem)] font-bold font-display text-[var(--accent-cyan)] drop-shadow-[0_0_15px_rgba(0,200,240,0.2)] tracking-tight">50M+</div>
          <div class="font-mono text-[9px] text-[var(--text-secondary)] opacity-70 uppercase tracking-widest mt-1.5">Total Reach</div>
        </div>

        <!-- Metric Node 2 -->
        <div class="liquid-glass-premium p-6 relative group hover:-translate-y-1 transition-all duration-300">
          <div class="absolute top-0 right-0 p-2 font-mono text-[7px] text-[color-mix(in_srgb,var(--text-primary)_10%,transparent)] select-none">// NETWORK_02</div>
          <div class="text-[clamp(1.8rem,4vw,2.5rem)] font-bold font-display text-[var(--accent-purple)] drop-shadow-[0_0_15px_rgba(124,92,252,0.2)] tracking-tight">150+</div>
          <div class="font-mono text-[9px] text-[var(--text-secondary)] opacity-70 uppercase tracking-widest mt-1.5">Elite KOL Partners</div>
        </div>

        <!-- Metric Node 3 -->
        <div class="liquid-glass-premium p-6 relative group hover:-translate-y-1 transition-all duration-300">
          <div class="absolute top-0 right-0 p-2 font-mono text-[7px] text-[color-mix(in_srgb,var(--text-primary)_10%,transparent)] select-none">// ECOSYSTEMS_03</div>
          <div class="text-[clamp(1.8rem,4vw,2.5rem)] font-bold font-display text-[var(--text-primary)] tracking-tight">12+</div>
          <div class="font-mono text-[9px] text-[var(--text-secondary)] opacity-70 uppercase tracking-widest mt-1.5">Chains Supported</div>
        </div>

        <!-- Metric Node 4 -->
        <div class="liquid-glass-premium p-6 relative group hover:-translate-y-1 transition-all duration-300">
          <div class="absolute top-0 right-0 p-2 font-mono text-[7px] text-[color-mix(in_srgb,var(--text-primary)_10%,transparent)] select-none">// GLOBAL_04</div>
          <div class="text-[clamp(1.8rem,4vw,2.5rem)] font-bold font-display text-emerald-400 drop-shadow-[0_0_15px_rgba(52,211,153,0.2)] tracking-tight">24/7</div>
          <div class="font-mono text-[9px] text-[var(--text-secondary)] opacity-70 uppercase tracking-widest mt-1.5">Distributed Nodes</div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-6 relative z-20">
        <a href="#open-positions" class="btn-liquid-glass-primary w-full sm:w-auto px-8 py-4 text-xs tracking-[0.2em]">
          View Open Positions
        </a>
        <a href="#general-application" class="btn-liquid-glass-ghost w-full sm:w-auto px-8 py-4 text-xs tracking-[0.2em]">
          Send General Application
        </a>
      </div>
    </div>
    
    <!-- Cinematic Fade Bottom -->
    <div class="absolute bottom-0 w-full h-32 bg-gradient-to-t from-[var(--bg-primary)] to-transparent pointer-events-none" aria-hidden="true"></div>
  </section>

  <!-- SECTION 2 — SYSTEM PERKS (Asymmetrical Creative Blueprint Layout) -->
  <section class="py-24 bg-[var(--bg-primary)] relative z-10 border-y border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center space-y-4 mb-20" data-animate="fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[color-mix(in_srgb,var(--accent-purple)_20%,transparent)] bg-[color-mix(in_srgb,var(--accent-purple)_5%,transparent)] text-[var(--accent-purple)] text-xs font-mono font-medium tracking-widest uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-purple)] animate-pulse" />
          SYS.VARIABLES // CULTURAL_PERKS
        </div>
        <h2 class="font-display text-h2 font-bold text-[var(--text-primary)] max-w-2xl mx-auto">
          Protocol Perks & 
          <span class="text-[var(--accent-purple)]">
            Ecosystem Rules
          </span>
        </h2>
        <div class="w-16 h-px bg-gradient-to-r from-transparent via-[color-mix(in_srgb,var(--accent-purple)_60%,transparent)] to-transparent mx-auto" />
      </div>

      <!-- Asymmetrical Creative Grid Layout -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 max-w-5xl mx-auto">
        
        <!-- Perks 1: Global (Span 7) -->
        <div class="liquid-glass-premium md:col-span-7 p-8 flex flex-col justify-between group hover:-translate-y-1.5 transition-all duration-500" data-animate="fade-up">
          <div class="absolute -top-[20%] -right-[20%] w-48 h-48 rounded-full bg-[var(--accent-cyan)] opacity-[0.03] filter blur-[30px] pointer-events-none group-hover:opacity-[0.06] transition-opacity" />
          <div class="absolute top-0 right-0 p-4 font-mono text-[8px] text-[color-mix(in_srgb,var(--text-primary)_5%,transparent)] opacity-40 select-none group-hover:text-[color-mix(in_srgb,var(--accent-cyan)_10%,transparent)] transition-colors">
            NODE.ADDR: GLOBAL_NET
          </div>
          <div class="space-y-4 relative z-10">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] to-[color-mix(in_srgb,var(--accent-purple)_20%,transparent)] border border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] flex items-center justify-center text-[var(--accent-cyan)] shadow-[0_0_15px_rgba(0,200,240,0.1)]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" />
                <line x1="2" y1="12" x2="22" y2="12" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
            </div>
            <h3 class="font-display text-h3 font-bold text-[var(--text-primary)] uppercase tracking-wide">
              Global Scale & Foundation Networks
            </h3>
            <p class="font-body text-sm text-text-secondary leading-relaxed font-light">
              Connect directly with Tier-1 blockchain ecosystems, venture capitals, and high-performance Web3 nodes globally. You will deploy campaigns that hit core audiences across target regional zones.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-[var(--border-subtle)] flex justify-between items-center text-[9px] font-mono text-[var(--accent-cyan)] uppercase tracking-widest relative z-10">
            <span>[ EXPONENT: GLOBAL_GROWTH ]</span>
            <span>OK // 1.0</span>
          </div>
        </div>

        <!-- Perks 2: Remote Autonomy (Span 5) -->
        <div class="liquid-glass-premium md:col-span-5 p-8 flex flex-col justify-between group hover:-translate-y-1.5 transition-all duration-500" data-animate="fade-up">
          <div class="absolute -bottom-[20%] -right-[20%] w-40 h-40 rounded-full bg-[var(--accent-purple)] opacity-[0.03] filter blur-[30px] pointer-events-none group-hover:opacity-[0.06] transition-opacity" />
          <div class="absolute top-0 right-0 p-4 font-mono text-[8px] text-[color-mix(in_srgb,var(--text-primary)_5%,transparent)] opacity-40 select-none group-hover:text-[color-mix(in_srgb,var(--accent-purple)_10%,transparent)] transition-colors">
            NODE.ADDR: ASYNC_NODE
          </div>
          <div class="space-y-4 relative z-10">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[color-mix(in_srgb,var(--accent-purple)_20%,transparent)] to-transparent border border-[color-mix(in_srgb,var(--accent-purple)_30%,transparent)] flex items-center justify-center text-[var(--accent-purple)] shadow-[0_0_15px_rgba(124,92,252,0.1)]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
            </div>
            <h3 class="font-display text-lg font-bold text-[var(--text-primary)] uppercase tracking-wide">
              Distributed Remote Nodes
            </h3>
            <p class="font-body text-xs text-text-secondary leading-relaxed font-light">
              Collaborate seamlessly via async channels. We value results over timezone surveillance, allowing you absolute autonomy to design your ideal workspace architecture.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-[var(--border-subtle)] flex justify-between items-center text-[9px] font-mono text-[var(--accent-purple)] uppercase tracking-widest relative z-10">
            <span>[ METRIC: TOTAL_AUTONOMY ]</span>
            <span>100%</span>
          </div>
        </div>

        <!-- Perks 3: Creative Freedom (Span 5) -->
        <div class="liquid-glass-premium md:col-span-5 p-8 flex flex-col justify-between group hover:-translate-y-1.5 transition-all duration-500" data-animate="fade-up">
          <div class="absolute -top-[20%] -left-[20%] w-40 h-40 rounded-full bg-white opacity-[0.015] filter blur-[30px] pointer-events-none group-hover:opacity-[0.03] transition-opacity" />
          <div class="absolute top-0 right-0 p-4 font-mono text-[8px] text-[color-mix(in_srgb,var(--text-primary)_5%,transparent)] opacity-40 select-none group-hover:text-[color-mix(in_srgb,var(--text-primary)_10%,transparent)] transition-colors">
            NODE.ADDR: CREATIVE_CORE
          </div>
          <div class="space-y-4 relative z-10">
            <div class="w-12 h-12 rounded-xl bg-[var(--surface-soft)] border border-[var(--border-default)] flex items-center justify-center text-[color-mix(in_srgb,var(--text-primary)_60%,transparent)]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
              </svg>
            </div>
            <h3 class="font-display text-lg font-bold text-[var(--text-primary)] uppercase tracking-wide">
              Creative Autonomy Protocol
            </h3>
            <p class="font-body text-xs text-text-secondary leading-relaxed font-light">
              We empower builders to run, test, and iterate marketing vectors. We back our contributors with the budget and resources to build real ecosystem influence.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-[var(--border-subtle)] flex justify-between items-center text-[9px] font-mono text-[var(--text-muted)] uppercase tracking-widest relative z-10">
            <span>[ CRITERIA: OWNERSHIP ]</span>
            <span>ACTIVE // 1</span>
          </div>
        </div>

        <!-- Perks 4: Career Matrix (Span 7) -->
        <div class="liquid-glass-premium md:col-span-7 p-8 flex flex-col justify-between group hover:-translate-y-1.5 transition-all duration-500" data-animate="fade-up">
          <div class="absolute -bottom-[20%] -left-[20%] w-48 h-48 rounded-full bg-emerald-500 opacity-[0.02] filter blur-[30px] pointer-events-none group-hover:opacity-[0.05] transition-opacity" />
          <div class="absolute top-0 right-0 p-4 font-mono text-[8px] text-[color-mix(in_srgb,var(--text-primary)_5%,transparent)] opacity-40 select-none group-hover:text-emerald-500/10 transition-colors">
            NODE.ADDR: GROWTH_MTX
          </div>
          <div class="space-y-4 relative z-10">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500/20 to-transparent border border-emerald-500/30 flex items-center justify-center text-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.1)]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                <polyline points="17 6 23 6 23 12" />
              </svg>
            </div>
            <h3 class="font-display text-h3 font-bold text-[var(--text-primary)] uppercase tracking-wide">
              Asymmetrical Network Scaling
            </h3>
            <p class="font-body text-sm text-text-secondary leading-relaxed font-light">
              We build your value index. You will interface directly with foundation leads, venture capitals, and Web3 protocol architects, scaling your professional network and authority in this space.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-[var(--border-subtle)] flex justify-between items-center text-[9px] font-mono text-emerald-400 uppercase tracking-widest relative z-10">
            <span>[ EXPONENT: VALUE_INDEXER ]</span>
            <span>SYS_READY // OK</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3 — ACTIVE JOBS (HUD Data Nodes & Vanilla JS Filter Stream) -->
  <section id="open-positions" class="py-32 bg-[var(--bg-primary)] relative z-10">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center space-y-4 mb-20" data-animate="fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_5%,transparent)] text-[var(--accent-cyan)] text-xs font-mono font-medium tracking-widest uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse" />
          ACTIVE_REGISTRIES
        </div>
        <h2 class="font-display text-h2 font-bold text-[var(--text-primary)] max-w-2xl mx-auto">
          Ecosystem Openings // 
          <span class="text-[var(--accent-cyan)]">
            Active Nodes
          </span>
        </h2>
        <div class="w-16 h-px bg-gradient-to-r from-transparent via-[color-mix(in_srgb,var(--accent-cyan)_60%,transparent)] to-transparent mx-auto" />
      </div>

      <!-- Dashboard-Style Navigation Filter -->
      <div class="flex justify-center flex-wrap gap-4 mb-16" data-animate="fade-up">
        {departments.map((dept) => (
          <button
            type="button"
            data-filter={dept}
            class="filter-tab px-6 py-2.5 border rounded-full font-mono text-[10px] uppercase tracking-[0.15em] transition-all duration-300 cursor-pointer text-[var(--text-muted)] border-[var(--border-subtle)] bg-white/[0.005] hover:border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] hover:text-[var(--text-primary)]"
          >
            {dept === 'All' ? 'All Departments' : dept}
          </button>
        ))}
      </div>

      <!-- Jobs Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto" id="jobs-container">
        {jobs.map((job, idx) => (
          <div
            data-department={job.department}
            class="job-card liquid-glass-premium p-6 sm:p-8 transition-all duration-500 flex flex-col justify-between gap-6 hover:-translate-y-1.5 group"
            data-animate="fade-up"
          >
            <div class="space-y-5">
              <div class="flex justify-between items-center gap-4 relative z-10">
                <Badge variant={job.department.includes('Community') ? 'purple' : 'cyan'}>
                  {job.department.toUpperCase()}
                </Badge>
                <span class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-widest font-medium">INDEX // 0{idx + 1}</span>
              </div>
              
              <h3 class="font-display text-xl font-bold text-[var(--text-primary)] uppercase group-hover:text-[var(--accent-cyan)] transition-colors tracking-wide pt-1 relative z-10">
                {job.title}
              </h3>
              
              <!-- Clean Specs Badges -->
              <div class="flex flex-wrap gap-2 pt-1 relative z-10">
                <span class="px-2.5 py-1 rounded-md bg-[var(--surface-soft)] border border-[var(--border-subtle)] font-mono text-[9px] uppercase tracking-wider text-[color-mix(in_srgb,var(--text-primary)_60%,transparent)]">
                  {job.type}
                </span>
                <span class="px-2.5 py-1 rounded-md bg-[var(--surface-soft)] border border-[var(--border-subtle)] font-mono text-[9px] uppercase tracking-wider text-[color-mix(in_srgb,var(--text-primary)_60%,transparent)]">
                  {job.location}
                </span>
                <span class="px-2.5 py-1 rounded-md bg-[var(--surface-soft)] border border-[var(--border-subtle)] font-mono text-[9px] uppercase tracking-wider text-[color-mix(in_srgb,var(--text-primary)_60%,transparent)]">
                  ID: {job.id}
                </span>
              </div>

              <p class="font-body text-xs text-text-secondary leading-relaxed font-light min-h-[50px] line-clamp-3 relative z-10">
                {job.about}
              </p>
            </div>

            <!-- Action Block -->
            <div class="relative z-10 flex items-center justify-between mt-4 pt-4 border-t border-[var(--border-subtle)]">
              <span class="font-mono text-[8px] text-[var(--accent-cyan)] tracking-widest uppercase animate-pulse">
                // ACTIVE_LISTING
              </span>
              <a
                href={`/careers/${job.slug}`}
                class="btn-liquid-glass-primary py-2 px-5 font-mono text-[9px] uppercase tracking-wider text-[var(--text-primary)] transition-all duration-300"
              >
                <span>View Position Details</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="inline ml-1"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4 — GENERAL APPLICATION (Interactive Form Island) -->
