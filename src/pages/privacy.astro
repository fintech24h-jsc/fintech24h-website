---
// src/pages/privacy.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Privacy Policy', item: 'https://fintech24h.com/privacy/' }
];

const EFFECTIVE_DATE = 'July 4, 2026';
---

<BaseLayout
  title="Privacy Policy — Fintech24h"
  description="How Fintech24h collects, uses, and protects personal data submitted through our website, forms, and marketing tools."
  canonical="https://fintech24h.com/privacy/"
>
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="relative py-24 lg:py-32 overflow-hidden" aria-label="Privacy Policy">
    <!-- Ambient background glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-cyan w-[600px] h-[600px] absolute -top-40 right-10 opacity-15"></div>
      <div class="bg-orb bg-orb-purple w-[500px] h-[500px] absolute bottom-10 -left-32 opacity-10"></div>
      <div class="grid-pattern absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section header -->
      <div class="mb-16" data-animate="fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_5%,transparent)] text-[var(--accent-cyan)] text-xs font-mono font-medium tracking-widest uppercase mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span>
          Legal
        </div>
        <h1 class="font-display text-h1 font-bold text-[var(--text-primary)] mb-4">Privacy Policy</h1>
        <p class="font-body text-[var(--text-secondary)] text-lg leading-relaxed">
          Effective date: {EFFECTIVE_DATE}. This policy explains what personal data Fintech24h collects,
          why we collect it, and the choices you have.
        </p>
      </div>

      <div class="w-16 h-px bg-gradient-to-r from-transparent via-[var(--accent-cyan)]/60 to-transparent mb-16"></div>

      <!-- Content -->
      <div class="space-y-12 font-body text-[var(--text-secondary)] leading-relaxed" data-animate="fade-up">

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">1. Who we are</h2>
          <p>
            Fintech24h ("we", "us", "our") is a Blockchain &amp; AI marketing agency based in Ho Chi Minh City,
            Vietnam, operating the website at <a href="https://fintech24h.com" class="text-[var(--accent-cyan)] hover:underline">fintech24h.com</a>.
            This policy applies to visitors of our website and to prospective clients who submit information
            through our forms.
          </p>
        </div>

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">2. Information we collect</h2>
          <p class="mb-3">We collect information in two ways:</p>
          <ul class="list-disc pl-5 space-y-2">
            <li><strong class="text-[var(--text-primary)]">Information you provide directly</strong> — when you submit a discovery-call or service inquiry form, we collect your name, email address, Telegram handle, LinkedIn profile, project/company name, website, service of interest, budget range, and any message you include.</li>
            <li><strong class="text-[var(--text-primary)]">Information collected automatically</strong> — standard usage data (pages visited, referrer, approximate location, device/browser type) via Google Analytics, and cookies used for analytics and session functionality.</li>
          </ul>
        </div>

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">3. How we use your information</h2>
          <ul class="list-disc pl-5 space-y-2">
            <li>Responding to your inquiry and scheduling discovery calls</li>
            <li>Evaluating fit between your project and our services</li>
            <li>Sending relevant follow-up communication about our services</li>
            <li>Understanding site traffic and improving content and performance</li>
            <li>Meeting legal, accounting, or security obligations</li>
          </ul>
          <p class="mt-3">We do not sell personal data to third parties.</p>
        </div>

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">4. Where your data goes</h2>
          <p class="mb-3">When you submit a form on this site, your data is sent to the following processors so our team can follow up with you:</p>
          <ul class="list-disc pl-5 space-y-2">
            <li><strong class="text-[var(--text-primary)]">Google (Sheets, Apps Script, Telegram notification)</strong> — stores your submission in an internal record and notifies our team by Telegram and email.</li>
            <li><strong class="text-[var(--text-primary)]">HubSpot</strong> — where configured, form submissions are synced to our CRM for follow-up and pipeline tracking.</li>
            <li><strong class="text-[var(--text-primary)]">Calendly</strong> — if you book a call, Calendly processes the scheduling details you provide directly to it, under its own privacy policy.</li>
            <li><strong class="text-[var(--text-primary)]">Google Analytics</strong> — processes anonymized/pseudonymized usage data for site analytics.</li>
            <li><strong class="text-[var(--text-primary)]">Cloudflare</strong> — our hosting and CDN provider, which handles all traffic to this site.</li>
          </ul>
          <p class="mt-3">
            These providers may process data on servers outside Vietnam, including in the United States, under
            their own respective data protection safeguards.
          </p>
        </div>

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">5. Cookies</h2>
          <p>
            We use cookies set by Google Analytics to understand aggregate site usage. You can disable cookies
            in your browser settings at any time; the site remains fully usable without them. We do not use
            cookies for cross-site advertising retargeting.
          </p>
        </div>

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">6. Data retention</h2>
          <p>
            We retain inquiry data for as long as needed to evaluate and follow up on your request, or for the
            duration of an active client relationship, after which it is deleted or anonymized unless we are
            required to keep it longer for legal or accounting reasons.
          </p>
        </div>

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">7. Your rights</h2>
          <p>
            You may request access to, correction of, or deletion of your personal data at any time by emailing
            <a href="mailto:info@fintech24h.com" class="text-[var(--accent-cyan)] hover:underline"> info@fintech24h.com</a>.
            We will respond within a reasonable timeframe and take reasonable steps to verify your request before
            acting on it.
          </p>
        </div>

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">8. Data security</h2>
          <p>
            We use industry-standard safeguards — including encrypted transport (HTTPS), access-restricted
            internal records, and reputable third-party processors — to protect the data we handle. No method of
            transmission or storage is 100% secure, and we cannot guarantee absolute security.
          </p>
        </div>

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">9. Children's privacy</h2>
          <p>
            Our services are intended for businesses and professionals. We do not knowingly collect personal
            data from individuals under 18 years of age.
          </p>
        </div>

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">10. Changes to this policy</h2>
          <p>
            We may update this policy from time to time to reflect changes in our practices or for legal
            reasons. The "Effective date" above reflects the latest revision. Material changes will be
            reflected on this page.
          </p>
        </div>

        <div>
          <h2 class="font-display text-h3 font-semibold text-[var(--text-primary)] mb-3">11. Contact us</h2>
          <p>
            Questions about this policy or your data can be sent to
            <a href="mailto:info@fintech24h.com" class="text-[var(--accent-cyan)] hover:underline"> info@fintech24h.com</a>
            or via Telegram at
            <a href="https://t.me/fintech24h" target="_blank" rel="noopener noreferrer" class="text-[var(--accent-cyan)] hover:underline"> @fintech24h</a>.
          </p>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
