---
// src/layouts/ServiceLayout.astro
import BaseLayout from './BaseLayout.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import CalendlyEmbed from '../components/ui/CalendlyEmbed.tsx';
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Services', item: 'https://fintech24h.com/services' },
  { name: service.title, item: `https://fintech24h.com/services/${service.slug}` }
];
---

<BaseLayout
  title={`${service.title} | Web3 Marketing Solutions`}
  description={service.shortDescription}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <article class="relative py-20 lg:py-28 overflow-hidden">
    <!-- Ambient background glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-cyan w-[600px] h-[600px] absolute -top-40 -right-32 opacity-15"></div>
      <div class="bg-orb bg-orb-purple w-[500px] h-[500px] absolute bottom-1/4 -left-32 opacity-10"></div>
      <div class="grid-pattern absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Eyebrow -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <a href="/services" class="inline-flex items-center gap-2 text-sm text-cyan-400 hover:text-cyan-300 transition-colors mb-6 font-body">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to all services
        </a>
        <h1 class="font-display text-h1 font-bold text-[#f0f4ff] leading-tight mb-6">
          {service.title}
        </h1>
        <p class="text-lg lg:text-xl text-[#94a3b8] font-body leading-relaxed">
          {service.shortDescription}
        </p>
      </div>

      <!-- Service-Specific Key Metrics -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto mb-20" data-animate="stagger">
        {service.metrics.map((m) => (
          <div class="glass-card rounded-2xl p-6 text-center border-cyan-400/10" data-animate-child>
            <div class="text-3xl lg:text-4xl font-display font-bold gradient-text-cyan mb-1">{m.value}</div>
            <div class="text-xs text-[#94a3b8] font-body uppercase tracking-wider">{m.label}</div>
          </div>
        ))}
      </div>

      <!-- Detailed Description & Content -->
      <div class="grid lg:grid-cols-12 gap-12 items-start mb-24">
        <div class="lg:col-span-7">
          <h2 class="font-display text-3xl font-semibold text-[#f0f4ff] mb-6">Overview & Execution</h2>
          <p class="text-lg text-[#94a3b8] font-body leading-relaxed mb-8">
            {service.longDescription}
          </p>

          <h3 class="font-display text-2xl font-semibold text-[#f0f4ff] mb-6">Core Capabilities</h3>
          <ul class="space-y-4 font-body text-[#94a3b8] text-base">
            {service.features.map((feature) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-cyan-400 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:col-span-5">
          <div class="glass-card rounded-2xl p-8 border-purple-500/15 relative overflow-hidden">
            <div class="absolute inset-0 bg-radial-gradient(circle, rgba(139,92,246,0.05) 0%, transparent 80%) pointer-events-none"></div>
            <h3 class="font-display text-xl font-semibold text-[#f0f4ff] mb-6">Expected Business Outcomes</h3>
            <ul class="space-y-4 font-body text-[#94a3b8] text-sm">
              {service.benefits.map((benefit) => (
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-purple-400 mt-2 shrink-0"></span>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Calendly Interactive Embed Booking Area -->
      <div id="book-call" class="glass-card rounded-2xl p-8 lg:p-12 border-cyan-400/20 max-w-5xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <h2 class="font-display text-3xl font-bold text-[#f0f4ff] mb-4">
            Schedule a Growth Audit
          </h2>
          <p class="text-base text-[#94a3b8] font-body">
            Book a 15-minute call directly with our strategy team. We'll audit your current positioning and outline a plug-and-play OKR template.
          </p>
        </div>

        <CalendlyEmbed client:load />
      </div>

    </div>
  </article>
</BaseLayout>
