---
// src/layouts/BlogLayout.astro
import BaseLayout from './BaseLayout.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import { formatDate, getFeaturedImage } from '../lib/wordpress';
import { getReadingTime } from '../lib/utils';
import type { WPPost } from '../lib/wordpress';

interface Props {
  post: WPPost;
}

const { post } = Astro.props;
const featuredImage = getFeaturedImage(post);
const readingTime = getReadingTime(post.content.rendered);

// Article schema representation
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title.rendered,
  "description": post.excerpt.rendered.replace(/<[^>]*>/g, '').trim(),
  "image": featuredImage.url,
  "datePublished": post.date,
  "dateModified": post.modified,
  "author": {
    "@type": "Organization",
    "name": "Fintech24h",
    "url": "https://fintech24h.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Fintech24h",
    "logo": {
      "@type": "ImageObject",
      "url": "https://fintech24h.com/images/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://fintech24h.com/blog/${post.slug}`
  }
};

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Blog', item: 'https://fintech24h.com/blog' },
  { name: post.title.rendered, item: `https://fintech24h.com/blog/${post.slug}` }
];
---

<BaseLayout
  title={post.title.rendered}
  description={post.excerpt.rendered.replace(/<[^>]*>/g, '').slice(0, 160).trim()}
  ogImage={featuredImage.url}
  ogType="article"
  schema={articleSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <article class="relative py-24 lg:py-32 overflow-hidden">
    <!-- Ambient background glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="bg-orb bg-orb-purple w-[500px] h-[500px] absolute top-10 right-0 opacity-10"></div>
      <div class="bg-orb bg-orb-cyan w-[400px] h-[400px] absolute bottom-1/3 -left-32 opacity-10"></div>
      <div class="grid-pattern absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back button -->
      <a href="/blog" class="inline-flex items-center gap-2 text-sm text-cyan-400 hover:text-cyan-300 transition-colors mb-8 font-body">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to blog
      </a>

      <!-- Header Info -->
      <header class="mb-12">
        <div class="flex flex-wrap items-center gap-4 text-sm text-[#94a3b8] font-body mb-6">
          <span>{formatDate(post.date)}</span>
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400/50"></span>
          <span>{readingTime} min read</span>
        </div>

        <h1 class="font-display text-4xl sm:text-5xl font-bold text-[#f0f4ff] leading-tight mb-8">
          {post.title.rendered}
        </h1>

        <!-- Author box -->
        <div class="flex items-center gap-4 py-6 border-y border-white/10">
          <div class="w-12 h-12 rounded-full bg-cyan-500/10 border border-cyan-400/30 flex items-center justify-center font-display text-cyan-400 font-bold text-lg">
            FT
          </div>
          <div>
            <div class="text-sm font-semibold text-[#f0f4ff] font-body">Fintech24h Research Team</div>
            <div class="text-xs text-[#94a3b8] font-body">Blockchain & AI Marketing Specialists</div>
          </div>
        </div>
      </header>

      <!-- Featured Image -->
      {featuredImage.url && (
        <div class="relative rounded-2xl overflow-hidden border border-white/10 mb-12 aspect-[16/9] shadow-2xl">
          <img
            src={featuredImage.url}
            alt={featuredImage.alt}
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      )}

      <!-- Content -->
      <div class="prose prose-invert max-w-none prose-headings:font-display prose-headings:font-semibold prose-headings:text-[#f0f4ff] prose-p:font-body prose-p:text-[#94a3b8] prose-p:leading-relaxed prose-a:text-cyan-400 hover:prose-a:text-cyan-300 prose-strong:text-[#f0f4ff] prose-code:text-cyan-400 prose-ul:list-disc prose-ul:pl-6 prose-ol:list-decimal prose-ol:pl-6 prose-blockquote:border-l-4 prose-blockquote:border-cyan-400 prose-blockquote:pl-4 prose-blockquote:italic text-lg">
        <slot />
      </div>

      <!-- Footer proposal CTA -->
      <div class="glass-card rounded-2xl p-8 lg:p-12 text-center mt-16 border border-cyan-400/25 relative overflow-hidden">
        <div class="absolute inset-0 pointer-events-none bg-radial-gradient(circle, rgba(0,212,255,0.05) 0%, transparent 70%)"></div>
        <h3 class="text-2xl font-display font-semibold text-[#f0f4ff] mb-4">
          Scaling a Web3 or AI Startup?
        </h3>
        <p class="text-base text-[#94a3b8] font-body mb-8 max-w-xl mx-auto">
          Get a free, custom-tailored marketing proposal and OKR checklist from Fintech24h. We deliver actual, on-chain growth.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#get-proposal" class="btn-primary font-display font-semibold">
            Get Free Proposal
          </a>
          <a href="/contact" class="btn-ghost font-display font-semibold">
            Book Discovery Call
          </a>
        </div>
      </div>

    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Base paragraph spacings inside WP content */
  .prose p {
    margin-bottom: 1.5rem;
  }
  .prose h2 {
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    color: #f0f4ff;
  }
  .prose h3 {
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #f0f4ff;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
</style>
