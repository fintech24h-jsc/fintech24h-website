---
// src/layouts/BlogLayout.astro
import BaseLayout from './BaseLayout.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import { formatDate, getFeaturedImage } from '../lib/wordpress';
import { getReadingTime } from '../lib/utils';
import type { WPPost } from '../lib/wordpress';

interface Props {
  post: WPPost;
}

const { post } = Astro.props;
const featuredImage = getFeaturedImage(post);
const readingTime = getReadingTime(post.content.rendered);

// Article schema representation
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title.rendered,
  "description": post.excerpt.rendered.replace(/<[^>]*>/g, '').trim(),
  "image": featuredImage.url,
  "datePublished": post.date,
  "dateModified": post.modified,
  "author": {
    "@type": "Organization",
    "name": "Fintech24h",
    "url": "https://fintech24h.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Fintech24h",
    "logo": {
      "@type": "ImageObject",
      "url": "https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://fintech24h.com/blog/${post.slug}`
  }
};

const breadcrumbs = [
  { name: 'Home', item: 'https://fintech24h.com' },
  { name: 'Blog', item: 'https://fintech24h.com/blog' },
  { name: post.title.rendered, item: `https://fintech24h.com/blog/${post.slug}` }
];
---

<BaseLayout
  title={post.title.rendered}
  description={post.excerpt.rendered.replace(/<[^>]*>/g, '').slice(0, 160).trim()}
  ogImage={featuredImage.url}
  ogType="article"
  schema={articleSchema}
>
  <BreadcrumbSchema items={breadcrumbs} />

  <article class="relative min-h-screen bg-[#05080C] overflow-hidden">
    
    <!-- IMMERSIVE HERO HEADER -->
    <header class="relative pt-32 pb-24 lg:pt-40 lg:pb-32 px-4 sm:px-6 lg:px-8 border-b border-white/5">
      <!-- Background Ambient Image (Blurred Featured Image) -->
      {featuredImage.url && (
        <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
          <img src={featuredImage.url} alt="" class="absolute inset-0 w-full h-full object-cover opacity-20 blur-[100px] scale-110 mix-blend-screen" />
          <div class="absolute inset-0 bg-gradient-to-b from-[#05080C]/50 via-[#05080C]/80 to-[#05080C]"></div>
        </div>
      )}

      <!-- Matrix grid pattern overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#00c8f01a_1px,transparent_1px),linear-gradient(to_bottom,#00c8f01a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_50%,#000_80%,transparent_100%)] opacity-10 pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto">
        <!-- Back button & Breadcrumbs -->
        <a href="/blog" class="inline-flex items-center gap-2 text-sm text-[var(--accent-cyan)] hover:text-white transition-colors mb-10 font-mono tracking-widest uppercase bg-[var(--accent-cyan)]/10 px-4 py-2 rounded-full border border-[var(--accent-cyan)]/30 backdrop-blur-md">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
          Return to Hub
        </a>

        <!-- Metadata Row -->
        <div class="flex flex-wrap items-center gap-4 text-xs font-mono tracking-widest text-[var(--text-muted)] mb-6 uppercase">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--accent-purple)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            {formatDate(post.date)}
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-white/20"></span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--accent-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {readingTime} MIN READ
          </span>
        </div>

        <!-- Title -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-[1.15] mb-10 tracking-tight">
          {post.title.rendered}
        </h1>

        <!-- Author Box Glassmorphism -->
        <div class="inline-flex items-center gap-4 p-4 pr-8 rounded-full bg-white/[0.03] border border-white/10 backdrop-blur-md">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[var(--accent-cyan)] to-[var(--accent-purple)] p-[2px]">
            <div class="w-full h-full rounded-full bg-[#05080C] flex items-center justify-center">
              <span class="font-display font-bold text-[var(--accent-cyan)]">F24</span>
            </div>
          </div>
          <div>
            <div class="text-sm font-bold text-white font-display">Fintech24h Intelligence</div>
            <div class="text-xs text-[var(--accent-cyan)] font-mono tracking-wide uppercase">Core Research Team</div>
          </div>
        </div>
      </div>
    </header>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      
      <!-- Featured Image (Premium Display) -->
      {featuredImage.url && (
        <div class="relative -mt-32 mb-16 rounded-3xl overflow-hidden border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] group">
          <div class="absolute inset-0 bg-gradient-to-t from-[#05080C] via-transparent to-transparent opacity-60 z-10"></div>
          <img
            src={featuredImage.url}
            alt={featuredImage.alt}
            width="1200"
            height="675"
            class="w-full h-auto aspect-[16/9] object-cover transform group-hover:scale-105 transition-transform duration-700"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}

      <!-- Main Content (Highly Polished Prose) -->
      <div class="prose prose-invert prose-lg md:prose-xl max-w-none 
                  prose-headings:font-display prose-headings:font-bold prose-headings:text-white prose-headings:tracking-tight 
                  prose-p:font-body prose-p:text-[#a1a1aa] prose-p:leading-relaxed 
                  prose-a:text-[var(--accent-cyan)] prose-a:no-underline hover:prose-a:underline hover:prose-a:text-white prose-a:transition-colors
                  prose-strong:text-white prose-strong:font-bold 
                  prose-ul:list-none prose-ol:list-decimal prose-ol:text-[#a1a1aa]
                  prose-img:rounded-2xl prose-img:border prose-img:border-white/10 prose-img:shadow-2xl">
        <slot />
      </div>

      <!-- Liquid Glass Footer CTA -->
      <div class="mt-24 relative overflow-hidden rounded-3xl border border-[var(--accent-purple)]/30 bg-[var(--accent-purple)]/5 p-10 md:p-16 text-center backdrop-blur-xl group">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[var(--accent-purple)]/10 to-[var(--accent-cyan)]/10 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
        <div class="relative z-10">
          <h3 class="font-display text-3xl font-bold text-white mb-6">Ready to Execute?</h3>
          <p class="font-body text-[#a1a1aa] mb-10 max-w-2xl mx-auto text-lg">
            Stop reading, start scaling. Get a free, custom-tailored marketing proposal and GTM strategy from Fintech24h. We deliver actual, on-chain growth.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/#get-proposal" class="relative overflow-hidden font-mono text-sm uppercase tracking-widest font-bold text-white border border-[var(--accent-cyan)]/40 bg-[var(--accent-cyan)]/10 px-8 py-4 rounded-xl hover:bg-[var(--accent-cyan)]/20 hover:border-[var(--accent-cyan)] hover:shadow-[0_0_40px_rgba(0,200,240,0.3)] transition-all duration-500 group/btn">
              <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover/btn:animate-[shimmer_1.5s_infinite]"></span>
              <span class="relative z-10 drop-shadow-[0_0_8px_rgba(0,200,240,0.8)]">Request Proposal</span>
            </a>
            <a href="/contact" class="font-mono text-sm uppercase tracking-widest font-bold text-white border border-white/20 bg-white/5 px-8 py-4 rounded-xl hover:bg-white/10 transition-colors">
              Book Call
            </a>
          </div>
        </div>
      </div>

    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Base paragraph spacings */
  .prose p { margin-bottom: 2rem; }
  
  /* Beautiful Headings */
  .prose h2 {
    font-size: 2.25rem;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    position: relative;
    padding-bottom: 1rem;
  }
  .prose h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 4px;
    background: var(--accent-cyan);
    border-radius: 2px;
  }
  
  .prose h3 {
    font-size: 1.5rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: #e4e4e7;
  }

  /* Custom Lists with Glowing Bullets */
  .prose ul li {
    position: relative;
    padding-left: 1.75rem;
    margin-bottom: 0.75rem;
    color: #a1a1aa;
  }
  .prose ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 8px var(--accent-cyan);
  }

  /* Glassmorphism Blockquotes */
  .prose blockquote {
    border-left: 4px solid var(--accent-purple);
    background: rgba(255, 255, 255, 0.02);
    padding: 1.5rem 2rem;
    margin: 2.5rem 0;
    border-radius: 0 1rem 1rem 0;
    font-style: italic;
    color: #f4f4f5;
    position: relative;
    overflow: hidden;
  }
  .prose blockquote::before {
    content: '"';
    position: absolute;
    top: -1rem;
    left: 0.5rem;
    font-size: 6rem;
    font-family: serif;
    color: rgba(167, 139, 250, 0.1); /* var(--accent-purple) */
    pointer-events: none;
  }
  
  /* Shimmer Animation for CTA */
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }

  /* HIDE WORDPRESS TABLE OF CONTENTS (UGLY TOC) */
  .prose #ez-toc-container,
  .prose .ez-toc-container,
  .prose .toc_container,
  .prose .wp-block-table-of-contents,
  .prose #toc_container,
  .prose .lwptoc,
  .prose .lwptoc_i {
    display: none !important;
  }
</style>
