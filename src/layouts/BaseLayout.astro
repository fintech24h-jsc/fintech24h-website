---
// src/layouts/BaseLayout.astro
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import OpenGraph from '../components/seo/OpenGraph.astro';
import NavbarReact from '../components/layout/NavbarReact.tsx';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: object;
  noIndex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = 'https://fintech24h.com/images/og-default.jpg',
  ogType = 'website',
  schema,
  noIndex = false,
} = Astro.props;

const siteTitle = title.includes('Fintech24h') ? title : `${title} | Fintech24h`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary Meta -->
  <title>{siteTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  {!noIndex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

  <!-- Open Graph -->
  <OpenGraph title={siteTitle} description={description} url={canonical} image={ogImage} type={ogType} />

  <!-- Theme color for mobile browsers -->
  <meta name="theme-color" content="#050810" />

  <!-- Geo tags for local SEO -->
  <meta name="geo.region" content="VN-SG" />
  <meta name="geo.placename" content="Ho Chi Minh City, Vietnam" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Fonts (preload for performance) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <!-- Schema.org JSON-LD -->
  {schema && <SchemaOrg schema={schema} />}

  <!-- Organization Schema (always present) -->
  <SchemaOrg schema={{
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Fintech24h",
    "url": "https://fintech24h.com",
    "logo": "https://fintech24h.com/images/Logo-Fintech24h.png",
    "description": "The Growth Partner Marketing Authority in Blockchain — KOL Marketing, PR, Community Building, Growth Hacking for Web3 Projects",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1014 Pham Van Dong Street, Hiep Binh",
      "addressLocality": "Ho Chi Minh City",
      "addressCountry": "VN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@fintech24h.com",
      "contactType": "sales",
      "areaServed": ["VN", "SG", "AE", "ID", "TH", "IN"]
    },
    "sameAs": [
      "https://www.linkedin.com/company/fintech24h/",
      "https://www.facebook.com/fintech24hnews",
      "https://x.com/fintech24h_com",
      "https://t.me/fintech24h",
      "https://medium.com/@fintech24h",
      "https://www.instagram.com/fintech24h/"
    ]
  }} />

  <!-- Performance hints -->
  <link rel="dns-prefetch" href="https://js.hsforms.net" />
  <link rel="dns-prefetch" href="https://assets.calendly.com" />
  <link rel="dns-prefetch" href="https://images.unsplash.com" />
  <link rel="dns-prefetch" href="https://i.pravatar.cc" />
</head>

<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased selection:bg-white selection:text-black">
  <!-- Skip to main content (accessibility) -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--accent-cyan)] focus:text-black focus:rounded">
    Skip to main content
  </a>

  <NavbarReact client:load />

  <main id="main-content" class="relative w-full flex flex-col overflow-hidden shrink-0">
    <slot />
  </main>

  <Footer />

  <!-- GSAP Init (global animations) -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Global scroll setup — chỉ chạy 1 lần
    document.addEventListener('DOMContentLoaded', () => {
      // Kiểm tra reduced motion
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) return; // Dừng tất cả GSAP animation

      // Batch animate tất cả [data-animate="fade-up"] elements
      ScrollTrigger.batch('[data-animate="fade-up"]', {
        onEnter: (elements) => {
          gsap.fromTo(elements,
            { opacity: 0, y: 28 },
            { opacity: 1, y: 0, duration: 0.75, stagger: 0.1, ease: 'power3.out' }
          );
        },
        start: 'top 84%',
        once: true,
      });

      ScrollTrigger.batch('[data-animate="scale-in"]', {
        onEnter: (elements) => {
          gsap.fromTo(elements,
            { opacity: 0, scale: 0.94, y: 16 },
            { opacity: 1, scale: 1, y: 0, duration: 0.65, stagger: 0.09, ease: 'power2.out' }
          );
        },
        start: 'top 82%',
        once: true,
      });
    });
  </script>
</body>
</html>
