---
// src/layouts/BaseLayout.astro
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import AsyncStylesheet from '../components/ui/AsyncStylesheet.astro';
import PartytownNonce from '../components/seo/PartytownNonce.astro';
import OpenGraph from '../components/seo/OpenGraph.astro';
import NavbarFast from '../components/layout/NavbarFast.astro';
import Footer from '../components/layout/Footer.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: object;
  noIndex?: boolean;
}

const {
  title,
  description,
  // Canonical must never include the query string — otherwise pages hit with
  // junk params (e.g. /blog/?paged=50, ?amp=1, or leftover hack spam params)
  // self-canonicalize to a duplicate URL and get stuck in Google's
  // "Crawled - currently not indexed" bucket. The public canonical host is
  // fixed so a request reaching www (or a preview host) never emits a
  // self-referential duplicate canonical.
  canonical = `https://fintech24h.com${Astro.url.pathname}`,
  ogImage = 'https://fintech24h.com/wp-content/uploads/2026/07/OG-FI24H.png',
  ogType = 'website',
  schema,
  noIndex = false,
} = Astro.props;

const siteTitle = title.includes('Fintech24h') ? title : `${title} | Fintech24h`;
const canonicalUrl = new URL(canonical, Astro.url.origin);
canonicalUrl.search = '';
canonicalUrl.hash = '';
const canonicalHref = canonicalUrl.href;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="color-scheme" content="dark light" />
  <meta id="theme-color-meta" name="theme-color" content="#050810" />
  <!-- Apply a saved theme before first paint. Dark remains the safe default. -->
  <script is:inline>
    (() => {
      const root = document.documentElement;
      let theme = 'dark';
      try {
        if (localStorage.getItem('fintech24h-theme') === 'light') theme = 'light';
      } catch {}
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
      const themeColor = document.getElementById('theme-color-meta');
      if (themeColor) themeColor.setAttribute('content', theme === 'light' ? '#f4f7fb' : '#050810');
    })();
  </script>

  <!-- Primary Meta -->
  <title>{siteTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalHref} />
  {noIndex && <meta name="robots" content="noindex, follow" />}
  {!noIndex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

  <!-- Open Graph -->
  <OpenGraph title={siteTitle} description={description} url={canonicalHref} image={ogImage} type={ogType} />

  <!-- Geo tags for local SEO -->
  <meta name="geo.region" content="VN-SG" />
  <meta name="geo.placename" content="Ho Chi Minh City, Vietnam" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Fonts — non-blocking async load to avoid render-blocking LCP -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <AsyncStylesheet href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" />

  <!-- Schema.org JSON-LD -->
  {schema && <SchemaOrg schema={schema} />}

  <!-- Organization Schema (always present) -->
  <SchemaOrg schema={{
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://fintech24h.com/#organization",
    "name": "Fintech24h",
    "url": "https://fintech24h.com",
    "logo": "https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp",
    "description": "The Growth Partner Marketing Authority in Blockchain — KOL Marketing, PR, Community Building, Growth Hacking for Web3 Projects",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1014 Pham Van Dong Street, Hiep Binh",
      "addressLocality": "Ho Chi Minh City",
      "addressCountry": "VN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@fintech24h.com",
      "contactType": "sales",
      "areaServed": ["VN", "SG", "AE", "ID", "TH", "IN"]
    },
    "sameAs": [
      "https://www.linkedin.com/company/fintech24h/",
      "https://www.facebook.com/fintech24hnews",
      "https://x.com/fintech24h_com",
      "https://t.me/fintech24h",
      "https://medium.com/@fintech24h",
      "https://www.instagram.com/fintech24h/"
    ]
  }} />

  <!-- RSS autodiscovery — browsers and feed readers detect this automatically -->
  <link rel="alternate" type="application/rss+xml" title="Fintech24h Blog — Blockchain &amp; Web3 Marketing Insights" href="https://fintech24h.com/rss.xml" />

  <!-- Performance hints -->
  <link rel="dns-prefetch" href="https://js.hsforms.net" />
  <link rel="dns-prefetch" href="https://assets.calendly.com" />
  <link rel="dns-prefetch" href="https://images.unsplash.com" />
  <link rel="dns-prefetch" href="https://i.pravatar.cc" />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.google-analytics.com" />

  <!-- Consent Mode v2 default — must run on the real main thread, before
       gtag.js loads, so GA4 starts in denied/cookieless mode until the
       cookie banner grants it. See /consent.js. -->
  <script is:inline src="/consent.js"></script>

  <!-- Google Analytics 4 via Partytown — runs in Web Worker, zero main-thread cost -->
  <PartytownNonce />
  <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-4TDZQMBWLR"></script>
  <script type="text/partytown">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4TDZQMBWLR');
  </script>
</head>

<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased">
  <!-- Skip to main content (accessibility) -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--accent-cyan)] focus:text-[var(--text-inverted)] focus:rounded">
    Skip to main content
  </a>

  <NavbarFast />

  <main id="main-content" class="relative w-full flex flex-col overflow-x-hidden shrink-0">
    <!-- overflow-x only (not overflow-hidden on both axes): clips decorative
         elements that bleed past the viewport edges horizontally, same as
         before. Clipping the Y axis too breaks `position: sticky` for any
         descendant (like the blog sidebar) because sticky needs an ancestor
         chain with no non-visible overflow up to the real scrolling
         viewport. -->
    <slot />
  </main>

  <Footer />

  <CookieBanner />

  <!-- Scroll reveals — native IntersectionObserver + CSS transitions, 0 KB JS overhead -->
  <!-- Visual result is identical to GSAP ScrollTrigger (same easing, same stagger) -->
  <script>
  // @ts-nocheck — plain JS moved out of is:inline/define:vars so the CSP needs no
  // 'unsafe-inline'; it was never type-checked as an inline script.
    document.addEventListener('DOMContentLoaded', () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // rootMargin '-6%' — triggers earlier so animation completes as element enters view
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter(e => e.isIntersecting);
        visible.forEach((entry, i) => {
          const el = entry.target;
          el.style.transitionDelay = `${Math.min(i * 0.08, 0.4)}s`;  // 80ms stagger, capped so nothing waits > 0.4s
          el.classList.add('is-visible');
          observer.unobserve(el);
        });
      }, { threshold: 0, rootMargin: '0px 0px -6% 0px' });

      document
        .querySelectorAll('[data-animate="fade-up"], [data-animate="scale-in"]')
        .forEach(el => observer.observe(el));
    });

    // Cursor-following light on glass cards (desktop pointers only). One
    // listener for the whole page; each card gets --mx/--my for its border glow.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const SPOT = '.liquid-glass-premium, .btn-liquid-glass-card, [data-spotlight]';
      document.addEventListener('pointermove', (e) => {
        const card = e.target instanceof Element ? e.target.closest(SPOT) : null;
        if (!card) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      }, { passive: true });
    }

    // Process timeline: a solid line draws down as the section scrolls past the
    // middle of the screen, and each step's node lights up once reached.
    (() => {
      const tl = document.querySelector('[data-timeline]');
      if (!tl) return;
      const steps = [...tl.querySelectorAll('[data-timeline-step]')];
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = tl.getBoundingClientRect();
        const mid = window.innerHeight * 0.55;
        const p = reduce ? 1 : Math.min(1, Math.max(0, (mid - r.top) / r.height));
        tl.style.setProperty('--tl-progress', p.toFixed(4));
        for (const s of steps) {
          const node = s.querySelector('[data-timeline-node]');
          const y = node ? node.getBoundingClientRect().top : s.getBoundingClientRect().top;
          s.classList.toggle('is-reached', reduce || y < mid);
        }
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    })();
  </script>
</body>
</html>
