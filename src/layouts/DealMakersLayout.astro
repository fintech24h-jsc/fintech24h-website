---
// src/layouts/DealMakersLayout.astro
// Standalone document for the DealMakers' Club microsite (/dealmakers/*).
// Deliberately does NOT use BaseLayout / Navbar / Footer — this campaign
// has its own header, footer, and color system, and only shares hosting +
// analytics + legal pages with fintech24h.com.
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import OpenGraph from '../components/seo/OpenGraph.astro';
import '../styles/dealmakers.css';
import { seasons } from '../data/dealmakers/seasons';
import { getSS3Content, type DealmakersLocale } from '../data/dealmakers/content';
import { getChrome } from '../data/dealmakers/chrome';

// Same box-shadow star-dot technique as the main site's Hero
// (src/components/sections/HeroSection.astro) — generated per-render,
// warm ivory instead of pure white to match the gold/emerald palette.
// Coordinates use vw/vh (viewport-relative) instead of fixed px so the
// field covers the full width on any screen size — a fixed 0-2000px box
// left large/ultrawide monitors with a bare right half (same bug fixed on
// the main site's HeroSection.astro on 2026-07-05; this layout has its own
// separate copy of the technique per the DealMakers design isolation, so it
// never got that fix).
const generateStars = (count: number) => {
  const shadows: string[] = [];
  for (let i = 0; i < count; i++) {
    const x = (Math.random() * 100).toFixed(2);
    const y = (Math.random() * 100).toFixed(2);
    const alpha = (Math.random() * 0.6 + 0.2).toFixed(2);
    shadows.push(`${x}vw ${y}vh rgba(245, 239, 226, ${alpha})`);
  }
  return shadows.join(', ');
};
const dmStarsSmall = generateStars(250);
const dmStarsMedium = generateStars(80);
const dmStarsLarge = generateStars(25);

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  keywords?: string;
  schema?: object;
  locale?: DealmakersLocale;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://fintech24h.com/wp-content/uploads/2026/07/OG-FI24H.png',
  keywords,
  schema,
  locale = 'en',
} = Astro.props;

// Deliberately always "ltr": the structural layout (header, nav order,
// card grids, arrow icons) stays identical to the English page — only the
// text itself is Arabic. Per-locale text direction for reading is handled
// by the [lang="ar"] CSS rule below, scoped to text elements only, so it
// never reorders flex/grid siblings.
const dir = 'ltr';
const t = getChrome(locale);
const { heroPartners } = getSS3Content(locale);

// The Fintech24h × Capital Partner co-brand lockup lives in the header and
// footer (site-wide identity), never inside the hero — the hero's spotlight
// is reserved for the Capital Partner's own logo alone.
const capitalPartner = heroPartners.find((p) => p.category === 'capital')!;

// The header logo links straight to the active season, not to /dealmakers/
// (which only exists to 301 there) — clicking it from ss3 would otherwise
// round-trip through that redirect instead of just staying put. Arabic
// routes live under /dealmakers/ar/... — same tree, one prefix segment.
const baseSeasonHref = (seasons.find((s) => s.status === 'active') ?? seasons[0]).href;
const localePrefix = (path: string) => (locale === 'ar' ? path.replace(/^\/dealmakers\//, '/dealmakers/ar/') : path);
const activeSeasonHref = localePrefix(baseSeasonHref);

// Language switcher: same page, other locale. Arabic routes always mirror
// the English tree one-for-one under /dealmakers/ar/..., so toggling is a
// straight prefix add/remove on the current path.
const currentPath = Astro.url.pathname;
const enPath = currentPath.replace(/^\/dealmakers\/ar\//, '/dealmakers/');
const arPath = locale === 'ar' ? currentPath : currentPath.replace(/^\/dealmakers\//, '/dealmakers/ar/');

// Same Organization schema BaseLayout injects site-wide. This microsite
// doesn't use BaseLayout, so it needs its own copy to carry brand identity
// (logo, sameAs social profiles) into Google's knowledge panel.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Fintech24h',
  url: 'https://fintech24h.com',
  logo: 'https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp',
  sameAs: [
    'https://www.linkedin.com/company/fintech24h/',
    'https://www.facebook.com/fintech24hnews',
    'https://x.com/fintech24h_com',
    'https://t.me/fintech24h',
    'https://medium.com/@fintech24h',
    'https://www.instagram.com/fintech24h/',
  ],
};

// Absolute (not bare `#id`) so these work identically from the ss3 page
// itself AND from any subpage (e.g. /join/) that doesn't have these
// sections — bare hashes on a subpage just no-op instead of navigating.
const navLinks = [
  { label: t.nav.featured, href: `${activeSeasonHref}#featured` },
  { label: t.nav.directory, href: `${activeSeasonHref}#directory` },
  { label: t.nav.members, href: localePrefix('/dealmakers/members/') },
  { label: t.nav.packages, href: `${activeSeasonHref}#packages` },
  { label: t.nav.benefits, href: localePrefix('/dealmakers/ss3/partner-benefits/') },
  { label: t.nav.faq, href: `${activeSeasonHref}#faq` },
];
const applyHref = `${activeSeasonHref}#apply`;

const socialLinks = [
  { label: 'Telegram', href: 'https://t.me/fintech24h', path: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.1.02-1.62 1.03-4.57 3.02-.43.3-.82.45-1.17.44-.39-.01-1.15-.22-1.71-.41-.69-.23-1.24-.35-1.19-.74.03-.2.3-.41.82-.62 3.2-1.39 5.34-2.31 6.42-2.76 3.05-1.28 3.68-1.5 4.1-.11.02.04.05.09.05.14z' },
  { label: 'X', href: 'https://x.com/fintech24h_com', path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/fintech24h/', path: 'M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z' },
  { label: 'Instagram', href: 'https://www.instagram.com/fintech24h/', path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.332.014 7.052.072 2.695.272.273 2.69.073 7.052.014 8.332 0 8.741 0 12s.014 3.668.072 4.948c.2 4.358 2.618 6.78 6.98 6.98C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948s-.014-3.668-.072-4.948C23.73 2.7 21.31.273 16.951.073 15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z' },
];

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang={locale} dir={dir} data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="author" content="Fintech24h" />

  <!-- hreflang: this page's English/Arabic counterpart always exists at the
       same path with/without the /ar/ segment (see localePrefix above), so
       we can always advertise both — Google needs this on every language
       version, not just one, for it to be respected as a genuine cluster. -->
  <link rel="alternate" hreflang="en" href={`https://fintech24h.com${enPath}`} />
  <link rel="alternate" hreflang="ar" href={`https://fintech24h.com${arPath}`} />
  <link rel="alternate" hreflang="x-default" href={`https://fintech24h.com${enPath}`} />

  <OpenGraph title={title} description={description} url={canonical} image={ogImage} />
  <SchemaOrg schema={organizationSchema} />
  {schema && <SchemaOrg schema={schema} />}

  <meta name="theme-color" content="#0a0908" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Arabic pages keep the exact same structural layout as English (header,
       nav order, card grids, arrow directions) — only the words are Arabic.
       This rule makes just the text content itself read naturally
       right-to-left, without touching `dir` on any flex/grid container
       (which would reorder siblings and mirror icons/arrows). -->
  <style>
    :root[lang="ar"] :is(p, h1, h2, h3, h4, li, label, blockquote, dt, dd, th, td, input, textarea, select, option) {
      direction: rtl;
    }
  </style>

  <!-- Fonts: Fraunces (display) + Inter (body) + JetBrains Mono (labels) — a
       distinct pairing from the main site's Space Grotesk/Inter, 2 weights
       each per the project's performance rule -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" />
  </noscript>

  <!-- Consent Mode v2 default — must run on the real main thread, before
       gtag.js loads, so GA4 starts in denied/cookieless mode until the
       cookie banner grants it. Same /consent.js and same first-party
       cookie as the main site — a choice made there carries over here. -->
  <script is:inline src="/consent.js"></script>

  <!-- Google Analytics 4 via Partytown — same property as the main site -->
  <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-4TDZQMBWLR"></script>
  <script type="text/partytown">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4TDZQMBWLR');
  </script>
</head>

<body class="dm-root antialiased">
  <div class="dm-grain" aria-hidden="true"></div>
  <div class="dm-starfield" aria-hidden="true">
    <div id="dm-stars-small" class="dm-stars-layer" style={`--dm-star-shadow-small: ${dmStarsSmall};`}></div>
    <div id="dm-stars-medium" class="dm-stars-layer" style={`--dm-star-shadow-medium: ${dmStarsMedium};`}></div>
    <div id="dm-stars-large" class="dm-stars-layer" style={`--dm-star-shadow-large: ${dmStarsLarge};`}></div>
  </div>
  <div class="dm-cursor-glow" id="dm-cursor-glow" aria-hidden="true"></div>
  <header class="dm-glass-panel sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      <a href={activeSeasonHref} class="flex items-center gap-3 shrink-0" aria-label={t.footer.presentedByAria}>
        <img src="https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp" alt="Fintech24h" width="300" height="210" class="h-8 sm:h-9 w-auto object-contain" loading="eager" />
        <span class="font-display font-light text-xl text-[var(--dm-border-accent)]" aria-hidden="true">|</span>
        {capitalPartner.confirmed && capitalPartner.logoUrl ? (
          <img src={capitalPartner.logoUrl} alt={`${capitalPartner.name}, Official Capital Partner`} class="h-8 sm:h-9 w-auto object-contain" loading="eager" />
        ) : (
          <span class="font-mono text-[9px] sm:text-[10px] text-[var(--dm-text-muted)] uppercase tracking-[0.1em] leading-tight whitespace-nowrap">{t.capitalPartnerFallback}</span>
        )}
      </a>

      <nav class="hidden lg:flex items-center gap-6 font-mono text-[11px] uppercase tracking-widest text-[var(--dm-text-secondary)]" aria-label={t.nav.sectionNavAria}>
        {navLinks.map((l) => (
          <a href={l.href} class="hover:text-[var(--dm-gold)] transition-colors whitespace-nowrap">{l.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2 shrink-0">
        <a
          href={locale === 'ar' ? enPath : arPath}
          class="hidden sm:inline-flex items-center justify-center w-9 h-9 rounded-lg border border-[var(--dm-border)] font-mono text-[10px] uppercase tracking-wider text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] hover:border-[var(--dm-border-hover)] transition-colors shrink-0"
          aria-label={locale === 'ar' ? 'Switch to English' : 'التبديل إلى العربية'}
        >
          {locale === 'ar' ? 'EN' : 'ع'}
        </a>
        <span class="hidden sm:inline-flex">
          <a href={applyHref} class="dm-btn-primary py-2 px-4 text-[10px]" data-dm-track="header_cta">{t.nav.applyToJoin}</a>
        </span>
        <button
          id="dm-nav-toggle"
          type="button"
          class="dm-btn-icon lg:hidden"
          aria-label={t.nav.toggleAria}
          aria-expanded="false"
          aria-controls="dm-mobile-nav"
        >
          <svg id="dm-nav-icon-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg id="dm-nav-icon-close" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <nav id="dm-mobile-nav" class="dm-mobile-nav lg:hidden" aria-label="Mobile section navigation" hidden>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col">
        {navLinks.map((l) => (
          <a href={l.href} class="dm-mobile-nav-link" data-dm-close-menu>{l.label}</a>
        ))}
        <a href={locale === 'ar' ? enPath : arPath} class="dm-mobile-nav-link" data-dm-close-menu>
          {locale === 'ar' ? 'English' : 'العربية'}
        </a>
        <span class="sm:hidden flex my-3">
          <a href={applyHref} class="dm-btn-primary w-full justify-center py-3 text-xs" data-dm-track="header_cta" data-dm-close-menu>{t.nav.applyToJoin}</a>
        </span>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="border-t border-[var(--dm-border)] bg-[var(--dm-bg-secondary)] pt-16 pb-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-3 mb-5" aria-label={t.footer.presentedByAria}>
            <img src="https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp" alt="Fintech24h" width="300" height="210" class="h-9 w-auto object-contain" loading="lazy" />
            <span class="font-display font-light text-xl text-[var(--dm-border-accent)]" aria-hidden="true">|</span>
            {capitalPartner.confirmed && capitalPartner.logoUrl ? (
              <img src={capitalPartner.logoUrl} alt={`${capitalPartner.name}, Official Capital Partner`} class="h-9 w-auto object-contain" loading="lazy" />
            ) : (
              <span class="font-mono text-[10px] text-[var(--dm-text-muted)] uppercase tracking-[0.1em]">{t.capitalPartnerFallback}</span>
            )}
          </div>
          <p class="text-sm text-[var(--dm-text-secondary)] leading-relaxed max-w-sm mb-5">
            {t.footer.description}
          </p>
          <div class="flex gap-3">
            {socialLinks.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="dm-btn-icon" aria-label={t.footer.socialAria(s.label)}>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.path}/></svg>
              </a>
            ))}
          </div>
        </div>

        <div>
          <h2 class="font-mono text-[10px] text-[var(--dm-text-muted)] uppercase tracking-[0.15em] mb-5">{t.footer.programHeading}</h2>
          <ul class="space-y-3">
            <li><a href={`${activeSeasonHref}#featured`} class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.footer.featuredDealMakers}</a></li>
            <li><a href={`${activeSeasonHref}#directory`} class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.footer.qualifiedDirectory}</a></li>
            <li><a href={localePrefix('/dealmakers/members/')} class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.footer.membersDirectory}</a></li>
            <li><a href={`${activeSeasonHref}#packages`} class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.footer.packages}</a></li>
            <li><a href={localePrefix('/dealmakers/ss3/partner-benefits/')} class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.footer.partnerBenefits}</a></li>
            <li><a href={localePrefix('/dealmakers/ss3/join/')} class="text-xs text-[var(--dm-gold)] hover:text-[var(--dm-gold-bright)] transition-colors font-semibold">{t.footer.joinClub}</a></li>
            <li><a href={`${activeSeasonHref}#faq`} class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.footer.faq}</a></li>
          </ul>
        </div>

        <div>
          <h2 class="font-mono text-[10px] text-[var(--dm-text-muted)] uppercase tracking-[0.15em] mb-5">{t.footer.legalHeading}</h2>
          <ul class="space-y-3">
            <li><a href="/privacy/" class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.footer.privacyPolicy}</a></li>
            <li><a href="/terms/" class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.footer.termsOfService}</a></li>
            <li><a href="/verify-members/" class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.footer.verifyMember}</a></li>
            <li><button type="button" id="dm-cookie-preferences-link" class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.footer.cookiePreferences}</button></li>
            <li><a href="mailto:info@fintech24h.com" class="text-xs text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors" dir="ltr">info@fintech24h.com</a></li>
          </ul>
        </div>
      </div>

      <div class="dm-divider mb-6"></div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-5">
        <p class="text-xs text-[var(--dm-text-muted)]">{t.footer.copyright(currentYear)}</p>

        <a
          href="https://fi24h-dealmakersclub.super.site/"
          target="_blank"
          rel="noopener noreferrer"
          class="group dm-btn-ghost py-2 px-4 text-[10px] font-mono uppercase tracking-[0.1em] inline-flex items-center gap-1.5 shrink-0"
        >
          <svg class="w-3 h-3 transition-transform duration-300 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
          {t.footer.backToSeason2}
        </a>

        <a href="https://fintech24h.com" class="flex items-center gap-2 text-xs text-[var(--dm-text-muted)] hover:text-[var(--dm-gold)] transition-colors" aria-label={t.footer.presentedByAria}>
          <img src="https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp" alt="Fintech24h" width="300" height="210" class="h-5 w-auto object-contain opacity-80" loading="lazy" />
          <span class="font-display font-light text-[var(--dm-border-accent)]" aria-hidden="true">|</span>
          {capitalPartner.confirmed && capitalPartner.logoUrl ? (
            <img src={capitalPartner.logoUrl} alt={`${capitalPartner.name}, Official Capital Partner`} class="h-5 w-auto object-contain opacity-80" loading="lazy" />
          ) : (
            <span class="font-mono text-[10px] uppercase tracking-[0.1em]">{t.capitalPartnerFallback}</span>
          )}
        </a>
      </div>
    </div>
  </footer>

  <!-- GDPR-style opt-in cookie banner — same consent state as the main
       site (see /consent.js), themed to the dm-* gold/emerald system so
       it never reads as the main site's cyan/purple banner leaking in. -->
  <div
    id="dm-cookie-banner"
    class="fixed inset-x-0 bottom-0 z-[100] px-4 pb-4 sm:px-6 sm:pb-6 translate-y-full opacity-0 transition-all duration-500 ease-out motion-reduce:transition-none"
    role="dialog"
    aria-live="polite"
    aria-label={t.cookie.consentAria}
    hidden
  >
    <div class="mx-auto max-w-3xl dm-glass-panel rounded-2xl p-5 sm:p-6">
      <div id="dm-cookie-banner-summary">
        <p class="font-body text-sm text-[var(--dm-text-secondary)] leading-relaxed mb-4">
          {t.cookie.text}
          {' '}<a href="/privacy/#cookies" class="text-[var(--dm-gold)] hover:underline">{t.cookie.privacyLink}</a>{' '}
          {t.cookie.textSuffix}
        </p>
        <div class="flex flex-wrap gap-3">
          <button type="button" id="dm-cookie-accept" class="dm-btn-primary py-2.5 px-5 text-xs">{t.cookie.accept}</button>
          <button type="button" id="dm-cookie-reject" class="dm-btn-ghost py-2.5 px-5 text-xs">{t.cookie.reject}</button>
          <button type="button" id="dm-cookie-customize" class="font-mono text-[10px] uppercase tracking-widest px-3 py-2.5 text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors underline underline-offset-2">{t.cookie.customize}</button>
        </div>
      </div>

      <div id="dm-cookie-banner-detail" class="hidden">
        <div class="flex items-center gap-3 py-1 mb-4">
          <span class="font-body text-sm text-[var(--dm-text-primary)] font-medium">{t.cookie.necessary}</span>
          <span class="text-xs text-[var(--dm-text-muted)] font-body">{t.cookie.necessaryNote}</span>
        </div>
        <div class="flex items-center justify-between gap-4 mb-5">
          <div class="flex flex-col">
            <span class="font-body text-sm text-[var(--dm-text-primary)] font-medium">{t.cookie.analytics}</span>
            <span class="text-xs text-[var(--dm-text-muted)] font-body">{t.cookie.analyticsNote}</span>
          </div>
          <button type="button" id="dm-cookie-analytics-toggle" role="switch" aria-checked="false" aria-label={t.cookie.toggleAnalyticsAria} class="relative w-11 h-6 rounded-full bg-white/10 transition-colors duration-200 shrink-0">
            <span class="absolute top-0.5 start-0.5 w-5 h-5 rounded-full bg-white transition-transform duration-200"></span>
          </button>
        </div>
        <div class="flex flex-wrap gap-3">
          <button type="button" id="dm-cookie-save" class="dm-btn-primary py-2.5 px-5 text-xs">{t.cookie.savePreferences}</button>
          <button type="button" id="dm-cookie-back" class="font-mono text-[10px] uppercase tracking-widest px-3 py-2.5 text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] transition-colors">{t.cookie.back}</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const banner = document.getElementById('dm-cookie-banner');
      const summary = document.getElementById('dm-cookie-banner-summary');
      const detail = document.getElementById('dm-cookie-banner-detail');
      const toggle = document.getElementById('dm-cookie-analytics-toggle');
      const toggleDot = toggle ? toggle.firstElementChild : null;
      const prefsLink = document.getElementById('dm-cookie-preferences-link');
      if (!banner || !window.Fi24hConsent) return;

      function paintToggle(on) {
        toggle.setAttribute('aria-checked', String(on));
        toggle.style.background = on ? 'var(--dm-gold)' : 'rgba(255,255,255,0.1)';
        toggleDot.style.transform = on ? 'translateX(20px)' : 'translateX(0)';
      }

      function show() {
        banner.hidden = false;
        requestAnimationFrame(() => banner.classList.remove('translate-y-full', 'opacity-0'));
      }

      function hide() {
        banner.classList.add('translate-y-full', 'opacity-0');
        window.setTimeout(() => { banner.hidden = true; }, 500);
      }

      function showSummary() {
        summary.classList.remove('hidden');
        detail.classList.add('hidden');
      }

      function showDetail() {
        const existing = window.Fi24hConsent.get();
        paintToggle(existing ? existing.analytics : false);
        summary.classList.add('hidden');
        detail.classList.remove('hidden');
      }

      document.getElementById('dm-cookie-accept').addEventListener('click', () => { window.Fi24hConsent.set(true); hide(); });
      document.getElementById('dm-cookie-reject').addEventListener('click', () => { window.Fi24hConsent.set(false); hide(); });
      document.getElementById('dm-cookie-customize').addEventListener('click', showDetail);
      document.getElementById('dm-cookie-back').addEventListener('click', showSummary);
      toggle.addEventListener('click', () => paintToggle(toggle.getAttribute('aria-checked') !== 'true'));
      document.getElementById('dm-cookie-save').addEventListener('click', () => {
        window.Fi24hConsent.set(toggle.getAttribute('aria-checked') === 'true');
        hide();
      });
      if (prefsLink) prefsLink.addEventListener('click', () => window.Fi24hConsent.openPreferences());

      document.addEventListener('fi24h-consent-reopen', () => { showDetail(); show(); });

      if (!window.Fi24hConsent.get()) {
        window.setTimeout(show, 600);
      }
    })();
  </script>

  <script is:inline>
    // Shared scroll-reveal entrance for every [data-dm-reveal] element across
    // the microsite — one observer, staggered by sibling position, so each
    // component doesn't need to reimplement it. Skips entirely under
    // prefers-reduced-motion (CSS also has a hard fallback for that).
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('[data-dm-reveal]').forEach((el) => el.classList.add('dm-in'));
        return;
      }
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('dm-in');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -6% 0px' }
      );
      document.querySelectorAll('[data-dm-reveal]').forEach((el) => {
        const idx = Array.prototype.indexOf.call(el.parentElement ? el.parentElement.children : [], el);
        el.style.setProperty('--dm-reveal-delay', String(Math.min(Math.max(idx, 0), 6) * 70));
        obs.observe(el);
      });
    })();
  </script>

  <script is:inline>
    // Mobile nav toggle for the header hamburger — desktop already shows the
    // section nav inline, this only covers the sub-lg breakpoint where it's
    // hidden (below lg, not md, so tablets get the clean dropdown instead of
    // a cramped inline nav). Vanilla JS, no framework: a single show/hide toggle.
    (function () {
      const toggle = document.getElementById('dm-nav-toggle');
      const menu = document.getElementById('dm-mobile-nav');
      const iconOpen = document.getElementById('dm-nav-icon-open');
      const iconClose = document.getElementById('dm-nav-icon-close');
      if (!toggle || !menu || !iconOpen || !iconClose) return;

      function setOpen(open) {
        menu.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        iconOpen.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
      }

      toggle.addEventListener('click', () => setOpen(menu.hidden));
      menu.querySelectorAll('[data-dm-close-menu]').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
      window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
        if (e.matches) setOpen(false);
      });
    })();
  </script>

  <script is:inline>
    // Cursor spotlight — only on devices with a real pointer, and only
    // without prefers-reduced-motion (this tracks continuous pointer
    // motion, which is exactly what that preference asks sites to avoid).
    (function () {
      const glow = document.getElementById('dm-cursor-glow');
      if (!glow) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!window.matchMedia('(pointer: fine)').matches) return;

      let raf = null;
      window.addEventListener('pointermove', (e) => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          glow.style.setProperty('--dm-spot-x', e.clientX + 'px');
          glow.style.setProperty('--dm-spot-y', e.clientY + 'px');
          glow.classList.add('is-active');
          raf = null;
        });
      });
      document.addEventListener('mouseleave', () => glow.classList.remove('is-active'));
    })();
  </script>
</body>
</html>
