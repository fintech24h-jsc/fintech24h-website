---
// src/components/ui/BlogPostCard.astro
// Article card for blog listings: a compact row (thumbnail left) on phones,
// a vertical image card from md up.
import { formatShortDate, getFeaturedImageSized } from '../../lib/wordpress';
import type { WPPost } from '../../lib/wordpress';
import { getReadingTime } from '../../lib/utils';

interface Props {
  post: WPPost;
  label?: string;
}
const { post, label } = Astro.props;
const href = `/blog/${post.slug}`;
const image = getFeaturedImageSized(post);
const readingTime = getReadingTime(post.content.rendered);
---

<article class="card-default overflow-hidden flex md:flex-col" data-animate-child>
  <a href={href} tabindex="-1" aria-hidden="true" class="block shrink-0 w-28 sm:w-40 md:w-full aspect-square md:aspect-[16/9] overflow-hidden bg-[var(--surface-soft)]">
    <img src={image.url} alt={image.alt} width="800" height="450" class="w-full h-full object-cover" loading="lazy" decoding="async" />
  </a>
  <div class="flex flex-col justify-center md:justify-start gap-2 md:gap-3 p-3.5 sm:p-4 md:p-6 flex-1 min-w-0">
    <div class="flex items-center justify-between gap-3 font-mono text-[11px] text-[var(--text-muted)]">
      {label && <span class="hidden md:inline text-[var(--accent-cyan)] uppercase tracking-[0.1em] truncate">{label}</span>}
      <span class="whitespace-nowrap">{formatShortDate(post.date)} · {readingTime} min</span>
    </div>
    <h3 class="font-display font-bold text-[15px] md:text-lg leading-snug text-[var(--text-primary)] line-clamp-3">
      <a href={href} class="hover:text-[var(--accent-cyan)] transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]">{post.title.rendered}</a>
    </h3>
  </div>
</article>
