---
// src/components/ui/CookieBanner.astro
// GDPR-style opt-in cookie banner for fintech24h.com. Reject and Accept
// carry equal visual weight (regulators have fined sites that buried
// Reject behind a smaller/lower-contrast control than Accept). Consent
// state itself lives in /consent.js — this component is UI only.
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-[100] px-4 pb-4 sm:px-6 sm:pb-6 translate-y-full opacity-0 transition-all duration-500 ease-out motion-reduce:transition-none"
  data-state="hidden"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
  hidden
>
  <div class="mx-auto max-w-3xl rounded-2xl border border-white/[0.08] bg-[var(--bg-glass)] backdrop-blur-md shadow-[0_8px_32px_rgba(0,0,0,0.4)] p-5 sm:p-6">
    <div id="cookie-banner-summary">
      <p class="font-body text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
        We use cookies to understand site traffic (Google Analytics). Nothing runs until you choose —
        see our <a href="/privacy/#cookies" class="text-[var(--accent-cyan)] hover:underline">Privacy Policy</a> for details.
      </p>
      <div class="flex flex-wrap gap-3">
        <button
          type="button"
          id="cookie-accept"
          class="font-display font-semibold text-sm px-5 py-2.5 rounded-lg text-[#050810] bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)] transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]"
        >
          Accept
        </button>
        <button
          type="button"
          id="cookie-reject"
          class="font-display font-semibold text-sm px-5 py-2.5 rounded-lg border border-white/[0.12] text-[var(--text-primary)] transition-colors duration-200 hover:border-white/[0.24] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]"
        >
          Reject non-essential
        </button>
        <button
          type="button"
          id="cookie-customize"
          class="font-display text-sm px-3 py-2.5 text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors underline underline-offset-2"
        >
          Customize
        </button>
      </div>
    </div>

    <div id="cookie-banner-detail" class="hidden">
      <div class="flex items-start justify-between gap-4 mb-4">
        <div class="flex items-center gap-3 py-1">
          <span class="font-body text-sm text-[var(--text-primary)] font-medium">Necessary</span>
          <span class="text-xs text-[var(--text-muted)] font-body">Always on — required for the site to function</span>
        </div>
      </div>
      <div class="flex items-center justify-between gap-4 mb-5">
        <div class="flex flex-col">
          <span class="font-body text-sm text-[var(--text-primary)] font-medium">Analytics</span>
          <span class="text-xs text-[var(--text-muted)] font-body">Google Analytics — aggregate traffic only, no ad tracking</span>
        </div>
        <button
          type="button"
          id="cookie-analytics-toggle"
          role="switch"
          aria-checked="false"
          aria-label="Toggle Analytics cookies"
          class="relative w-11 h-6 rounded-full bg-white/10 transition-colors duration-200 shrink-0"
        >
          <span class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white transition-transform duration-200"></span>
        </button>
      </div>
      <div class="flex flex-wrap gap-3">
        <button
          type="button"
          id="cookie-save"
          class="font-display font-semibold text-sm px-5 py-2.5 rounded-lg text-[#050810] bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)] transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]"
        >
          Save preferences
        </button>
        <button
          type="button"
          id="cookie-back"
          class="font-display text-sm px-3 py-2.5 text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
        >
          Back
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var banner = document.getElementById('cookie-banner');
    var summary = document.getElementById('cookie-banner-summary');
    var detail = document.getElementById('cookie-banner-detail');
    var toggle = document.getElementById('cookie-analytics-toggle');
    var toggleDot = toggle ? toggle.firstElementChild : null;
    if (!banner || !window.Fi24hConsent) return;

    function paintToggle(on) {
      toggle.setAttribute('aria-checked', String(on));
      toggle.style.background = on ? 'var(--accent-cyan)' : 'rgba(255,255,255,0.1)';
      toggleDot.style.transform = on ? 'translateX(20px)' : 'translateX(0)';
    }

    function show() {
      banner.hidden = false;
      requestAnimationFrame(function () {
        banner.classList.remove('translate-y-full', 'opacity-0');
      });
    }

    function hide() {
      banner.classList.add('translate-y-full', 'opacity-0');
      window.setTimeout(function () { banner.hidden = true; }, 500);
    }

    function showSummary() {
      summary.classList.remove('hidden');
      detail.classList.add('hidden');
    }

    function showDetail() {
      var existing = window.Fi24hConsent.get();
      paintToggle(existing ? existing.analytics : false);
      summary.classList.add('hidden');
      detail.classList.remove('hidden');
    }

    document.getElementById('cookie-accept').addEventListener('click', function () {
      window.Fi24hConsent.set(true);
      hide();
    });
    document.getElementById('cookie-reject').addEventListener('click', function () {
      window.Fi24hConsent.set(false);
      hide();
    });
    document.getElementById('cookie-customize').addEventListener('click', showDetail);
    document.getElementById('cookie-back').addEventListener('click', showSummary);
    toggle.addEventListener('click', function () {
      paintToggle(toggle.getAttribute('aria-checked') !== 'true');
    });
    document.getElementById('cookie-save').addEventListener('click', function () {
      window.Fi24hConsent.set(toggle.getAttribute('aria-checked') === 'true');
      hide();
    });

    document.addEventListener('fi24h-consent-reopen', function () {
      showDetail();
      show();
    });

    if (!window.Fi24hConsent.get()) {
      window.setTimeout(show, 600);
    }
  })();
</script>
