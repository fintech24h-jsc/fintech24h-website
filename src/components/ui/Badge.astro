---
// src/components/ui/Badge.astro
interface Props {
  variant?: 'cyan' | 'purple' | 'pink' | 'gray';
  class?: string;
}

const { variant = 'cyan', class: className } = Astro.props;

const styles = {
  cyan: 'border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_5%,transparent)] text-[var(--accent-cyan)]',
  purple: 'border-[color-mix(in_srgb,var(--accent-purple)_30%,transparent)] bg-[color-mix(in_srgb,var(--accent-purple)_5%,transparent)] text-[var(--accent-purple)]',
  pink: 'border-pink-400/30 bg-pink-400/5 text-pink-400',
  gray: 'border-[var(--border-default)] bg-[var(--surface-soft)] text-[var(--text-secondary)]'
};
---

<span class:list={["inline-flex items-center gap-1.5 px-3 py-1 rounded-full border text-xs font-semibold font-body", styles[variant], className]}>
  <slot />
</span>
