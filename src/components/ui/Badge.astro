---
// src/components/ui/Badge.astro
interface Props {
  variant?: 'cyan' | 'purple' | 'pink' | 'gray';
  class?: string;
}

const { variant = 'cyan', class: className } = Astro.props;

const styles = {
  cyan: 'border-cyan-400/30 bg-cyan-400/5 text-cyan-400',
  purple: 'border-purple-400/30 bg-purple-400/5 text-purple-400',
  pink: 'border-pink-400/30 bg-pink-400/5 text-pink-400',
  gray: 'border-white/10 bg-white/5 text-[#94a3b8]'
};
---

<span class:list={["inline-flex items-center gap-1.5 px-3 py-1 rounded-full border text-xs font-semibold font-body", styles[variant], className]}>
  <slot />
</span>
