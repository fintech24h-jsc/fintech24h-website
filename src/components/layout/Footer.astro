---
// src/components/layout/Footer.astro
import { footerLinks } from '../../data/navigation';
import { isBlogAvailable } from '../../lib/wordpress';

const showBlog = await isBlogAvailable();
const resourceLinks = showBlog
  ? footerLinks.resources
  : footerLinks.resources.filter((link) => link.href !== '/blog');
---

<footer class="relative border-t border-[var(--border-subtle)] bg-[var(--bg-primary)] pt-20 pb-10 overflow-hidden" aria-label="Agency Footer">
  <!-- Glowing background lines -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="bg-orb bg-orb-cyan w-[400px] h-[400px] absolute -bottom-40 right-10 opacity-10"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 mb-16">
      
      <!-- Company Branding Col -->
      <div class="col-span-2">
        <a href="/" class="inline-flex items-center gap-2 mb-6" aria-label="Fintech24h Homepage">
          <img src="https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp" alt="Fintech24h" width="300" height="210" loading="lazy" decoding="async" class="brand-logo h-[48px] md:h-[64px] w-auto -my-[6px] md:-my-[10px] object-contain" />
        </a>
        <p class="text-sm text-[var(--text-secondary)] font-body leading-relaxed mb-6 max-w-xs">
          Fintech24h is the growth partner and marketing authority for Blockchain, Fintech & AI projects, offering KOL marketing, PR, community growth, and business development.
        </p>
        <div class="flex gap-4">
          <!-- Telegram link -->
          <a href="https://t.me/fintech24h" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h Telegram">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.1.02-1.62 1.03-4.57 3.02-.43.3-.82.45-1.17.44-.39-.01-1.15-.22-1.71-.41-.69-.23-1.24-.35-1.19-.74.03-.2.3-.41.82-.62 3.2-1.39 5.34-2.31 6.42-2.76 3.05-1.28 3.68-1.5 4.1-.11.02.04.05.09.05.14z"/></svg>
          </a>
          <!-- Twitter link -->
          <a href="https://x.com/fintech24h_com" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h Twitter">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <!-- LinkedIn link -->
          <a href="https://www.linkedin.com/company/fintech24h/" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h LinkedIn">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <!-- Facebook link -->
          <a href="https://www.facebook.com/fintech24hnews" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h Facebook">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"/></svg>
          </a>
          <!-- Medium link -->
          <a href="https://medium.com/@fintech24h" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h Medium">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M7.124 2.873L0 7v10.126L7.124 21.25V2.873zM7.5 3.52v16.96l9-5.405V8.926l-9-5.405zm9.376 5.406L24 13v-6L16.876 2.873v6.053zm0 1.054V21.25L24 17V10L16.876 9.98zM8.5 21l7 4 7-4-7-4-7 4z" /></svg>
          </a>
          <!-- Instagram link -->
          <a href="https://www.instagram.com/fintech24h/" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h Instagram">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.332.014 7.052.072 2.695.272.273 2.69.073 7.052.014 8.332 0 8.741 0 12s.014 3.668.072 4.948c.2 4.358 2.618 6.78 6.98 6.98C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948s-.014-3.668-.072-4.948C23.73 2.7 21.31.273 16.951.073 15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        </div>
      </div>

      <!-- Links Column: Services -->
      <div>
        <h2 class="font-mono text-[10px] text-[var(--text-secondary)] uppercase tracking-[0.15em] mb-6">Services</h2>
        <ul class="space-y-4">
          {footerLinks.services.map((link) => (
            <li>
              <a href={link.href} class="text-xs text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] font-body transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links Column: Resources -->
      <div>
        <h2 class="font-mono text-[10px] text-[var(--text-secondary)] uppercase tracking-[0.15em] mb-6">Resources</h2>
        <ul class="space-y-4">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="text-xs text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] font-body transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links Column: Ecosystem -->
      <div>
        <h2 class="font-mono text-[10px] text-[var(--text-secondary)] uppercase tracking-[0.15em] mb-6">Ecosystem</h2>
        <ul class="space-y-4">
          {footerLinks.ecosystem.map((link) => (
            <li>
              <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="text-xs text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] font-body transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Location / Office Details -->
      <div>
        <h2 class="font-mono text-[10px] text-[var(--text-secondary)] uppercase tracking-[0.15em] mb-6">Headquarters</h2>
        <address class="not-italic text-xs text-[var(--text-secondary)] font-body leading-relaxed space-y-4">
          <p>
            1014 Pham Van Dong Street, Hiep Binh, Ho Chi Minh City, Vietnam.
          </p>
          <p>
            Email: <a href="mailto:info@fintech24h.com" class="hover:text-[var(--accent-cyan)]">info@fintech24h.com</a>
          </p>
        </address>
      </div>

    </div>

    <!-- Neon Divider -->
    <div class="divider-gradient mb-8" />

    <!-- Bottom border & legal references -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[var(--text-muted)] font-body">
        &copy; {new Date().getFullYear()} Fintech24h. All rights reserved.
      </p>
      
      <div class="flex gap-4 sm:gap-6 flex-wrap">
        {footerLinks.company.map((link) => (
          <a href={link.href} class="text-xs text-[var(--text-muted)] hover:text-[var(--accent-cyan)] font-body transition-colors">
            {link.label}
          </a>
        ))}
        {footerLinks.legal.map((link) => (
          <a href={link.href} class="text-xs text-[var(--text-muted)] hover:text-[var(--accent-cyan)] font-body transition-colors">
            {link.label}
          </a>
        ))}
        <button
          type="button"
          id="cookie-preferences-link"
          class="text-xs text-[var(--text-muted)] hover:text-[var(--accent-cyan)] font-body transition-colors"
        >
          Cookie Preferences
        </button>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var btn = document.getElementById('cookie-preferences-link');
    if (btn) btn.addEventListener('click', function () {
      if (window.Fi24hConsent) window.Fi24hConsent.openPreferences();
    });
  })();
</script>
