---
// src/components/layout/Footer.astro
// Layout, top to bottom:
//   1. Brand (logo, positioning line, HQ, socials) + three contact tiles
//      (the footer is where people look for "how do I reach you").
//   2. Five equal link columns: Services, Company, Resources, Ecosystem,
//      Markets. The three market pillar pages used to sit in the bottom bar
//      and made it wrap unevenly; they now have their own column with flags.
//   3. A slim bottom bar: copyright on one side, legal links on the other.
//   4. An oversized, near-transparent wordmark as the closing visual.
// Responsive: 2 link columns on phones, 3 on tablets, 5 on desktop.
import { footerLinks } from '../../data/navigation';
import { isBlogAvailable } from '../../lib/wordpress';

const showBlog = await isBlogAvailable();
const resourceLinks = showBlog
  ? footerLinks.resources
  : footerLinks.resources.filter((link) => link.href !== '/blog');

const isExternal = (href: string) => href.startsWith('http');

const linkColumns = [
  { title: 'Services', links: footerLinks.services },
  { title: 'Company', links: footerLinks.company },
  { title: 'Resources', links: resourceLinks },
  { title: 'Ecosystem', links: footerLinks.ecosystem },
];

const contactTiles = [
  {
    label: 'Email',
    value: 'info@fintech24h.com',
    href: 'mailto:info@fintech24h.com',
    icon: 'M4 6h16v12H4z M4 7l8 6 8-6',
  },
  {
    label: 'Telegram',
    value: '@fintech24h',
    href: 'https://t.me/fintech24h',
    icon: 'M21 4 3 11l6 2 2 6 3-4 5 4z M9 13l8-6',
  },
  {
    label: 'Discovery call',
    value: 'Book a time',
    href: '/contact/#book-call',
    icon: 'M7 3v3 M17 3v3 M4 8h16 M5 5h14v15H5z M9 13h2v2H9z',
  },
];

const linkClass =
  'text-sm text-[var(--text-secondary)] font-body transition-colors duration-200 hover:text-[var(--text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)] rounded-sm';
---

<footer class="relative border-t border-[var(--border-subtle)] bg-[var(--bg-primary)] overflow-hidden" aria-label="Agency Footer">
  <!-- Ambient glow, kept from the previous footer -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="bg-orb bg-orb-cyan w-[400px] h-[400px] absolute -bottom-40 right-10 opacity-10"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 md:pt-20">
    <!-- 1. Brand + contact -->
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12 pb-12 md:pb-14">
      <div class="lg:col-span-5">
        <a href="/" class="inline-flex items-center mb-6 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-cyan)]" aria-label="Fintech24h Homepage">
          <img src="https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp" alt="Fintech24h" width="300" height="210" loading="lazy" decoding="async" class="brand-logo h-[48px] md:h-[60px] w-auto -my-[6px] md:-my-[8px] object-contain" />
        </a>
        <p class="font-body text-base text-[var(--text-secondary)] leading-relaxed max-w-md">
          The growth partner and marketing authority for Blockchain, Fintech &amp; AI projects: KOL marketing, PR, community growth and business development.
        </p>
        <address class="not-italic mt-5 flex items-start gap-2.5 text-sm text-[var(--text-secondary)] font-body leading-relaxed max-w-md">
          <svg class="w-4 h-4 mt-0.5 shrink-0 text-[var(--accent-cyan)]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          <span>1014 Pham Van Dong Street, Hiep Binh, Ho Chi Minh City, Vietnam</span>
        </address>

        <ul class="flex flex-wrap gap-3 mt-7" aria-label="Fintech24h on social media">
          <li>
            <a href="https://t.me/fintech24h" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h Telegram">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.1.02-1.62 1.03-4.57 3.02-.43.3-.82.45-1.17.44-.39-.01-1.15-.22-1.71-.41-.69-.23-1.24-.35-1.19-.74.03-.2.3-.41.82-.62 3.2-1.39 5.34-2.31 6.42-2.76 3.05-1.28 3.68-1.5 4.1-.11.02.04.05.09.05.14z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://x.com/fintech24h_com" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h on X">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/company/fintech24h/" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h LinkedIn">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://www.facebook.com/fintech24hnews" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h Facebook">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://medium.com/@fintech24h" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h Medium">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.124 2.873L0 7v10.126L7.124 21.25V2.873zM7.5 3.52v16.96l9-5.405V8.926l-9-5.405zm9.376 5.406L24 13v-6L16.876 2.873v6.053zm0 1.054V21.25L24 17V10L16.876 9.98zM8.5 21l7 4 7-4-7-4-7 4z" /></svg>
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/fintech24h/" target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Fintech24h Instagram">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.332.014 7.052.072 2.695.272.273 2.69.073 7.052.014 8.332 0 8.741 0 12s.014 3.668.072 4.948c.2 4.358 2.618 6.78 6.98 6.98C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948s-.014-3.668-.072-4.948C23.73 2.7 21.31.273 16.951.073 15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-7 lg:pt-2">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--text-secondary)] mb-4">
          Start a conversation
        </p>
        <ul class="grid gap-3 sm:grid-cols-3">
          {contactTiles.map((tile) => (
            <li>
              <a
                href={tile.href}
                target={isExternal(tile.href) ? '_blank' : undefined}
                rel={isExternal(tile.href) ? 'noopener noreferrer' : undefined}
                class="group flex h-full items-center gap-3 sm:flex-col sm:items-start sm:gap-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-glass)] p-4 sm:p-5 transition-colors duration-200 hover:border-[color-mix(in_srgb,var(--accent-cyan)_45%,transparent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]"
              >
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[var(--border-subtle)] text-[var(--accent-cyan)]">
                  <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d={tile.icon} /></svg>
                </span>
                <span class="min-w-0">
                  <span class="block font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--text-secondary)]">{tile.label}</span>
                  <span class="mt-1 flex items-center gap-1.5 font-display text-[15px] font-semibold text-[var(--text-primary)] break-all sm:break-normal">
                    {tile.value}
                    <svg class="w-3.5 h-3.5 shrink-0 text-[var(--text-secondary)] transition-colors duration-200 group-hover:text-[var(--accent-cyan)]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="divider-gradient" />

    <!-- 2. Link columns -->
    <nav class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-10 py-12 md:py-14" aria-label="Footer">
      {linkColumns.map((col) => (
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--text-secondary)] mb-5">{col.title}</h2>
          <ul class="space-y-3">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={isExternal(link.href) ? '_blank' : undefined}
                  rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
                  class={`${linkClass} inline-flex items-center gap-1`}
                >
                  {link.label}
                  {isExternal(link.href) && (
                    <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="col-span-2 sm:col-span-1">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--text-secondary)] mb-5">Markets</h2>
        <ul class="grid gap-3">
          {footerLinks.markets.map((m) => (
            <li>
              <a href={m.href} class={`${linkClass} group flex items-start gap-2.5`}>
                <img src={`/images/flags/${m.flag}.svg`} alt="" width="20" height="14" decoding="async" class="mt-[3px] h-[14px] w-5 shrink-0 rounded-[2px] object-cover ring-1 ring-[var(--border-subtle)]" />
                <span>
                  <span class="block text-[var(--text-primary)]">{m.country}</span>
                  <span class="block text-xs text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] transition-colors duration-200">Blockchain marketing agency</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- 3. Bottom bar -->
    <div class="flex flex-col gap-4 border-t border-[var(--border-subtle)] py-6 md:flex-row md:items-center md:justify-between">
      <p class="text-xs text-[var(--text-secondary)] font-body">
        &copy; {new Date().getFullYear()} Fintech24h. All rights reserved.
      </p>
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {footerLinks.legal.map((link) => (
          <li>
            <a href={link.href} class={`${linkClass} text-xs`}>{link.label}</a>
          </li>
        ))}
        <li>
          <button
            type="button"
            id="cookie-preferences-link"
            class={`${linkClass} text-xs`}
          >
            Cookie Preferences
          </button>
        </li>
      </ul>
    </div>
  </div>

  <!-- 4. Closing wordmark (decorative) -->
  <div class="relative z-0 -mt-2 select-none pointer-events-none overflow-hidden" aria-hidden="true">
    <p class="footer-wordmark max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 font-display font-bold leading-[0.8] tracking-[-0.05em] text-[clamp(4.5rem,17vw,15rem)] translate-y-[18%]">
      fintech24h
    </p>
  </div>
</footer>

<style>
  /* Near-transparent gradient fill so the wordmark reads as texture, not as
     content, in both the dark and light themes. */
  .footer-wordmark {
    background-image: linear-gradient(
      180deg,
      color-mix(in srgb, var(--text-primary) 10%, transparent) 0%,
      transparent 85%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>

<script>
  // @ts-nocheck — plain JS moved out of is:inline/define:vars so the CSP needs no
  // 'unsafe-inline'; it was never type-checked as an inline script.
  (function () {
    var btn = document.getElementById('cookie-preferences-link');
    if (btn) btn.addEventListener('click', function () {
      if (window.Fi24hConsent) window.Fi24hConsent.openPreferences();
    });
  })();
</script>
