---
// src/components/layout/Navbar.astro
import { mainNavLinks } from '../../data/navigation';
import MobileMenu from './MobileMenu.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 py-4 lg:py-6" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="card-default px-6 py-3.5 flex items-center justify-between relative z-50">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group" aria-label="Fintech24h Homepage">
        <span class="font-display font-bold text-xl sm:text-2xl text-[var(--text-primary)] tracking-tight">
          Fintech<span class="text-[var(--accent-cyan)]">24h</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Main navigation">
        {mainNavLinks.map((link) => (
          <div class="relative group">
            {link.children ? (
              <div>
                <button
                  class="flex items-center gap-1.5 font-display text-sm font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors py-2 focus:outline-none"
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {link.label}
                  <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </button>

                <div class="absolute top-full left-1/2 -translate-x-1/2 mt-3 w-64 bg-[var(--bg-glass)] border border-[var(--border-default)] rounded-xl p-2 shadow-2xl opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 backdrop-blur-xl">
                  <div class="flex flex-col gap-0.5">
                    {link.children.map((child) => (
                      <a
                        href={child.href}
                        class="font-body text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] hover:bg-white/[0.04] px-3 py-2.5 rounded-lg transition-all duration-150"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={link.href}
                class="font-display text-sm font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors py-2"
              >
                {link.label}
              </a>
            )}
          </div>
        ))}
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-4">
        <a
          href="/#get-proposal"
          class="hidden sm:inline-flex btn-primary text-sm py-2.5 px-5"
        >
          <span>Get Proposal</span>
        </a>

        <button
          id="menu-toggle"
          class="lg:hidden p-2 text-[var(--text-secondary)] hover:text-[var(--text-primary)] focus:outline-none"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path
              id="menu-icon"
              d="M4 6h16M4 12h16M4 18h16"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <MobileMenu />
</header>

<style>
  #navbar {
    transition: transform 0.3s ease, padding 0.3s ease;
  }
  #navbar.scrolled .card-default {
    background: rgba(8, 13, 26, 0.92);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-color: rgba(255,255,255,0.08);
  }
  #navbar.hidden-up {
    transform: translateY(-100%);
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  let lastScrollY = 0;

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;

    if (currentScrollY > 50) {
      navbar?.classList.add('scrolled');
      navbar?.classList.remove('py-4', 'lg:py-6');
      navbar?.classList.add('py-3', 'lg:py-3');
    } else {
      navbar?.classList.remove('scrolled');
      navbar?.classList.remove('py-3', 'lg:py-3');
      navbar?.classList.add('py-4', 'lg:py-6');
    }

    if (currentScrollY > 200) {
      if (currentScrollY > lastScrollY + 10) {
        navbar?.classList.add('hidden-up');
      } else if (currentScrollY < lastScrollY - 5) {
        navbar?.classList.remove('hidden-up');
      }
    }

    lastScrollY = currentScrollY;
  }, { passive: true });

  let isOpen = false;
  toggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    if (isOpen) {
      mobileMenu?.classList.remove('translate-x-full');
      menuIcon?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      toggle.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu?.classList.add('translate-x-full');
      menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });

  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      isOpen = false;
      mobileMenu?.classList.add('translate-x-full');
      menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
