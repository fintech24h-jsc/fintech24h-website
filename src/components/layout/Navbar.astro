---
// src/components/layout/Navbar.astro
import { mainNavLinks } from '../../data/navigation';
import MobileMenu from './MobileMenu.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 py-2 lg:py-4" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Outer wrapper handles the spotlight ring (not clipped) -->
    <div class="navbar-spotlight-wrap">
      <!-- Inner glass bar -->
      <div class="liquid-glass-premium px-6 py-2 flex items-center justify-between relative z-50">

        <!-- Logo -->
        <a href="/" class="flex-shrink-0 flex items-center">
          <img src="/images/Logo-Fintech24h.png" alt="Fintech24h" width="300" height="210" loading="eager" fetchpriority="high" decoding="async" class="h-[48px] md:h-[64px] -my-[6px] md:-my-[10px] object-contain" />
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-8" aria-label="Main navigation">
          {mainNavLinks.map((link) => (
            <div class="relative group">
              {link.children ? (
                <div>
                  <button
                    class="flex items-center gap-1.5 font-display text-sm font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors py-2 focus:outline-none"
                    aria-expanded="false"
                    aria-haspopup="true"
                  >
                    {link.label}
                    <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                  </button>

                  <div class="absolute top-full left-1/2 -translate-x-1/2 mt-3 w-64 bg-[var(--bg-glass)] border border-[var(--border-default)] rounded-xl p-2 shadow-2xl opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 backdrop-blur-xl">
                    <div class="flex flex-col gap-0.5">
                      {link.children.map((child) => (
                        <a
                          href={child.href}
                          class="font-body text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] hover:bg-white/[0.04] px-3 py-2.5 rounded-lg transition-all duration-150"
                        >
                          {child.label}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              ) : link.label === 'Get Proposal' ? (
                <a
                  href={link.href}
                  class="font-display text-sm font-bold text-[var(--text-primary)] bg-gradient-to-r from-[#ff6b83] to-[#f0a278] bg-clip-text text-transparent hover:opacity-80 transition-opacity py-2"
                >
                  {link.label}
                </a>
              ) : link.label === 'Partnership' ? (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-display text-sm font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors py-2"
                >
                  {link.label}
                </a>
              ) : (
                <a
                  href={link.href}
                  class="font-display text-sm font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors py-2"
                >
                  {link.label}
                </a>
              )}
            </div>
          ))}
        </nav>

        <!-- Hamburger -->
        <button
          id="menu-toggle"
          class="lg:hidden p-2 text-[var(--text-secondary)] hover:text-[var(--text-primary)] focus:outline-none"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path
              id="menu-icon"
              d="M4 6h16M4 12h16M4 18h16"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

      </div>
    </div>
  </div>

  <MobileMenu />
</header>

<style>
  /* ─── Navbar outer wrapper — spotlight ring lives here ─── */
  .navbar-spotlight-wrap {
    position: relative;
    border-radius: 18px;
  }

  /* Conic spotlight ring — absolutely placed on the wrapper, not clipped */
  .navbar-spotlight-wrap::after {
    content: '';
    position: absolute;
    inset: -1.5px;
    border-radius: 19px;
    background: conic-gradient(
      from var(--sweep-angle, 0deg),
      transparent 0deg,
      transparent 55deg,
      rgba(0, 200, 240, 0.95) 80deg,
      rgba(240, 162, 120, 0.85) 90deg,
      rgba(124, 92, 252, 0.95) 100deg,
      transparent 130deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: 1.5px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
  }

  .navbar-spotlight-wrap:hover::after {
    opacity: 1;
    animation: navbar-spotlight-sweep 2s linear infinite;
  }
  .navbar-spotlight-wrap:hover .liquid-glass-premium {
    box-shadow: 0 8px 40px 0 rgba(0, 200, 240, 0.1), 0 0 25px rgba(124, 92, 252, 0.06);
  }

  /* Ensure glass inner bar is above the spotlight ring */
  .liquid-glass-premium {
    position: relative;
    z-index: 2;
  }

  /* Scrolled state */
  #navbar {
    transition: transform 0.3s ease, padding 0.3s ease;
  }
  #navbar.scrolled .liquid-glass-premium {
    background: rgba(5, 8, 16, 0.94);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
  }
  #navbar.hidden-up {
    transform: translateY(-100%);
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  let lastScrollY = 0;

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;

    if (currentScrollY > 50) {
      navbar?.classList.add('scrolled');
      navbar?.classList.remove('py-2', 'lg:py-4');
      navbar?.classList.add('py-1', 'lg:py-2');
    } else {
      navbar?.classList.remove('scrolled');
      navbar?.classList.remove('py-1', 'lg:py-2');
      navbar?.classList.add('py-2', 'lg:py-4');
    }

    if (currentScrollY > 200) {
      if (currentScrollY > lastScrollY + 10) {
        navbar?.classList.add('hidden-up');
      } else if (currentScrollY < lastScrollY - 5) {
        navbar?.classList.remove('hidden-up');
      }
    }

    lastScrollY = currentScrollY;
  }, { passive: true });

  let isOpen = false;
  toggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    if (isOpen) {
      mobileMenu?.classList.remove('translate-x-full');
      menuIcon?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      toggle.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu?.classList.add('translate-x-full');
      menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });

  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      isOpen = false;
      mobileMenu?.classList.add('translate-x-full');
      menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
