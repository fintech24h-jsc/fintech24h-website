---
// src/components/sections/CaseStudyWidget.astro
import type { CaseStudy } from '../../lib/wordpress';
import AnimatedCounter from '../ui/AnimatedCounter.tsx';

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;
const { acf } = caseStudy;
---

<section class="py-24 bg-[#050810] relative overflow-hidden" aria-label="Featured Case Study">
  <!-- Glowing background lines -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="bg-orb bg-orb-cyan w-[500px] h-[500px] absolute top-1/3 -left-32 opacity-10"></div>
    <div class="grid-pattern absolute inset-0 opacity-20"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header intro -->
    <div class="max-w-3xl mb-16" data-animate="fade-up">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-400/30 bg-cyan-400/5 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        <span class="text-xs font-semibold text-cyan-400 font-body uppercase tracking-wider">Featured Campaign</span>
      </div>
      <h2 class="font-display text-h2 font-bold text-[#f0f4ff] mb-4">
        Driving On-Chain Growth
      </h2>
      <p class="text-base text-[#94a3b8] font-body leading-relaxed">
        See how we helped <span class="text-cyan-400 font-semibold">{acf.client_name}</span> launch regional Web3 initiatives and drive scalable user engagement.
      </p>
    </div>

    <!-- Case study content grid -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
      
      <!-- Left Column: Metrics -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-4" data-animate="stagger">
        
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-center border-cyan-400/20" data-animate-child>
          <div class="text-3xl sm:text-4xl font-display font-bold gradient-text-cyan mb-2">
            {acf.result_roi}
          </div>
          <div class="text-xs text-[#94a3b8] font-body uppercase tracking-wider">Campaign ROI</div>
        </div>

        <div class="glass-card rounded-2xl p-6 flex flex-col justify-center border-purple-500/15" data-animate-child>
          <div class="text-3xl sm:text-4xl font-display font-bold gradient-text-purple mb-2">
            {acf.result_reach}
          </div>
          <div class="text-xs text-[#94a3b8] font-body uppercase tracking-wider">Organic Reach</div>
        </div>

        <div class="glass-card rounded-2xl p-6 flex flex-col justify-center border-purple-500/15" data-animate-child>
          <div class="text-3xl sm:text-4xl font-display font-bold gradient-text-purple mb-2">
            {acf.result_leads}
          </div>
          <div class="text-xs text-[#94a3b8] font-body uppercase tracking-wider">Users Acquired</div>
        </div>

        <div class="glass-card rounded-2xl p-6 flex flex-col justify-center border-cyan-400/20" data-animate-child>
          <div class="text-3xl sm:text-4xl font-display font-bold gradient-text-cyan mb-2">
            {acf.result_timeline}
          </div>
          <div class="text-xs text-[#94a3b8] font-body uppercase tracking-wider">Launch Time</div>
        </div>

      </div>

      <!-- Right Column: Case Details & Testimonial -->
      <div class="lg:col-span-7 flex flex-col justify-between" data-animate="fade-up">
        <div class="glass-card rounded-3xl p-8 lg:p-10 border-white/5 flex-grow flex flex-col justify-between gap-8">
          <div>
            <div class="flex flex-wrap gap-2 mb-6">
              {acf.services_used.map((s) => (
                <span class="px-3 py-1 rounded-full border border-white/10 bg-white/5 text-[10px] font-semibold text-[#94a3b8] font-body tracking-wider uppercase">
                  {s}
                </span>
              ))}
            </div>
            
            <h3 class="font-display text-2xl font-bold text-[#f0f4ff] mb-6">
              {caseStudy.title.rendered}
            </h3>

            <div class="space-y-6 text-sm text-[#94a3b8] font-body leading-relaxed mb-8">
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-2">The Challenge</h4>
                <p>{acf.challenge}</p>
              </div>
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-purple-400 mb-2">The Solution</h4>
                <p>{acf.solution}</p>
              </div>
            </div>
          </div>

          <!-- Testimonial quote block -->
          {acf.testimonial_quote && (
            <blockquote class="border-t border-white/5 pt-6 mt-auto">
              <p class="text-[#f0f4ff] font-body italic text-sm leading-relaxed mb-4">
                "{acf.testimonial_quote}"
              </p>
              <footer class="flex items-center gap-3">
                <div>
                  <div class="text-xs font-semibold text-cyan-400 font-display">{acf.testimonial_author}</div>
                  <div class="text-[10px] text-[#475569] font-body">{acf.testimonial_role} at {acf.client_name}</div>
                </div>
              </footer>
            </blockquote>
          )}
        </div>

        <!-- Case study details redirect -->
        <div class="flex justify-end mt-4">
          <a
            href={`/case-studies/${caseStudy.slug}`}
            class="text-sm font-semibold text-cyan-400 hover:text-cyan-300 font-display uppercase tracking-wider flex items-center gap-2 transition-colors"
          >
            Read Full Case Study
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
