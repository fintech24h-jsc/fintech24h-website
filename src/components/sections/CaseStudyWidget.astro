---
// src/components/sections/CaseStudyWidget.astro
// Fully redesigned to be a highly creative, luxury, showstopper Case Study Section.
// Styled in the Space Grotesk / astronomical dark theme with rose-gold accent border sweep.
import type { CaseStudy } from '../../lib/wordpress';

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;
const { acf } = caseStudy;
---

<section class="py-14 md:py-32 bg-[var(--bg-primary)] relative overflow-hidden" aria-label="Featured Case Study">
  <!-- Glowing background astronomical details -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute w-[600px] h-[600px] rounded-full"
      style="background: radial-gradient(circle, rgba(0, 200, 240, 0.04) 0%, transparent 70%); top: 10%; left: -10%; filter: blur(80px);">
    </div>
    <div class="absolute w-[500px] h-[500px] rounded-full"
      style="background: radial-gradient(circle, rgba(124, 92, 252, 0.03) 0%, transparent 70%); bottom: 10%; right: -10%; filter: blur(80px);">
    </div>
    <div class="absolute inset-0 grid-pattern animate-grid-drift" style="opacity: 0.15;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Intro -->
    <div class="max-w-3xl mb-24" data-animate="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[color-mix(in_srgb,var(--accent-cyan)_25%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_5%,transparent)] mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span>
        <span class="text-[10px] font-mono font-bold text-[var(--accent-cyan)] uppercase tracking-[0.15em]">Proof of Concept</span>
      </div>
      <h2 class="font-display text-h2 font-bold text-[var(--text-primary)] mb-5">
        Driving <span class="bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-warm)] bg-clip-text text-transparent">On-Chain Acceleration</span>
      </h2>
      <p class="text-base text-[var(--text-secondary)] font-body leading-relaxed max-w-xl">
        Explore how our custom strategy led to explosive engagement metrics, building verified sustainable liquidity channels for <span class="text-[var(--text-primary)] font-semibold">{acf.client_name}</span>.
      </p>
    </div>
 
    <!-- Case Study Content Grid: Creative Overlapping Layout -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
      
      <!-- Left Column: Interactive looking Metrics Stack -->
      <div class="lg:col-span-5 flex flex-col gap-6" data-animate="stagger">
        
        {/* Metric 1 */}
        <div class="p-8 rounded-[24px] border border-[color-mix(in_srgb,var(--accent-rose)_20%,transparent)] bg-gradient-to-br from-[rgba(255,107,131,0.03)] to-transparent shadow-[0_15px_30px_rgba(255,107,131,0.02)] hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group" data-animate-child>
          <div class="absolute inset-0 bg-radial-gradient(circle, rgba(255,107,131,0.03) 0%, transparent 60%) pointer-events-none"></div>
          <div class="relative z-10 flex justify-between items-start">
            <div>
              <span class="font-mono text-[9px] text-[var(--accent-warm)] uppercase tracking-wider block mb-2">Campaign Performance</span>
              <h3 class="font-display text-4xl sm:text-5xl font-bold text-[var(--text-primary)] tracking-tight">{acf.result_roi}</h3>
            </div>
            <div class="w-8 h-8 rounded-lg bg-[var(--surface-soft)] border border-[var(--border-default)] flex items-center justify-center text-[var(--accent-warm)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            </div>
          </div>
        </div>
 
        {/* Metric 2 */}
        <div class="p-8 rounded-[24px] border border-[var(--border-default)] bg-[var(--surface-faint)] hover:border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] hover:bg-[var(--surface-soft)] shadow-[var(--shadow-card)] hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group" data-animate-child>
          <div class="absolute inset-0 bg-radial-gradient(circle, rgba(0,200,240,0.03) 0%, transparent 60%) pointer-events-none"></div>
          <div class="relative z-10 flex justify-between items-start">
            <div>
              <span class="font-mono text-[9px] text-[var(--accent-cyan)] uppercase tracking-wider block mb-2">Audience Amplification</span>
              <h3 class="font-display text-4xl sm:text-5xl font-bold text-[var(--text-primary)] tracking-tight">{acf.result_reach}</h3>
            </div>
            <div class="w-8 h-8 rounded-lg bg-[var(--surface-soft)] border border-[var(--border-default)] flex items-center justify-center text-[var(--accent-cyan)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
          </div>
        </div>
 
        {/* Metric 3 */}
        <div class="p-8 rounded-[24px] border border-[var(--border-default)] bg-[var(--surface-faint)] hover:border-[color-mix(in_srgb,var(--accent-purple)_30%,transparent)] hover:bg-[var(--surface-soft)] shadow-[var(--shadow-card)] hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group" data-animate-child>
          <div class="absolute inset-0 bg-radial-gradient(circle, rgba(124,92,252,0.03) 0%, transparent 60%) pointer-events-none"></div>
          <div class="relative z-10 flex justify-between items-start">
            <div>
              <span class="font-mono text-[9px] text-[var(--accent-purple)] uppercase tracking-wider block mb-2">User Growth</span>
              <h3 class="font-display text-4xl sm:text-5xl font-bold text-[var(--text-primary)] tracking-tight">{acf.result_leads}</h3>
            </div>
            <div class="w-8 h-8 rounded-lg bg-[var(--surface-soft)] border border-[var(--border-default)] flex items-center justify-center text-[var(--accent-purple)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="15"></line><line x1="15" y1="9" x2="9" y2="15"></line></svg>
            </div>
          </div>
        </div>
 
      </div>
 
      {/* Right Column: Case Details & Testimonial inside a beautiful glass card */}
      <div class="lg:col-span-7 flex flex-col justify-between" data-animate="fade-up">
        <div class="p-8 lg:p-12 rounded-[24px] border border-[var(--border-default)] bg-gradient-to-br from-[var(--surface-faint)] to-[var(--surface-soft)] shadow-[var(--shadow-card)] flex-grow flex flex-col justify-between gap-10 hover:border-[var(--border-hover)] transition-colors duration-300">
          <div>
            <div class="flex flex-wrap gap-2 mb-8">
              {acf.services_used.map((s) => (
                <span class="px-3 py-1 rounded-full border border-[var(--border-default)] bg-[var(--surface-soft)] text-[9px] font-mono font-bold text-[var(--text-secondary)] tracking-wider uppercase">
                  {s}
                </span>
              ))}
            </div>
            
            <h3 class="font-display text-2xl lg:text-3xl font-bold text-[var(--text-primary)] mb-8 leading-tight">
              {caseStudy.title.rendered}
            </h3>
 
            <div class="space-y-8 text-sm text-[var(--text-secondary)] font-body leading-relaxed">
              <div class="border-l-2 border-[color-mix(in_srgb,var(--accent-cyan)_30%,transparent)] pl-4">
                <h4 class="text-[10px] font-mono font-bold uppercase tracking-[0.12em] text-[var(--accent-cyan)] mb-2">The Challenge</h4>
                <p class="text-xs sm:text-sm">{acf.challenge}</p>
              </div>
              <div class="border-l-2 border-[color-mix(in_srgb,var(--accent-purple)_30%,transparent)] pl-4">
                <h4 class="text-[10px] font-mono font-bold uppercase tracking-[0.12em] text-[var(--accent-purple)] mb-2">The Solution</h4>
                <p class="text-xs sm:text-sm">{acf.solution}</p>
              </div>
            </div>
          </div>
 
          <!-- Testimonial Quote Block -->
          {acf.testimonial_quote && (
            <blockquote class="border-t border-[var(--border-subtle)] pt-8 mt-6">
              <svg class="w-8 h-8 text-[color-mix(in_srgb,var(--accent-rose)_30%,transparent)] mb-3" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.748-9.791 9-10.455v2.894c-3.057.586-4.947 2.767-4.947 5.756h4.053V21h-8.106zm-12 0v-7.391c0-5.704 3.748-9.791 9-10.455v2.894c-3.057.586-4.947 2.767-4.947 5.756h4.053V21H2.017z"/></svg>
              <p class="text-[var(--text-primary)] font-body italic text-xs sm:text-sm leading-relaxed mb-4">
                "{acf.testimonial_quote}"
              </p>
              <footer class="flex items-center gap-3">
                <div>
                  <div class="text-xs font-semibold text-[var(--accent-cyan)] font-display">{acf.testimonial_author}</div>
                  <div class="text-[10px] text-[var(--text-muted)] font-body">{acf.testimonial_role} at {acf.client_name}</div>
                </div>
              </footer>
            </blockquote>
          )}
        </div>

        <!-- Case Study Link -->
        <div class="flex justify-end mt-6">
          <a
            href={`/case-studies/${caseStudy.slug}`}
            class="text-xs font-bold text-[var(--accent-cyan)] hover:text-cyan-300 font-display uppercase tracking-widest flex items-center gap-2 transition-colors group"
          >
            Read Full Case Study 
            <span class="group-hover:translate-x-1.5 transition-transform">→</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
