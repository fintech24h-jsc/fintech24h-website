---
// src/components/sections/ProcessSection.astro
// Theo design-system.md section 7.5:
// - KHÔNG dùng icon circles + line kết nối (quá AI clichés)
// - Thay bằng: numbered list với card lớn, step number làm background watermark
// - Timeline connector line với reveal animation (Pattern 5 trong design-system.md)
---

<section id="process" class="py-24 bg-[var(--bg-secondary)] relative overflow-hidden" aria-label="Our Process">
  <!-- Background orbs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[600px] h-[600px] rounded-full"
      style="background: var(--gradient-glow-purple); top: 10%; left: -10%; filter: blur(72px);
             animation: orb-pulse 10s ease-in-out infinite 2s, orb-drift 15s ease-in-out infinite 4s;">
    </div>
    <div class="absolute w-[400px] h-[400px] rounded-full"
      style="background: var(--gradient-glow-cyan); bottom: 10%; right: -5%; filter: blur(72px);
             animation: orb-pulse 8s ease-in-out infinite, orb-drift 12s ease-in-out infinite;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="animation: grid-shimmer 6s ease-in-out infinite; opacity: 0.2;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
      <p class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.12em] mb-4">How We Work</p>
      <h2 class="font-display text-h2 font-bold text-[var(--text-primary)] mb-4">
        The Plug &amp; Play Revenue Engine
      </h2>
      <p class="text-base text-[var(--text-secondary)] font-body leading-relaxed">
        Our campaigns align direct conversions with measurable marketing OKRs. Here is how we launch and scale your project.
      </p>
    </div>

    <!-- Process: 2x2 grid — numbered cards với step number watermark theo design-system.md 7.5 -->
    <!-- Layout phá vỡ lưới: 2 col top, 1 large + 1 normal bottom -->
    <div class="space-y-6">

      <!-- Row 1: 2 cards đều -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-animate="stagger">

        <!-- Step 1 -->
        <div class="card-numbered p-8 group" data-step="01" data-animate-child>
          <div class="relative z-10">
            <div class="flex items-start justify-between mb-6">
              <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-[var(--accent-cyan)] text-[var(--bg-primary)] font-display font-bold text-base shadow-[0_0_20px_rgba(0,200,240,0.4)]">
                1
              </div>
              <span class="font-mono text-[10px] text-[var(--text-muted)] uppercase tracking-widest">Week 1–2</span>
            </div>
            <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-3">01 / Audit &amp; Alignment</h3>
            <p class="text-sm text-[var(--text-secondary)] font-body leading-relaxed mb-6">
              We review your current tokenomics, community metrics, and target positioning. Then, we construct a custom OKR template defining conversion targets.
            </p>
            <div class="border-t border-[var(--border-subtle)] pt-5">
              <span class="font-mono text-[9px] text-[var(--accent-cyan)] uppercase tracking-widest block mb-3">Deliverables</span>
              <ul class="space-y-1.5">
                {['Comprehensive Positioning Audit', 'KPI & Goal Alignment Map', 'Initial Competitor Review'].map(d => (
                  <li class="flex items-center gap-2 text-xs text-[var(--text-secondary)] font-body">
                    <span class="w-1 h-1 rounded-full bg-[var(--accent-cyan)] flex-shrink-0"></span>
                    {d}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="card-numbered p-8 group" data-step="02" data-animate-child>
          <div class="relative z-10">
            <div class="flex items-start justify-between mb-6">
              <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-[var(--accent-purple)] text-white font-display font-bold text-base shadow-[0_0_20px_rgba(124,92,252,0.4)]">
                2
              </div>
              <span class="font-mono text-[10px] text-[var(--text-muted)] uppercase tracking-widest">Week 2–4</span>
            </div>
            <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-3">02 / Setup &amp; Campaign Formula</h3>
            <p class="text-sm text-[var(--text-secondary)] font-body leading-relaxed mb-6">
              We list and approve vetted regional KOL networks, design marketing briefs, write PR drafts, and secure publisher editorial calendars.
            </p>
            <div class="border-t border-[var(--border-subtle)] pt-5">
              <span class="font-mono text-[9px] text-[var(--accent-purple)] uppercase tracking-widest block mb-3">Deliverables</span>
              <ul class="space-y-1.5">
                {['Vetted KOL Seeding List', 'Press Release Editorial Calendar', 'Community Moderation Setup'].map(d => (
                  <li class="flex items-center gap-2 text-xs text-[var(--text-secondary)] font-body">
                    <span class="w-1 h-1 rounded-full bg-[var(--accent-purple)] flex-shrink-0"></span>
                    {d}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2: layout bất đối xứng — 1 large (col-span-2) + 1 normal -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-animate="stagger">

        <!-- Step 3: LARGE card (2 col) -->
        <div class="card-numbered md:col-span-2 p-8 group" data-step="03" data-animate-child>
          <div class="relative z-10">
            <div class="flex items-start justify-between mb-6">
              <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-[var(--accent-cyan)] text-[var(--bg-primary)] font-display font-bold text-base shadow-[0_0_20px_rgba(0,200,240,0.4)]">
                3
              </div>
              <span class="font-mono text-[10px] text-[var(--text-muted)] uppercase tracking-widest">Month 1</span>
            </div>
            <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-3">03 / Launch &amp; Engagement</h3>
            <p class="text-sm text-[var(--text-secondary)] font-body leading-relaxed mb-6 max-w-lg">
              Campaigns go live. Our 24/7 moderators manage group chat channels, Quest platforms are activated, and regional PR releases go in sync.
            </p>

            <!-- Metrics highlight cho step quan trọng nhất -->
            <div class="grid grid-cols-3 divide-x divide-white/[0.06] mb-6">
              <div class="text-center px-4 first:pl-0">
                <div class="font-display text-2xl font-bold text-[var(--color-success)] tabular-nums">24/7</div>
                <div class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-widest mt-1">Moderation</div>
              </div>
              <div class="text-center px-4">
                <div class="font-display text-2xl font-bold text-[var(--accent-cyan)] tabular-nums">Day 14</div>
                <div class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-widest mt-1">PR Live</div>
              </div>
              <div class="text-center px-4 last:pr-0">
                <div class="font-display text-2xl font-bold text-[var(--accent-cyan)] tabular-nums">30+</div>
                <div class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-widest mt-1">Channels</div>
              </div>
            </div>

            <div class="border-t border-[var(--border-subtle)] pt-5">
              <span class="font-mono text-[9px] text-[var(--accent-cyan)] uppercase tracking-widest block mb-3">Deliverables</span>
              <ul class="flex flex-wrap gap-x-8 gap-y-1.5">
                {['Active Multi-channel Moderation', 'KOL Content Placements Live', 'Viral Referral Quest Structures'].map(d => (
                  <li class="flex items-center gap-2 text-xs text-[var(--text-secondary)] font-body">
                    <span class="w-1 h-1 rounded-full bg-[var(--accent-cyan)] flex-shrink-0"></span>
                    {d}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Step 4: Normal card -->
        <div class="card-numbered p-8 group" data-step="04" data-animate-child>
          <div class="relative z-10">
            <div class="flex items-start justify-between mb-6">
              <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-[var(--accent-purple)] text-white font-display font-bold text-base shadow-[0_0_20px_rgba(124,92,252,0.4)]">
                4
              </div>
              <span class="font-mono text-[10px] text-[var(--text-muted)] uppercase tracking-widest">Ongoing</span>
            </div>
            <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-3">04 / Growth Optimization</h3>
            <p class="text-sm text-[var(--text-secondary)] font-body leading-relaxed mb-6">
              Weekly ROI dashboards, pruning underperforming channels, scaling highest-converting campaigns.
            </p>
            <div class="border-t border-[var(--border-subtle)] pt-5">
              <span class="font-mono text-[9px] text-[var(--accent-purple)] uppercase tracking-widest block mb-3">Deliverables</span>
              <ul class="space-y-1.5">
                {['Weekly ROI Analytics Reports', 'Campaign Spend Optimization', 'Scaled Growth Playbooks'].map(d => (
                  <li class="flex items-center gap-2 text-xs text-[var(--text-secondary)] font-body">
                    <span class="w-1 h-1 rounded-full bg-[var(--accent-purple)] flex-shrink-0"></span>
                    {d}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
