---
// src/components/sections/ProcessSection.astro
// Zig-zag interactive timeline with subtle rose-gold connecting glows and dynamic node hover states.
---

<section id="process" class="py-14 md:py-32 bg-[var(--bg-primary)] relative overflow-hidden" aria-label="Our Process">
  <!-- Background orbs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[600px] h-[600px] rounded-full"
      style="background: var(--gradient-glow-purple); top: 5%; left: -10%; filter: blur(90px);
             animation: orb-pulse 12s ease-in-out infinite 2s, orb-drift 18s ease-in-out infinite 4s;">
    </div>
    <div class="absolute w-[500px] h-[500px] rounded-full"
      style="background: var(--gradient-glow-cyan); bottom: 5%; right: -5%; filter: blur(80px);
             animation: orb-pulse 10s ease-in-out infinite, orb-drift 14s ease-in-out infinite;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="opacity: 0.15;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-28" data-animate="fade-up">
      <p class="font-mono text-xs text-[var(--accent-warm)] uppercase tracking-[0.15em] mb-4 flex items-center justify-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-rose)]"></span>
        Execution Blueprint
      </p>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-[var(--text-primary)] mb-4 tracking-tight">
        The Plug &amp; Play <span class="bg-gradient-to-r from-[var(--accent-cyan)] via-[var(--accent-warm)] to-[var(--accent-rose)] bg-clip-text text-transparent">Growth Funnel</span>
      </h2>
      <p class="text-base text-[var(--text-secondary)] font-body leading-relaxed">
        Our campaigns align direct conversions with measurable marketing OKRs. Here is how we launch and scale your project.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative max-w-5xl mx-auto">
      
      <!-- Central vertical timeline line -->
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-[var(--accent-cyan)] via-[var(--accent-purple)] to-[var(--accent-warm)] -translate-x-1/2 z-0 opacity-20" aria-hidden="true"></div>
      
      <!-- Moving light dot down the timeline -->
      <div class="absolute left-4 md:left-1/2 top-0 w-1 h-32 bg-gradient-to-b from-transparent via-[var(--accent-warm)] to-transparent -translate-x-1/2 z-0 blur-[1px] animate-flow-timeline" aria-hidden="true"></div>

      <!-- Timeline steps -->
      <div class="space-y-16 relative z-10">

        <!-- Step 1 (Left on Desktop, Right on Mobile) -->
        <div class="flex flex-col md:flex-row md:justify-start items-start group relative animate-trigger" data-animate="fade-up">
          {/* Timeline Node Dot */}
          <div class="absolute left-4 md:left-1/2 top-8 w-4 h-4 rounded-full border-2 border-[var(--accent-cyan)] bg-[var(--bg-primary)] -translate-x-1/2 z-20 flex items-center justify-center transition-all duration-300 group-hover:scale-125 group-hover:border-[var(--accent-warm)] group-hover:shadow-[0_0_15px_var(--accent-warm)]">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] group-hover:bg-[var(--accent-warm)] transition-all"></span>
            <span class="absolute inset-0 rounded-full bg-[var(--accent-cyan)] opacity-0 group-hover:opacity-30 group-hover:animate-ping"></span>
          </div>
 
          <div class="w-full md:w-[45%] pl-10 md:pl-0 md:pr-10 text-left relative">
            {/* Step Card */}
            <div class="p-8 rounded-[20px] border border-[var(--border-default)] bg-[var(--surface-faint)] hover:bg-[var(--surface-soft)] hover:border-[var(--accent-cyan)]/30 hover:shadow-[0_15px_35px_rgba(0,200,240,0.04)] transition-all duration-500 relative overflow-hidden">
              
              {/* Nebula Point Glow */}
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
                style="background: radial-gradient(circle at 10% 10%, rgba(0,200,240,0.05) 0%, transparent 60%);">
              </div>
 
              <div class="relative z-10">
                <div class="flex justify-between items-center mb-4">
                  <span class="font-mono text-xs text-[var(--accent-warm)] font-semibold">01 / WEEK 1-2</span>
                  <div class="text-3xl font-display font-bold text-[var(--text-primary)]/5 group-hover:text-[var(--accent-cyan)]/10 transition-all duration-300">01</div>
                </div>
 
                <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-3 group-hover:text-[var(--accent-cyan)] transition-colors">Audit &amp; Alignment</h3>
                <p class="text-xs text-[var(--text-secondary)] font-body leading-relaxed mb-6">
                  We review your current tokenomics, community metrics, and target positioning. Then, we construct a custom OKR template defining conversion targets.
                </p>
 
                <div class="border-t border-[var(--border-subtle)] pt-4">
                  <span class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-wider block mb-2">Deliverables</span>
                  <ul class="flex flex-wrap gap-1.5">
                    {['Positioning Audit', 'KPI Alignment Map', 'Competitor Review'].map(d => (
                      <li class="tag bg-[var(--surface-soft)] border-none text-[10px] text-[var(--text-secondary)] py-0.5 px-2 rounded-full">{d}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
 
        <!-- Step 2 (Right on Desktop, Right on Mobile) -->
        <div class="flex flex-col md:flex-row md:justify-end items-start group relative animate-trigger" data-animate="fade-up">
          {/* Timeline Node Dot */}
          <div class="absolute left-4 md:left-1/2 top-8 w-4 h-4 rounded-full border-2 border-[var(--accent-purple)] bg-[var(--bg-primary)] -translate-x-1/2 z-20 flex items-center justify-center transition-all duration-300 group-hover:scale-125 group-hover:border-[var(--accent-warm)] group-hover:shadow-[0_0_15px_var(--accent-warm)]">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-purple)] group-hover:bg-[var(--accent-warm)] transition-all"></span>
            <span class="absolute inset-0 rounded-full bg-[var(--accent-purple)] opacity-0 group-hover:opacity-30 group-hover:animate-ping"></span>
          </div>
 
          <div class="w-full md:w-[45%] pl-10 text-left relative">
            {/* Step Card */}
            <div class="p-8 rounded-[20px] border border-[var(--border-default)] bg-[var(--surface-faint)] hover:bg-[var(--surface-soft)] hover:border-[var(--accent-purple)]/30 hover:shadow-[0_15px_35px_rgba(124,92,252,0.04)] transition-all duration-500 relative overflow-hidden">
              
              {/* Nebula Point Glow */}
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
                style="background: radial-gradient(circle at 90% 10%, rgba(124,92,252,0.05) 0%, transparent 60%);">
              </div>
 
              <div class="relative z-10">
                <div class="flex justify-between items-center mb-4">
                  <span class="font-mono text-xs text-[var(--accent-warm)] font-semibold">02 / WEEK 2-4</span>
                  <div class="text-3xl font-display font-bold text-[var(--text-primary)]/5 group-hover:text-[var(--accent-purple)]/10 transition-all duration-300">02</div>
                </div>
 
                <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-3 group-hover:text-[var(--accent-purple)] transition-colors">Campaign Formula</h3>
                <p class="text-xs text-[var(--text-secondary)] font-body leading-relaxed mb-6">
                  We list and approve vetted regional KOL networks, design marketing briefs, write PR drafts, and secure publisher editorial calendars.
                </p>
 
                <div class="border-t border-[var(--border-subtle)] pt-4">
                  <span class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-wider block mb-2">Deliverables</span>
                  <ul class="flex flex-wrap gap-1.5">
                    {['KOL Seeding List', 'PR Calendar Draft', 'Community Setup'].map(d => (
                      <li class="tag bg-[var(--surface-soft)] border-none text-[10px] text-[var(--text-secondary)] py-0.5 px-2 rounded-full">{d}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
 
        <!-- Step 3 (Left on Desktop, Right on Mobile) - SOFTER WARM ACCENT -->
        <div class="flex flex-col md:flex-row md:justify-start items-start group relative animate-trigger" data-animate="fade-up">
          {/* Timeline Node Dot */}
          <div class="absolute left-4 md:left-1/2 top-8 w-5 h-5 rounded-full border-2 border-[var(--accent-rose)] bg-[var(--bg-primary)] -translate-x-1/2 z-20 flex items-center justify-center transition-all duration-300 group-hover:scale-125 group-hover:shadow-[0_0_20px_var(--accent-rose)] animate-pulse">
            <span class="w-2 h-2 rounded-full bg-[var(--accent-warm)]"></span>
            <span class="absolute inset-0 rounded-full bg-[var(--accent-rose)] opacity-0 group-hover:opacity-30 group-hover:animate-ping"></span>
          </div>
 
          <div class="w-full md:w-[45%] pl-10 md:pl-0 md:pr-10 text-left relative">
            {/* Step Card with softer warm border */}
            <div class="p-8 rounded-[24px] border border-[var(--accent-rose)]/20 bg-[rgba(255,107,131,0.01)] hover:bg-[rgba(255,107,131,0.02)] hover:border-[var(--accent-warm)]/40 hover:shadow-[0_20px_45px_rgba(255,107,131,0.04)] transition-all duration-500 relative overflow-hidden">
              
              {/* Nebula Point Glow */}
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
                style="background: radial-gradient(circle at 10% 10%, rgba(255,107,131,0.05) 0%, transparent 60%);">
              </div>
 
              <div class="relative z-10">
                <div class="flex justify-between items-center mb-4">
                  <span class="font-mono text-xs text-[var(--accent-warm)] font-bold tracking-wider">03 / MONTH 1 (LAUNCH)</span>
                  <div class="text-3xl font-display font-bold text-[var(--text-primary)]/5 group-hover:text-[var(--accent-rose)]/10 transition-all duration-300">03</div>
                </div>
 
                <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-3 bg-gradient-to-r from-[var(--text-primary)] to-[var(--accent-warm)] bg-clip-text text-transparent group-hover:text-[var(--accent-rose)] transition-colors">Launch &amp; Engagement</h3>
                <p class="text-xs text-[var(--text-secondary)] font-body leading-relaxed mb-6">
                  Campaigns go live. Our 24/7 moderators manage group chat channels, Quest platforms are activated, and regional PR releases go in sync.
                </p>
 
                {/* Inline Stats to highlight success */}
                <div class="grid grid-cols-3 divide-x divide-[var(--border-subtle)] border-y border-[var(--border-subtle)] py-4 mb-5 text-center">
                  <div>
                    <span class="font-display text-lg font-bold text-[var(--accent-warm)]">24/7</span>
                    <span class="font-mono text-[8px] text-[var(--text-muted)] uppercase tracking-wider block mt-0.5">Moderation</span>
                  </div>
                  <div>
                    <span class="font-display text-lg font-bold text-[var(--accent-warm)]">Day 14</span>
                    <span class="font-mono text-[8px] text-[var(--text-muted)] uppercase tracking-wider block mt-0.5">PR Placement</span>
                  </div>
                  <div>
                    <span class="font-display text-lg font-bold text-[var(--accent-warm)]">30+</span>
                    <span class="font-mono text-[8px] text-[var(--text-muted)] uppercase tracking-wider block mt-0.5">KOL Channels</span>
                  </div>
                </div>
 
                <div>
                  <span class="font-mono text-[9px] text-[var(--accent-warm)] uppercase tracking-wider block mb-2">Deliverables</span>
                  <ul class="flex flex-wrap gap-1.5">
                    {['Active Chat Moderation', 'KOL Placement Live', 'Quests Activation'].map(d => (
                      <li class="tag bg-[var(--surface-soft)] border-none text-[10px] text-[var(--text-secondary)] py-0.5 px-2 rounded-full">{d}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
 
        <!-- Step 4 (Right on Desktop, Right on Mobile) -->
        <div class="flex flex-col md:flex-row md:justify-end items-start group relative animate-trigger" data-animate="fade-up">
          {/* Timeline Node Dot */}
          <div class="absolute left-4 md:left-1/2 top-8 w-4 h-4 rounded-full border-2 border-[var(--accent-purple)] bg-[var(--bg-primary)] -translate-x-1/2 z-20 flex items-center justify-center transition-all duration-300 group-hover:scale-125 group-hover:border-[var(--accent-warm)] group-hover:shadow-[0_0_15px_var(--accent-warm)]">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-purple)] group-hover:bg-[var(--accent-warm)] transition-all"></span>
            <span class="absolute inset-0 rounded-full bg-[var(--accent-purple)] opacity-0 group-hover:opacity-30 group-hover:animate-ping"></span>
          </div>
 
          <div class="w-full md:w-[45%] pl-10 text-left relative">
            {/* Step Card */}
            <div class="p-8 rounded-[20px] border border-[var(--border-default)] bg-[var(--surface-faint)] hover:bg-[var(--surface-soft)] hover:border-[var(--accent-purple)]/30 hover:shadow-[0_15px_35px_rgba(124,92,252,0.04)] transition-all duration-500 relative overflow-hidden">
              
              {/* Nebula Point Glow */}
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
                style="background: radial-gradient(circle at 90% 10%, rgba(124,92,252,0.05) 0%, transparent 60%);">
              </div>
 
              <div class="relative z-10">
                <div class="flex justify-between items-center mb-4">
                  <span class="font-mono text-xs text-[var(--accent-warm)] font-semibold">04 / ONGOING</span>
                  <div class="text-3xl font-display font-bold text-[var(--text-primary)]/5 group-hover:text-[var(--accent-purple)]/10 transition-all duration-300">04</div>
                </div>
 
                <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-3 group-hover:text-[var(--accent-purple)] transition-colors">Growth Optimization</h3>
                <p class="text-xs text-[var(--text-secondary)] font-body leading-relaxed mb-6">
                  Weekly ROI dashboards, pruning underperforming channels, scaling highest-converting campaigns.
                </p>
 
                <div class="border-t border-[var(--border-subtle)] pt-4">
                  <span class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-wider block mb-2">Deliverables</span>
                  <ul class="flex flex-wrap gap-1.5">
                    {['Weekly ROI Analytics', 'Ad Spend Optimization', 'Growth Playbook'].map(d => (
                      <li class="tag bg-[var(--surface-soft)] border-none text-[10px] text-[var(--text-secondary)] py-0.5 px-2 rounded-full">{d}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  @keyframes flow-timeline {
    0% {
      top: -100px;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  .animate-flow-timeline {
    animation: flow-timeline 6s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
  }

  /* Interactive timeline segment highlight effect between cards */
  .animate-trigger:hover ~ .animate-trigger::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent-cyan);
    opacity: 0.8;
    filter: blur(1px);
    transition: opacity 0.5s ease;
  }
  @media (min-width: 768px) {
    .animate-trigger:hover ~ .animate-trigger::before {
      left: 50%;
    }
  }
</style>
