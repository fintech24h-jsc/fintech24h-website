---
// src/components/sections/HeroSection.astro
// Multi-step lead form instead of Book-a-Call directly
import MultiStepForm from '../ui/MultiStepForm.tsx';
---

<section class="relative min-h-screen flex items-center overflow-hidden" aria-label="Hero">

  <!-- Ambient background orbs -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="bg-orb bg-orb-cyan w-[600px] h-[600px] absolute -top-32 -left-32 opacity-20 animate-glow-pulse"></div>
    <div class="bg-orb bg-orb-purple w-[500px] h-[500px] absolute top-1/2 -right-32 opacity-15" style="animation-delay: 2s;"></div>
    <div class="grid-pattern absolute inset-0 opacity-30"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Copy -->
      <div>
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--accent-cyan)]/30 bg-[var(--accent-cyan)]/5 mb-8" data-animate="fade-up">
          <span class="w-2 h-2 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span>
          <span class="text-sm font-medium text-[var(--accent-cyan)] font-body">Blockchain & AI Marketing Agency</span>
        </div>

        <!-- H1 -->
        <h1 class="font-display text-hero font-bold text-[var(--text-primary)] leading-tight mb-6" data-animate="fade-up">
          We Scale
          <span class="gradient-text-cyan text-glow-cyan block">AI, Blockchain</span>
          & Fintech Startups
          <span class="text-[var(--text-secondary)]">Globally</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-lg lg:text-xl text-[var(--text-secondary)] font-body leading-relaxed mb-8 max-w-xl" data-animate="fade-up">
          From KOL campaigns to community building — our Plug & Play Marketing model with OKR framework drives measurable growth for Web3 projects across Vietnam, Singapore, UAE, and beyond.
        </p>

        <!-- Social proof numbers -->
        <div class="flex flex-wrap gap-8 mb-10" data-animate="stagger">
          <div data-animate-child>
            <div class="text-3xl font-display font-bold gradient-text-cyan">200+</div>
            <div class="text-sm text-[var(--text-secondary)] font-body mt-1">Projects Scaled</div>
          </div>
          <div data-animate-child>
            <div class="text-3xl font-display font-bold gradient-text-cyan">50x</div>
            <div class="text-sm text-[var(--text-secondary)] font-body mt-1">Avg ROI Delivered</div>
          </div>
          <div data-animate-child>
            <div class="text-3xl font-display font-bold gradient-text-cyan">6</div>
            <div class="text-sm text-[var(--text-secondary)] font-body mt-1">Countries Covered</div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4" data-animate="fade-up">
          <a
            href="#get-proposal"
            class="btn-primary"
            aria-label="Get a free marketing proposal from Fintech24h"
          >
            <span>Get a Free Proposal</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            href="https://t.me/fintech24h"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
            aria-label="Chat with Fintech24h on Telegram"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            <span>Chat on Telegram</span>
          </a>
        </div>
      </div>

      <!-- Right: Multi-step Lead Form (CTA #1 template) -->
      <div id="get-proposal" class="card-default p-8 lg:p-10" data-animate="fade-up">
        <div class="text-center mb-6">
          <h2 class="text-xl font-display font-semibold text-[var(--text-primary)] mb-2">
            Get Your Free Strategy
          </h2>
          <p class="text-sm text-[var(--text-secondary)] font-body">
            Tell us about your project. We'll build a custom growth plan in 24 hours.
          </p>
        </div>
        <MultiStepForm client:load />
      </div>

    </div>
  </div>
</section>
