---
// src/components/sections/HeroSection.astro
// Fully redesigned to be a centered, high-impact astronomical landing hero.
// Features centered copy, larger brand text, and highly creative glowing stats.
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden py-32 lg:py-40" aria-label="Hero">

  <!-- Background Layer 1: Mesh gradient -->
  <div class="absolute inset-0" style="background: var(--gradient-hero-bg);" aria-hidden="true"></div>

  <!-- Background Layer 2: Orbs + Grid -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <!-- Orb 1 — Cyan, top-left -->
    <div class="absolute w-[600px] h-[600px] rounded-full"
      style="
        background: var(--gradient-glow-cyan);
        top: -10%; left: -5%;
        filter: blur(80px);
        animation: orb-pulse 8s ease-in-out infinite, orb-drift 12s ease-in-out infinite;
      ">
    </div>
    <!-- Orb 2 — Purple, bottom-right -->
    <div class="absolute w-[500px] h-[500px] rounded-full"
      style="
        background: var(--gradient-glow-purple);
        bottom: -5%; right: -8%;
        filter: blur(80px);
        animation: orb-pulse 10s ease-in-out infinite 2s, orb-drift 15s ease-in-out infinite 4s;
      ">
    </div>
    <!-- Background Layer 3: Grid pattern overlay -->
    <div class="absolute inset-0 grid-pattern"
      style="animation: grid-shimmer 6s ease-in-out infinite; opacity: 0.35;">
    </div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <!-- Eyebrow -->
    <p class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.18em] mb-6 flex items-center justify-center gap-2" data-hero-eyebrow>
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span>
      BLOCKCHAIN &amp; FINTECH GROWTH PARTNER
    </p>

    <!-- H1: Larger, beautifully styled rhythm -->
    <h1 class="font-display font-bold leading-[1.08] mb-8 text-center max-w-4xl mx-auto">
      <span class="block text-[clamp(1.6rem,4vw,2.75rem)] tracking-[-0.02em] text-[var(--text-secondary)] mb-3" data-hero-line>
        The Growth Partner
      </span>
      <span class="block text-[clamp(3.2rem,8vw,6.5rem)] tracking-[-0.03em] bg-gradient-to-r from-[var(--accent-cyan)] via-[#f0a278] to-[#ff6b83] bg-clip-text text-transparent mb-3" data-hero-line>
        &amp; Marketing Authority
      </span>
      <span class="block text-[clamp(3.2rem,8vw,6.5rem)] tracking-[-0.03em] text-[var(--text-primary)]" data-hero-line>
        in Blockchain
      </span>
    </h1>

    <!-- Subheadline -->
    <p class="text-base sm:text-lg lg:text-xl text-[var(--text-secondary)] font-body leading-relaxed mb-16 max-w-3xl mx-auto">
      From brand positioning to full-scale execution, we build the marketing engine that turns Blockchain, Fintech &amp; Web3 projects into market leaders.
    </p>

    <!-- Stats: Outstanding layout with circular gradient border sweeps and floating animations -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto mb-16">
      
      <!-- Stat 1 -->
      <div class="relative p-8 rounded-3xl border border-white/5 bg-white/[0.01] overflow-hidden group shadow-2xl transition-all duration-300 hover:border-[var(--accent-cyan)]/30 hover:-translate-y-1">
        <div class="absolute inset-0 bg-gradient-to-br from-[var(--accent-cyan)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="absolute -inset-[1px] rounded-3xl bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)] opacity-10 blur-[6px] group-hover:opacity-30 transition-opacity duration-500"></div>
        <div class="relative z-10">
          <div class="font-display text-5xl sm:text-6xl font-bold text-white tracking-tight tabular-nums" data-count="200" data-suffix="+">200+</div>
          <div class="font-mono text-[10px] text-[var(--accent-cyan)] uppercase tracking-widest mt-3 font-semibold">Projects Scaled</div>
        </div>
      </div>

      <!-- Stat 2 -->
      <div class="relative p-8 rounded-3xl border border-white/5 bg-white/[0.01] overflow-hidden group shadow-2xl transition-all duration-300 hover:border-[#f0a278]/30 hover:-translate-y-1">
        <div class="absolute inset-0 bg-gradient-to-br from-[#f0a278]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="absolute -inset-[1px] rounded-3xl bg-gradient-to-r from-[#f0a278] to-[#ff6b83] opacity-10 blur-[6px] group-hover:opacity-30 transition-opacity duration-500"></div>
        <div class="relative z-10">
          <div class="font-display text-5xl sm:text-6xl font-bold text-white tracking-tight tabular-nums" data-count="50" data-suffix="x">50x</div>
          <div class="font-mono text-[10px] text-[#f0a278] uppercase tracking-widest mt-3 font-semibold">Avg ROI</div>
        </div>
      </div>

      <!-- Stat 3 -->
      <div class="relative p-8 rounded-3xl border border-white/5 bg-white/[0.01] overflow-hidden group shadow-2xl transition-all duration-300 hover:border-[var(--accent-purple)]/30 hover:-translate-y-1">
        <div class="absolute inset-0 bg-gradient-to-br from-[var(--accent-purple)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="absolute -inset-[1px] rounded-3xl bg-gradient-to-r from-[var(--accent-purple)] to-[var(--accent-cyan)] opacity-10 blur-[6px] group-hover:opacity-30 transition-opacity duration-500"></div>
        <div class="relative z-10">
          <div class="font-display text-5xl sm:text-6xl font-bold text-white tracking-tight tabular-nums" data-count="6" data-suffix="">6</div>
          <div class="font-mono text-[10px] text-[var(--accent-purple)] uppercase tracking-widest mt-3 font-semibold">Countries</div>
        </div>
      </div>

    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="#strategy-section"
        class="btn-primary py-4 px-8 text-sm"
        aria-label="Get a free marketing proposal from Fintech24h"
      >
        <span>Get Your Free Strategy</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a
        href="https://t.me/fintech24h"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost py-4 px-8 text-sm"
        aria-label="Chat with Fintech24h on Telegram"
      >
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        <span>Chat on Telegram</span>
      </a>
    </div>

  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-[var(--text-muted)]" aria-hidden="true">
    <span class="font-mono text-[9px] uppercase tracking-widest">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-[var(--accent-cyan)]/40 to-transparent"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const heroLines = document.querySelectorAll('[data-hero-line]');
    const heroEyebrow = document.querySelector('[data-hero-eyebrow]');

    if (heroEyebrow) {
      gsap.fromTo(heroEyebrow,
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }
      );
    }

    gsap.fromTo(
      heroLines,
      { opacity: 0, y: 32, filter: 'blur(6px)' },
      {
        opacity: 1, y: 0, filter: 'blur(0px)',
        duration: 1.0,
        stagger: 0.12,
        ease: 'power4.out',
        delay: 0.1,
      }
    );

    // Dynamic Odometer counter simulation
    document.querySelectorAll('[data-count]').forEach((el) => {
      const target = parseInt(el.getAttribute('data-count') || '0');
      const suffix = el.getAttribute('data-suffix') || '';
      ScrollTrigger.create({
        trigger: el,
        start: 'top 90%',
        once: true,
        onEnter: () => {
          const obj = { val: 0 };
          gsap.to(obj, {
            val: target,
            duration: 2.2,
            ease: 'power3.out',
            onUpdate() {
              el.textContent = Math.round(obj.val) + suffix;
            },
          });
        },
      });
    });
  });
</script>
