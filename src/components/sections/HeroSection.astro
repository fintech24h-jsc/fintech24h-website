---
// src/components/sections/HeroSection.astro
// Theo design-system.md section 7.1:
// - H1 tách 3 dòng với weight/color khác nhau để tạo rhythm
// - Background: mesh gradient + orbs + grid pattern (3 lớp)
// - Chỉ animate H1 reveal + form fade-in — KHÔNG animate subtext/buttons
// - Eyebrow: font-mono uppercase tracking-widest
import MultiStepForm from '../ui/MultiStepForm.tsx';
---

<section class="relative min-h-screen flex items-center overflow-hidden" aria-label="Hero">

  <!-- Background Layer 1: Mesh gradient -->
  <div class="absolute inset-0" style="background: var(--gradient-hero-bg);" aria-hidden="true"></div>

  <!-- Background Layer 2: Orbs + Grid — theo design-system.md 5.3 -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <!-- Orb 1 — Cyan, góc trên trái -->
    <div class="absolute w-[500px] h-[500px] rounded-full"
      style="
        background: var(--gradient-glow-cyan);
        top: -10%; left: -5%;
        filter: blur(72px);
        animation: orb-pulse 8s ease-in-out infinite, orb-drift 12s ease-in-out infinite;
      ">
    </div>
    <!-- Orb 2 — Purple, góc dưới phải (offset thời gian khác nhau) -->
    <div class="absolute w-[400px] h-[400px] rounded-full"
      style="
        background: var(--gradient-glow-purple);
        bottom: -5%; right: -8%;
        filter: blur(72px);
        animation: orb-pulse 10s ease-in-out infinite 2s, orb-drift 15s ease-in-out infinite 4s;
      ">
    </div>
    <!-- Background Layer 3: Grid pattern overlay -->
    <div class="absolute inset-0 grid-pattern"
      style="animation: grid-shimmer 6s ease-in-out infinite; opacity: 0.3;">
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Copy -->
      <div>
        <!-- Eyebrow: JetBrains Mono uppercase — điểm nhận diện theo spec -->
        <p class="font-mono text-xs text-[var(--text-muted)] uppercase tracking-[0.12em] mb-8" data-hero-eyebrow>
          Blockchain &amp; AI Marketing Agency
        </p>

        <!-- H1: 3 dòng với weight/color/style khác nhau — theo design-system.md 7.1 -->
        <h1 class="font-display font-bold leading-[1.05] mb-6">
          <!-- Dòng 1: text-secondary, smaller — tạo contrast -->
          <span class="block text-[clamp(1.5rem,3vw,2.25rem)] tracking-[-0.02em] text-[var(--text-secondary)]" data-hero-line>
            We Scale
          </span>
          <!-- Dòng 2: gradient text — điểm nhấn chính -->
          <span class="block text-[clamp(3rem,7vw,5.5rem)] tracking-[-0.03em] bg-gradient-to-r from-[var(--accent-cyan)] to-[#a78bfa] bg-clip-text text-transparent" data-hero-line>
            AI &amp; Blockchain
          </span>
          <!-- Dòng 3: text-primary — trọng lượng -->
          <span class="block text-[clamp(3rem,7vw,5.5rem)] tracking-[-0.03em] text-[var(--text-primary)]" data-hero-line>
            Startups Globally
          </span>
        </h1>

        <!-- Subheadline: KHÔNG animate theo spec -->
        <p class="text-base lg:text-lg text-[var(--text-secondary)] font-body leading-relaxed mb-8 max-w-xl">
          From KOL campaigns to community building — our Plug &amp; Play Marketing model with OKR framework drives measurable growth for Web3 projects across Vietnam, Singapore, UAE, and beyond.
        </p>

        <!-- Stats: Divider dọc — theo design-system.md 6.2 -->
        <div class="grid grid-cols-3 divide-x divide-white/[0.06] mb-10">
          <div class="text-center px-6 first:pl-0">
            <div class="font-display text-4xl font-bold text-[var(--accent-cyan)] tabular-nums" data-count="200" data-suffix="+">200+</div>
            <div class="font-mono text-[10px] text-[var(--text-muted)] uppercase tracking-widest mt-2">Projects Scaled</div>
          </div>
          <div class="text-center px-6">
            <div class="font-display text-4xl font-bold text-[var(--accent-cyan)] tabular-nums" data-count="50" data-suffix="x">50x</div>
            <div class="font-mono text-[10px] text-[var(--text-muted)] uppercase tracking-widest mt-2">Avg ROI</div>
          </div>
          <div class="text-center px-6 last:pr-0">
            <div class="font-display text-4xl font-bold text-[var(--accent-cyan)] tabular-nums" data-count="6">6</div>
            <div class="font-mono text-[10px] text-[var(--text-muted)] uppercase tracking-widest mt-2">Countries</div>
          </div>
        </div>

        <!-- CTA Buttons: KHÔNG animate theo spec — cần clickable ngay -->
        <div class="flex flex-wrap gap-4">
          <a
            href="#get-proposal"
            class="btn-primary"
            aria-label="Get a free marketing proposal from Fintech24h"
          >
            <span>Get a Free Proposal</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            href="https://t.me/fintech24h"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
            aria-label="Chat with Fintech24h on Telegram"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            <span>Chat on Telegram</span>
          </a>
        </div>
      </div>

      <!-- Right: Multi-step Lead Form — KHÔNG mockup/3D object theo spec -->
      <div id="get-proposal" class="card-default p-8 lg:p-10" data-animate="fade-up">
        <div class="text-center mb-6">
          <h2 class="font-display text-xl font-bold text-[var(--text-primary)] mb-2">
            Get Your Free Strategy
          </h2>
          <p class="text-sm text-[var(--text-secondary)] font-body">
            Tell us about your project. We'll build a custom growth plan in 24 hours.
          </p>
        </div>
        <MultiStepForm client:load />
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-[var(--text-muted)]" aria-hidden="true">
    <span class="font-mono text-[9px] uppercase tracking-widest">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-[var(--accent-cyan)]/40 to-transparent"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ── Pattern 4: Hero headline reveal — chỉ dùng đúng 1 lần theo design-system.md ──
  document.addEventListener('DOMContentLoaded', () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const heroLines = document.querySelectorAll('[data-hero-line]');
    const heroEyebrow = document.querySelector('[data-hero-eyebrow]');

    // Eyebrow fade in trước
    if (heroEyebrow) {
      gsap.fromTo(heroEyebrow,
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }
      );
    }

    // H1 lines: blur reveal theo design-system.md pattern 4
    gsap.fromTo(
      heroLines,
      { opacity: 0, y: 32, filter: 'blur(6px)' },
      {
        opacity: 1, y: 0, filter: 'blur(0px)',
        duration: 1.0,
        stagger: 0.12,
        ease: 'power4.out',
        delay: 0.1,
      }
    );

    // Counter animation — theo design-system.md Pattern 3
    document.querySelectorAll('[data-count]').forEach((el) => {
      const target = parseInt(el.getAttribute('data-count') || '0');
      const suffix = el.getAttribute('data-suffix') || '';
      ScrollTrigger.create({
        trigger: el,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          const obj = { val: 0 };
          gsap.to(obj, {
            val: target,
            duration: 2,
            ease: 'power2.out',
            onUpdate() {
              el.textContent = Math.round(obj.val) + suffix;
            },
          });
        },
      });
    });
  });
</script>
