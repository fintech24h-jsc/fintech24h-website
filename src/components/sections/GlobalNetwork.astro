---
// src/components/sections/GlobalNetwork.astro
---

<section class="py-24 bg-[var(--bg-primary)] relative overflow-hidden" aria-label="Global Network">
  
  <!-- Ambient background glow -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[800px] h-[800px] rounded-full"
      style="background: var(--gradient-glow-purple); top: 50%; left: 50%; transform: translate(-50%, -50%); filter: blur(120px); opacity: 0.1;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="opacity: 0.25;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mb-12 sm:mb-16 animate-fade-up">
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-[var(--text-primary)] mb-4 tracking-tight leading-tight">
        Global Reach.<br class="hidden sm:block" />
        <span class="bg-gradient-to-r from-[var(--accent-cyan)] to-[#f0a278] bg-clip-text text-transparent">Local Impact.</span>
      </h2>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] font-body leading-relaxed max-w-2xl mx-auto">
        Instantly expand your reach & publish content to global audiences, connecting your Web3 project with millions of investors in over 10 countries.
      </p>
    </div>

    <!-- Map Container -->
    <div class="relative w-full max-w-5xl aspect-[16/10] md:aspect-[21/9] mx-auto flex items-center justify-center mt-4">
      
      <!-- Minimalist Dotted/Vector World Map SVG (Background) -->
      <!-- A stylized, low-opacity vector path representing continents -->
      <svg class="absolute inset-0 w-full h-full text-white drop-shadow-md" style="opacity: 0.08;" viewBox="0 0 1000 450" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- North America -->
        <path d="M150,120 Q120,80 180,50 Q250,30 280,70 Q300,120 220,180 Q180,200 150,120 Z"/>
        <!-- South America -->
        <path d="M220,200 Q280,210 300,280 Q320,380 250,420 Q200,350 220,200 Z"/>
        <!-- Europe & Asia (Eurasia) -->
        <path d="M450,120 Q480,50 600,40 Q750,30 850,70 Q950,150 850,220 Q700,280 600,220 Q450,200 450,120 Z"/>
        <!-- Africa -->
        <path d="M450,150 Q550,150 580,250 Q600,350 500,400 Q400,300 450,150 Z"/>
        <!-- Australia -->
        <path d="M780,300 Q850,280 880,350 Q850,420 780,380 Q750,350 780,300 Z"/>
      </svg>

      <!-- Connection lines (optional styling to link hubs) -->
      <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-20" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M20,35 Q40,15 50,30 T65,45 T75,55 T85,38" fill="none" stroke="var(--accent-cyan)" stroke-width="0.1" stroke-dasharray="1 1" class="connection-line"/>
      </svg>

      <!-- Pill Container: Absolute positioning based on % of container -->
      <!-- To maintain responsive design, top/left are in percentages -->
      
      <!-- 1. United States -->
      <div class="country-pill" style="top: 30%; left: 15%; animation-delay: 0.2s;">
        <span class="flag">🇺🇸</span>
        <span class="name">USA</span>
      </div>

      <!-- 2. United Kingdom -->
      <div class="country-pill" style="top: 25%; left: 46%; animation-delay: 0.7s;">
        <span class="flag">🇬🇧</span>
        <span class="name">UK</span>
      </div>

      <!-- 3. France -->
      <div class="country-pill" style="top: 35%; left: 48%; animation-delay: 1.1s;">
        <span class="flag">🇫🇷</span>
        <span class="name">FRANCE</span>
      </div>

      <!-- 4. Turkey -->
      <div class="country-pill" style="top: 38%; left: 56%; animation-delay: 0.5s;">
        <span class="flag">🇹🇷</span>
        <span class="name">TURKEY</span>
      </div>

      <!-- 5. UAE -->
      <div class="country-pill" style="top: 48%; left: 60%; animation-delay: 1.4s;">
        <span class="flag">🇦🇪</span>
        <span class="name">UAE</span>
      </div>

      <!-- 6. India -->
      <div class="country-pill" style="top: 50%; left: 68%; animation-delay: 0.9s;">
        <span class="flag">🇮🇳</span>
        <span class="name">INDIA</span>
      </div>

      <!-- 7. Vietnam -->
      <div class="country-pill" style="top: 55%; left: 75%; animation-delay: 0.3s;">
        <span class="flag">🇻🇳</span>
        <span class="name">VIETNAM</span>
      </div>

      <!-- 8. Singapore -->
      <div class="country-pill" style="top: 65%; left: 77%; animation-delay: 1.6s;">
        <span class="flag">🇸🇬</span>
        <span class="name">SINGAPORE</span>
      </div>

      <!-- 9. South Korea -->
      <div class="country-pill" style="top: 35%; left: 82%; animation-delay: 1.2s;">
        <span class="flag">🇰🇷</span>
        <span class="name">KOREA</span>
      </div>

      <!-- 10. Japan -->
      <div class="country-pill" style="top: 38%; left: 88%; animation-delay: 0.6s;">
        <span class="flag">🇯🇵</span>
        <span class="name">JAPAN</span>
      </div>

      <!-- Special Pill: Global -->
      <div class="country-pill special-pill" style="bottom: 5%; left: 50%; transform: translateX(-50%); animation-delay: 0s;">
        <div class="flex items-center gap-2">
          <!-- Small glowing equalizer icon -->
          <div class="flex items-end gap-[2px] h-3">
            <span class="w-[2px] h-full bg-[var(--accent-cyan)] animate-[eq_1.2s_ease-in-out_infinite_alternate]"></span>
            <span class="w-[2px] h-[60%] bg-[#f0a278] animate-[eq_0.8s_ease-in-out_infinite_alternate]"></span>
            <span class="w-[2px] h-[80%] bg-[var(--accent-purple)] animate-[eq_1.5s_ease-in-out_infinite_alternate]"></span>
          </div>
          <span class="name">+30 MORE REGIONS</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Glassmorphism Pill Style */
  .country-pill {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 8px 16px;
    border-radius: 9999px;
    box-shadow: 
      0 8px 32px 0 rgba(0, 0, 0, 0.2),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.15);
    /* Initial state for GSAP is handled in inline styles or JS to prevent flicker, 
       but we set opacity 0 here just in case */
    opacity: 0; 
    animation: floating-pill 4s ease-in-out infinite;
    animation-play-state: paused; /* Will be unpaused by GSAP when in view */
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    cursor: default;
    z-index: 20;
  }

  /* When hovered, glow and stop floating slightly */
  .country-pill:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--accent-cyan);
    box-shadow: 
      0 0 20px rgba(0, 200, 240, 0.3),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.3);
    z-index: 30;
  }

  .country-pill .flag {
    font-size: 1.25rem;
    line-height: 1;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
  }

  .country-pill .name {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  /* Special Global Pill */
  .special-pill {
    padding: 10px 24px;
    background: linear-gradient(90deg, rgba(0,200,240,0.05), rgba(124,92,252,0.05));
    border-color: rgba(124, 92, 252, 0.3);
  }
  .special-pill .name {
    font-size: 0.75rem;
    background: linear-gradient(to right, #fff, #a1a1aa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Responsive Adjustments for mobile */
  @media (max-width: 768px) {
    .country-pill {
      padding: 6px 10px;
      gap: 6px;
    }
    .country-pill .flag {
      font-size: 1rem;
    }
    .country-pill .name {
      font-size: 0.5rem;
    }
    .special-pill {
      padding: 8px 16px;
    }
    .special-pill .name {
      font-size: 0.65rem;
    }
  }

  /* Floating Animation */
  @keyframes floating-pill {
    0% { transform: translate(-50%, 0px); }
    50% { transform: translate(-50%, -8px); }
    100% { transform: translate(-50%, 0px); }
  }

  @keyframes eq {
    0% { height: 30%; }
    100% { height: 100%; }
  }

  /* Subtle pulsing line */
  @keyframes dash-flow {
    to { stroke-dashoffset: -2; }
  }
  .connection-line {
    animation: dash-flow 2s linear infinite;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pills = document.querySelectorAll('.country-pill');

    if (prefersReduced) {
      gsap.set(pills, { opacity: 1, scale: 1, xPercent: -50, yPercent: -50 });
      pills.forEach(p => { (p as HTMLElement).style.animationPlayState = 'running'; });
      return;
    }

    // Set initial state for entrance animation
    // We use xPercent/yPercent -50 to keep them centered on their left/top coordinates
    gsap.set(pills, { opacity: 0, scale: 0.5, xPercent: -50, yPercent: -50 });

    ScrollTrigger.create({
      trigger: '.country-pill',
      start: 'top 85%',
      once: true,
      onEnter: () => {
        gsap.to(pills, {
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: "back.out(1.5)",
          stagger: 0.1,
          onComplete: () => {
            // Unpause the CSS floating animation after GSAP finishes
            pills.forEach(p => {
              (p as HTMLElement).style.animationPlayState = 'running';
            });
          }
        });
      }
    });
  });
</script>
