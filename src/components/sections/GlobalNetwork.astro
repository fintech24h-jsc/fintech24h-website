---
// src/components/sections/GlobalNetwork.astro
---

<section id="global-network-section" class="py-12 md:py-24 bg-[var(--bg-primary)] relative overflow-hidden" aria-label="Global Network">
  
  <!-- Ambient background glow -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[800px] h-[800px] rounded-full"
      style="background: var(--gradient-glow-purple); top: 50%; left: 50%; transform: translate(-50%, -50%); filter: blur(120px); opacity: 0.1;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="opacity: 0.25;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mb-8 sm:mb-16 animate-fade-up">
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-[var(--text-primary)] mb-4 tracking-tight leading-tight">
        Global Reach.<br class="hidden sm:block" />
        <span class="bg-gradient-to-r from-[var(--accent-cyan)] to-[#f0a278] bg-clip-text text-transparent">Local Impact.</span>
      </h2>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] font-body leading-relaxed max-w-2xl mx-auto">
        Instantly expand your reach & publish content to global audiences, connecting your Web3 project with millions of investors in over 10 countries.
      </p>
    </div>

    <!-- Map Container -->
    <div class="relative w-full max-w-[1400px] aspect-[2/1] mx-auto flex items-center justify-center mt-4 sm:mt-8">
      
      <!-- High-Quality Vector World Map (Background) -->
      <img src="/images/world-map.svg" alt="" width="1400" height="700" class="absolute inset-0 w-full h-full object-contain opacity-[0.15] pointer-events-none drop-shadow-lg" aria-hidden="true" loading="lazy" decoding="async" style="filter: invert(1);" />

      <!-- Connection lines (optional styling to link hubs) -->
      <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-20" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M20,35 Q40,15 50,30 T65,45 T75,55 T85,38" fill="none" stroke="var(--accent-cyan)" stroke-width="0.1" stroke-dasharray="1 1" class="connection-line"/>
      </svg>

      <!-- Pill Container: Absolute positioning based on % of container -->
      <!-- To maintain responsive design, top/left are in percentages -->

      <!-- 1. United States (~39°N 86°W — central-eastern US) -->
      <div class="country-pill" style="top: 28%; left: 26%; animation-delay: 0.2s;">
        <img src="/images/flags/us.svg" alt="USA" width="24" height="24" class="w-6 h-6 rounded-full object-cover shadow-sm" loading="lazy" decoding="async" />
      </div>

      <!-- 2. United Kingdom (London 51.5°N 0°E) -->
      <div class="country-pill" style="top: 19.5%; left: 47.5%; animation-delay: 0.7s;">
        <img src="/images/flags/gb.svg" alt="UK" width="24" height="24" class="w-6 h-6 rounded-full object-cover shadow-sm" loading="lazy" decoding="async" />
      </div>

      <!-- 3. France (Paris 48.9°N 2.35°E) -->
      <div class="country-pill" style="top: 21%; left: 48.5%; animation-delay: 1.1s;">
        <img src="/images/flags/fr.svg" alt="France" width="24" height="24" class="w-6 h-6 rounded-full object-cover shadow-sm" loading="lazy" decoding="async" />
      </div>

      <!-- 4. Turkey (Ankara 39.9°N 32.85°E) -->
      <div class="country-pill" style="top: 27%; left: 57%; animation-delay: 0.5s;">
        <img src="/images/flags/tr.svg" alt="Turkey" width="24" height="24" class="w-6 h-6 rounded-full object-cover shadow-sm" loading="lazy" decoding="async" />
      </div>

      <!-- 5. UAE (Dubai 25.2°N 55.27°E) -->
      <div class="country-pill" style="top: 37%; left: 63%; animation-delay: 1.4s;">
        <img src="/images/flags/ae.svg" alt="UAE" width="24" height="24" class="w-6 h-6 rounded-full object-cover shadow-sm" loading="lazy" decoding="async" />
      </div>

      <!-- 6. India (New Delhi 28.6°N 77.2°E) -->
      <div class="country-pill" style="top: 35%; left: 69%; animation-delay: 0.9s;">
        <img src="/images/flags/in.svg" alt="India" width="24" height="24" class="w-6 h-6 rounded-full object-cover shadow-sm" loading="lazy" decoding="async" />
      </div>

      <!-- 7. Vietnam (Hanoi 21°N 105.85°E) -->
      <div class="country-pill" style="top: 40%; left: 77%; animation-delay: 0.3s;">
        <img src="/images/flags/vn.svg" alt="Vietnam" width="24" height="24" class="w-6 h-6 rounded-full object-cover shadow-sm" loading="lazy" decoding="async" />
      </div>

      <!-- 8. Singapore (1.35°N 103.82°E) -->
      <div class="country-pill" style="top: 53%; left: 76.5%; animation-delay: 1.6s;">
        <img src="/images/flags/sg.svg" alt="Singapore" width="24" height="24" class="w-6 h-6 rounded-full object-cover shadow-sm" loading="lazy" decoding="async" />
      </div>

      <!-- 9. South Korea (Seoul 37.57°N 126.98°E) -->
      <div class="country-pill" style="top: 29%; left: 83%; animation-delay: 1.2s;">
        <img src="/images/flags/kr.svg" alt="South Korea" width="24" height="24" class="w-6 h-6 rounded-full object-cover shadow-sm" loading="lazy" decoding="async" />
      </div>

      <!-- 10. Japan (Tokyo 35.68°N 139.69°E) -->
      <div class="country-pill" style="top: 30%; left: 86.5%; animation-delay: 0.6s;">
        <img src="/images/flags/jp.svg" alt="Japan" width="24" height="24" class="w-6 h-6 rounded-full object-cover shadow-sm" loading="lazy" decoding="async" />
      </div>

      <!-- Special Pill: Global -->
      <div class="country-pill special-pill" style="bottom: 5%; left: 50%; transform: translateX(-50%); animation-delay: 0s;">
        <div class="flex items-center gap-2">
          <!-- Small glowing equalizer icon -->
          <div class="flex items-end gap-[2px] h-3">
            <span class="w-[2px] h-full bg-[var(--accent-cyan)] eq-bar animate-[eq_1.2s_ease-in-out_infinite_alternate]"></span>
            <span class="w-[2px] h-full bg-[#f0a278] eq-bar animate-[eq_0.8s_ease-in-out_infinite_alternate]"></span>
            <span class="w-[2px] h-full bg-[var(--accent-purple)] eq-bar animate-[eq_1.5s_ease-in-out_infinite_alternate]"></span>
          </div>
          <span class="name">+30 MORE REGIONS</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Transparent Flag Style */
  .country-pill {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0;
    border-radius: 50%;
    /* Initial state for GSAP is handled in inline styles or JS to prevent flicker, 
       but we set opacity 0 here just in case */
    opacity: 0; 
    animation: floating-pill 4s ease-in-out infinite;
    animation-play-state: paused; /* Will be unpaused by GSAP when in view */
    transition: transform 0.3s ease;
    cursor: default;
    z-index: 20;
  }

  /* When hovered, slight scale */
  .country-pill:hover {
    transform: scale(1.2) translate(-50%, -50%);
    z-index: 30;
  }

  .country-pill img {
    /* Subtle shadow for the flag */
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
  }



  /* Special Global Pill */
  .special-pill {
    padding: 10px 24px;
    background: linear-gradient(90deg, rgba(0,200,240,0.05), rgba(124,92,252,0.05));
    border-color: rgba(124, 92, 252, 0.3);
  }
  .special-pill .name {
    font-size: 0.75rem;
    background: linear-gradient(to right, #fff, #a1a1aa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (max-width: 768px) {
    .country-pill img {
      width: 1rem;
      height: 1rem;
    }
    .special-pill {
      padding: 8px 16px;
    }
    .special-pill .name {
      font-size: 0.65rem;
    }
  }

  /* Floating Animation */
  @keyframes floating-pill {
    0% { transform: translate(-50%, -50%); }
    50% { transform: translate(-50%, calc(-50% - 8px)); }
    100% { transform: translate(-50%, -50%); }
  }

  /* scaleY replaces height animation — GPU compositor handles this, zero layout recalculate */
  .eq-bar {
    transform-origin: bottom;
  }
  @keyframes eq {
    0%   { transform: scaleY(0.3); }
    100% { transform: scaleY(1); }
  }

  /* Subtle pulsing line */
  @keyframes dash-flow {
    to { stroke-dashoffset: -2; }
  }
  .connection-line {
    animation: dash-flow 2s linear infinite;
  }
</style>

<script>
  // GSAP loaded only when this section enters viewport — not on initial page load
  // back.out(1.5) overshoot spring cannot be replicated in CSS, so we keep GSAP here
  document.addEventListener('DOMContentLoaded', () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pills = document.querySelectorAll('.country-pill');

    if (prefersReduced) {
      pills.forEach(p => {
        const el = p as HTMLElement;
        el.style.opacity = '1';
        el.style.transform = 'translate(-50%, -50%)';
        el.style.animationPlayState = 'running';
      });
      return;
    }

    const section = document.getElementById('global-network-section');
    if (!section) return;

    const observer = new IntersectionObserver(async (entries) => {
      if (!entries.some(e => e.isIntersecting)) return;
      observer.disconnect();

      // Load GSAP only now — user has scrolled here, plenty of time to fetch
      const { gsap } = await import('gsap');

      gsap.set(pills, { opacity: 0, scale: 0.5, xPercent: -50, yPercent: -50 });
      gsap.to(pills, {
        opacity: 1,
        scale: 1,
        duration: 0.8,
        ease: 'back.out(1.5)',
        stagger: 0.1,
        onComplete: () => {
          pills.forEach(p => {
            (p as HTMLElement).style.animationPlayState = 'running';
          });
        },
      });
    }, { threshold: 0.1 });

    observer.observe(section);
  });
</script>
