---
// src/components/sections/FaqSection.astro
// FAQ Section expanded to 15+ SEO-optimized questions in English.
// Reflects global partner network, Vietnam legal entity, and flexible budgets.

const faqs = [
  {
    q: "Does Fintech24h operate in the Vietnamese market?",
    a: "Yes, Vietnam is one of our primary growth hubs. We possess an extensive network of local partners, crypto communities, and localized media relationships, enabling Web3 projects to quickly establish a strong brand footprint in the region."
  },
  {
    q: "Does Fintech24h have offices in the UAE (Dubai) or Europe?",
    a: "Fintech24h is a global agency legally based in Vietnam. We operate globally through a highly integrated network of on-the-ground strategic partners in key Web3 hubs, including the UAE, Singapore, and Europe, rather than maintaining physical branch entities."
  },
  {
    q: "What is Fintech24h's minimum budget requirement?",
    a: "We offer highly flexible engagement models tailored to the specific growth phase of your project. We design customized campaign scopes to match the budget constraints and target OKRs of early-stage startups and enterprise-grade networks alike."
  },
  {
    q: "How do you ensure campaign transparency and ROI?",
    a: "We prioritize verifiable metrics over vanity KPIs. Every campaign is backed by an alignment roadmap, transparent target tracking, and regular analytics dashboards to ensure you see real, on-chain growth."
  },
  {
    q: "How long does it take to see measurable results?",
    a: "Initial media exposure and press coverage typically launch within the first 14 days. Community sentiment shifts and campaign engagement loops show tangible traction within 30–60 days, while search authority and full-funnel conversions compound over 90 days."
  },
  {
    q: "What marketing channels do you specialize in?",
    a: "We optimize the core Web3 user acquisition funnel, focusing on social media management (X/Twitter), community activation platforms (Telegram/Discord), regional public relations, and developer relations."
  },
  {
    q: "What types of Web3 projects do you support?",
    a: "We work across all major Web3 sectors, including Decentralized Finance (DeFi), Layer 1 & Layer 2 protocols, exchanges (CEX/DEX), GameFi/NFT projects, and emerging AI-integrated Web3 solutions."
  },
  {
    q: "Do you accept payments in cryptocurrencies?",
    a: "Yes, as a native Web3 agency, we accept payments in major stablecoins (USDT, USDC) as well as major platform assets (BTC, ETH) to facilitate smooth collaborations."
  },
  {
    q: "How does your partner network benefit projects?",
    a: "Our global network includes prominent venture capitals, major centralized exchange listing teams, key opinion leaders, and regional PR agencies, giving our clients direct fast-track access to critical industry gatekeepers."
  },
  {
    q: "Do you help with exchange listings?",
    a: "Through our B2B business development services, we connect projects directly with listing teams at Tier-1 and Tier-2 centralized exchanges, helping navigate the requirements and streamline the application process."
  },
  {
    q: "How do you verify and select influencers?",
    a: "We audit influencers using engagement-tracking tools to filter out bot traffic and ensure real, organic reach. We select partners based on their audience alignment with your specific project type."
  },
  {
    q: "Can you manage community moderation in multiple time zones?",
    a: "Yes, our moderation network operates 24/7, providing round-the-clock chat management, spam prevention, and active engagement across multiple regional communities."
  },
  {
    q: "Do you support localized campaigns?",
    a: "Yes, we specialize in localized outreach, translating and adapting your message to fit the cultural and investment nuances of specific regions in Asia, the Middle East, and Europe."
  },
  {
    q: "How does Fintech24h differ from traditional agencies?",
    a: "Unlike generic agencies, we have deep native knowledge of Web3 user behavior and tokenomics. We focus strictly on conversion-driven growth and treat your team as our own partners."
  },
  {
    q: "How do we get started with Fintech24h?",
    a: "Simply submit our strategy inquiry form. Our team will review your project details and follow up with a custom 90-day campaign blueprint within 24 hours."
  }
];
---

<section class="py-14 md:py-32 bg-[var(--bg-secondary)] relative overflow-hidden" aria-label="Frequently Asked Questions">
  <!-- Background -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[500px] h-[500px] rounded-full"
      style="background: var(--gradient-glow-purple); top: -10%; right: 0; filter: blur(90px);
             animation: orb-pulse 10s ease-in-out infinite 2s;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="opacity: 0.15;"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Heading -->
    <div class="mb-20" data-animate="fade-up">
      <p class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.15em] mb-4 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]"></span>
        FAQ Engine
      </p>
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <h2 class="font-display text-h2 font-bold text-[var(--text-primary)]">
          Knowledge Base &amp; FAQs
        </h2>
        <p class="text-sm text-[var(--text-secondary)] font-body leading-relaxed">
          Everything you need to know about our Web3 marketing models, flexible pricing packages, regional campaign coverages, and OKR guarantees.
        </p>
      </div>
    </div>

    <!-- Accordion -->
    <div class="space-y-4" data-animate="stagger">
      {faqs.map((faq, i) => (
        <details
          class="card-default p-0 border border-[var(--border-default)] hover:border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] transition-all duration-300 group overflow-hidden"
          data-animate-child
        >
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <span class="flex items-center gap-4">
              <span class="font-mono text-[10px] text-[var(--text-muted)] tracking-widest w-8 shrink-0">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-display font-bold text-sm sm:text-base text-[var(--text-primary)] group-hover:text-[var(--accent-cyan)] transition-colors">
                {faq.q}
              </span>
            </span>
            <div class="w-7 h-7 rounded-lg bg-[var(--surface-soft)] border border-[var(--border-default)] flex items-center justify-center text-[var(--text-muted)] group-hover:text-[var(--accent-cyan)] group-hover:bg-[color-mix(in_srgb,var(--accent-cyan)_10%,transparent)] group-hover:border-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] transition-all shrink-0 ml-4">
              <svg class="w-3.5 h-3.5 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6 text-xs sm:text-sm text-[var(--text-secondary)] font-body leading-relaxed border-t border-[var(--border-subtle)] pt-4 pl-14 sm:pl-18">
            <p class="whitespace-pre-line">{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
