---
// src/components/sections/FaqSection.astro
// Theo design-system.md: eyebrow font-mono, không dùng badge to
// Accordion với transition mượt, không cùng cấu trúc section khác

const faqs = [
  {
    q: "What services does Fintech24h offer?",
    a: "Fintech24h offers 6 core services for blockchain, crypto, DeFi, and AI projects: KOL & Influencer Marketing, PR & Media Coverage, Community Management, Growth & Airdrop Campaigns, B2B Business Development, and Content Strategy & SEO."
  },
  {
    q: "How much does blockchain marketing cost?",
    a: "Our agency works on a monthly retainer structure. Pricing starts at $3,000/month for starter growth packages. Mid-tier packages range from $5,000–$10,000/month, and enterprise-grade launch packages start at $15,000/month. Custom projects can be quoted based on required milestones."
  },
  {
    q: "What markets does Fintech24h cover?",
    a: "We specialize in Tier 1 markets globally, with local teams on the ground in Southeast Asia (Vietnam, Singapore, Indonesia, Thailand) and the Middle East (UAE). We also support global outreach campaigns in Western Europe and North America through specialized publications."
  },
  {
    q: "How long does it take to see results?",
    a: "Public relations coverage (placements on Bloomberg, CoinTelegraph) can begin within the first 14 days. Community growth and active referral loops show results within 30–60 days. SEO strategies typically compounding and show significant organic traction within 90 days."
  }
];
---

<section class="py-24 bg-[var(--bg-secondary)] relative overflow-hidden" aria-label="Frequently Asked Questions">
  <!-- Background -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[400px] h-[400px] rounded-full"
      style="background: var(--gradient-glow-purple); top: -10%; right: 0; filter: blur(72px);
             animation: orb-pulse 10s ease-in-out infinite 2s;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="animation: grid-shimmer 6s ease-in-out infinite; opacity: 0.2;"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Heading — layout khác các section khác: left-aligned thay vì centered -->
    <div class="mb-16" data-animate="fade-up">
      <p class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.12em] mb-4">FAQs</p>
      <div class="grid md:grid-cols-2 gap-8 items-end">
        <h2 class="font-display text-h2 font-bold text-[var(--text-primary)]">
          Common Questions
        </h2>
        <p class="text-base text-[var(--text-secondary)] font-body leading-relaxed">
          Everything you need to know about our Web3 marketing models, pricing packages, and regional campaign coverages.
        </p>
      </div>
    </div>

    <!-- Accordion -->
    <div class="space-y-3" data-animate="stagger">
      {faqs.map((faq, i) => (
        <details
          class="card-default p-0 border border-[var(--border-subtle)] hover:border-[var(--accent-cyan)]/20 transition-all duration-300 group overflow-hidden"
          data-animate-child
        >
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <span class="flex items-center gap-4">
              <span class="font-mono text-[10px] text-[var(--text-muted)] tracking-widest w-6 shrink-0">0{i + 1}</span>
              <span class="font-display font-bold text-base sm:text-lg text-[var(--text-primary)] group-hover:text-[var(--accent-cyan)] transition-colors">
                {faq.q}
              </span>
            </span>
            <div class="w-7 h-7 rounded-lg bg-white/[0.04] border border-white/[0.06] flex items-center justify-center text-[var(--text-muted)] group-hover:text-[var(--accent-cyan)] group-hover:bg-[var(--accent-cyan)]/10 group-hover:border-[var(--accent-cyan)]/20 transition-all shrink-0 ml-4">
              <svg class="w-3.5 h-3.5 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6 text-sm text-[var(--text-secondary)] font-body leading-relaxed border-t border-[var(--border-subtle)] pt-4 pl-16">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
