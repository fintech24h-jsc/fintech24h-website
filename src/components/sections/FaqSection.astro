---
// src/components/sections/FaqSection.astro

const faqs = [
  {
    q: "What services does Fintech24h offer?",
    a: "Fintech24h offers 6 core services for blockchain, crypto, DeFi, and AI projects: KOL & Influencer Marketing, PR & Media Coverage, Community Management, Growth & Airdrop Campaigns, B2B Business Development, and Content Strategy & SEO."
  },
  {
    q: "How much does blockchain marketing cost?",
    a: "Our agency works on a monthly retainer structure. Pricing starts at $3,000/month for starter growth packages. Mid-tier packages range from $5,000–$10,000/month, and enterprise-grade launch packages start at $15,000/month. Custom projects can be quoted based on required milestones."
  },
  {
    q: "What markets does Fintech24h cover?",
    a: "We specialize in Tier 1 markets globally, with local teams on the ground in Southeast Asia (Vietnam, Singapore, Indonesia, Thailand) and the Middle East (UAE). We also support global outreach campaigns in Western Europe and North America through specialized publications."
  },
  {
    q: "How long does it take to see results?",
    a: "Public relations coverage (placements on Bloomberg, CoinTelegraph) can begin within the first 14 days. Community growth and active referral loops show results within 30–60 days. SEO strategies typically compound and show significant organic traction within 90 days."
  }
];
---

<section class="py-24 bg-[#0a0f1e]/40 relative overflow-hidden" aria-label="Frequently Asked Questions">
  <!-- Glowing background lines -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="bg-orb bg-orb-purple w-[400px] h-[400px] absolute -top-10 right-0 opacity-10"></div>
    <div class="grid-pattern absolute inset-0 opacity-20"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-400/30 bg-cyan-400/5 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
        <span class="text-xs font-semibold text-cyan-400 font-body uppercase tracking-wider">FAQs</span>
      </div>
      <h2 class="font-display text-h2 font-bold text-[#f0f4ff] mb-4">
        Common Questions
      </h2>
      <p class="text-base text-[#94a3b8] font-body leading-relaxed">
        Everything you need to know about our Web3 marketing models, pricing packages, and regional campaign coverages.
      </p>
    </div>

    <!-- Accordion lists -->
    <div class="space-y-4" data-animate="stagger">
      {faqs.map((faq, i) => (
        <details 
          class="glass-card rounded-2xl border border-white/5 hover:border-cyan-400/30 transition-all duration-300 group overflow-hidden"
          data-animate-child
        >
          <summary class="flex items-center justify-between p-6 cursor-pointer font-display font-semibold text-[#f0f4ff] hover:text-cyan-400 transition-colors list-none">
            <span class="text-base sm:text-lg pr-4">{faq.q}</span>
            <div class="w-6 h-6 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-[#94a3b8] group-hover:text-cyan-400 group-hover:bg-cyan-400/10 transition-colors shrink-0">
              <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </summary>
          <div class="px-6 pb-6 text-sm sm:text-base text-[#94a3b8] font-body leading-relaxed border-t border-white/5 pt-4 bg-[#050810]/30">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  /* Remove default browser details marker */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
