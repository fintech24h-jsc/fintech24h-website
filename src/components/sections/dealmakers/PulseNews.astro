---
// src/components/sections/dealmakers/PulseNews.astro
// Latest posts from the WordPress "Dealmakers Pulse" category (partner
// announcements, season news), shown at the end of the Season 3 landing as
// proof that the program is live and covered. Up to 9 compact cards, 3 per row.
//
// The page is prerendered, so the cards baked in here are the posts that existed
// at deploy time (one shared, retried fetch for en/ar/zh; if WordPress fails the
// build uses pulse-fallback.ts). On load, the script below asks
// /dealmakers/pulse.json for the current list and redraws the cards when it
// differs, so a post published after the last deploy still shows up.
import type { DealmakersLocale } from '../../../data/dealmakers/content';
import { pulseFallback, type PulseCard } from '../../../data/dealmakers/pulse-fallback';
import { getPulseCards, PULSE_SLUG, PULSE_COUNT } from '../../../lib/dealmakersPulse';

interface Props {
  locale?: DealmakersLocale;
}
const { locale = 'en' } = Astro.props;

const g = globalThis as { __dmPulseCards?: Promise<PulseCard[]> };
g.__dmPulseCards ??= getPulseCards(PULSE_COUNT, 3).then((c) => {
  if (c.length > 0) return c;
  console.warn('PulseNews: WordPress returned no Dealmakers Pulse posts, using pulse-fallback.ts');
  return pulseFallback.slice(0, PULSE_COUNT);
});
const cards = await g.__dmPulseCards;

const copy = locale === 'ar' ? {
  ariaLabel: 'DealMakers Pulse',
  eyebrow: 'Season 3 · آخر الأخبار',
  titleA: 'DealMakers',
  titleB: 'Pulse',
  lede: 'إعلانات الشراكات وأخبار الموسم كما نُشرت على Fintech24h.',
  viewAll: 'عرض جميع مقالات DealMakers Pulse',
  dateLocale: 'ar-EG-u-nu-latn',
} : locale === 'zh' ? {
  ariaLabel: 'DealMakers Pulse',
  eyebrow: 'Season 3 · 最新动态',
  titleA: 'DealMakers',
  titleB: 'Pulse',
  lede: '合作伙伴公告与赛季新闻，均已发布于 Fintech24h。',
  viewAll: '查看全部 DealMakers Pulse 文章',
  dateLocale: 'zh-CN',
} : {
  ariaLabel: 'DealMakers Pulse',
  eyebrow: 'Season 3 · Latest news',
  titleA: 'DealMakers',
  titleB: 'Pulse',
  lede: 'Partner announcements and season news, as published on Fintech24h.',
  viewAll: 'View all DealMakers Pulse articles',
  dateLocale: 'en-US',
};

const fmtDate = (d: string) => new Date(d).toLocaleDateString(copy.dateLocale, { year: 'numeric', month: 'short', day: 'numeric' });
---

{cards.length > 0 && (
  <section id="pulse" class="relative py-20 lg:py-28" aria-label={copy.ariaLabel} data-dm-pulse data-date-locale={copy.dateLocale}>
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[var(--dm-border-accent)] to-transparent" aria-hidden="true"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10" data-dm-reveal>
        <p class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--dm-border-accent)] bg-[rgba(217,178,106,0.06)] font-mono text-[11px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--dm-emerald)]" aria-hidden="true"></span>{copy.eyebrow}
        </p>
        <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-3" dir="ltr">
          {copy.titleA}{' '}<span class="dm-text-gradient">{copy.titleB}</span>
        </h2>
        <p class="text-sm sm:text-base text-[var(--dm-text-secondary)] max-w-xl mx-auto">{copy.lede}</p>
      </div>

      <ul class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4" data-dm-pulse-list>
        {cards.map((c) => (
          <li data-dm-pulse-item data-slug={c.slug}>
            <a
              href={`/blog/${c.slug}`}
              class="group flex flex-col h-full rounded-2xl overflow-hidden border border-[var(--dm-border)] bg-[var(--dm-bg-secondary)] transition-all duration-300 ease-out hover:border-[var(--dm-border-accent)] hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--dm-gold)]"
            >
              <span class="block aspect-[768/552] overflow-hidden bg-[var(--dm-bg-tertiary)] border-b border-[var(--dm-border)]">
                <img
                  src={c.img}
                  alt={c.alt}
                  width="768"
                  height="552"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
                />
              </span>
              <span class="flex flex-col flex-1 gap-1.5 p-3 sm:p-4" dir="ltr">
                <time datetime={c.date} dir="auto" class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--dm-gold)]">{fmtDate(c.date)}</time>
                <span class="font-display font-semibold text-sm sm:text-[15px] leading-snug text-[var(--dm-text-primary)] line-clamp-3 group-hover:text-[var(--dm-gold-bright)] transition-colors duration-200">{c.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="text-center mt-8">
        <a href={`/blog/category/${PULSE_SLUG}`} class="text-sm text-[var(--dm-text-secondary)] hover:text-[var(--dm-gold)] underline underline-offset-4 decoration-[var(--dm-border-hover)] transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--dm-gold)]">
          {copy.viewAll} →
        </a>
      </p>
    </div>
  </section>
)}

<script>
  // Refresh the baked-in cards with the live list (see the header comment).
  // The first card is the template for any card this adds.
  type Card = { slug: string; title: string; date: string; img: string; alt: string };

  const section = document.querySelector<HTMLElement>('[data-dm-pulse]');
  const list = section?.querySelector<HTMLUListElement>('[data-dm-pulse-list]');
  const template = list?.querySelector<HTMLLIElement>('[data-dm-pulse-item]');

  if (section && list && template) {
    const dateLocale = section.dataset.dateLocale || 'en-US';
    const shown = [...list.querySelectorAll<HTMLLIElement>('[data-dm-pulse-item]')].map((li) => li.dataset.slug).join('|');

    fetch('/dealmakers/pulse.json', { headers: { Accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((data: { cards?: Card[] } | null) => {
        const cards = data?.cards;
        if (!cards || cards.length === 0) return;
        if (cards.map((c) => c.slug).join('|') === shown) return;

        const items = cards.map((c) => {
          const li = template.cloneNode(true) as HTMLLIElement;
          li.dataset.slug = c.slug;
          li.querySelector('a')!.setAttribute('href', `/blog/${c.slug}`);
          const img = li.querySelector('img')!;
          img.src = c.img;
          img.alt = c.alt;
          const time = li.querySelector('time')!;
          time.dateTime = c.date;
          time.textContent = new Date(c.date).toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' });
          li.querySelector('.font-display')!.textContent = c.title;
          return li;
        });
        list.replaceChildren(...items);
      })
      .catch(() => { /* keep the baked-in cards */ });
  }
</script>
