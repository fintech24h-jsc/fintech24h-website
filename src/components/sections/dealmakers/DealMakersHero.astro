---
// src/components/sections/dealmakers/DealMakersHero.astro
// Hero + current-season partners. Capital Partner is NOT a peer of the
// other three — it's the lead sponsor funding the most, so it gets its own
// full-width spotlight band with an animated gradient border. The other
// three partners sit in a secondary row beneath, visibly smaller. Any
// partner without `confirmed: true` renders as a neutral "Confirming
// soon" slot — never a fake logo.
import { heroPartners } from '../../../data/dealmakers/ss3';

const capital = heroPartners.find((p) => p.category === 'capital')!;
const others = heroPartners.filter((p) => p.category !== 'capital');
---

<section class="relative overflow-hidden pt-28 pb-20 lg:pt-36 lg:pb-28" aria-label="DealMakers Hero">
  <!-- Ambient background: mesh gradient + 2 drifting orbs (gold + emerald) -->
  <div class="absolute inset-0" style="background: var(--dm-gradient-hero-bg);" aria-hidden="true"></div>
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[560px] h-[560px] rounded-full opacity-40 mix-blend-screen dm-orb-gold"
      style="top: -12%; left: -6%; filter: blur(90px); animation: orb-drift 14s ease-in-out infinite, orb-pulse 9s ease-in-out infinite;"></div>
    <div class="absolute w-[480px] h-[480px] rounded-full opacity-40 mix-blend-screen dm-orb-emerald"
      style="bottom: -8%; right: -8%; filter: blur(90px); animation: orb-drift 17s ease-in-out infinite 3s, orb-pulse 11s ease-in-out infinite 2s;"></div>
    <div class="absolute inset-0 dm-grid-pattern" style="opacity: 0.25;"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center gap-5 max-w-3xl mx-auto">
      <p class="font-mono text-[10px] lg:text-xs text-[var(--dm-gold)] uppercase tracking-[0.18em] flex items-center gap-2" data-dm-reveal>
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--dm-gold)] animate-pulse"></span>
        Fintech24h presents · Season 3
      </p>

      <h1 class="font-display font-semibold leading-[1.1] text-[clamp(2.4rem,6vw,4.2rem)] tracking-[-0.01em]" data-dm-reveal>
        Where decision-makers
        <span class="block dm-text-gradient">meet to make deals.</span>
      </h1>

      <p class="text-sm sm:text-base text-[var(--dm-text-secondary)] font-body leading-relaxed max-w-2xl" data-dm-reveal>
        DealMakers’ Club: F-Matching is a curated network for Founders, Investors, Exchanges, and Web3 builders. More than networking: it’s where <strong class="text-[var(--dm-text-primary)] font-semibold">verified decision-makers</strong>, <strong class="text-[var(--dm-text-primary)] font-semibold">qualified deal flow</strong>, and <strong class="text-[var(--dm-text-primary)] font-semibold">strategic introductions</strong> are seen, verified, and connected to the right people.
      </p>

      <div class="flex flex-wrap gap-4 justify-center mt-4" data-dm-reveal>
        <a href="#apply" class="dm-btn-primary py-3 px-6 text-xs" aria-label="Become a DealMaker">
          <span>Become a DealMaker</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="inline ml-1"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#featured" class="dm-btn-ghost py-3 px-6 text-xs" aria-label="Explore Featured DealMakers">
          <span>Explore Featured DealMakers</span>
        </a>
      </div>

      <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center mt-2 text-[var(--dm-text-muted)] text-xs font-body" data-dm-reveal>
        <span class="flex items-center gap-2"><i class="w-1.5 h-1.5 rounded-full bg-[var(--dm-gold)]"></i>Verified members</span>
        <span class="flex items-center gap-2"><i class="w-1.5 h-1.5 rounded-full bg-[var(--dm-gold)]"></i>Moderated introductions</span>
        <span class="flex items-center gap-2"><i class="w-1.5 h-1.5 rounded-full bg-[var(--dm-gold)]"></i>Real opportunities, prioritized</span>
      </div>
    </div>

    <!-- Capital Partner — lead sponsor spotlight, its own tier. This slot is
    reserved exclusively for the Capital Partner's own logo; Fintech24h's
    brand already appears in the header and footer and does not belong here. -->
    <div class="mt-16 lg:mt-20 max-w-3xl mx-auto" data-dm-reveal>
      <p class="text-center font-mono text-[10px] text-[var(--dm-text-muted)] uppercase tracking-[0.15em] mb-4">
        Official Capital Partner · Season 3
      </p>
      <div class="dm-spotlight">
        <div class="dm-spotlight-inner px-8 py-10 flex flex-col items-center justify-center gap-5 min-h-[160px]">
          <span class="dm-badge-sponsored">Lead Sponsor</span>
          <div class="flex items-center justify-center w-full">
            {capital.confirmed && capital.logoUrl ? (
              <img src={capital.logoUrl} alt={`${capital.name} logo, Official Capital Partner of F-Matching Season 3`} class="h-14 sm:h-16 w-auto object-contain" loading="eager" />
            ) : (
              <span class="font-display font-semibold text-lg sm:text-xl text-[var(--dm-text-secondary)]">Confirming soon</span>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Secondary partners — smaller, clearly a lower tier -->
    <div class="mt-6 max-w-3xl mx-auto">
      <div class="grid grid-cols-3 gap-3">
        {others.map((p) => (
          <div class="dm-card rounded-xl p-3.5 flex flex-col items-center justify-center gap-1.5 min-h-[84px]" data-dm-reveal>
            <span class="font-mono text-[7px] text-[var(--dm-text-muted)] uppercase tracking-[0.1em] text-center leading-tight">{p.label}</span>
            {p.confirmed && p.logoUrl ? (
              <img src={p.logoUrl} alt={`${p.name} logo, ${p.label} of F-Matching Season 3`} class="h-5 w-auto object-contain" loading="lazy" />
            ) : (
              <span class="font-body text-[11px] text-[var(--dm-text-muted)]">Confirming soon</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
