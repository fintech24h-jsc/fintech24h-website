---
// src/components/sections/dealmakers/LastSeasonPartners.astro
// "Featured Partners from Last Season" — 8 logo slots. Only entries with
// confirmed:true + an actual logoUrl render a real logo; everything else
// (including confirmed-name-but-no-asset rows) renders a neutral wordmark
// placeholder so we never fabricate a logo file we don't have.
import { lastSeasonPartners } from '../../../data/dealmakers/ss3';
---

<section class="relative py-20 lg:py-24 border-y border-[var(--dm-border)]" aria-label="Featured partners from last season">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div data-dm-reveal>
      <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">A growing ecosystem</p>
      <h2 class="font-display font-semibold text-h3 text-[var(--dm-text-primary)] mb-10">Featured Partners from Last Season</h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-4xl mx-auto">
      {lastSeasonPartners.map((p, i) => (
        <div class="group flex items-center justify-center min-h-[108px] px-5 rounded-xl border border-[var(--dm-border)] bg-[var(--dm-bg-glass)] transition-all duration-300 hover:border-[var(--dm-border-accent)] hover:bg-white/[0.04] hover:-translate-y-1" data-dm-reveal style={`--dm-reveal-delay: ${i * 50}`}>
          {p.logoUrl ? (
            <img
              src={p.logoUrl}
              alt={`${p.name} logo, Featured Partner from last season of DealMakers' Club`}
              class="h-11 sm:h-14 w-auto max-w-full object-contain opacity-70 group-hover:opacity-100 transition-opacity duration-300"
              loading="lazy"
            />
          ) : p.name ? (
            <span class="font-display font-semibold text-sm tracking-tight text-[var(--dm-text-secondary)] group-hover:text-[var(--dm-gold-bright)] transition-colors">
              {p.name}
            </span>
          ) : (
            <span class="font-mono text-[10px] uppercase tracking-widest text-[var(--dm-text-muted)]">Your logo</span>
          )}
        </div>
      ))}
    </div>
    <p class="text-xs text-[var(--dm-text-muted)] max-w-lg mx-auto mt-6">
      With heartfelt thanks to the partners who stood beside us last season, every partnership here is one we deeply value.
    </p>
  </div>
</section>
