---
// src/components/sections/dealmakers/LastSeasonPartners.astro
// "Featured Partners from Last Season" — 8 logo slots. Only entries with
// confirmed:true + an actual logoUrl render a real logo; everything else
// (including confirmed-name-but-no-asset rows) renders a neutral wordmark
// placeholder so we never fabricate a logo file we don't have.
import { getSS3Content, type DealmakersLocale } from '../../../data/dealmakers/content';

interface Props {
  locale?: DealmakersLocale;
}
const { locale = 'en' } = Astro.props;
const { lastSeasonPartners } = getSS3Content(locale);

const copy = locale === 'ar' ? {
  ariaLabel: 'شركاء رأس المال والاستثمار البارزون - الموسم الثاني',
  eyebrow: 'شبكة رأس المال',
  heading: 'شركاء رأس المال والاستثمار البارزون - الموسم الثاني',
  yourLogo: 'شعارك هنا',
  thanks: 'بخالص الشكر لشركاء رأس المال الذين وقفوا إلى جانبنا في الموسم الثاني، فكل شراكة هنا نعتز بها بصدق.',
} : locale === 'zh' ? {
  ariaLabel: '第二季精选资本合作伙伴',
  eyebrow: '资本网络',
  heading: '第二季精选资本合作伙伴',
  yourLogo: '你的品牌标识',
  thanks: '衷心感谢第二季与我们并肩同行的资本合作伙伴，这里的每一段合作我们都珍视。',
} : {
  ariaLabel: 'Featured Capital & Ventures Partners — SS2',
  eyebrow: 'Capital network',
  heading: 'Featured Capital & Ventures Partners — SS2',
  yourLogo: 'Your logo',
  thanks: 'With heartfelt thanks to the capital partners who stood beside us in Season 2, every partnership here is one we deeply value.',
};
---

<section class="relative py-20 lg:py-24 border-y border-[var(--dm-border)]" aria-label={copy.ariaLabel}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div data-dm-reveal>
      <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">{copy.eyebrow}</p>
      <h2 class="font-display font-semibold text-h3 text-[var(--dm-text-primary)] mb-10">{copy.heading}</h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-4xl mx-auto">
      {lastSeasonPartners.map((p, i) => {
        const Tag = p.logoUrl && p.websiteUrl ? 'a' : 'div';
        const linkProps = p.logoUrl && p.websiteUrl
          ? { href: p.websiteUrl, target: '_blank', rel: 'noopener noreferrer' }
          : {};
        return (
          <Tag
            {...linkProps}
            class="group flex items-center justify-center min-h-[108px] px-5 rounded-xl border border-[var(--dm-border)] bg-[var(--dm-bg-glass)] transition-all duration-300 hover:border-[var(--dm-border-accent)] hover:bg-white/[0.04] hover:-translate-y-1"
            data-dm-reveal
            style={`--dm-reveal-delay: ${i * 50}`}
          >
            {p.logoUrl ? (
              <img
                src={p.logoUrl}
                alt={`${p.name} logo, Capital partner of DealMakers' Club`}
                class="h-16 sm:h-20 w-auto max-w-[85%] object-contain opacity-70 group-hover:opacity-100 transition-opacity duration-300"
                loading="lazy"
              />
            ) : p.name ? (
              <span class="font-display font-semibold text-sm tracking-tight text-[var(--dm-text-secondary)] group-hover:text-[var(--dm-gold-bright)] transition-colors">
                {p.name}
              </span>
            ) : (
              <span class="font-mono text-[10px] uppercase tracking-widest text-[var(--dm-text-muted)]">{copy.yourLogo}</span>
            )}
          </Tag>
        );
      })}
    </div>
    <p class="text-xs text-[var(--dm-text-muted)] max-w-lg mx-auto mt-6">
      {copy.thanks}
    </p>
  </div>
</section>
