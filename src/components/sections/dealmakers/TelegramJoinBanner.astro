---
// src/components/sections/dealmakers/TelegramJoinBanner.astro
// Slim callout pointing to the standalone /join/ page, not a modal here,
// so the destination stays a single shareable URL the team can send
// directly to a prospect for vetting.
import { telegramGroupName } from '../../../data/dealmakers/ss3';
---

<section class="relative py-4" aria-label="Join the Telegram community">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <a
      href="/dealmakers/ss3/join/"
      data-dm-track="telegram_banner_cta"
      class="dm-card dm-sweep-trigger group relative flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl px-6 py-5 overflow-hidden"
      data-dm-reveal
    >
      <div class="flex items-center gap-4">
        <span class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: var(--dm-gradient-primary);">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="#0a0908"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.1.02-1.62 1.03-4.57 3.02-.43.3-.82.45-1.17.44-.39-.01-1.15-.22-1.71-.41-.69-.23-1.24-.35-1.19-.74.03-.2.3-.41.82-.62 3.2-1.39 5.34-2.31 6.42-2.76 3.05-1.28 3.68-1.5 4.1-.11.02.04.05.09.05.14z"/></svg>
        </span>
        <div>
          <p class="font-display font-semibold text-sm text-[var(--dm-text-primary)]">Join {telegramGroupName} on Telegram</p>
          <p class="text-xs text-[var(--dm-text-secondary)]">A vetted community for verified members only. Requests are reviewed before approval.</p>
        </div>
      </div>
      <span class="dm-btn-ghost py-2 px-4 text-[10px] shrink-0">
        Request to Join
        <svg class="w-3 h-3 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
      <div class="dm-sweep pointer-events-none absolute inset-0" aria-hidden="true"></div>
    </a>
  </div>
</section>
