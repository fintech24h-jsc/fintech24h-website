---
// src/components/sections/dealmakers/MediaPartners.astro
import { mediaPartners, partnerTracks } from '../../../data/dealmakers/ss3';

const mediaTrack = partnerTracks.find((t) => t.id === 'media')!;
---

<section class="relative py-20 lg:py-24 bg-[var(--dm-bg-secondary)]" aria-label="Media Partners">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div data-dm-reveal>
      <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">Media Partners · Community support</p>
      <h2 class="font-display font-semibold text-h3 text-[var(--dm-text-primary)] mb-4">
        Amplified by media partners across the ecosystem.
      </h2>
      <p class="text-sm text-[var(--dm-text-secondary)] max-w-xl mx-auto mb-6">
        We're proud to work alongside respected voices in Web3 and fintech media, whose coverage helps bring F-Matching Season 3 to a wider audience.
      </p>

      <ul class="flex flex-wrap items-center justify-center gap-2 max-w-2xl mx-auto mb-10">
        {mediaTrack.benefits.map((b) => (
          <li class="dm-tag dm-tag-gray text-[10px] py-1 px-2.5">{b}</li>
        ))}
      </ul>
    </div>

    <div class="grid grid-cols-3 sm:grid-cols-6 gap-3 max-w-3xl mx-auto mb-10">
      {mediaPartners.map((p, i) => {
        const Tag = p.confirmed && p.websiteUrl ? 'a' : 'div';
        const linkProps = p.confirmed && p.websiteUrl
          ? { href: p.websiteUrl, target: '_blank', rel: 'noopener noreferrer', 'aria-label': p.name ?? 'Media partner' }
          : {};
        return (
          <Tag
            {...linkProps}
            class="flex items-center justify-center min-h-[68px] p-1.5 rounded-xl border border-[var(--dm-border)] bg-white/[0.015] hover:border-[var(--dm-border-accent)] hover:bg-white/[0.03] hover:-translate-y-1 transition-all duration-300"
            data-dm-reveal
            style={`--dm-reveal-delay: ${i * 50}`}
          >
            {p.confirmed && p.logoUrl ? (
              <img
                src={p.logoUrl}
                alt={p.name ?? 'Media partner'}
                class="h-12 sm:h-14 w-auto max-w-[92%] object-contain opacity-90 hover:opacity-100 transition-all duration-300"
                loading="lazy"
              />
            ) : (
              <span class="font-mono text-[9px] uppercase tracking-widest text-[var(--dm-text-muted)]">
                {p.name ?? 'Your logo'}
              </span>
            )}
          </Tag>
        );
      })}
    </div>

    <a href="#apply" data-dm-prefill-interest="Media Partner" data-dm-track="media_partner_cta" class="dm-btn-ghost py-2.5 px-6 text-[10px]">
      Become a Media Partner
    </a>
    <p class="mt-4">
      <a href="/dealmakers/ss3/partner-benefits/" class="text-xs text-[var(--dm-text-muted)] hover:text-[var(--dm-gold)] transition-colors underline underline-offset-4 decoration-[var(--dm-border)]">
        See the full Media Partner benefit list →
      </a>
    </p>
  </div>
</section>
