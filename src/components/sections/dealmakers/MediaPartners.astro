---
// src/components/sections/dealmakers/MediaPartners.astro
import { getSS3Content, type DealmakersLocale } from '../../../data/dealmakers/content';

interface Props {
  locale?: DealmakersLocale;
}
const { locale = 'en' } = Astro.props;
const { mediaPartners, partnerTracks } = getSS3Content(locale);
const localePrefix = (path: string) => (locale === 'en' ? path : path.replace(/^\/dealmakers\//, `/dealmakers/${locale}/`));
const benefitsHref = localePrefix('/dealmakers/ss3/partner-benefits/');

const mediaTrack = partnerTracks.find((t) => t.id === 'media')!;

const copy = locale === 'ar' ? {
  ariaLabel: 'الشركاء الإعلاميون',
  eyebrow: 'الشركاء الإعلاميون · دعم المجتمع',
  h2: 'تضخيم الصدى عبر شركاء إعلاميين في المنظومة بأكملها.',
  lede: 'نفخر بالعمل إلى جانب أصوات موثوقة في إعلام Web3 والتكنولوجيا المالية، تساعد تغطيتها في إيصال F-Matching Season 3 إلى جمهور أوسع.',
  mediaPartnerFallback: 'شريك إعلامي',
  yourLogo: 'شعارك هنا',
  becomeMediaPartner: 'كن شريكًا إعلاميًا',
  seeFullList: 'عرض القائمة الكاملة لمزايا الشريك الإعلامي',
  interest: 'الشريك الإعلامي',
} : locale === 'zh' ? {
  ariaLabel: '媒体合作伙伴',
  eyebrow: '媒体合作伙伴 · 社区支持',
  h2: '来自整个生态系统媒体合作伙伴的放大传播。',
  lede: '我们很荣幸能与 Web3 与金融科技媒体领域备受信赖的声音合作，他们的报道帮助 F-Matching Season 3 触达更广泛的受众。',
  mediaPartnerFallback: '媒体合作伙伴',
  yourLogo: '你的品牌标识',
  becomeMediaPartner: '成为媒体合作伙伴',
  seeFullList: '查看媒体合作伙伴完整权益列表',
  interest: '媒体合作伙伴',
} : {
  ariaLabel: 'Media Partners',
  eyebrow: 'Media Partners · Community support',
  h2: 'Amplified by media partners across the ecosystem.',
  lede: 'We’re proud to work alongside respected voices in Web3 and fintech media, whose coverage helps bring F-Matching Season 3 to a wider audience.',
  mediaPartnerFallback: 'Media partner',
  yourLogo: 'Your logo',
  becomeMediaPartner: 'Become a Media Partner',
  seeFullList: 'See the full Media Partner benefit list',
  interest: 'Media Partner',
};
---

<section class="relative py-20 lg:py-24 bg-[var(--dm-bg-secondary)]" aria-label={copy.ariaLabel}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div data-dm-reveal>
      <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">{copy.eyebrow}</p>
      <h2 class="font-display font-semibold text-h3 text-[var(--dm-text-primary)] mb-4">
        {copy.h2}
      </h2>
      <p class="text-sm text-[var(--dm-text-secondary)] max-w-xl mx-auto mb-6">
        {copy.lede}
      </p>

      <ul class="flex flex-wrap items-center justify-center gap-2 max-w-2xl mx-auto mb-10">
        {mediaTrack.benefits.map((b) => (
          <li class="dm-tag dm-tag-gray text-[10px] py-1 px-2.5">{b}</li>
        ))}
      </ul>
    </div>

    <div class="grid grid-cols-3 sm:grid-cols-6 gap-3 max-w-3xl mx-auto mb-10">
      {mediaPartners.map((p, i) => {
        const Tag = p.confirmed && p.websiteUrl ? 'a' : 'div';
        const linkProps = p.confirmed && p.websiteUrl
          ? { href: p.websiteUrl, target: '_blank', rel: 'noopener noreferrer', 'aria-label': p.name ?? copy.mediaPartnerFallback }
          : {};
        return (
          <Tag
            {...linkProps}
            class="flex items-center justify-center min-h-[68px] p-1.5 rounded-xl border border-[var(--dm-border)] bg-white/[0.015] hover:border-[var(--dm-border-accent)] hover:bg-white/[0.03] hover:-translate-y-1 transition-all duration-300"
            data-dm-reveal
            style={`--dm-reveal-delay: ${i * 50}`}
          >
            {p.confirmed && p.logoUrl ? (
              <img
                src={p.logoUrl}
                alt={p.name ?? copy.mediaPartnerFallback}
                class="h-12 sm:h-14 w-auto max-w-[92%] object-contain opacity-90 hover:opacity-100 transition-all duration-300"
                loading="lazy"
              />
            ) : (
              <span class="font-mono text-[9px] uppercase tracking-widest text-[var(--dm-text-muted)]">
                {p.name ?? copy.yourLogo}
              </span>
            )}
          </Tag>
        );
      })}
    </div>

    <a href="#apply" data-dm-prefill-interest={copy.interest} data-dm-track="media_partner_cta" class="dm-btn-ghost py-2.5 px-6 text-[10px]">
      {copy.becomeMediaPartner}
    </a>
    <p class="mt-4">
      <a href={benefitsHref} class="text-xs text-[var(--dm-text-muted)] hover:text-[var(--dm-gold)] transition-colors underline underline-offset-4 decoration-[var(--dm-border)]">
        {copy.seeFullList} <span>→</span>
      </a>
    </p>
  </div>
</section>
