---
// src/components/sections/dealmakers/FeaturedDealMakers.astro
// Featured DealMaker cards. `illustrative: true` profiles are fictional
// placeholders (Season 3 has not onboarded real Featured DealMakers yet) —
// each card carries a small "Preview" tag so nobody mistakes them for real
// applicants. Hover reveals a specular sweep + subtle pointer-tilt.
import { featuredDealMakers } from '../../../data/dealmakers/ss3';
---

<section id="featured" class="relative py-20 lg:py-28" aria-label="Featured DealMakers">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-12" data-dm-reveal>
      <div>
        <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">Featured DealMakers</p>
        <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] max-w-xl">
          State who you are. <span class="dm-text-gradient">So the right people find you.</span>
        </h2>
      </div>
      <a href="#packages" class="dm-btn-ghost py-2.5 px-5 text-[10px] self-start shrink-0">
        View the $1,000 Featured Package →
      </a>
    </div>

    <p class="text-sm text-[var(--dm-text-secondary)] max-w-2xl mb-10">
      Every company featured here has been reviewed and verified, representing some of the most credible names building in Web3 and fintech today.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {featuredDealMakers.map((dm, i) => (
        <article class="dm-card dm-sweep-trigger group relative rounded-[20px] overflow-hidden" data-dm-tilt data-dm-reveal style={`--dm-reveal-delay: ${i * 80}`}>
          {dm.illustrative && (
            <span class="absolute top-3 left-3 z-20 px-2 py-1 rounded-full bg-[rgba(9,8,10,0.8)] border border-[var(--dm-border)] text-[9px] font-mono uppercase tracking-wider text-[var(--dm-text-muted)]">
              Preview
            </span>
          )}

          <!-- Video poster area -->
          <div class={`relative h-44 flex items-end p-4 overflow-hidden bg-gradient-to-br ${dm.posterGradient}`}>
            <div class="absolute inset-0 opacity-70" style="background: radial-gradient(circle at 18% 10%, rgba(212,175,106,0.3), transparent 34%), radial-gradient(circle at 78% 76%, rgba(47,158,110,0.32), transparent 39%);" aria-hidden="true"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-16 h-16 rounded-full border-2 border-white/40 bg-white/10 flex items-center justify-center text-white font-display font-semibold text-lg backdrop-blur-sm">
                {dm.companyInitials}
              </div>
            </div>
            <span class="absolute right-3 bottom-3 px-2 py-1 rounded-md bg-[rgba(10,9,8,0.75)] text-[10px] font-mono font-semibold text-white/80">
              02:00 max
            </span>
          </div>

          <div class="p-5">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-9 h-9 rounded-lg bg-[var(--dm-bg-tertiary)] border border-[var(--dm-border)] flex items-center justify-center font-mono text-[10px] font-bold text-[var(--dm-gold)] shrink-0">
                {dm.companyInitials}
              </span>
              <div class="min-w-0">
                <p class="font-display font-semibold text-sm text-[var(--dm-text-primary)] truncate">{dm.name}</p>
                <p class="text-xs text-[var(--dm-text-muted)] truncate">{dm.role} · {dm.company}</p>
              </div>
            </div>

            <div class="flex flex-wrap gap-1.5 mb-5">
              {dm.offerTags.map((t) => <span class="dm-tag dm-tag-gold text-[10px] py-0.5 px-2">Offer: {t}</span>)}
              {dm.needTags.map((t) => <span class="dm-tag dm-tag-emerald text-[10px] py-0.5 px-2">Need: {t}</span>)}
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-[var(--dm-border)] text-[11px]">
              <span class="text-[var(--dm-text-muted)] font-body">Verified profile</span>
              <a href="#apply" data-dm-intro={`${dm.name} at ${dm.company}`} class="font-display font-semibold text-[var(--dm-gold)] hover:text-[var(--dm-text-primary)] transition-colors flex items-center gap-1">
                Request Introduction
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>

          <!-- Specular sweep on hover -->
          <div class="dm-sweep pointer-events-none absolute inset-0" aria-hidden="true"></div>
        </article>
      ))}
    </div>

    <p class="text-center mt-10">
      <a href="#apply" class="inline-flex items-center gap-2 text-[var(--dm-gold)] hover:text-[var(--dm-text-primary)] font-display font-semibold text-sm transition-colors">
        Want to appear here? Apply as a Featured DealMaker →
      </a>
    </p>
  </div>
</section>

<style>
  [data-dm-tilt] {
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  [data-dm-tilt]:hover {
    border-color: rgba(217,178,106,0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-dm-tilt] { transition: none !important; }
  }
</style>

<script is:inline>
  // Subtle pointer-tilt on Featured DealMaker cards — desktop hover only, no dependency.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(hover: none)').matches) return;

    document.querySelectorAll('[data-dm-tilt]').forEach((card) => {
      const maxTilt = 4;
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(800px) rotateX(${(-py * maxTilt).toFixed(2)}deg) rotateY(${(px * maxTilt).toFixed(2)}deg) translateY(-2px)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg)';
      });
    });
  })();
</script>
