---
// src/components/sections/dealmakers/PricingPackages.astro
import { getSS3Content, type DealmakersLocale } from '../../../data/dealmakers/content';

interface Props {
  locale?: DealmakersLocale;
}
const { locale = 'en' } = Astro.props;
const { pricingPackages } = getSS3Content(locale);

const copy = locale === 'ar' ? {
  ariaLabel: 'الباقات',
  eyebrow: 'باقات الإيرادات الأساسية',
  h2a: 'باقات أقل.',
  h2b: 'قيمة أوضح.',
  lede: 'يركّز Season 3 على أربعة منتجات نوعية: شراكة حصرية، مقاعد Solution مخصّصة، DealMaker مميّز، وتعارفات مدقّقة.',
  footnote: 'تبقى Fintech24h نقطة الفرز وتنسّق كل طلب تعارف. الأسعار المرجعية تخص Season 3.',
  notPurchased: 'القائمة المؤهّلة ليست قائمة اتصال مُشتراة.',
} : {
  ariaLabel: 'Packages',
  eyebrow: 'Core revenue packages',
  h2a: 'Fewer packages.',
  h2b: 'Clearer value.',
  lede: 'Season 3 focuses on four quality products: exclusive partnership, dedicated Solution slots, Featured DealMaker, and vetted connections.',
  footnote: 'Fintech24h remains the screening point and coordinates every Request Introduction. Reference pricing applies to Season 3.',
  notPurchased: 'A Qualified Listing is not a purchased contact list.',
};
---

<section id="packages" class="relative py-20 lg:py-28" aria-label={copy.ariaLabel}>
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[500px] h-[500px] rounded-full opacity-30 mix-blend-screen dm-orb-emerald"
      style="top: 5%; right: -10%; filter: blur(90px); animation: orb-pulse 10s ease-in-out infinite 2s;"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-14" data-dm-reveal>
      <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">{copy.eyebrow}</p>
      <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-4">
        {copy.h2a} <span class="dm-text-gradient">{copy.h2b}</span>
      </h2>
      <p class="text-sm text-[var(--dm-text-secondary)]">
        {copy.lede}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 items-stretch">
      {pricingPackages.map((pkg, i) => (
        <div class={`relative flex flex-col p-7 rounded-[20px] ${pkg.highlight ? 'dm-card-featured lg:-translate-y-2' : 'dm-card'}`} data-dm-reveal style={`--dm-reveal-delay: ${i * 90}`}>
          <div class="flex items-start justify-between gap-2 mb-2">
            <span class="min-w-0 font-mono text-[10px] uppercase tracking-widest text-[var(--dm-emerald)]">{pkg.kicker}</span>
            {pkg.ribbon && (
              <span class="shrink-0 px-2.5 py-1 rounded-full text-[9px] font-mono font-bold uppercase tracking-widest text-[var(--dm-text-inverted)] whitespace-nowrap" style="background: var(--dm-gold);">
                {pkg.ribbon}
              </span>
            )}
          </div>
          <h3 class="font-display font-semibold text-lg text-[var(--dm-text-primary)] mb-2">{pkg.title}</h3>
          <p class="text-xs text-[var(--dm-text-secondary)] leading-relaxed min-h-[46px]">{pkg.description}</p>

          <div class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5 mt-6 mb-1">
            <span class="font-display font-semibold text-3xl lg:text-2xl text-[var(--dm-text-primary)] tracking-tight whitespace-nowrap">{pkg.price}</span>
            <span class="text-xs text-[var(--dm-text-muted)] whitespace-nowrap">{pkg.priceQualifier}</span>
          </div>

          <div class="dm-divider my-5"></div>

          <ul class="space-y-3 mb-6 flex-1">
            {pkg.benefits.map((b) => (
              <li class="flex items-start gap-2.5 text-xs text-[var(--dm-text-secondary)]">
                <svg class="w-3.5 h-3.5 mt-0.5 shrink-0 text-[var(--dm-gold)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 13 4 4L19 7"/></svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>

          {pkg.addOn && (
            <p class="text-xs text-[var(--dm-gold)] bg-[rgba(212,175,106,0.06)] border border-[var(--dm-border-accent)] rounded-lg px-3 py-2 mb-5">
              <strong>{pkg.addOn.label}:</strong> {pkg.addOn.description}
            </p>
          )}

          <a
            href="#apply"
            data-dm-prefill-interest={pkg.ctaInterest}
            data-dm-track="package_cta"
            data-dm-track-label={pkg.id}
            class={pkg.highlight ? 'dm-btn-primary justify-center text-xs' : 'dm-btn-ghost justify-center text-xs'}
          >
            {pkg.ctaLabel} <span aria-hidden="true">→</span>
          </a>

          {/* Always reserve this line's height (even when empty) so all 4
              CTAs land on the same baseline regardless of which cards carry
              a detail link — an invisible placeholder keeps the layout
              consistent instead of the button height diverging per card. */}
          {pkg.detailLink ? (
            <a href={pkg.detailLink.href} class="text-xs text-center text-[var(--dm-text-muted)] hover:text-[var(--dm-gold)] transition-colors underline underline-offset-4 decoration-[var(--dm-border)] mt-3">
              {pkg.detailLink.label} <span>→</span>
            </a>
          ) : (
            <span class="text-xs text-center mt-3 invisible" aria-hidden="true">placeholder →</span>
          )}
        </div>
      ))}
    </div>

    <p class="text-xs text-[var(--dm-text-muted)] max-w-3xl mx-auto text-center mt-10">
      <strong class="text-[var(--dm-text-secondary)]">{copy.notPurchased}</strong> {copy.footnote}
    </p>
  </div>
</section>
