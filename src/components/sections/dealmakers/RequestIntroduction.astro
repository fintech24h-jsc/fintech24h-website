---
// src/components/sections/dealmakers/RequestIntroduction.astro
// "Moderated Request Introduction" — trust-building without promising
// outcomes we don't control (no "guaranteed connection" language).
const steps = [
  {
    n: '01',
    title: 'A request with context',
    body: 'State your goal, the value you bring, and why both sides should talk. No mass-messaged inbox.',
  },
  {
    n: '02',
    title: 'Fintech24h reviews',
    body: 'The team checks fit — need, stage, region, and decision-maker status — before considering a connection.',
  },
  {
    n: '03',
    title: 'Consent from the other side',
    body: 'We reach the receiving party first, ask for consent, and prepare context. Direct contact info is never shared.',
  },
  {
    n: '04',
    title: 'Warm introduction',
    body: 'If it’s a fit, Fintech24h sends a contextual introduction. Not every request is approved.',
  },
];
---

<section class="relative py-20 lg:py-28" aria-label="Moderated Request Introduction">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">Moderated Request Introduction</p>
      <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-5">
        We protect <span class="dm-text-gradient">everyone’s time in the network.</span>
      </h2>
      <p class="text-sm text-[var(--dm-text-secondary)] leading-relaxed">
        A good introduction isn’t a handed-over contact. It’s a meeting with a clear reason, properly prepared context, and only opened when both sides have something to talk about.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {steps.map((s) => (
        <div class="relative dm-card-numbered p-6" data-step={s.n}>
          <p class="font-mono text-[10px] text-[var(--dm-gold)] tracking-widest mb-3">{s.n}</p>
          <h3 class="font-display font-semibold text-sm text-[var(--dm-text-primary)] mb-2">{s.title}</h3>
          <p class="text-xs text-[var(--dm-text-secondary)] leading-relaxed">{s.body}</p>
        </div>
      ))}
    </div>

    <p class="text-center mt-10">
      <a href="#apply" data-dm-prefill-interest="Join DealMakers’ Club" class="dm-btn-primary py-3 px-6 text-xs" data-dm-track="request_intro_cta">
        Request an Introduction
      </a>
    </p>
  </div>
</section>
