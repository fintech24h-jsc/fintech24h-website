---
// src/components/sections/dealmakers/HowItWorks.astro
// The signature "how it works" moment: Fintech24h sits between Company and
// Investor as the moderating hub, using the same visual language as the
// Global Deal Pipeline panel on /services/business-development/, adapted
// to this microsite's gold/emerald glass system. Replaces a generic
// 4-card numbered-steps grid (a classic template pattern) with one
// asymmetric, illustrated centerpiece.
import type { DealmakersLocale } from '../../../data/dealmakers/content';

interface Props {
  locale?: DealmakersLocale;
}
const { locale = 'en' } = Astro.props;

const feed = locale === 'ar' ? [
  { time: 'مباشر', text: 'مراجعة إشارة الصفقة من قِبل Fintech24h', tone: 'gold' },
  { time: 'مباشر', text: 'طلب الموافقة من الطرف المُستقبِل', tone: 'amber' },
  { time: 'مباشر', text: 'تم إرسال التعارف، وتأكيد الاتصال', tone: 'emerald' },
] : locale === 'zh' ? [
  { time: '实时', text: 'Fintech24h 审核交易信号', tone: 'gold' },
  { time: '实时', text: '向接收方征求同意', tone: 'amber' },
  { time: '实时', text: '引荐已发送，连接已确认', tone: 'emerald' },
] : [
  { time: 'Live', text: 'Deal signal reviewed by Fintech24h', tone: 'gold' },
  { time: 'Live', text: 'Consent requested from receiving party', tone: 'amber' },
  { time: 'Live', text: 'Introduction sent, connection confirmed', tone: 'emerald' },
];

const copy = locale === 'ar' ? {
  ariaLabel: 'كيف يعمل F-Matching',
  eyebrow: 'كيف يعمل F-Matching',
  h2a: 'نحن نحافظ على',
  h2bStrong: 'وقت الجميع',
  h2c: 'في الشبكة.',
  lede: 'التعارف الجيد ليس مجرد تسليم جهة اتصال. تقف Fintech24h بين كل شركة ومستثمر في الشبكة، تراجع مدى الملاءمة، وتطلب الموافقة، ولا تفتح التواصل إلا عندما يكون لدى الطرفين سبب حقيقي للتحدث.',
  step1Strong: 'حدّد الإشارة:',
  step1: 'تُقدّم الشركة أو المستثمر طلبًا بنيّة واضحة، دون تواصل جماعي.',
  step2Strong: 'تراجع Fintech24h مدى الملاءمة:',
  step2: 'الاحتياج، والمرحلة، والمنطقة، وصفة صاحب القرار، قبل المضي في أي خطوة.',
  step3Strong: 'يتم إجراء تعارف دافئ',
  step3: 'فقط بعد موافقة الطرف المُستقبِل. لا تُشارَك معلومات الاتصال المباشرة مطلقًا.',
  requestIntro: 'طلب تعارف',
  networkStatus: 'حالة الشبكة',
  dealPipeline: 'خط أنابيب الصفقات',
  connected: 'متصل',
  company: 'الشركة',
  investor: 'المستثمر',
  joinInterest: 'الانضمام إلى DealMakers’ Club',
} : locale === 'zh' ? {
  ariaLabel: 'F-Matching 如何运作',
  eyebrow: 'F-Matching 如何运作',
  h2a: '我们守护',
  h2bStrong: '每个人的时间',
  h2c: '，服务于整个网络。',
  lede: '一次好的引荐不是简单地交出一个联系方式。Fintech24h 站在网络中每一家公司与投资人之间，审核匹配度、征求同意，只有当双方都有真正的理由沟通时，才会开启联系。',
  step1Strong: '明确信号：',
  step1: '公司或投资人以清晰的意图提交请求，而非批量陌生开发。',
  step2Strong: 'Fintech24h 审核匹配度：',
  step2: '需求、阶段、地域，以及决策者身份，一切前进之前都会先确认。',
  step3Strong: '促成一次真诚的引荐，',
  step3: '仅在接收方同意之后才会进行。直接联系方式永远不会被直接共享。',
  requestIntro: '请求引荐',
  networkStatus: '网络状态',
  dealPipeline: '交易流水线',
  connected: '已连接',
  company: '公司',
  investor: '投资人',
  joinInterest: '加入 DealMakers’ Club',
} : {
  ariaLabel: 'How F-Matching works',
  eyebrow: 'How F-Matching works',
  h2a: 'We protect',
  h2bStrong: 'everyone’s time',
  h2c: 'in the network.',
  lede: 'A good introduction isn’t a handed-over contact. Fintech24h sits between every Company and Investor in the network, reviewing fit, requesting consent, and only opening a connection when both sides have a real reason to talk.',
  step1Strong: 'State the signal:',
  step1: 'a company or investor submits a request with clear intent, no mass outreach.',
  step2Strong: 'Fintech24h reviews fit:',
  step2: 'need, stage, region, and decision-maker status, before anything moves forward.',
  step3Strong: 'A warm introduction is made',
  step3: 'only after the receiving party consents. Direct contact info is never shared outright.',
  requestIntro: 'Request an Introduction',
  networkStatus: 'Network status',
  dealPipeline: 'Deal Pipeline',
  connected: 'Connected',
  company: 'Company',
  investor: 'Investor',
  joinInterest: 'Join DealMakers’ Club',
};
---

<section class="relative py-20 lg:py-28 overflow-hidden" aria-label={copy.ariaLabel}>
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[420px] h-[420px] rounded-full opacity-25 mix-blend-screen dm-orb-emerald"
      style="top: 10%; left: -8%; filter: blur(100px); animation: orb-pulse 11s ease-in-out infinite;"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-12 lg:gap-16 items-center">
      <!-- Copy column -->
      <div data-dm-reveal>
        <p class="font-mono text-[10px] text-[var(--dm-gold)] uppercase tracking-[0.18em] mb-3">{copy.eyebrow}</p>
        <h2 class="font-display font-semibold text-h2 text-[var(--dm-text-primary)] mb-5">
          {copy.h2a} <span class="dm-text-gradient">{copy.h2bStrong}</span> {copy.h2c}
        </h2>
        <p class="text-sm text-[var(--dm-text-secondary)] leading-relaxed mb-8">
          {copy.lede}
        </p>

        <ul class="space-y-5">
          <li class="flex gap-4">
            <span class="w-7 h-7 rounded-full border border-[var(--dm-border-accent)] bg-[rgba(217,178,106,0.08)] flex items-center justify-center text-[var(--dm-gold)] text-[11px] font-mono font-bold shrink-0">1</span>
            <p class="text-sm text-[var(--dm-text-secondary)]"><strong class="text-[var(--dm-text-primary)] font-semibold">{copy.step1Strong}</strong> {copy.step1}</p>
          </li>
          <li class="flex gap-4">
            <span class="w-7 h-7 rounded-full border border-[var(--dm-border-accent)] bg-[rgba(217,178,106,0.08)] flex items-center justify-center text-[var(--dm-gold)] text-[11px] font-mono font-bold shrink-0">2</span>
            <p class="text-sm text-[var(--dm-text-secondary)]"><strong class="text-[var(--dm-text-primary)] font-semibold">{copy.step2Strong}</strong> {copy.step2}</p>
          </li>
          <li class="flex gap-4">
            <span class="w-7 h-7 rounded-full border border-[var(--dm-border-accent)] bg-[rgba(217,178,106,0.08)] flex items-center justify-center text-[var(--dm-gold)] text-[11px] font-mono font-bold shrink-0">3</span>
            <p class="text-sm text-[var(--dm-text-secondary)]"><strong class="text-[var(--dm-text-primary)] font-semibold">{copy.step3Strong}</strong> {copy.step3}</p>
          </li>
        </ul>

        <a href="#apply" data-dm-prefill-interest={copy.joinInterest} class="dm-btn-primary py-3 px-6 text-xs mt-8" data-dm-track="request_intro_cta">
          {copy.requestIntro}
        </a>
      </div>

      <!-- Hub diagram -->
      <div class="dm-card rounded-[26px] p-6 sm:p-8" data-dm-reveal>
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style="background: var(--dm-gradient-primary);">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="#0a0908" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M4 12l4-4m-4 4 4 4"/></svg>
            </span>
            <div class="leading-none">
              <p class="font-mono text-[9px] text-[var(--dm-text-muted)] uppercase tracking-widest mb-1">{copy.networkStatus}</p>
              <p class="font-display font-semibold text-sm text-[var(--dm-text-primary)]">{copy.dealPipeline}</p>
            </div>
          </div>
          <span class="dm-tag dm-tag-emerald text-[9px] py-1 px-2.5 flex items-center gap-1.5">
            <i class="w-1.5 h-1.5 rounded-full bg-[var(--dm-emerald-bright)]" style="animation: dm-pulse-dot 1.6s ease-in-out infinite;"></i>
            {copy.connected}
          </span>
        </div>

        <!-- Nodes -->
        <div class="relative flex items-center justify-between px-2 mb-8">
          <!-- Connector lines: viewBox and rendered box share the exact same
          aspect ratio (via CSS aspect-ratio), so scaling is always uniform —
          no preserveAspectRatio="none" hacks that stretch the stroke and
          the moving dot into an ugly, overflowing ellipse at other widths. -->
          <svg class="absolute left-[13%] right-[13%] top-[32px] -translate-y-1/2 w-auto overflow-visible" style="aspect-ratio: 320 / 40;" viewBox="0 0 320 40" aria-hidden="true">
            <defs>
              <linearGradient id="dm-flow-gold" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="var(--dm-gold)" stop-opacity="0.12" />
                <stop offset="50%" stop-color="var(--dm-gold)" stop-opacity="0.55" />
                <stop offset="100%" stop-color="var(--dm-gold)" stop-opacity="0.12" />
              </linearGradient>
              <linearGradient id="dm-flow-emerald" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="var(--dm-emerald)" stop-opacity="0.12" />
                <stop offset="50%" stop-color="var(--dm-emerald)" stop-opacity="0.55" />
                <stop offset="100%" stop-color="var(--dm-emerald)" stop-opacity="0.12" />
              </linearGradient>
            </defs>

            <path d="M0,20 C48,7 82,7 130,20" fill="none" stroke="url(#dm-flow-gold)" stroke-width="1.5" stroke-linecap="round" />
            <circle r="2" fill="var(--dm-gold-bright)" style="filter: drop-shadow(0 0 5px var(--dm-gold));">
              <animateMotion dur="2.2s" repeatCount="indefinite" path="M0,20 C48,7 82,7 130,20" />
            </circle>

            <path d="M190,20 C238,33 272,33 320,20" fill="none" stroke="url(#dm-flow-emerald)" stroke-width="1.5" stroke-linecap="round" />
            <circle r="2" fill="var(--dm-emerald-bright)" style="filter: drop-shadow(0 0 5px var(--dm-emerald));">
              <animateMotion dur="2.2s" repeatCount="indefinite" begin="0.6s" path="M190,20 C238,33 272,33 320,20" />
            </circle>
          </svg>

          <div class="flex flex-col items-center gap-2 z-10">
            <div class="w-14 h-14 rounded-2xl border border-[var(--dm-border)] bg-[var(--dm-bg-tertiary)] flex items-center justify-center text-[var(--dm-text-primary)] font-display font-semibold">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="11"/><path d="M9 22V12h6v10M4 9l8-6 8 6"/></svg>
            </div>
            <span class="font-mono text-[8px] text-[var(--dm-text-muted)] uppercase tracking-widest">{copy.company}</span>
          </div>

          <div class="flex flex-col items-center gap-2 z-10">
            <div class="w-16 h-16 rounded-full flex items-center justify-center shrink-0 p-3 bg-[var(--dm-bg-tertiary)] border-2 border-[var(--dm-gold)]" style="box-shadow: 0 0 30px rgba(217,178,106,0.4);">
              <img src="https://fintech24h.com/wp-content/uploads/2026/07/Logo-Fintech24h.webp" alt="Fintech24h" width="300" height="210" class="w-full h-full object-contain" loading="lazy" />
            </div>
            <span class="font-mono text-[8px] text-[var(--dm-gold)] uppercase tracking-widest">Fintech24h</span>
          </div>

          <div class="flex flex-col items-center gap-2 z-10">
            <div class="w-14 h-14 rounded-2xl border border-[var(--dm-border)] bg-[var(--dm-bg-tertiary)] flex items-center justify-center text-[var(--dm-text-primary)]">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2m0 16v2M4.2 4.2l1.4 1.4m12.8 12.8 1.4 1.4M2 12h2m16 0h2M4.2 19.8l1.4-1.4m12.8-12.8 1.4-1.4"/><circle cx="12" cy="12" r="4"/></svg>
            </div>
            <span class="font-mono text-[8px] text-[var(--dm-text-muted)] uppercase tracking-widest">{copy.investor}</span>
          </div>
        </div>

        <!-- Live feed -->
        <div class="space-y-2">
          {feed.map((f) => (
            <div class="flex items-center gap-3 px-3.5 py-2.5 rounded-lg bg-[rgba(255,255,255,0.025)] border border-[var(--dm-border)]">
              <i class={`w-1.5 h-1.5 rounded-full shrink-0 ${f.tone === 'gold' ? 'bg-[var(--dm-gold)]' : f.tone === 'emerald' ? 'bg-[var(--dm-emerald-bright)]' : 'bg-[#e0a94a]'}`}></i>
              <span class="font-mono text-[9px] text-[var(--dm-text-muted)] uppercase tracking-wider shrink-0">{f.time}</span>
              <span class="text-xs text-[var(--dm-text-secondary)]">{f.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
