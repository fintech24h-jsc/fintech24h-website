---
// src/components/sections/TestimonialsSection.astro
// Theo design-system.md:
// - Số liệu lớn (ROI, reach) dùng color-success cho ROI, cyan cho reach — section 7.4
// - Eyebrow dùng font-mono
// - Không phải 3-col grid đồng đều — 1 featured lớn + 2 nhỏ bên dưới

const testimonials = [
  {
    quote: "Fintech24h executed our regional developer rollout flawlessly. Within 60 days, we onboarded over 30,000 active builders and community members across Vietnam and Singapore. Their developer relations and local KOL networks are top tier.",
    author: "Sarah Chen",
    role: "APAC Growth Director",
    company: "Avalanche Ecosystem",
    metrics: "45x ROI",
    metricColor: "success", // green cho ROI
    secondMetric: "30K+ Users",
    secondColor: "cyan",
  },
  {
    quote: "Securing tier-1 PR slots (Bloomberg, CoinTelegraph) is critical for our credibility. Fintech24h drafted compelling narratives and secured press release coverage within the first 14 days of listing.",
    author: "Kenji Sato",
    role: "Core Contributor",
    company: "DeFi Solutions",
    metrics: "25+ Placements",
    metricColor: "cyan",
    secondMetric: "Day 14",
    secondColor: "success",
  },
  {
    quote: "Their community moderation team works 24/7. They configure custom security filters to prevent scams while executing active community quizzes that keep users educated about our protocol governance.",
    author: "Marcus Aurel",
    role: "Operations Lead",
    company: "Aptos Hub Partners",
    metrics: "99.9% Spam Defended",
    metricColor: "success",
    secondMetric: "24/7 Active",
    secondColor: "cyan",
  }
];
---

<section class="py-24 bg-[var(--bg-primary)] relative overflow-hidden" aria-label="Client Testimonials">
  <!-- Background orbs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[500px] h-[500px] rounded-full"
      style="background: var(--gradient-glow-cyan); bottom: 10%; left: -8%; filter: blur(72px);
             animation: orb-pulse 8s ease-in-out infinite, orb-drift 12s ease-in-out infinite;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="animation: grid-shimmer 6s ease-in-out infinite; opacity: 0.15;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
      <p class="font-mono text-xs text-[var(--accent-purple)] uppercase tracking-[0.12em] mb-4">Testimonials</p>
      <h2 class="font-display text-h2 font-bold text-[var(--text-primary)] mb-4">
        Validated By Founders
      </h2>
      <p class="text-base text-[var(--text-secondary)] font-body leading-relaxed">
        See how leading layer-1 ecosystems, DeFi protocols, and launchpads scale user acquisition globally.
      </p>
    </div>

    <!-- Layout bất đối xứng: featured top, 2 nhỏ bottom -->
    <!-- Featured testimonial (first one — largest) -->
    <div class="card-featured p-8 lg:p-10 mb-6 group" data-animate="fade-up">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

        <!-- Left: Numbers lớn — theo design-system.md 7.4 -->
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-[var(--bg-secondary)] border border-[var(--border-default)] rounded-xl p-6 text-center">
            <!-- ROI: color success (green) theo spec -->
            <div class="font-display text-4xl font-bold text-[var(--color-success)] tabular-nums mb-1">{testimonials[0].metrics}</div>
            <div class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-widest">Campaign ROI</div>
          </div>
          <div class="bg-[var(--bg-secondary)] border border-[var(--border-default)] rounded-xl p-6 text-center">
            <!-- Reach: cyan theo spec -->
            <div class="font-display text-4xl font-bold text-[var(--accent-cyan)] tabular-nums mb-1">{testimonials[0].secondMetric}</div>
            <div class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-widest">Users Acquired</div>
          </div>
          <div class="col-span-2 bg-[var(--bg-secondary)] border border-[var(--border-default)] rounded-xl px-6 py-4 text-center">
            <div class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-widest mb-1">Timeline</div>
            <div class="font-display text-xl font-bold text-[var(--text-primary)] tabular-nums">60 Days</div>
          </div>
        </div>

        <!-- Right: Quote -->
        <div>
          <blockquote>
            <p class="text-base text-[var(--text-primary)] font-body italic leading-relaxed mb-6">
              &ldquo;{testimonials[0].quote}&rdquo;
            </p>
          </blockquote>
          <div class="flex items-center gap-3 border-t border-[var(--border-subtle)] pt-6">
            <div class="w-10 h-10 rounded-xl bg-[var(--accent-cyan)]/10 border border-[var(--accent-cyan)]/30 flex items-center justify-center font-display text-[var(--accent-cyan)] font-bold text-sm">
              {testimonials[0].company.slice(0, 2).toUpperCase()}
            </div>
            <div>
              <div class="text-sm font-bold text-[var(--text-primary)] font-display">{testimonials[0].author}</div>
              <div class="text-xs text-[var(--text-muted)] font-body">
                {testimonials[0].role}, <span class="text-[var(--accent-cyan)]">{testimonials[0].company}</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- 2 cards nhỏ bên dưới -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-animate="stagger">
      {testimonials.slice(1).map((t) => (
        <div class="card-default p-8 flex flex-col justify-between" data-animate-child>
          <div>
            <!-- Metrics tag -->
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--accent-cyan)]/30 bg-[var(--accent-cyan)]/5 mb-6">
              <span class="font-display text-2xl font-bold text-[var(--color-success)] tabular-nums">{t.metrics}</span>
            </div>
            <blockquote>
              <p class="text-sm text-[var(--text-secondary)] font-body italic leading-relaxed mb-8">
                &ldquo;{t.quote}&rdquo;
              </p>
            </blockquote>
          </div>
          <div class="flex items-center gap-3 border-t border-[var(--border-subtle)] pt-6">
            <div class="w-10 h-10 rounded-xl bg-[var(--accent-purple)]/10 border border-[var(--accent-purple)]/30 flex items-center justify-center font-display text-[var(--accent-purple)] font-bold text-sm">
              {t.company.slice(0, 2).toUpperCase()}
            </div>
            <div>
              <div class="text-xs font-bold text-[var(--text-primary)] font-display">{t.author}</div>
              <div class="text-[10px] text-[var(--text-muted)] font-body">
                {t.role}, <span class="text-[var(--accent-cyan)]">{t.company}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
