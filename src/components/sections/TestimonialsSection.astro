---
// src/components/sections/TestimonialsSection.astro

const testimonials = [
  {
    quote: "Fintech24h executed our regional developer rollout flawlessly. Within 60 days, we onboarded over 30,000 active builders and community members across Vietnam and Singapore. Their developer relations and local KOL networks are top tier.",
    author: "Sarah Chen",
    role: "APAC Growth Director",
    company: "Avalanche Ecosystem",
    metrics: "45x ROI"
  },
  {
    quote: "Securing tier-1 PR slots (Bloomberg, CoinTelegraph) is critical for our credibility. Fintech24h drafted compelling narratives and secured press release coverage within the first 14 days of listing. Highly recommended for any launch phase.",
    author: "Kenji Sato",
    role: "Core Contributor",
    company: "DeFi Solutions",
    metrics: "25+ Placements"
  },
  {
    quote: "Their community moderation team works 24/7. They configure custom security filters to prevent scams while executing active community quizzes that keep users educated about our protocol governance. Truly a plug-and-play solution.",
    author: "Marcus Aurel",
    role: "Operations Lead",
    company: "Aptos Hub Partners",
    metrics: "99.9% Spam Defended"
  }
];
---

<section class="py-24 bg-[#050810] relative overflow-hidden" aria-label="Client Testimonials">
  <!-- Glowing background lines -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="bg-orb bg-orb-cyan w-[500px] h-[500px] absolute bottom-10 left-10 opacity-10"></div>
    <div class="grid-pattern absolute inset-0 opacity-20"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-purple-400/30 bg-purple-400/5 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
        <span class="text-xs font-semibold text-purple-400 font-body uppercase tracking-wider">Testimonials</span>
      </div>
      <h2 class="font-display text-h2 font-bold text-[#f0f4ff] mb-4">
        Validated By Founders
      </h2>
      <p class="text-base text-[#94a3b8] font-body leading-relaxed">
        See how leading layer-1 ecosystems, DeFi protocols, and launchpads scale user acquisition globally.
      </p>
    </div>

    <!-- Testimonials grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-animate="stagger">
      {testimonials.map((t) => (
        <div 
          class="glass-card rounded-2xl p-8 border border-white/5 hover:border-purple-400/30 transition-all duration-300 flex flex-col justify-between"
          data-animate-child
        >
          <div>
            <!-- Metrics tag -->
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-cyan-400/30 bg-cyan-400/5 text-[10px] font-bold text-cyan-400 font-body tracking-wider uppercase mb-6">
              {t.metrics}
            </div>

            <!-- Quote -->
            <p class="text-sm text-[#94a3b8] font-body italic leading-relaxed mb-8">
              "{t.quote}"
            </p>
          </div>

          <!-- Author details -->
          <div class="flex items-center gap-3 border-t border-white/5 pt-6">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-400/30 flex items-center justify-center font-display text-purple-400 font-bold text-sm">
              {t.company.slice(0, 2).toUpperCase()}
            </div>
            <div>
              <div class="text-xs font-semibold text-[#f0f4ff] font-display">{t.author}</div>
              <div class="text-[10px] text-[#475569] font-body">{t.role}, <span class="text-cyan-400">{t.company}</span></div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
