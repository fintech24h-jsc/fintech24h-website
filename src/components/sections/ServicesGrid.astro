---
// src/components/sections/ServicesGrid.astro
import { services } from '../../data/services';
---

<section class="py-24 bg-[#0a0f1e]/40 relative overflow-hidden" aria-label="Services Overview">
  <!-- Glowing background lines -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="bg-orb bg-orb-purple w-[500px] h-[500px] absolute -top-40 -right-32 opacity-10"></div>
    <div class="bg-orb bg-orb-cyan w-[400px] h-[400px] absolute bottom-10 left-10 opacity-10"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-purple-400/30 bg-purple-400/5 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
        <span class="text-xs font-semibold text-purple-400 font-body uppercase tracking-wider">What We Do</span>
      </div>
      <h2 class="font-display text-h2 font-bold text-[#f0f4ff] mb-4">
        Full-Stack Growth Engines
      </h2>
      <p class="text-base text-[#94a3b8] font-body leading-relaxed">
        We merge specialized Web3 marketing tactics with quantifiable metrics, acting as your extended growth team.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate="stagger">
      {services.map((s) => (
        <a 
          href={`/services/${s.slug}`} 
          class="glass-card rounded-2xl p-8 border border-white/5 hover:border-cyan-400/40 hover:scale-[1.01] transition-all duration-300 flex flex-col justify-between group relative overflow-hidden"
          data-animate-child
          aria-label={`Explore ${s.title}`}
        >
          <!-- Radial hover gradient -->
          <div class="absolute inset-0 bg-radial-gradient(circle, rgba(0,212,255,0.02) 0%, transparent 80%) opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

          <div>
            <!-- Icon -->
            <div class="w-12 h-12 rounded-xl bg-cyan-400/10 border border-cyan-400/20 flex items-center justify-center text-cyan-400 mb-6 group-hover:bg-cyan-400 group-hover:text-black transition-colors duration-300">
              {s.icon === 'Users' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v-2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {s.icon === 'FileText' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {s.icon === 'MessageSquare' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {s.icon === 'TrendingUp' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18M17 6h6v6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {s.icon === 'Briefcase' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {s.icon === 'Search' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
            </div>

            <!-- Title & Copy -->
            <h3 class="font-display text-xl font-bold text-[#f0f4ff] mb-4 group-hover:text-cyan-400 transition-colors">
              {s.title}
            </h3>
            <p class="text-sm text-[#94a3b8] font-body leading-relaxed mb-8">
              {s.shortDescription}
            </p>
          </div>

          <!-- Bottom Link arrow -->
          <div class="flex items-center gap-2 text-xs font-semibold text-cyan-400 font-display uppercase tracking-wider group-hover:gap-3 transition-all duration-300">
            Learn More
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Action CTA -->
    <div class="text-center mt-16" data-animate="fade-up">
      <a href="/services" class="btn-ghost font-display font-semibold text-sm">
        Explore All Solutions
      </a>
    </div>

  </div>
</section>
