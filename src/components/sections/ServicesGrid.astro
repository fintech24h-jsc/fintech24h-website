---
// src/components/sections/ServicesGrid.astro
// Theo design-system.md section 7.3 + 6.1:
// - Layout A (2+1 asymmetric): card featured lớn bên trái, 2 card nhỏ bên phải, 3 đều bên dưới
// - Card content: [Số 01] [Tag KOL] → H3 → 2-3 câu có con số → 3 bullet → Link
// - Đã thêm: Cực kỳ làm nổi bật dịch vụ KOL với màu cam-hồng gradient và tag HOT lấp lánh
import { services } from '../../data/services';
---

<section class="py-28 bg-[var(--bg-secondary)] relative overflow-hidden" aria-label="Services Overview">
  <!-- Background orbs với mesh pattern chuyển động chìm -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[600px] h-[600px] rounded-full"
      style="background: var(--gradient-glow-purple); top: -10%; right: -5%; filter: blur(90px);
             animation: orb-pulse 10s ease-in-out infinite 2s, orb-drift 18s ease-in-out infinite 4s;">
    </div>
    <div class="absolute w-[500px] h-[500px] rounded-full"
      style="background: var(--gradient-glow-cyan); bottom: 5%; left: -8%; filter: blur(80px);
             animation: orb-pulse 8s ease-in-out infinite, orb-drift 14s ease-in-out infinite;">
    </div>
    <!-- Điểm nhấn màu ấm ở giữa góc trái -->
    <div class="absolute w-[350px] h-[350px] rounded-full"
      style="background: radial-gradient(circle, var(--color-orange-pink-glow) 0%, transparent 70%); top: 40%; left: 10%; filter: blur(50px); animation: orb-pulse 7s ease-in-out infinite 1s;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="opacity: 0.15;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Heading -->
    <div class="max-w-3xl mb-20" data-animate="fade-up">
      <p class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.15em] mb-4 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]"></span>
        Core Solutions
      </p>
      <h2 class="font-display text-h2 font-bold text-[var(--text-primary)] mb-4">
        Full-Stack <span class="bg-gradient-to-r from-[var(--accent-cyan)] to-[#ff9966] bg-clip-text text-transparent">Growth Engines</span>
      </h2>
      <p class="text-base text-[var(--text-secondary)] font-body leading-relaxed max-w-lg">
        Specialized Web3 marketing tactics aligned with quantifiable OKRs — acting as your extended growth team.
      </p>
    </div>

    <!-- Services Grid — Layout A (2+1 asymmetric) theo design-system.md 6.1 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6" data-animate="stagger">

      <!-- Card 1: FEATURED (KOL Service) — md:col-span-2 — NỔI BẬT CAM-HỒNG -->
      <a
        href={`/services/${services[0].slug}`}
        class="md:col-span-2 p-8 lg:p-12 flex flex-col justify-between group relative overflow-hidden transition-all duration-500 rounded-[24px] border border-[#ff5e62]/30 bg-gradient-to-br from-[rgba(255,94,98,0.06)] via-transparent to-[rgba(124,92,252,0.03)] hover:-translate-y-2 hover:border-[#ff9966]/60 hover:shadow-[0_20px_50px_rgba(255,94,98,0.12),0_0_0_1px_rgba(255,255,255,0.05)]"
        data-animate-child
        aria-label={`Explore ${services[0].title}`}
      >
        <!-- Ambient radial glow inside -->
        <div class="absolute inset-0 opacity-40 group-hover:opacity-80 transition-opacity duration-500 pointer-events-none"
          style="background: radial-gradient(ellipse 60% 60% at 20% 20%, rgba(255,94,98,0.1), transparent 60%);">
        </div>

        <div class="relative z-10">
          <!-- Number + Category tags (HOT label lấp lánh) -->
          <div class="flex items-center justify-between mb-8">
            <span class="font-mono text-[11px] text-[#ff9966] tracking-widest font-semibold">01 / FEATURED</span>
            <span class="tag bg-gradient-to-r from-[#ff5e62] to-[#ff9966] text-[#050810] font-bold border-none px-3.5 py-1 flex items-center gap-1.5 shadow-[0_0_15px_rgba(255,94,98,0.3)] animate-pulse rounded text-[10px] tracking-wider">
              <span class="w-1.5 h-1.5 rounded-full bg-[#050810]" aria-hidden="true"></span>
              HOT / PERFORMANCE GUARANTEED
            </span>
          </div>

          <!-- Title -->
          <h3 class="font-display text-2xl lg:text-4xl font-bold text-[var(--text-primary)] mb-5 group-hover:text-[var(--accent-cyan)] transition-colors duration-300">
            {services[0].title}
          </h3>

          <!-- Description với con số cụ thể -->
          <p class="text-sm md:text-base text-[var(--text-secondary)] font-body leading-relaxed mb-8 max-w-xl">
            {services[0].shortDescription}
          </p>

          <!-- 3 bullet keywords -->
          <ul class="flex flex-wrap gap-2.5 mb-10">
            {['Network 5,000+ KOLs', 'Tier-1 Regional Coverage', 'Performance-based Contract'].map(b => (
              <li class="tag bg-white/[0.03] border-white/10 text-[var(--text-secondary)] py-1 px-3 rounded hover:border-[#ff9966]/40 transition-colors font-body text-xs">{b}</li>
            ))}
          </ul>
        </div>

        <!-- Link / CTA -->
        <div class="relative z-10 inline-flex items-center gap-2 text-xs font-display font-bold text-[#ff9966] uppercase tracking-wider group-hover:gap-4 transition-all duration-300 group-hover:text-[var(--accent-cyan)]">
          Explore Solution →
        </div>
      </a>

      <!-- Cards 2 & 3: bên phải (normal size) -->
      {services.slice(1, 3).map((s, i) => (
        <a
          href={`/services/${s.slug}`}
          class="card-default p-8 flex flex-col justify-between group relative overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:border-[var(--accent-cyan)]/30"
          data-animate-child
          aria-label={`Explore ${s.title}`}
        >
          <!-- Accent glow -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-400 pointer-events-none"
            style={`background: radial-gradient(circle at 50% 50%, ${i === 0 ? 'rgba(124,92,252,0.06)' : 'rgba(0,200,240,0.06)'}, transparent 70%);`}>
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-6">
              <span class="font-mono text-[10px] text-[var(--text-muted)] tracking-widest">0{i + 2}</span>
              <span class={i === 0 ? 'tag tag-purple' : 'tag tag-cyan'}>
                {i === 0 ? 'PR' : 'Community'}
              </span>
            </div>
            <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-4 group-hover:text-[var(--accent-cyan)] transition-colors duration-300">
              {s.title}
            </h3>
            <p class="text-xs text-[var(--text-secondary)] font-body leading-relaxed">
              {s.shortDescription}
            </p>
          </div>

          <div class="relative z-10 mt-8 flex items-center gap-2 text-xs font-display font-bold text-[var(--accent-cyan)] uppercase tracking-wider group-hover:gap-3 transition-all duration-300">
            Explore →
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom row: 3 cards đều nhau -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-animate="stagger">
      {services.slice(3).map((s, i) => (
        <a
          href={`/services/${s.slug}`}
          class="card-default p-8 flex flex-col justify-between group relative overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:border-[var(--accent-cyan)]/30"
          data-animate-child
          aria-label={`Explore ${s.title}`}
        >
          <!-- Accent glow -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-400 pointer-events-none"
            style="background: radial-gradient(circle at 50% 50%, rgba(124,92,252,0.04), transparent 70%);">
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-6">
              <span class="font-mono text-[10px] text-[var(--text-muted)] tracking-widest">0{i + 4}</span>
              <span class="tag tag-gray">{['BD & Ecosystems', 'Event Marketing', 'AI Marketing'][i] ?? 'Service'}</span>
            </div>
            <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-4 group-hover:text-[var(--accent-cyan)] transition-colors duration-300">
              {s.title}
            </h3>
            <p class="text-xs text-[var(--text-secondary)] font-body leading-relaxed">
              {s.shortDescription}
            </p>
          </div>

          <div class="relative z-10 mt-8 flex items-center gap-2 text-xs font-display font-bold text-[var(--accent-cyan)] uppercase tracking-wider group-hover:gap-3 transition-all duration-300">
            Explore →
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Action CTA -->
    <div class="text-center mt-20" data-animate="fade-up">
      <a href="/services" class="btn-ghost">
        <span>Explore All Solutions</span>
      </a>
    </div>

  </div>
</section>
