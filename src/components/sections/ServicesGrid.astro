---
// src/components/sections/ServicesGrid.astro
// Fully redesigned to be an extremely creative, premium 3D Floating Perspective Deck.
// The cards are fanned out in 3D space with subtle overlap, and hovering brings a card forward with a glowing aura.
import { services } from '../../data/services';

const icons = {
  'kol-influencer': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>',
  'pr-media': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>',
  'community-management': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>',
  'growth-airdrop': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>',
  'business-development': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path><line x1="16" y1="11" x2="20" y2="11"></line><line x1="18" y1="9" x2="18" y2="13"></line></svg>',
  'content-strategy-seo': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>',
};

const tags = [
  'GUARANTEED ROI',
  'GLOBAL REACH',
  '24/7 MODERATION',
  'AIRDROP CAMPAIGN',
  'EXCHANGE LISTING',
  'ORGANIC AUTHORITY'
];
---

<section class="py-32 bg-[var(--bg-secondary)] relative overflow-hidden" aria-label="Services Overview">
  <!-- Background ambient elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[600px] h-[600px] rounded-full"
      style="background: var(--gradient-glow-purple); top: -10%; right: -5%; filter: blur(90px);
             animation: orb-pulse 10s ease-in-out infinite 2s, orb-drift 18s ease-in-out infinite 4s;">
    </div>
    <div class="absolute w-[500px] h-[500px] rounded-full"
      style="background: var(--gradient-glow-cyan); bottom: 5%; left: -8%; filter: blur(80px);
             animation: orb-pulse 8s ease-in-out infinite, orb-drift 14s ease-in-out infinite;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="opacity: 0.15;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-20 animate-fade-up">
      <p class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.15em] mb-4 flex items-center justify-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span>
        Core Solutions
      </p>
      <h2 class="font-display text-h2 font-bold text-[var(--text-primary)] mb-4">
        Interactive <span class="bg-gradient-to-r from-[var(--accent-cyan)] via-[#f0a278] to-[#ff6b83] bg-clip-text text-transparent">3D Growth Deck</span>
      </h2>
      <p class="text-base text-[var(--text-secondary)] font-body leading-relaxed max-w-lg mx-auto">
        Hover over the cards to navigate our core marketing pillars and bring each growth engine forward.
      </p>
    </div>

    <!-- 3D Perspective Deck Container -->
    <div class="perspective-container">
      <div class="services-3d-deck">
        {services.map((s, idx) => (
          <a
            href={`/services/${s.slug}`}
            class={`deck-card card-${idx + 1} group`}
            style={`--card-index: ${idx};`}
            aria-label={`Explore ${s.title}`}
          >
            {/* Subtle glow on hover */}
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              style={`background: radial-gradient(circle at 10% 10%, ${idx === 0 ? 'rgba(255,107,131,0.06)' : 'rgba(0,200,240,0.06)'}, transparent 60%);`}>
            </div>

            <div class="card-inner flex flex-col justify-between h-full relative z-10">
              <div>
                {/* Header info */}
                <div class="flex items-center justify-between mb-8">
                  <span class="font-mono text-xs text-[var(--text-muted)] font-semibold">0{idx + 1} / SOLUTIONS</span>
                  <div class="text-[var(--accent-cyan)] group-hover:scale-110 transition-transform duration-300" set:html={icons[s.id]} />
                </div>

                {/* Tag */}
                <span class={`inline-block text-[9px] font-mono font-bold tracking-widest uppercase mb-4 px-2 py-0.5 rounded border ${
                  idx === 0 
                    ? 'border-[#ff6b83]/30 bg-[#ff6b83]/5 text-[#f0a278]' 
                    : 'border-[var(--accent-cyan)]/25 bg-[var(--accent-cyan)]/5 text-[var(--accent-cyan)]'
                }`}>
                  {tags[idx]}
                </span>

                {/* Title */}
                <h3 class="font-display text-xl font-bold text-[var(--text-primary)] mb-4 group-hover:text-[var(--accent-cyan)] transition-colors duration-300">
                  {s.title}
                </h3>

                {/* Description */}
                <p class="text-xs text-[var(--text-secondary)] font-body leading-relaxed mb-6">
                  {s.shortDescription}
                </p>
              </div>

              {/* Action Trigger */}
              <div class="flex items-center gap-2 text-[10px] font-display font-bold text-[var(--accent-cyan)] uppercase tracking-wider group-hover:gap-3.5 transition-all duration-300">
                <span>Explore Solution</span>
                <span>→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* 3D Scene configurations */
  .perspective-container {
    perspective: 2000px;
    width: 100%;
    padding: 60px 0;
    overflow: visible;
  }

  .services-3d-deck {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: -40px; /* Overlap cards on desktop */
    transform-style: preserve-3d;
    position: relative;
    width: 100%;
    min-height: 480px;
    transition: transform 0.5s ease;
  }

  /* Base deck card style */
  .deck-card {
    display: block;
    width: 290px;
    height: 400px;
    padding: 32px;
    border-radius: 24px;
    background: rgba(8, 13, 26, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
    position: relative;
    transition: 
      transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), 
      opacity 0.6s ease, 
      filter 0.6s ease,
      border-color 0.4s ease,
      box-shadow 0.4s ease;
    cursor: pointer;
    flex-shrink: 0;
    margin: 0 -25px; /* Overlapping spacing */
    z-index: calc(10 + var(--card-index));
  }

  /* Default fanned-out perspective orientations for all 6 cards */
  .card-1 { transform: rotateY(20deg) translateZ(-60px) translateX(-30px) rotateX(2deg); }
  .card-2 { transform: rotateY(12deg) translateZ(-30px) translateX(-15px) rotateX(2deg); }
  .card-3 { transform: rotateY(4deg) translateZ(0px) translateX(-5px) rotateX(2deg); }
  .card-4 { transform: rotateY(-4deg) translateZ(0px) translateX(5px) rotateX(2deg); }
  .card-5 { transform: rotateY(-12deg) translateZ(-30px) translateX(15px) rotateX(2deg); }
  .card-6 { transform: rotateY(-20deg) translateZ(-60px) translateX(30px) rotateX(2deg); }

  /* Deck container hover states: fade & blur other cards */
  .services-3d-deck:hover .deck-card {
    opacity: 0.35;
    filter: blur(2px) scale(0.96);
  }

  /* Hovering card is highlighted, scales, pushes forward in 3D, and blurs others */
  .services-3d-deck .deck-card:hover {
    opacity: 1;
    filter: blur(0px) scale(1.05);
    z-index: 100;
    transform: rotateY(0deg) translateZ(120px) translateY(-15px) rotateX(0deg) !important;
    border-color: var(--accent-cyan);
    box-shadow: 0 25px 60px rgba(0, 200, 240, 0.15), 0 0 20px rgba(0, 200, 240, 0.05);
  }

  /* Custom glow for featured KOL card on hover */
  .services-3d-deck .card-1:hover {
    border-color: #ff6b83;
    box-shadow: 0 25px 60px rgba(255, 107, 131, 0.15), 0 0 20px rgba(255, 107, 131, 0.05);
  }

  /* Responsive styling: fallback to flat grid or horizontal swiper on mobile */
  @media (max-width: 1200px) {
    .services-3d-deck {
      gap: 20px;
      flex-wrap: wrap;
      min-height: auto;
      justify-content: center;
    }
    .deck-card {
      margin: 0;
      transform: none !important;
      width: calc(50% - 20px);
      max-width: 340px;
    }
    .services-3d-deck:hover .deck-card {
      opacity: 1;
      filter: none;
    }
    .services-3d-deck .deck-card:hover {
      transform: translateY(-5px) !important;
    }
  }

  @media (max-width: 640px) {
    .perspective-container {
      padding: 20px 0;
    }
    .services-3d-deck {
      flex-direction: column;
      gap: 16px;
    }
    .deck-card {
      width: 100%;
      max-width: 100%;
      height: auto;
      min-height: 280px;
    }
  }
</style>
