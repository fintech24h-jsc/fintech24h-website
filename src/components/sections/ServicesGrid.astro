---
// src/components/sections/ServicesGrid.astro
// Theo design-system.md section 7.3 + 6.1:
// - Layout A (2+1 asymmetric): card featured lớn bên trái, 2 card nhỏ bên phải, 3 đều bên dưới
// - Card content: [Số 01] [Tag KOL] → H3 → 2-3 câu có con số → 3 bullet → Link
// - Không phải template icon-title-text đồng đều
import { services } from '../../data/services';
---

<section class="py-24 bg-[var(--bg-secondary)] relative overflow-hidden" aria-label="Services Overview">
  <!-- Background orbs theo design-system.md 5.3 -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[500px] h-[500px] rounded-full"
      style="background: var(--gradient-glow-purple); top: -10%; right: -5%; filter: blur(72px);
             animation: orb-pulse 10s ease-in-out infinite 2s, orb-drift 15s ease-in-out infinite 4s;">
    </div>
    <div class="absolute w-[400px] h-[400px] rounded-full"
      style="background: var(--gradient-glow-cyan); bottom: 5%; left: -8%; filter: blur(72px);
             animation: orb-pulse 8s ease-in-out infinite, orb-drift 12s ease-in-out infinite;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="animation: grid-shimmer 6s ease-in-out infinite; opacity: 0.2;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Heading -->
    <div class="max-w-3xl mb-20" data-animate="fade-up">
      <!-- Eyebrow: font-mono theo spec -->
      <p class="font-mono text-xs text-[var(--accent-purple)] uppercase tracking-[0.12em] mb-4">What We Do</p>
      <h2 class="font-display text-h2 font-bold text-[var(--text-primary)] mb-4">
        Full-Stack Growth Engines
      </h2>
      <p class="text-base text-[var(--text-secondary)] font-body leading-relaxed max-w-lg">
        Specialized Web3 marketing tactics aligned with quantifiable OKRs — acting as your extended growth team.
      </p>
    </div>

    <!-- Services Grid — Layout A (2+1 asymmetric) theo design-system.md 6.1 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6" data-animate="stagger">

      <!-- Card 1: FEATURED — md:col-span-2 md:row-span-2 -->
      <a
        href={`/services/${services[0].slug}`}
        class="card-featured md:col-span-2 p-8 lg:p-10 flex flex-col justify-between group relative overflow-hidden hover:-translate-y-1 transition-transform duration-300"
        data-animate-child
        aria-label={`Explore ${services[0].title}`}
      >
        <!-- Subtle shimmer on hover -->
        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          style="background: radial-gradient(ellipse 60% 60% at 30% 40%, rgba(0,200,240,0.04), transparent);">
        </div>

        <div class="relative z-10">
          <!-- Number + Category tags -->
          <div class="flex items-center justify-between mb-6">
            <span class="font-mono text-[10px] text-[var(--text-muted)] tracking-widest">01</span>
            <span class="tag tag-cyan">KOL</span>
          </div>

          <!-- Title -->
          <h3 class="font-display text-2xl lg:text-3xl font-bold text-[var(--text-primary)] mb-4 group-hover:text-[var(--accent-cyan)] transition-colors duration-300">
            {services[0].title}
          </h3>

          <!-- Description với con số cụ thể -->
          <p class="text-sm text-[var(--text-secondary)] font-body leading-relaxed mb-6 max-w-md">
            {services[0].shortDescription}
          </p>

          <!-- 3 bullet keywords -->
          <ul class="flex flex-wrap gap-2 mb-8">
            {['Network 5,000+ KOLs', 'Tier-1 Coverage', 'Performance-based'].map(b => (
              <li class="tag tag-gray">{b}</li>
            ))}
          </ul>
        </div>

        <!-- Link -->
        <div class="relative z-10 flex items-center gap-2 text-xs font-display font-bold text-[var(--accent-cyan)] uppercase tracking-wider group-hover:gap-3 transition-all duration-300">
          Explore →
        </div>
      </a>

      <!-- Cards 2 & 3: bên phải (normal size) -->
      {services.slice(1, 3).map((s, i) => (
        <a
          href={`/services/${s.slug}`}
          class="card-default p-6 flex flex-col justify-between group relative overflow-hidden"
          data-animate-child
          aria-label={`Explore ${s.title}`}
        >
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-400"
            style="background: radial-gradient(circle at 50% 50%, rgba(0,200,240,0.03), transparent 70%);">
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-5">
              <span class="font-mono text-[10px] text-[var(--text-muted)] tracking-widest">0{i + 2}</span>
              <span class={i === 0 ? 'tag tag-purple' : 'tag tag-cyan'}>
                {i === 0 ? 'PR' : 'Community'}
              </span>
            </div>
            <h3 class="font-display text-lg font-bold text-[var(--text-primary)] mb-3 group-hover:text-[var(--accent-cyan)] transition-colors duration-300">
              {s.title}
            </h3>
            <p class="text-xs text-[var(--text-secondary)] font-body leading-relaxed">
              {s.shortDescription}
            </p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-2 text-xs font-display font-bold text-[var(--accent-cyan)] uppercase tracking-wider group-hover:gap-3 transition-all duration-300">
            Explore →
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom row: 3 cards đều nhau -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-animate="stagger">
      {services.slice(3).map((s, i) => (
        <a
          href={`/services/${s.slug}`}
          class="card-default p-6 flex flex-col justify-between group relative overflow-hidden"
          data-animate-child
          aria-label={`Explore ${s.title}`}
        >
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-400"
            style="background: radial-gradient(circle at 50% 50%, rgba(124,92,252,0.03), transparent 70%);">
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-5">
              <span class="font-mono text-[10px] text-[var(--text-muted)] tracking-widest">0{i + 4}</span>
              <span class="tag tag-gray">{['Growth', 'B2B', 'SEO'][i] ?? 'Service'}</span>
            </div>
            <h3 class="font-display text-lg font-bold text-[var(--text-primary)] mb-3 group-hover:text-[var(--accent-cyan)] transition-colors duration-300">
              {s.title}
            </h3>
            <p class="text-xs text-[var(--text-secondary)] font-body leading-relaxed">
              {s.shortDescription}
            </p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-2 text-xs font-display font-bold text-[var(--accent-cyan)] uppercase tracking-wider group-hover:gap-3 transition-all duration-300">
            Explore →
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Action CTA -->
    <div class="text-center mt-16" data-animate="fade-up">
      <a href="/services" class="btn-ghost">
        <span>Explore All Solutions</span>
      </a>
    </div>

  </div>
</section>
