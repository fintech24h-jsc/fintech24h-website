---
// src/components/sections/TrustBar.astro
// Theo design-system.md section 7.2:
// - Row 1: Platform badges (Crunchbase, Clutch...) — static, không scroll
// - Row 2: Client logos — marquee-track với pause on hover
import { clients } from '../../data/clients';

const platformBadges = [
  { name: 'Crunchbase', url: 'https://www.crunchbase.com/organization/fintech24h', badge: 'Listed' },
  { name: 'Clutch',     url: 'https://clutch.co/profile/fintech24hcom-blockchain-agency-more', badge: 'Verified' },
  { name: 'Sortlist',   url: 'https://www.sortlist.com/agency/fintech24h', badge: 'Top Agency' },
  { name: 'The Manifest', url: 'https://themanifest.com/company/fintech24hcom-blockchain-agency-more', badge: 'Listed' },
];
---

<section class="py-12 border-y border-[var(--border-subtle)] overflow-hidden bg-[var(--bg-primary)]" aria-label="Trusted by clients">

  <!-- Label -->
  <div class="max-w-7xl mx-auto px-4 mb-8 text-center">
    <p class="font-mono text-[10px] text-[var(--text-muted)] uppercase tracking-[0.15em]">
      Trusted by 200+ blockchain &amp; AI projects worldwide
    </p>
  </div>

  <!-- Row 1: Platform badges — STATIC, không scroll -->
  <div class="flex justify-center gap-4 md:gap-6 mb-10 flex-wrap px-4">
    {platformBadges.map((b) => (
      <a
        href={b.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-glass)] text-xs font-body text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]/20 transition-all duration-200 group"
        aria-label={`Fintech24h on ${b.name}`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)] group-hover:bg-[var(--accent-cyan)] transition-colors" aria-hidden="true"></span>
        <span class="font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent-cyan)] transition-colors">{b.name}</span>
        <span class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-wider">{b.badge}</span>
      </a>
    ))}
  </div>

  <!-- Row 2: Client logos — marquee-track với pause on hover theo design-system.md 7.2 -->
  <div class="relative overflow-hidden w-full" role="img" aria-label="Client logos">
    <!-- Gradient overlays fade-out trái/phải -->
    <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-[var(--bg-primary)] to-transparent z-10 pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-[var(--bg-primary)] to-transparent z-10 pointer-events-none"></div>

    <!-- Dùng .marquee-track class từ global.css — có pause on hover -->
    <div class="marquee-track">
      {[...clients, ...clients].map((client, i) => (
        <div
          key={i}
          class="flex items-center gap-2 flex-shrink-0 opacity-40 hover:opacity-90 transition-opacity duration-300"
        >
          {client.logo ? (
            <img
              src={client.logo}
              alt={client.name}
              width="120"
              height="40"
              class="h-7 w-auto object-contain grayscale hover:grayscale-0 transition-all duration-300"
              loading="lazy"
            />
          ) : (
            <span class="font-display font-bold text-sm tracking-wide text-[var(--text-muted)] hover:text-[var(--accent-cyan)] transition-colors uppercase whitespace-nowrap">
              {client.name}
            </span>
          )}
        </div>
      ))}
    </div>
  </div>

</section>
