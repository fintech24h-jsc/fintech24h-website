---
// src/components/sections/TrustBar.astro
// Fully redesigned: Large scale client logos scrolling in opposite directions.
// Features counter-flow scrolling tracks, ambient mesh background grid, and soft glowing hover drop-shadows.
import { clients } from '../../data/clients';

const platformBadges = [
  { name: 'Crunchbase', url: 'https://www.crunchbase.com/organization/fintech24h', badge: 'Listed' },
  { name: 'Clutch',     url: 'https://clutch.co/profile/fintech24hcom-blockchain-agency-more', badge: 'Verified' },
  { name: 'Sortlist',   url: 'https://www.sortlist.com/agency/fintech24h', badge: 'Top Agency' },
  { name: 'The Manifest', url: 'https://themanifest.com/company/fintech24hcom-blockchain-agency-more', badge: 'Listed' },
];

// Split client list into two rows for the counter-flow effect
const row1Clients = clients.slice(0, Math.ceil(clients.length / 2));
const row2Clients = clients.slice(Math.ceil(clients.length / 2));
---

<section class="py-24 border-y border-[var(--border-subtle)] overflow-hidden bg-[var(--bg-primary)] relative" aria-label="Trusted by clients">
  <!-- Glowing background mesh to elevate the section -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute w-[400px] h-[400px] rounded-full"
      style="background: radial-gradient(circle, rgba(0, 200, 240, 0.03) 0%, transparent 70%); top: 50%; left: 50%; transform: translate(-50%, -50%); filter: blur(60px);">
    </div>
    <div class="absolute inset-0 grid-pattern" style="opacity: 0.1;"></div>
  </div>

  <div class="relative z-10">
    <!-- Section Header / Label -->
    <div class="max-w-7xl mx-auto px-4 mb-16 text-center animate-fade-up">
      <p class="font-mono text-[10px] text-[var(--accent-cyan)] uppercase tracking-[0.18em] mb-4 flex items-center justify-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span>
        Global Partnership Network
      </p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--text-primary)] mb-4 tracking-tight">
        Trusted by <span class="bg-gradient-to-r from-[var(--accent-cyan)] to-[#f0a278] bg-clip-text text-transparent">200+ Web3 &amp; AI Brands</span>
      </h2>
    </div>

    <!-- Row 1: Forward Marquee (Scrolling Left-to-Right) -->
    <div class="relative overflow-hidden w-full mb-10 py-2" role="img" aria-label="Client logos row 1">
      <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[var(--bg-primary)] to-transparent z-10 pointer-events-none"></div>
      <div class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--bg-primary)] to-transparent z-10 pointer-events-none"></div>

      <!-- Marquee track scrolling left-to-right -->
      <div class="marquee-track">
        {[...row1Clients, ...row1Clients, ...row1Clients].map((client, i) => (
          <div
            key={i}
            class="flex items-center justify-center flex-shrink-0 px-6 logo-container transition-all duration-300"
          >
            {client.logo ? (
              <img
                src={client.logo}
                alt={client.name}
                width="180"
                height="60"
                class="h-18 sm:h-20 md:h-22 w-auto object-contain logo-img transition-all duration-300"
                loading="lazy"
              />
            ) : (
              <span class="font-display font-bold text-lg md:text-xl tracking-wide text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] transition-colors uppercase whitespace-nowrap">
                {client.name}
              </span>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2: Reverse Marquee (Scrolling Right-to-Left) -->
    <div class="relative overflow-hidden w-full mb-16 py-2" role="img" aria-label="Client logos row 2">
      <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[var(--bg-primary)] to-transparent z-10 pointer-events-none"></div>
      <div class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--bg-primary)] to-transparent z-10 pointer-events-none"></div>

      <!-- Marquee track scrolling right-to-left -->
      <div class="marquee-track-reverse">
        {[...row2Clients, ...row2Clients, ...row2Clients].map((client, i) => (
          <div
            key={i}
            class="flex items-center justify-center flex-shrink-0 px-6 logo-container transition-all duration-300"
          >
            {client.logo ? (
              <img
                src={client.logo}
                alt={client.name}
                width="180"
                height="60"
                class="h-18 sm:h-20 md:h-22 w-auto object-contain logo-img transition-all duration-300"
                loading="lazy"
              />
            ) : (
              <span class="font-display font-bold text-lg md:text-xl tracking-wide text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] transition-colors uppercase whitespace-nowrap">
                {client.name}
              </span>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Row 3: Platform badges (Static validation) -->
    <div class="flex justify-center gap-4 md:gap-6 flex-wrap px-4 animate-fade-up">
      {platformBadges.map((b) => (
        <a
          href={b.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-glass)] text-xs font-body text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]/25 transition-all duration-200 group shadow-lg"
          aria-label={`Fintech24h on ${b.name}`}
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)] group-hover:bg-[var(--accent-cyan)] transition-colors" aria-hidden="true"></span>
          <span class="font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent-cyan)] transition-colors">{b.name}</span>
          <span class="font-mono text-[9px] text-[var(--text-muted)] uppercase tracking-wider">{b.badge}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Base logo styling: default grayscale and brightness */
  .logo-img {
    filter: grayscale(1) brightness(0.7) contrast(1.1);
    opacity: 0.45;
  }

  /* Interactive hover states: restore colors, scale up, and create backdrops */
  .logo-container:hover .logo-img {
    filter: grayscale(0) brightness(1) contrast(1);
    opacity: 1;
    transform: scale(1.12);
  }

  /* Slow down scrolling speeds for easier readability of large logos */
  .marquee-track {
    animation-duration: 45s;
  }
  .marquee-track-reverse {
    animation-duration: 45s;
  }
</style>
