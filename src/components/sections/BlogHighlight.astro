---
// src/components/sections/BlogHighlight.astro
import { getAllPosts, formatDate, getExcerpt, getFeaturedImage } from '../../lib/wordpress';
import { getReadingTime } from '../../lib/utils';

const allPosts = await getAllPosts();
const posts = allPosts.slice(0, 6);
---

{posts.length > 0 && (
<section class="py-12 md:py-24 bg-[var(--bg-primary)] relative overflow-hidden" aria-label="Blog Highlights">
  <!-- Ambient background glow -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-[500px] h-[500px] rounded-full"
      style="background: var(--gradient-glow-cyan); bottom: 10%; right: -5%; filter: blur(90px); opacity: 0.15;">
    </div>
    <div class="absolute inset-0 grid-pattern" style="opacity: 0.1;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 animate-fade-up">
      <div class="max-w-2xl text-left">
        <p class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-[0.15em] mb-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-pulse"></span>
          Insights &amp; Strategy
        </p>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-[var(--text-primary)] mb-4 tracking-tight">
          Latest Web3 <span class="bg-gradient-to-r from-[var(--accent-cyan)] to-[#f0a278] bg-clip-text text-transparent">Marketing Intel</span>
        </h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)] font-body leading-relaxed">
          Stay ahead of the curve with our latest case studies, crypto SEO guidelines, and community growth marketing playbooks.
        </p>
      </div>
      <div>
        <a
          href="/blog"
          class="inline-flex items-center justify-center bg-[var(--surface-soft)] border border-[var(--border-default)] backdrop-blur-md text-[var(--text-primary)] font-mono font-semibold uppercase tracking-wider text-[10px] py-2.5 px-5 rounded-full shadow-md transition-all duration-300 hover:bg-[var(--surface-hover)] hover:border-[var(--border-hover)] hover:-translate-y-0.5 cursor-pointer"
        >
          <span>Explore All Articles →</span>
        </a>
      </div>
    </div>

    <!-- Blog Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate="stagger">
      {posts.map((post) => {
        const rTime = getReadingTime(post.content.rendered);
        const excerptText = getExcerpt(post, 120);
        const featuredImage = getFeaturedImage(post);
        return (
          <article class="btn-liquid-glass-card group flex flex-col justify-between" data-animate-child>
            <div>
              {/* Image Container with Liquid Glass Shine effect on card hover
                  (clickable → article; hidden from tab order since the title
                  below is the primary accessible link to the same post) */}
              {featuredImage.url && (
                <a
                  href={`/blog/${post.slug}`}
                  tabindex="-1"
                  aria-hidden="true"
                  class="block relative aspect-[16/10] rounded-xl overflow-hidden mb-5 border border-[var(--border-subtle)] shadow-inner"
                >
                  <img
                    src={featuredImage.url}
                    alt={featuredImage.alt}
                    width="800"
                    height="500"
                    class="w-full h-full object-cover grayscale transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                  {/* Slate Gray Filter Overlay (No Blur) */}
                  <div class="absolute inset-0 bg-slate-900/60 pointer-events-none transition-all duration-500 group-hover:bg-slate-900/20" aria-hidden="true"></div>

                  {/* Specular Diagonal Glass Sheen Sweep */}
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-out" aria-hidden="true"></div>

                  {/* Bottom Dark shadow for card integration */}
                  <div class="absolute inset-0 bg-gradient-to-t from-[#080c1a]/50 via-transparent to-transparent opacity-40"></div>
                </a>
              )}

              <!-- Info row -->
              <div class="flex items-center gap-3 text-[10px] text-[var(--text-muted)] font-mono uppercase tracking-wider mb-3">
                <span>{formatDate(post.date)}</span>
                <span class="w-1 h-1 rounded-full bg-[var(--border-default)]"></span>
                <span>{rTime} min read</span>
              </div>

              <!-- Title & Summary -->
              <h3 class="font-display text-lg font-bold text-[var(--text-primary)] mb-3 line-clamp-2 leading-snug">
                <a href={`/blog/${post.slug}`} class="group-hover:text-[var(--accent-cyan)] hover:text-[var(--accent-cyan)] transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]">
                  {post.title.rendered}
                </a>
              </h3>
              <p class="text-xs text-[var(--text-secondary)] font-body leading-relaxed mb-6 line-clamp-3">
                {excerptText}
              </p>
            </div>

            <!-- Redirect link styled as a tiny luxury glass button -->
            <div class="flex justify-end pt-4 border-t border-[var(--border-subtle)] mt-auto">
              <a
                href={`/blog/${post.slug}`}
                class="inline-flex items-center justify-center bg-[rgba(0,200,240,0.05)] border border-[rgba(0,200,240,0.2)] backdrop-blur-sm text-[var(--text-primary)] font-mono text-[9px] font-semibold uppercase tracking-wider py-1.5 px-3 rounded-full hover:bg-[rgba(0,200,240,0.12)] hover:border-[rgba(0,200,240,0.45)] hover:shadow-[0_4px_12px_rgba(0,200,240,0.15)] transition-all duration-300"
                aria-label={`Read ${post.title.rendered}`}
              >
                <span>Read Article</span>
                <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>
)}

<style>
  /* Custom Liquid Glass Cards */
  .btn-liquid-glass-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 
      0 8px 32px 0 rgba(0, 0, 0, 0.25),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.08);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .btn-liquid-glass-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(0, 200, 240, 0.25);
    transform: translateY(-8px);
    box-shadow: 
      0 20px 48px 0 rgba(0, 200, 240, 0.08),
      inset 0 1px 2px 0 rgba(255, 255, 255, 0.25);
  }
</style>
