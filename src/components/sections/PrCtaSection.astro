---
// src/components/sections/PrCtaSection.astro
interface Props {
  isHero?: boolean;
}
const { isHero = false } = Astro.props;
const TitleTag = isHero ? 'h1' : 'h2';
const SubtitleTag = isHero ? 'h2' : 'span';
const HeadlineTag = isHero ? 'h3' : 'span';
---
  <section class="relative flex flex-col md:flex-row items-center pt-14 md:pt-24 border-b border-white/10 bg-[#04060A]">
    <!-- Left: Typography Heavy -->
    <div class="w-full md:w-1/2 px-6 md:px-12 lg:px-24 pt-20 pb-16 relative z-10">
      <div class="reveal">
        <span class="block font-mono text-[10px] uppercase tracking-[0.3em] text-white/50 mb-6 border-b border-white/10 pb-4">
          PR & MEDIA CAMPAIGNS // ISSUE 01
        </span>
        <TitleTag class="font-display font-bold text-[clamp(2.5rem,6vw,5rem)] leading-[1.0] text-white tracking-[-0.04em] uppercase mb-8">
          Coverage in the Publications<br/>
          <span class="text-transparent text-stroke-white text-stroke-1 hover:text-white transition-colors duration-500">Your Investors Are Reading.</span>
        </TitleTag>
        <p class="font-body text-lg text-white/70 max-w-md leading-relaxed mb-10 border-l-2 border-white/20 pl-6">
          A press release distributed to 200 outlets nobody reads does nothing. We place editorial coverage that builds credibility, trust, and search authority.
        </p>
        <a href="/services/pr-media" class="inline-block bg-white text-black px-8 py-4 font-mono text-sm uppercase tracking-widest font-bold hover:bg-white/80 transition-colors">
          Get a PR Strategy
        </a>
      </div>
    </div>

    <!-- Right: Realistic Newspaper Mockup -->
    <div class="w-full md:w-1/2 min-h-[50vh] md:h-full relative overflow-hidden bg-[#0A0D14] border-l border-white/10 flex items-center justify-center p-8 lg:p-16 perspective-1000 py-16">
      
      <!-- Ethereal Glow Behind Newspaper -->
      <div class="absolute w-[400px] h-[400px] bg-white/5 rounded-full blur-[100px] animate-pulse pointer-events-none"></div>

      <!-- Newspaper Paper Container -->
      <div class="relative w-full max-w-lg bg-[#f0ede6] shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-6 md:p-8 transform-gpu rotate-y-[-10deg] rotate-x-[5deg] rotate-[-2deg] hover:rotate-0 hover:scale-105 transition-all duration-700 ease-out border border-[#d6d2c4] newspaper-texture reveal reveal-delay-2 group">
        
        <!-- Subtle paper texture overlay -->
        <div class="absolute inset-0 opacity-30 mix-blend-multiply pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/aged-paper.png')]"></div>
        
        <!-- Masthead -->
        <div class="text-center border-b-[3px] border-black/85 pb-3 mb-3 relative z-10">
          <SubtitleTag class="font-serif text-[clamp(2.5rem,4vw,4rem)] font-black text-black/90 uppercase tracking-tighter leading-none block" style="font-family: Georgia, 'Times New Roman', serif;">
            Fintech24h
          </SubtitleTag>
        </div>
        
        <!-- Dateline -->
        <div class="flex justify-between items-center border-b border-black/85 pb-2 mb-6 text-[9px] md:text-[10px] font-mono uppercase text-black/70 tracking-widest relative z-10">
          <span>Global Edition</span>
          <span class="hidden sm:inline">Tier-1 Editorial Placement</span>
          <span>Vol. 1</span>
        </div>
        
        <!-- Headline (The Tagline) -->
        <div class="mb-6 text-center relative z-10">
          <HeadlineTag class="block font-serif text-[clamp(1.8rem,3vw,2.5rem)] font-bold text-black/90 leading-[1.05] tracking-tight uppercase" style="font-family: Georgia, 'Times New Roman', serif;">
            The Growth Partner<br/>in Blockchain, Fintech & Web3
          </HeadlineTag>
        </div>
        
        <!-- 3-Column Layout Content -->
        <div class="grid grid-cols-3 gap-4 md:gap-6 relative z-10">
          <div class="col-span-2 space-y-3">
            <!-- Featured Image Placeholder with zoom effect -->
            <div class="w-full h-32 md:h-40 bg-black/10 flex items-center justify-center overflow-hidden border border-black/20">
              <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=2070&auto=format&fit=crop')] bg-cover bg-center opacity-80 mix-blend-multiply grayscale group-hover:scale-110 transition-transform duration-1000"></div>
            </div>
            <!-- Body Text Lines -->
            <div class="space-y-1.5">
              <div class="w-full h-1 bg-black/20"></div>
              <div class="w-full h-1 bg-black/20"></div>
              <div class="w-11/12 h-1 bg-black/20"></div>
              <div class="w-full h-1 bg-black/20"></div>
              <div class="w-9/12 h-1 bg-black/20"></div>
            </div>
          </div>
          
          <div class="col-span-1 border-l border-black/30 pl-4 md:pl-6 space-y-3">
            <span class="block font-serif text-[10px] md:text-xs font-bold text-black/90 leading-tight uppercase">Dominating Market Share</span>
            <div class="space-y-1.5 mt-2">
              <div class="w-full h-1 bg-black/20"></div>
              <div class="w-10/12 h-1 bg-black/20"></div>
              <div class="w-full h-1 bg-black/20"></div>
              <div class="w-8/12 h-1 bg-black/20"></div>
              <div class="w-full h-1 bg-black/20"></div>
              <div class="w-11/12 h-1 bg-black/20"></div>
              <div class="w-7/12 h-1 bg-[var(--accent-cyan)] shadow-[0_0_8px_var(--accent-cyan)]"></div>
            </div>
            
            <div class="pt-2 mt-2 border-t border-black/20 space-y-1.5">
              <div class="w-full h-1 bg-black/20"></div>
              <div class="w-9/12 h-1 bg-black/20"></div>
            </div>
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <style>
    .text-stroke-white { -webkit-text-stroke: 1px rgba(255,255,255,0.2); }
    .text-stroke-1 { -webkit-text-stroke-width: 1px; }
  </style>
