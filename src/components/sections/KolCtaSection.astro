---
// src/components/sections/KolCtaSection.astro
interface Props {
  isHero?: boolean;
}
const { isHero = false } = Astro.props;
const TitleTag = isHero ? 'h1' : 'h2';
// On the KOL page itself the CTA must not link back to the same page.
const ctaHref = isHero ? '/contact/' : '/services/kol-marketing/';
---
  <section class="relative min-h-[70vh] md:min-h-[90vh] flex flex-col justify-center pt-16 pb-12 md:pt-32 md:pb-20 px-4 overflow-hidden border-b border-[var(--border-default)] bg-[#04060A]" data-theme-surface="midnight">
    <!-- Network Background Nodes -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <!-- Ambient overall glow for mobile -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,200,240,0.1),transparent_60%)] sm:opacity-50"></div>

      <!-- Node 1 -->
      <div class="absolute top-[10%] left-[-5%] sm:left-[10%] w-40 h-40 sm:w-32 sm:h-32 rounded-full border border-[var(--border-subtle)] flex items-center justify-center animate-[float-slow_8s_ease-in-out_infinite]">
        <div class="w-20 h-20 sm:w-12 sm:h-12 rounded-full bg-[var(--gradient-glow-cyan)] opacity-40 sm:opacity-20 blur-2xl sm:blur-xl"></div>
        <span class="w-12 h-12 sm:w-10 sm:h-10 rounded-full border border-[var(--accent-cyan)] bg-[#04060A] flex items-center justify-center opacity-80 sm:opacity-60 absolute text-[var(--accent-cyan)]"><svg class="w-5 h-5 sm:w-4 sm:h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L2 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z"/></svg></span>
        <div class="absolute inset-0 rounded-full border border-[var(--accent-cyan)] opacity-30 animate-[pulse-ring_6s_ease-out_infinite]"></div>
      </div>

      <!-- Node 2 -->
      <div class="absolute top-[40%] sm:top-[30%] right-[-10%] sm:right-[15%] w-56 h-56 sm:w-40 sm:h-40 rounded-full border border-[var(--border-subtle)] flex items-center justify-center animate-[float-slow_10s_ease-in-out_infinite_reverse]">
        <div class="w-28 h-28 sm:w-16 sm:h-16 rounded-full bg-[var(--gradient-glow-purple)] opacity-40 sm:opacity-20 blur-2xl sm:blur-xl"></div>
        <span class="w-14 h-14 sm:w-12 sm:h-12 rounded-full border border-[var(--accent-purple)] bg-[#04060A] flex items-center justify-center opacity-80 sm:opacity-60 absolute text-[var(--accent-purple)]"><svg class="w-6 h-6 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3-5.2 3Z"/></svg></span>
        <div class="absolute inset-0 rounded-full border border-[var(--accent-purple)] opacity-30 animate-[pulse-ring_8s_ease-out_infinite]"></div>
      </div>

      <!-- Node 3 -->
      <div class="absolute bottom-[5%] sm:bottom-[20%] left-[10%] sm:left-[25%] w-32 h-32 sm:w-24 sm:h-24 rounded-full border border-[var(--border-subtle)] flex items-center justify-center animate-[float-fast_7s_ease-in-out_infinite]">
        <div class="w-16 h-16 rounded-full bg-white opacity-10 blur-xl"></div>
        <span class="w-10 h-10 sm:w-8 sm:h-8 rounded-full border border-white/30 bg-[#04060A] flex items-center justify-center opacity-60 sm:opacity-40 absolute text-white"><svg class="w-4 h-4 sm:w-3.5 sm:h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z"/></svg></span>
      </div>

      <!-- Connecting Lines (SVG) -->
      <svg class="absolute inset-0 w-full h-full opacity-20 sm:opacity-10" preserveAspectRatio="none">
        <line x1="0%" y1="20%" x2="50%" y2="50%" stroke="var(--accent-cyan)" stroke-width="1.5" stroke-dasharray="4 4" class="line-reveal" />
        <line x1="100%" y1="50%" x2="50%" y2="50%" stroke="var(--accent-purple)" stroke-width="1.5" stroke-dasharray="4 4" class="line-reveal delay-200" />
        <line x1="20%" y1="90%" x2="50%" y2="50%" stroke="white" stroke-width="1.5" stroke-dasharray="4 4" class="line-reveal delay-500" />
      </svg>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto w-full text-center px-4 sm:px-0">
      <div class="relative p-6 sm:p-0 rounded-2xl sm:rounded-none bg-black/20 sm:bg-transparent backdrop-blur-md sm:backdrop-blur-none border border-[var(--border-subtle)] sm:border-none shadow-[0_0_30px_rgba(0,0,0,0.5)] sm:shadow-none">
        <div class="inline-flex items-center justify-center mb-6 sm:mb-8 reveal reveal-delay-1">
          <span class="px-4 py-1.5 rounded-full border border-[var(--accent-cyan)] bg-[color-mix(in_srgb,var(--accent-cyan)_10%,transparent)] text-[var(--accent-cyan)] font-mono text-xs uppercase tracking-[0.14em] shadow-[0_0_15px_rgba(0,200,240,0.2)]">
            KOL & INFLUENCER MARKETING
          </span>
        </div>

        {isHero ? (
          <>
            <h1 class="font-display font-bold max-w-4xl mx-auto reveal reveal-delay-2 relative">
              <span class="block text-[clamp(2.5rem,6vw,5rem)] tracking-[-0.03em] leading-[1.05] text-[var(--text-primary)]">
                Crypto KOL &amp;<br/>
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)]">Influencer Marketing Agency</span>
              </span>
            </h1>
            <p class="font-display font-semibold text-[clamp(1.2rem,2.2vw,1.6rem)] text-[var(--text-primary)] max-w-2xl mx-auto mt-6 reveal reveal-delay-3">
              The right voice, reaching the right audience.
            </p>
            <p class="font-body text-base sm:text-[18px] text-[var(--text-secondary)] max-w-2xl mx-auto mt-4 mb-4 sm:mb-12 leading-[1.7] reveal reveal-delay-3">
              We plan and run KOL campaigns for crypto, Web3, DeFi and fintech projects on X, YouTube, Telegram and TikTok, choosing influencers for audience fit and real engagement, not follower count.
            </p>
          </>
        ) : (
          <>
            <TitleTag class="font-display font-bold max-w-4xl mx-auto reveal reveal-delay-2 relative">
              <span class="block text-[clamp(2.5rem,6vw,5rem)] tracking-[-0.03em] leading-[1.05] text-[var(--text-primary)]">
                The Right Voice,<br/>
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)]">Reaching the Right Audience.</span>
              </span>
            </TitleTag>

            <p class="font-body text-base sm:text-[18px] text-[var(--text-secondary)] max-w-2xl mx-auto mt-6 sm:mt-8 mb-4 sm:mb-12 leading-[1.7] reveal reveal-delay-3">
              Most KOL campaigns fail before they start, because the wrong influencers are chosen for the wrong reasons. We build campaigns around audience fit, not follower count.
            </p>
          </>
        )}
      </div>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-6 reveal reveal-delay-4 mt-8">
        <!-- Liquid Glass Button -->
        <a href={ctaHref} class="relative overflow-hidden font-mono text-sm uppercase tracking-widest font-bold text-[var(--text-primary)] border border-[color-mix(in_srgb,var(--accent-cyan)_40%,transparent)] bg-[color-mix(in_srgb,var(--accent-cyan)_10%,transparent)] px-8 py-4 rounded-xl hover:bg-[color-mix(in_srgb,var(--accent-cyan)_20%,transparent)] hover:border-[var(--accent-cyan)] hover:shadow-[0_0_40px_rgba(0,200,240,0.3)] transition-all duration-500 group/btn backdrop-blur-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-cyan)]">
          <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover/btn:animate-[shimmer_1.5s_infinite]"></span>
          <span class="relative z-10 drop-shadow-[0_0_8px_rgba(0,200,240,0.8)]">Get a KOL Proposal</span>
        </a>
        
        <a href="https://t.me/fintech24h" target="_blank" rel="noopener noreferrer" class="font-mono text-sm uppercase tracking-widest font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border-b border-transparent hover:border-white/50 pb-1 rounded-sm">
          Chat on Telegram
        </a>
      </div>
    </div>
  </section>

  <style is:global>
    /* Hidden only when JS can reveal it; 0.01 (not 0) keeps the hero H1 eligible as LCP. */
    @media (scripting: enabled) {
      .reveal { opacity: 0.01; transform: translateY(14px); transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1); }
    }
    .reveal.revealed { opacity: 1; transform: translateY(0); }
    .reveal-delay-1 { transition-delay: 0.05s; }
    .reveal-delay-2 { transition-delay: 0.1s; }
    .reveal-delay-3 { transition-delay: 0.15s; }
    .reveal-delay-4 { transition-delay: 0.2s; }
    .line-reveal { transform: scaleX(0); transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transform-origin: left; }
    .revealed .line-reveal { transform: scaleX(1); }
    @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
    @keyframes shimmer {
      100% { transform: translateX(100%); }
    }
  </style>

  <script>
  // @ts-nocheck — plain JS moved out of is:inline/define:vars so the CSP needs no
  // 'unsafe-inline'; it was never type-checked as an inline script.
    document.addEventListener('DOMContentLoaded', () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.05 });
      document.querySelectorAll('.reveal, svg').forEach(el => observer.observe(el));
    });
  </script>
