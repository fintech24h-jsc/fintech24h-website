/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), haptic-feedback=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.hsforms.net https://assets.calendly.com https://*.calendly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.hsforms.com https://*.hsforms.com https://fintech24h.com https://*.fintech24h.com https://script.google.com https://script.googleusercontent.com; frame-src 'self' https://assets.calendly.com https://calendly.com; img-src 'self' data: https://fintech24h.com https://*.fintech24h.com https://images.unsplash.com https://i.pravatar.cc;
  Link: </.well-known/api-catalog>; rel="api-catalog"

# Agent discovery well-known files — correct Content-Type for non-extension files
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/.well-known/agent-skills/index.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/auth.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

# Cache static assets from Astro (CSS/JS with hashes) for 1 year
/_assets/*
  Cache-Control: public, max-age=31536000, immutable
