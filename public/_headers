# The CSP hash placeholder (double-underscore CSP_SCRIPT_HASHES) is replaced at build time with the
# sha256 of every inline <script> in dist/**/*.html (scripts/csp-hashes.mjs).
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://platform.twitter.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://api.hsforms.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://fintech24h-dealmakers-community.fintech24hvn.workers.dev https://cloudflareinsights.com; frame-src 'self' https://calendly.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.linkedin.com https://platform.twitter.com https://syndication.twitter.com; worker-src 'self' blob:; manifest-src 'self'; img-src 'self' data: blob: https://fintech24h.com https://*.fintech24h.com https://images.unsplash.com https://i.pravatar.cc https://*.google-analytics.com https://fintech24h-dealmakers-community.fintech24hvn.workers.dev
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' __CSP_SCRIPT_HASHES__ https://www.googletagmanager.com https://static.cloudflareinsights.com https://platform.twitter.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://api.hsforms.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://fintech24h-dealmakers-community.fintech24hvn.workers.dev https://cloudflareinsights.com; frame-src 'self' https://calendly.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.linkedin.com https://platform.twitter.com https://syndication.twitter.com; worker-src 'self' blob:; manifest-src 'self'; img-src 'self' data: blob: https://fintech24h.com https://*.fintech24h.com https://images.unsplash.com https://i.pravatar.cc https://*.google-analytics.com https://fintech24h-dealmakers-community.fintech24hvn.workers.dev
  Link: </.well-known/api-catalog>; rel="api-catalog"

# Agent discovery well-known files — correct Content-Type for non-extension files
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/.well-known/agent-skills/index.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/auth.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

# Internal coordinate tool must never be indexed.
/map-test
  X-Robots-Tag: noindex, nofollow
/map-test.html
  X-Robots-Tag: noindex, nofollow

# Cache static assets from Astro (CSS/JS with hashes) for 1 year
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ensure blog pages revalidate and do not cache stale mock data
/blog
  Cache-Control: no-cache, no-store, must-revalidate
/blog/*
  Cache-Control: no-cache, no-store, must-revalidate
