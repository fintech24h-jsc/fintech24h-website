// ⚠️ DO NOT DELETE THIS FILE OR REMOVE ANY FIELD BELOW.
//
// Without this file, Cloudflare's git-connected deploy for the
// `fintech24h-website` Worker fails SILENTLY after a successful build —
// `npx wrangler deploy` (the dashboard-configured deploy command) errors
// with "Missing entry-point to Worker script or to assets directory" and
// the live site never updates, even though the build step shows green.
// See DEPLOYMENT.md at the repo root for the full incident writeup.
//
// Also required: public/.assetsignore (containing "_worker.js") — without
// it, wrangler refuses to deploy at all, warning that the SSR server code
// in dist/_worker.js would be uploaded as a public static asset.
{
  "name": "fintech24h-website",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Astro's @astrojs/cloudflare adapter emits the SSR Worker entry here.
  // If you upgrade that adapter and it changes its output layout, update
  // this path to match — check dist/_worker.js/ after a local build.
  "main": "./dist/_worker.js/index.js",
  // run_worker_first was tried and REVERTED: forcing the Worker to run for
  // every request also runs it for static files the sitemap integration
  // writes straight to dist/ (sitemap-index.xml, sitemap-0.xml) — those
  // aren't registered in Astro's own route manifest, so with the Worker
  // running first they fell through to the catch-all src/pages/[...path].astro
  // (prerender:false, matches anything) which rewrote them to a 404 instead
  // of ever reaching Cloudflare's real static-asset lookup. Confirmed by the
  // 404 carrying an `x-astro-rewrite: yes` header. Do not re-enable this
  // without also teaching [...path].astro to ignore known static filenames.
  //
  // The actual fix for the GSC redirect-validation failures was
  // html_handling below, combined with enabling "Always Use HTTPS" in the
  // Cloudflare dashboard (SSL/TLS > Edge Certificates) for the HTTP->HTTPS
  // part — neither depends on run_worker_first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Cloudflare's asset serving defaults to html_handling
    // "auto-trailing-slash", which transparently serves dist/careers/
    // index.html for BOTH /careers and /careers/ as separate 200s — no
    // redirect, so middleware.ts and public/_redirects never even get a
    // chance to run (confirmed: identical <title> from both URLs).
    // "force-trailing-slash" makes Cloudflare itself 301 the slashless
    // form instead of serving duplicate content.
    "html_handling": "force-trailing-slash"
  }
  // No "routes" field on purpose — routes for this zone are configured in
  // the Cloudflare dashboard directly. Adding a routes field here would
  // make wrangler try to manage (and potentially clobber) them.
}
